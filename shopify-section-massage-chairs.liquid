<!-- PRODUCT DATA FROM SHOPIFY LIQUID — ALWAYS LIVE -->
<script>
var mcProducts = [
  {% paginate collection.products by 250 %}
  {% for product in collection.products %}
  {
    n: {{ product.title | json }},
    u: "{{ product.url }}",
    i: "{{ product.featured_image | image_url: width: 600 }}",
    p: {{ product.price }},
    cp: {{ product.compare_at_price | default: 0 }},
    b: {{ product.vendor | json }},
    tags: {{ product.tags | json }},
    type: {{ product.type | json }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% endpaginate %}
];

var mcBrandOrder = ["Osaki","Bodyfriend","Ogawa","Infinity","Cozzia","Kyota","Fujiiryoki","JP Medics","Svago"];
var mcPriceFilter = {type:'all'};
var mcBrand = 'all';

function mcFormatPrice(cents){
  return '$' + (cents/100).toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:0});
}

function mcApplyFilters(){
  var filtered = mcProducts;
  if(mcPriceFilter.type!=='all'){
    filtered = filtered.filter(function(p){var v=p.p/100;return v>=mcPriceFilter.min && v<mcPriceFilter.max;});
  }
  if(mcBrand!=='all'){
    filtered = filtered.filter(function(p){return p.b===mcBrand;});
  }
  var grid = document.getElementById('mcProductGrid');
  grid.style.opacity='0';
  setTimeout(function(){
    grid.innerHTML='';
    mcRenderProducts(filtered);
    document.getElementById('mcFilterCount').textContent = filtered.length + ' chair' + (filtered.length!==1?'s':'');
    grid.style.opacity='1';
  },200);
}

function mcFilter(btn,minOrAll,max){
  document.querySelectorAll('#mcFilterBar .filter-btn:not(.brand-filter)').forEach(function(b){b.classList.remove('active');});
  btn.classList.add('active');
  if(minOrAll==='all'){mcPriceFilter={type:'all'};}
  else{mcPriceFilter={type:'range',min:minOrAll,max:max};}
  mcApplyFilters();
}

function mcBrandFilter(btn,brand){
  document.querySelectorAll('.mc-landing .brand-filter').forEach(function(b){b.classList.remove('active');});
  btn.classList.add('active');
  mcBrand=brand;
  mcApplyFilters();
}

function mcGetBadge(p){
  var t=p.tags||[];var tl=t.map(function(x){return x.toLowerCase();});
  if(tl.indexOf('duo')!==-1||p.n.toLowerCase().indexOf('duo')!==-1) return 'Duo';
  if(tl.indexOf('5d')!==-1||p.n.toLowerCase().indexOf('5d')!==-1) return '5D';
  if(tl.indexOf('ai')!==-1||p.n.toLowerCase().indexOf('ai ')!==-1||p.n.toLowerCase().indexOf(' ai')!==-1) return 'AI';
  if(tl.indexOf('4d')!==-1||p.n.toLowerCase().indexOf('4d')!==-1) return '4D';
  if(tl.indexOf('3d')!==-1||p.n.toLowerCase().indexOf('3d')!==-1) return '3D';
  if(tl.indexOf('syner-d')!==-1||p.n.toLowerCase().indexOf('syner')!==-1) return 'Syner-D';
  if(tl.indexOf('zero gravity')!==-1) return 'ZG';
  if(p.p<500000) return 'Value';
  if(p.p>=1000000) return 'Premium';
  return '';
}

function mcGetFeatures(p){
  var feats=[];
  var nl=p.n.toLowerCase();var tl=(p.tags||[]).map(function(x){return x.toLowerCase();});
  if(nl.indexOf('duo')!==-1||nl.indexOf('dual')!==-1) feats.push('Dual engine system');
  if(nl.indexOf('5d')!==-1) feats.push('5D roller technology');
  else if(nl.indexOf('4d')!==-1) feats.push('4D roller technology');
  else if(nl.indexOf('3d')!==-1) feats.push('3D roller technology');
  if(nl.indexOf('syner')!==-1) feats.push('Syner-D dual rollers');
  if(tl.indexOf('zero gravity')!==-1||nl.indexOf('zero gravity')!==-1) feats.push('Zero gravity recline');
  else feats.push('Zero gravity recline');
  if(tl.indexOf('heat')!==-1||tl.indexOf('heat therapy')!==-1) feats.push('Heat therapy');
  if(tl.indexOf('sl-track')!==-1||tl.indexOf('sl track')!==-1) feats.push('SL-track massage');
  if(tl.indexOf('body scan')!==-1||tl.indexOf('body scanning')!==-1) feats.push('AI body scanning');
  if(nl.indexOf('ai')!==-1) feats.push('AI-powered programs');
  if(feats.length<3) feats.push('Full body air compression');
  if(feats.length<3) feats.push('Space-saving design');
  return feats.slice(0,3);
}

function mcRenderProducts(list){
  var grid=document.getElementById('mcProductGrid');
  var brands=mcBrandOrder.filter(function(b){return list.some(function(p){return p.b===b;});});
  var otherBrands=[];
  list.forEach(function(p){if(mcBrandOrder.indexOf(p.b)===-1 && otherBrands.indexOf(p.b)===-1) otherBrands.push(p.b);});
  brands=brands.concat(otherBrands);

  if(brands.length===0){
    grid.innerHTML='<div style="text-align:center;padding:64px 0;"><p style="font-size:18px;color:#444;margin-bottom:8px;">No chairs match your filters.</p><p style="font-size:15px;color:#444;">Try adjusting your price range or brand selection.</p></div>';
    return;
  }

  brands.forEach(function(brand){
    var bp=list.filter(function(p){return p.b===brand;});
    var sec=document.createElement('div');sec.className='brand-section';
    sec.innerHTML='<div class="brand-divider"><h3>'+brand+' Massage Chairs</h3><span class="brand-count">'+bp.length+'</span></div>';
    var g=document.createElement('div');g.className='brand-products';
    bp.forEach(function(p){
      var card=document.createElement('div');card.className='product-card';
      var badge=mcGetBadge(p);
      var feats=mcGetFeatures(p);
      var featHtml=feats.map(function(f){return '<li style="display:flex;align-items:center;gap:6px;"><span style="color:#b38b4d;font-size:12px;">✓</span> '+f+'</li>';}).join('');
      var priceHtml='<span class="price-sale">'+mcFormatPrice(p.p)+'</span>';
      if(p.cp && p.cp>p.p){priceHtml+='<span class="price-compare">'+mcFormatPrice(p.cp)+'</span>';}
      card.innerHTML=(badge?'<span class="product-badge">'+badge+'</span>':'')
        +'<a href="'+p.u+'"><img class="product-card-img" src="'+p.i+'" alt="'+p.n+'" loading="lazy"></a>'
        +'<div class="product-card-body"><h3><a href="'+p.u+'" style="color:inherit;">'+p.n+'</a></h3>'
        +'<ul style="list-style:none;padding:0;margin:0 0 12px;font-size:13px;color:#444;line-height:1.9;">'+featHtml+'</ul>'
        +'<div class="product-prices">'+priceHtml+'</div>'
        +'<a href="'+p.u+'" class="product-card-link">View Details</a></div>';
      g.appendChild(card);
    });
    sec.appendChild(g);grid.appendChild(sec);
  });
}

mcRenderProducts(mcProducts);

var mcActiveTier=null;
function mcToggleTier(el,min,max){
  var wrap=document.getElementById('mcTierProducts');
  var inner=document.getElementById('mcTierProductsInner');
  var cards=document.querySelectorAll('.mc-tier-card');
  if(mcActiveTier===el){wrap.style.maxHeight='0';el.style.boxShadow='';el.style.transform='';cards.forEach(function(c){c.style.opacity='1';});mcActiveTier=null;return;}
  mcActiveTier=el;
  cards.forEach(function(c){c.style.opacity='0.5';c.style.boxShadow='';c.style.transform='';});
  el.style.opacity='1';el.style.transform='translateY(-4px)';el.style.boxShadow='0 12px 28px rgba(179,139,77,0.2)';
  var filtered=mcProducts.filter(function(p){return p.p>=min && p.p<max;});
  inner.innerHTML='';
  if(filtered.length===0){inner.innerHTML='<p style="grid-column:1/-1;text-align:center;color:#444;padding:32px;">No chairs found in this range.</p>';}
  else{filtered.forEach(function(p){
    var card=document.createElement('div');
    card.style.cssText='background:#fff;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;transition:all 0.3s;';
    card.onmouseover=function(){card.style.transform='translateY(-4px)';card.style.boxShadow='0 12px 24px rgba(0,0,0,0.08)';};
    card.onmouseout=function(){card.style.transform='';card.style.boxShadow='';};
    var priceHtml='<span style="font-size:18px;font-weight:800;">'+mcFormatPrice(p.p)+'</span>';
    if(p.cp&&p.cp>p.p){priceHtml+='<span style="font-size:14px;color:#999;text-decoration:line-through;margin-left:6px;">'+mcFormatPrice(p.cp)+'</span>';}
    card.innerHTML='<a href="'+p.u+'"><img src="'+p.i+'" alt="'+p.n+'" style="width:100%;height:200px;object-fit:contain;padding:16px;background:#fff;" loading="lazy"></a>'
      +'<div style="padding:16px 20px 20px;"><h4 style="font-size:15px;margin-bottom:6px;line-height:1.3;font-weight:700;"><a href="'+p.u+'" style="color:inherit;">'+p.n+'</a></h4>'
      +'<div style="display:flex;align-items:baseline;gap:6px;margin-bottom:12px;">'+priceHtml+'</div>'
      +'<a href="'+p.u+'" style="display:block;text-align:center;background:#000;color:#fff;padding:10px;border-radius:10px;font-weight:700;font-size:14px;transition:background 0.2s;" onmouseover="this.style.background=\'#b38b4d\'" onmouseout="this.style.background=\'#000\'">View Details</a></div>';
    inner.appendChild(card);
  });}
  wrap.style.maxHeight=inner.scrollHeight+40+'px';
  setTimeout(function(){wrap.scrollIntoView({behavior:'smooth',block:'nearest'});},100);
}

function toggleMcFaq(el){var a=el.nextElementSibling;var o=a.classList.contains('open');document.querySelectorAll('.mc-landing .faq-a').forEach(function(x){x.classList.remove('open');});document.querySelectorAll('.mc-landing .faq-q').forEach(function(x){x.classList.remove('active');});if(!o){a.classList.add('open');el.classList.add('active');}}
</script>

