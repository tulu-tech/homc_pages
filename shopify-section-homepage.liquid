{% raw %}
<style>
.hp-landing{--bg:#fff;--surface:#f8fafc;--dark:#000;--muted:#444;--accent:#b38b4d;--accent-hover:#96723e;--border:#e2e8f0;font-family:'Inter',sans-serif;line-height:1.75;font-size:17px;font-weight:500;-webkit-font-smoothing:antialiased;color:#000}
.hp-landing *{box-sizing:border-box}
.hp-landing h1,.hp-landing h2,.hp-landing h3,.hp-landing h4{color:var(--dark);line-height:1.2;font-weight:700;letter-spacing:-0.025em}
.hp-landing a{color:inherit;text-decoration:none} .hp-landing img{max-width:100%;display:block}
.hp-landing .container{max-width:1200px;margin:0 auto;padding:0 2rem}
.hp-landing .container-narrow{max-width:900px;margin:0 auto;padding:0 2rem}
.hp-landing .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--dark);color:#fff;padding:16px 40px;font-size:16px;font-weight:700;border-radius:50px;text-decoration:none;transition:all 0.25s;border:2px solid var(--dark);cursor:pointer}
.hp-landing .btn:hover{background:#222;border-color:#222;transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,0.15)}
.hp-landing .btn-outline{background:transparent;color:var(--dark);border:2px solid var(--border)}
.hp-landing .btn-outline:hover{border-color:var(--dark);background:var(--surface)}
.hp-landing .btn-gold{background:var(--accent);border-color:var(--accent);color:#fff}
.hp-landing .btn-gold:hover{background:var(--accent-hover);border-color:var(--accent-hover);transform:translateY(-2px);box-shadow:0 8px 20px rgba(179,139,77,0.25)}
.hp-landing .hero{padding:0;background:#000;text-align:center;position:relative;overflow:hidden;min-height:85vh;display:flex;align-items:center;justify-content:center}
.hp-landing .hero-bg-video{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:1;opacity:0.6}
.hp-landing .hero::after{content:'';position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(to bottom,rgba(0,0,0,0.1) 0%,rgba(0,0,0,0.4) 100%);z-index:2;pointer-events:none}
.hp-landing .hero .container{position:relative;z-index:3;padding:96px 2rem}
.hp-landing .hero h1{font-size:72px;margin-bottom:24px;font-weight:900;color:#fff;text-shadow:0 2px 20px rgba(0,0,0,0.3)}
.hp-landing .hero p{font-size:22px;color:rgba(255,255,255,0.9);max-width:700px;margin:0 auto 40px}
.hp-landing .trust-bar{display:flex;justify-content:center;gap:48px;padding:20px 2rem;border-bottom:1px solid var(--border);font-size:15px;font-weight:700;flex-wrap:wrap;background:#fff}
.hp-landing .trust-item{display:flex;align-items:center;gap:10px}
.hp-landing .trust-item svg{width:22px;height:22px;fill:var(--accent)}
.hp-landing .section{padding:80px 0}
.hp-landing .section-header{text-align:center;margin-bottom:48px}
.hp-landing .section-header h2{font-size:40px;margin-bottom:16px}
.hp-landing .section-header h2::before{content:'';display:block;width:40px;height:3px;background:var(--accent);margin:0 auto 20px;border-radius:2px}
.hp-landing .section-header p{font-size:18px;color:var(--muted);max-width:680px;margin:0 auto;line-height:1.8}
.hp-landing .product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.hp-landing .product-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:all 0.3s;position:relative}
.hp-landing .product-card:hover{transform:translateY(-8px);box-shadow:0 25px 50px rgba(0,0,0,0.08);border-color:var(--accent)}
.hp-landing .product-card-img{width:100%;height:300px;object-fit:contain;padding:24px;background:#fff}
.hp-landing .product-card-body{padding:20px 24px 24px}
.hp-landing .product-card-body h3{font-size:18px;margin-bottom:10px;line-height:1.3}
.hp-landing .product-prices{display:flex;align-items:baseline;gap:10px;margin-bottom:12px}
.hp-landing .price-sale{font-size:22px;font-weight:800;color:var(--dark)}
.hp-landing .price-compare{font-size:16px;color:#94a3b8;text-decoration:line-through;font-weight:500}
.hp-landing .product-card-link{display:block;text-align:center;background:var(--dark);color:#fff;padding:12px;border-radius:10px;font-weight:700;font-size:15px;transition:background 0.2s}
.hp-landing .product-card-link:hover{background:var(--accent)}
.hp-landing .badge{position:absolute;top:16px;left:16px;background:var(--accent);color:#fff;font-size:12px;font-weight:800;padding:5px 12px;border-radius:50px;text-transform:uppercase;letter-spacing:1px;z-index:2}
.hp-landing .brands-grid{display:flex;justify-content:center;gap:28px;flex-wrap:wrap;max-width:1200px;margin:0 auto;padding:0 2rem}
.hp-landing .brand-badge{display:flex;align-items:center;justify-content:center;text-decoration:none;transition:all 0.3s;width:140px}
.hp-landing .brand-badge:hover{transform:translateY(-6px)}
.hp-landing .brand-badge img{width:100%;height:auto;transition:all 0.3s}
.hp-landing .blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.hp-landing .blog-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:all 0.3s}
.hp-landing .blog-card:hover{border-color:var(--accent);transform:translateY(-6px);box-shadow:0 15px 30px rgba(0,0,0,0.05)}
.hp-landing .blog-icon{width:100%;height:180px;display:flex;align-items:center;justify-content:center;background:#fff}
.hp-landing .blog-icon svg{width:56px;height:56px;fill:var(--accent)}
.hp-landing .blog-card-body{padding:24px}
.hp-landing .blog-card-body h3{font-size:18px;margin-bottom:10px;line-height:1.3}
.hp-landing .blog-card-body p{font-size:15px;color:var(--muted);margin-bottom:12px}
.hp-landing .blog-read{font-weight:700;color:var(--accent);font-size:15px}
.hp-landing .faq-item{border-bottom:1px solid var(--border)}
.hp-landing .faq-q{display:flex;justify-content:space-between;align-items:center;padding:24px 0;cursor:pointer;gap:16px}
.hp-landing .faq-q h3{font-size:17px;margin:0;transition:color 0.2s}
.hp-landing .faq-q:hover h3{color:var(--accent)}
.hp-landing .faq-q .faq-icon{width:24px;height:24px;flex-shrink:0;transition:transform 0.3s;fill:var(--muted)}
.hp-landing .faq-q.active .faq-icon{transform:rotate(45deg)}
.hp-landing .faq-a{max-height:0;overflow:hidden;transition:max-height 0.35s ease}
.hp-landing .faq-a.open{max-height:300px}
.hp-landing .faq-a p{margin:0;padding-bottom:24px;font-size:15px;line-height:1.8}
/* ===== MOBILE RESPONSIVE ===== */
@media(max-width:900px){
/* Hero */
.hp-landing .hero{min-height:60vh}
.hp-landing .hero .container{padding:60px 1.5rem}
.hp-landing .hero h1{font-size:32px}
.hp-landing .hero p{font-size:18px;margin-bottom:28px}
/* Trust bar */
.hp-landing .trust-bar{gap:16px 24px;padding:16px 1rem;font-size:13px}
/* Section spacing */
.hp-landing .section{padding:48px 0}
.hp-landing .container{padding:0 1.25rem}
.hp-landing .container-narrow{padding:0 1.25rem}
/* Section headers */
.hp-landing .section-header h2{font-size:28px}
.hp-landing .section-header p{font-size:16px}
/* All grids to single column */
.hp-landing .product-grid,
.hp-landing .blog-grid{grid-template-columns:1fr}
/* Product cards */
.hp-landing .product-card-img{height:250px;padding:16px}
/* 2-column content grids to stack */
.hp-landing .section > .container > div[style*="grid-template-columns: 1fr 1fr"],
.hp-landing .section > .container > div[style*="grid-template-columns:1fr 1fr"]{
    display:block !important;
}
.hp-landing .section > .container > div[style*="grid-template-columns:1fr 1fr"] > div{
    margin-bottom:24px;
}
/* 3-column grids */
.hp-landing .section > .container > div[style*="repeat(3,1fr)"],
.hp-landing .section > .container > div[style*="1fr 1fr 1fr"]{
    grid-template-columns:1fr !important;
}
/* 4-column grids (buying experience steps) */
.hp-landing .section > .container > div[style*="repeat(4,1fr)"]{
    grid-template-columns:1fr 1fr !important;
}
/* 2x2 icon grids inside sections */
.hp-landing div[style*="grid-template-columns: 1fr 1fr;"][style*="gap: 16px"],
.hp-landing div[style*="grid-template-columns:1fr 1fr;"][style*="gap:16px"]{
    grid-template-columns:1fr !important;
}
/* Brand badges - handled by auto-fit in base styles */
/* Showroom banner */
.hp-landing section[style*="height:400px"]{height:auto !important;min-height:320px}
.hp-landing section[style*="height:400px"] .container{padding:40px 1.25rem}
.hp-landing section[style*="height:400px"] h2{font-size:26px}
/* Guide CTA section */
.hp-landing section[style*="linear-gradient(135deg"] > .container > div[style*="grid-template-columns"]{
    display:block !important;
}
.hp-landing section[style*="linear-gradient(135deg"] h2{font-size:28px !important}
.hp-landing section[style*="linear-gradient(135deg"] > .container > div > div:last-child{margin-top:24px}
/* Blog cards */
.hp-landing .blog-icon{height:120px}
/* Premium support bar */
.hp-landing section[style*="background:var(--dark);padding:48px"] .container > div{gap:24px 20px}
/* Final CTA */
.hp-landing div[style*="border-radius:26px"][style*="padding:64px"]{padding:36px 24px !important;border-radius:20px !important}
.hp-landing div[style*="border-radius:26px"] h2{font-size:26px !important}
.hp-landing div[style*="border-radius:26px"] p{font-size:16px !important}
.hp-landing div[style*="border-radius:26px"] div[style*="display:flex"]{flex-direction:column}
.hp-landing div[style*="border-radius:26px"] div[style*="display:flex"] .btn{width:100%;text-align:center}
/* Buttons */
.hp-landing .btn{padding:14px 28px;font-size:15px}
/* Lifestyle images */
.hp-landing div[style*="height:220px"]{height:180px !important}
/* Local SEO card */
.hp-landing div[style*="padding:32px"][style*="border-radius:20px"][style*="border:1px solid"]{padding:24px;margin-top:16px}
}
@media(max-width:480px){
.hp-landing .hero h1{font-size:26px}
.hp-landing .hero p{font-size:16px}
.hp-landing .section-header h2{font-size:24px}
.hp-landing .trust-bar{gap:10px 20px;align-items:center}
.hp-landing .section > .container > div[style*="repeat(4,1fr)"]{
    grid-template-columns:1fr !important;
}
/* Brand badges - handled by auto-fit in base styles */
}
</style>
{% endraw %}

