{% raw %}
<script>
var hpFeaturedHandles = [
  'bodyfriend-falcon-sv-massage-chair',
  'osaki-grand-duo-4d-4d-massage-chair',
  'ogawa-master-drive-duo-massage-chair',
  'cozzia-zen-duo-massage-chair',
  'infinity-gen-max-4d-massage-chair',
  'kyota-nokori-m980-syner-d-massage-chair'
];

function hpFormatPrice(cents){return '$'+(cents/100).toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:0});}

function hpLoadFeatured(){
  var grid=document.getElementById('hpFeaturedGrid');if(!grid)return;
  var promises=hpFeaturedHandles.map(function(h){
    return fetch('/products/'+h+'.js').then(function(r){return r.json();}).catch(function(){return null;});
  });
  Promise.all(promises).then(function(products){
    products.forEach(function(p){
      if(!p)return;
      var card=document.createElement('div');card.className='product-card';
      var price=p.price;var cp=p.compare_at_price||0;
      var img=p.featured_image||'';
      var priceHtml='<span class="price-sale">'+hpFormatPrice(price)+'</span>';
      if(cp&&cp>price){priceHtml+='<span class="price-compare">'+hpFormatPrice(cp)+'</span>';}
      card.innerHTML='<a href="'+p.url+'"><img class="product-card-img" src="'+img+'" alt="'+p.title+'" loading="lazy"></a>'
        +'<div class="product-card-body"><h3><a href="'+p.url+'" style="color:inherit;">'+p.title+'</a></h3>'
        +'<div class="product-prices">'+priceHtml+'</div>'
        +'<a href="'+p.url+'" class="product-card-link">View Details</a></div>';
      grid.appendChild(card);
    });
  });
}
hpLoadFeatured();

function toggleHpFaq(el){var a=el.nextElementSibling;var o=a.classList.contains('open');document.querySelectorAll('.hp-landing .faq-a').forEach(function(x){x.classList.remove('open');});document.querySelectorAll('.hp-landing .faq-q').forEach(function(x){x.classList.remove('active');});if(!o){a.classList.add('open');el.classList.add('active');}}

/* Force brand grid bigger on mobile + fix trust bar */
(function(){
  function fixMobile(){
    if(window.innerWidth>768)return;
    var grid=document.querySelector('.hp-landing .brands-grid');
    if(grid){
      grid.style.cssText='display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:100%;margin:0 auto;padding:0 12px;';
      var badges=grid.querySelectorAll('.brand-badge');
      badges.forEach(function(b){b.style.cssText='width:100%;max-width:100%;display:flex;align-items:center;justify-content:center;padding:0;';});
      var imgs=grid.querySelectorAll('.brand-badge img');
      imgs.forEach(function(i){i.style.cssText='width:100%;height:auto;max-width:100%;';});
    }
    var trust=document.querySelector('.hp-landing .trust-bar');
    if(trust){
      trust.style.cssText='display:flex;flex-direction:row;flex-wrap:wrap;justify-content:center;gap:8px 20px;padding:16px 1rem;font-size:13px;';
    }
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',fixMobile);}else{fixMobile();}
  window.addEventListener('resize',fixMobile);
})();
</script>
