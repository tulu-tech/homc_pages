        .model-price-main { font-size: 1.7rem; font-weight: 900; color: #fff; letter-spacing: -0.04em; }
        .model-price-compare { font-size: 0.82rem; color: rgba(255,255,255,0.35); text-decoration: line-through; margin-top: 2px; }
        .model-sidebar-cta { display: block; margin-top: 0.875rem; text-align: center; background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; padding: 0.72rem; border-radius: var(--radius-sm); font-size: 0.82rem; font-weight: 700; transition: all 0.25s; letter-spacing: 0.03em; }
        .model-sidebar-cta:hover { transform: translateY(-2px); box-shadow: var(--shadow-gold); filter: brightness(1.08); }
        .model-entry-content { padding: 2.5rem; }
        .model-best-for-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); background: var(--accent-pale); padding: 5px 14px; border-radius: 50px; margin-bottom: 1.25rem; border: 1px solid rgba(196,149,74,0.2); }
        .model-entry-content h4 { font-size: 1.1rem; margin-bottom: 0.75rem; }
        .model-entry-content p { font-size: 0.9rem; color: var(--muted); line-height: 1.8; margin-bottom: 1rem; }
        .model-traits { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; }
        .trait-pill { font-size: 0.72rem; font-weight: 700; padding: 5px 12px; border-radius: 20px; background: var(--surface); border: 1px solid var(--border); color: var(--muted); transition: all 0.2s; }
        .trait-pill:hover { background: var(--accent-pale); border-color: var(--accent); color: var(--accent); }
        .model-tradeoff { margin-top: 1.5rem; padding: 1.1rem 1.4rem; border-radius: var(--radius-sm); background: var(--surface2); border-left: 3px solid var(--border-strong); font-size: 0.85rem; color: var(--muted-light); line-height: 1.7; }
        .model-tradeoff strong { color: var(--muted); }

        /* ===== BUYER TYPE ===== */
        .buyer-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
        .buyer-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; transition: all 0.3s; position: relative; overflow: hidden; }
        .buyer-card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--accent), var(--accent2)); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
        .buyer-card:hover::after { transform: scaleX(1); }
        .buyer-card:hover { border-color: rgba(196,149,74,0.3); box-shadow: var(--shadow-md); transform: translateY(-4px); }
        .buyer-icon { width: 46px; height: 46px; background: var(--accent-pale); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
        .buyer-icon svg { width: 22px; height: 22px; fill: var(--accent); }
        .buyer-card h3 { font-size: 0.95rem; margin-bottom: 0.4rem; }
        .buyer-card .buyer-type { font-size: 0.68rem; font-weight: 800; color: var(--muted-light); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.5rem; }
        .buyer-card p { font-size: 0.855rem; color: var(--muted); margin: 0 0 0.75rem; line-height: 1.7; }
        .buyer-rec { font-size: 0.78rem; font-weight: 800; color: var(--accent); display: flex; align-items: center; gap: 6px; }
        .buyer-rec::before { content: '→'; }

        /* ===== COMPARE TABLE ===== */
        .compare-wrap { overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-sm); }
        .compare-table { width: 100%; border-collapse: collapse; font-size: 0.855rem; min-width: 700px; }
        .compare-table th { background: var(--dark); color: #fff; padding: 1rem 1.25rem; text-align: left; font-size: 0.76rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.07em; }
        .compare-table th:first-child { background: #111; }
        .compare-table td { padding: 0.875rem 1.25rem; border-bottom: 1px solid var(--border); color: var(--muted); vertical-align: middle; }
        .compare-table tr:last-child td { border-bottom: none; }
        .compare-table tr:hover td { background: var(--surface); }
        .compare-table .col-feat { font-weight: 700; color: var(--dark); white-space: nowrap; }
        .check { color: var(--accent); font-weight: 800; }
        .cross { color: #d4d4d8; }

        /* ===== EXPERT CALLOUT ===== */
        .expert-callout { background: var(--white); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 0 var(--radius-md) var(--radius-md) 0; padding: 1.75rem 2rem; display: flex; align-items: flex-start; gap: 1rem; box-shadow: var(--shadow-sm); }
        .expert-callout svg { width: 26px; height: 26px; fill: var(--accent); flex-shrink: 0; margin-top: 3px; }
        .expert-callout p { font-size: 0.92rem; color: var(--muted); line-height: 1.8; margin: 0; }
        .expert-callout strong { color: var(--dark); }

        /* ===== BRAND COMPARE ===== */
        .brand-compare-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem; }
        .brand-compare-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; transition: all 0.3s; }
        .brand-compare-card:hover { border-color: rgba(196,149,74,0.3); box-shadow: var(--shadow-md); transform: translateY(-3px); }
        .brand-compare-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
        .brand-compare-header h3 { font-size: 1rem; }
        .vs-pill { font-size: 0.66rem; font-weight: 800; padding: 4px 12px; background: var(--accent-pale); color: var(--accent); border-radius: 20px; text-transform: uppercase; letter-spacing: 0.12em; border: 1px solid rgba(196,149,74,0.2); }
        .brand-compare-card p { font-size: 0.875rem; color: var(--muted); line-height: 1.8; margin: 0; }

        /* ===== PRICE LADDER ===== */
        .price-ladder { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-sm); }
        .price-rung { display: grid; grid-template-columns: 170px 1fr; gap: 0; border-bottom: 1px solid var(--border); transition: all 0.3s; }
        .price-rung:last-child { border-bottom: none; }
        .price-rung:hover { background: var(--surface); }
        .price-range-label { padding: 1.75rem 1.5rem; border-right: 1px solid var(--border); background: var(--dark); display: flex; flex-direction: column; justify-content: center; }
        .price-amount { font-size: 1.1rem; font-weight: 900; color: var(--accent2); }
        .price-tier-name { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.45); font-weight: 700; margin-bottom: 4px; }
        .price-rung-body { padding: 1.75rem 2rem; }
        .price-rung-body h4 { font-size: 0.95rem; margin-bottom: 0.4rem; }
        .price-rung-body p { font-size: 0.855rem; color: var(--muted); margin: 0; line-height: 1.7; }
        .price-models { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 0.75rem; }
        .price-model-tag { font-size: 0.7rem; font-weight: 700; padding: 4px 12px; border-radius: 20px; background: var(--accent-pale); color: var(--accent); border: 1px solid rgba(196,149,74,0.2); }

        /* ===== TRUST CARDS ===== */
        .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
        .trust-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; transition: all 0.3s; }
        .trust-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: rgba(196,149,74,0.25); }
        .trust-card-icon { width: 50px; height: 50px; background: var(--accent-pale); border-radius: 15px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; transition: all 0.3s; }
        .trust-card:hover .trust-card-icon { background: linear-gradient(135deg, var(--accent), var(--accent2)); }
        .trust-card-icon svg { width: 24px; height: 24px; fill: var(--accent); transition: fill 0.3s; }
        .trust-card:hover .trust-card-icon svg { fill: #fff; }
        .trust-card h3 { font-size: 1rem; margin-bottom: 0.6rem; }
        .trust-card p { font-size: 0.87rem; color: var(--muted); margin: 0; line-height: 1.75; }

        /* ===== SHOWROOM ===== */
        .showroom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
        .showroom-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; transition: all 0.35s; box-shadow: var(--shadow-sm); }
