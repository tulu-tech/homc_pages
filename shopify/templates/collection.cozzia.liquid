        .step-card h4 { color: #fff; margin-bottom: 0.5rem; font-size: 1rem; }
        .step-card p { color: rgba(255,255,255,0.58); font-size: 0.875rem; line-height: 1.75; margin: 0; }

        /* ===== BRAND PILLS ===== */
        .brand-pills { display: flex; justify-content: center; gap: 0.875rem; flex-wrap: wrap; }
        .brand-pill { padding: 0.65rem 1.5rem; border: 1.5px solid var(--border); border-radius: 50px; font-size: 0.855rem; font-weight: 700; transition: all 0.3s; background: var(--white); color: var(--dark); }
        .brand-pill:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-pale); transform: translateY(-2px); box-shadow: 0 6px 18px rgba(196,149,74,0.15); }

        /* ===== DIVIDER ===== */
        .grad-divider { height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); margin: 0; }

        /* ===== FOOTER ===== */
        .site-footer { background: var(--dark); color: #fff; padding: 4rem 0 2rem; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }
        .site-footer h4 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.18em; margin-bottom: 1rem; color: var(--accent2); font-weight: 800; }
        .site-footer p, .site-footer a { color: rgba(255,255,255,0.5); font-size: 0.84rem; }
        .site-footer a { display: block; margin-bottom: 0.5rem; transition: color 0.2s; }
        .site-footer a:hover { color: #fff; }
        .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1.5rem; text-align: center; color: rgba(255,255,255,0.3); font-size: 0.8rem; }
        .footer-brand { font-size: 0.95rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.75rem; display: block; color: #fff; }

        /* ===== RESPONSIVE ===== */
        @media(max-width:1100px) {
            .product-grid-main { grid-template-columns: repeat(2, 1fr); }
            .pillar-grid { grid-template-columns: repeat(2, 1fr); }
