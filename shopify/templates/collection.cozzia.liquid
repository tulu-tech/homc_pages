<section class="collection-section" id="collection">
    <div class="container">
        <div class="collection-header">
            <div class="collection-intro-label"><span></span>Live Collection<span></span></div>
            <h2 class="accent-heading">All Cozzia Massage Chairs</h2>
            <p>{{ collection.products_count }} premium massage chairs with live pricing. Every model available to try in person at our San Jose &amp; Pleasanton showrooms.</p>
        </div>

        <div class="product-grid-main">

            {% comment %}
            ── PRODUCT CARD LOOP ──────────────────────────────────────────
            Badge assignment: based on product handle.
            Tier label:       based on product.type (set in Shopify Admin).
            Feature bullets:  defined per handle below (pipe-delimited).
            Savings:          calculated from compare_at_price - price.
            ──────────────────────────────────────────────────────────────
            {% endcomment %}

            {% for product in collection.products %}

                {%- comment %} ── Badge & tier ── {% endcomment -%}
                {%- assign prod_badge       = 'Premium' -%}
                {%- assign prod_badge_class = 'standard' -%}

                {%- if product.handle contains 'qi-xe-pro' -%}
                    {%- assign prod_badge       = 'Flagship' -%}
                    {%- assign prod_badge_class = 'flagship' -%}
                {%- elsif product.handle contains 'zen-duo' -%}
                    {%- assign prod_badge       = 'Dual 3D' -%}
                    {%- assign prod_badge_class = 'dual' -%}
                {%- elsif product.handle contains 'zen-2' or product.handle contains '645' -%}
                    {%- assign prod_badge       = 'Best Value' -%}
                    {%- assign prod_badge_class = 'value' -%}
                {%- elsif product.handle contains 'fusion-pro' -%}
                    {%- assign prod_badge       = 'Entry Premium' -%}
                    {%- assign prod_badge_class = 'standard' -%}
                {%- elsif product.handle contains 'qi-se' -%}
                    {%- assign prod_badge       = '4D' -%}
                    {%- assign prod_badge_class = 'standard' -%}
                {%- endif -%}

                {%- comment %} ── Feature bullets (pipe-delimited per handle) ── {% endcomment -%}
                {%- capture feat_raw -%}
                    {%- if product.handle contains 'qi-xe-pro' -%}
                        Dual 4D VarioMotion™ independent mechanisms|Chair Doctor™ biometric session recommendation|64 airbags · 5 adjustable intensity levels|Li Flex Track — neck to buttocks|Heat: legs + lumbar + both mechanisms|8-mode chromotherapy · Bluetooth audio
                    {%- elsif product.handle contains 'qi-se' -%}
                        4D VarioMotion™ mechanism|Long track — neck to buttock|60 airbags · 23 auto programs|Dual-zone heat: knees + calves + lumbar|Tri-action foot rollers|Amazon Alexa · ~5" wall clearance
                    {%- elsif product.handle contains 'zen-duo' -%}
                        Dual 3D Human-Like Massage Technology|Li Flex Track — neck to buttocks|18 auto programs + 9 stretch routines|40 airbags · offline voice control|Heat: lumbar + legs|3.5" wall clearance — best in lineup
                    {%- elsif product.handle contains 'zen-2' or product.handle contains '645' -%}
                        4D VarioMotion™ mechanism|60 airbags · 23 auto programs|Heated knee therapy + moving compression|Long track — neck to buttock|Amazon Alexa voice control|7-mode chromotherapy lighting
                    {%- elsif product.handle contains 'fusion-pro' -%}
                        Advanced 2D Li Flex Track system|34 airbags · 5 intensity levels|Heat therapy: legs + lumbar|Foot + sole rollers|Offline voice control|Bluetooth audio · 12 auto programs
                    {%- else -%}
                        {{ product.description | strip_html | truncate: 120 }}
                    {%- endif -%}
                {%- endcapture -%}
                {%- assign features = feat_raw | strip | split: '|' -%}

                {%- comment %} ── Savings ── {% endcomment -%}
                {%- assign has_discount = false -%}
                {%- if product.compare_at_price > product.price -%}
                    {%- assign has_discount     = true -%}
                    {%- assign savings_cents    = product.compare_at_price | minus: product.price -%}
                {%- endif -%}

                {%- comment %} ── Flagship gets gold top bar ── {% endcomment -%}
                <div class="pcard{% if product.handle contains 'qi-xe-pro' %} flagship-card{% endif %}">

                    {% if product.handle contains 'qi-xe-pro' %}
                        <div class="flagship-card-top"></div>
                    {% else %}
                        <div class="pcard-accent-line"></div>
                    {% endif %}

                    <div class="pcard-img-zone">
                        <span class="pcard-badge {{ prod_badge_class }}">{{ prod_badge }}</span>
                        {% if has_discount %}
                            <span class="pcard-savings">Save {{ savings_cents | money }}</span>
                        {% endif %}
                        <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                            <img src="{{ product.featured_image | image_url: width: 800 }}"
                                 alt="{{ product.featured_image.alt | default: product.title | escape }}"
                                 loading="lazy"
                                 width="800"
                                 height="600">
                        </a>
                    </div>

                    <div class="pcard-body">
                        <div class="pcard-tier">{{ product.type }}</div>
                        <div class="pcard-name">
                            <a href="{{ product.url }}">{{ product.title }}</a>
                        </div>
                        <ul class="pcard-feats">
                            {% for feat in features %}
                                {%- assign feat_clean = feat | strip -%}
                                {% unless feat_clean == blank %}
                                    <li>{{ feat_clean }}</li>
                                {% endunless %}
                            {% endfor %}
                        </ul>
                        <div class="pcard-pricing">
                            <span class="pcard-price">{{ product.price | money }}</span>
                            {% if has_discount %}
                                <span class="pcard-compare">{{ product.compare_at_price | money }}</span>
                            {% endif %}
                        </div>
                        <a href="{{ product.url }}" class="pcard-cta">View Full Details</a>
                    </div>

                </div>

            {% else %}
                <p style="grid-column:1/-1;text-align:center;color:var(--muted);padding:3rem;">
                    No products found in this collection.
                </p>
            {% endfor %}

        </div><!-- /.product-grid-main -->

