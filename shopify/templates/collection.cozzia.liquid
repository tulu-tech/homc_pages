        .showroom-card-header { background: linear-gradient(135deg, #09090f, #1c1408); padding: 2.25rem 2.5rem 2rem; }
        .showroom-location-pill { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent2); background: rgba(196,149,74,0.15); padding: 5px 14px; border-radius: 50px; margin-bottom: 0.875rem; display: inline-block; border: 1px solid rgba(196,149,74,0.2); }
        .showroom-card-header h3 { color: #fff; font-size: 1.15rem; margin-bottom: 0.4rem; }
