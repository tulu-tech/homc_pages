            .qa-grid, .glance-grid, .for-grid, .brand-compare-grid, .showroom-grid, .review-grid, .buyer-grid { grid-template-columns: 1fr; }
            .pillar-grid, .trust-grid, .step-cards { grid-template-columns: 1fr; }
            .model-entry-body { grid-template-columns: 1fr; }
            .model-sidebar-imgbox { max-height: 220px; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
            .nav-links { display: none; }
            .hero-stats { gap: 1.5rem; }
            .hero-stat { padding-right: 1.5rem; margin-right: 1.5rem; }
            .price-rung { grid-template-columns: 120px 1fr; }
        }
        @media(max-width:600px) {
            .trust-bar { overflow-x: auto; justify-content: flex-start; }
            .model-sidebar-imgbox { max-height: 180px; min-height: 160px; }
            .quick-answer { padding: 2rem; }
        }
    </style>
</head>
