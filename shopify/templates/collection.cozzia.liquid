        .glance-table { width: 100%; border-collapse: collapse; }
        .glance-table tr { border-bottom: 1px solid var(--border); transition: background 0.2s; }
        .glance-table tr:hover { background: var(--surface); }
        .glance-table tr:last-child { border-bottom: none; }
        .glance-table td { padding: 0.9rem 0.75rem; font-size: 0.88rem; vertical-align: top; }
        .glance-table td:first-child { font-weight: 800; color: var(--dark); width: 40%; }
        .glance-table td:last-child { color: var(--muted); }
        .glance-verdict { background: linear-gradient(145deg, #09090f 0%, #1c1408 100%); border-radius: var(--radius-xl); padding: 2.75rem; color: #fff; border: 1px solid rgba(196,149,74,0.15); position: relative; overflow: hidden; }
        .glance-verdict h3 { color: #fff; font-size: 1.15rem; margin-bottom: 1.5rem; }
        .verdict-item { display: flex; align-items: flex-start; gap: 12px; padding: 0.8rem 0; border-bottom: 1px solid rgba(255,255,255,0.07); }
        .verdict-item:last-child { border-bottom: none; padding-bottom: 0; }
        .verdict-dot { width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent2)); flex-shrink: 0; margin-top: 9px; }
        .verdict-item p { font-size: 0.865rem; color: rgba(255,255,255,0.68); margin: 0; line-height: 1.7; }

