{% comment %}
==========================================================================
  FILE:    templates/collection.cozzia.liquid
  PURPOSE: Custom editorial landing page for the Cozzia collection.
           Assign this template to the "cozzia" collection in Shopify Admin:
           Online Store → Navigation → Collections → Cozzia → Template → collection.cozzia
  NOTES:
  - Uses {% layout none %} for full-page control (own nav/footer/head).
  - {{ content_for_header }} is REQUIRED for Shopify analytics, pixels etc.
  - Product grid rendered natively via {% for product in collection.products %}.
  - Feature bullets assigned per product handle (no metafields required).
  - Badge/tier assigned per product handle.
  - Prices: product.price | money (live from Shopify, always accurate).
  - Images: product.featured_image | image_url (Shopify CDN with size).
==========================================================================
{% endcomment %}
{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cozzia Massage Chairs — Expert Guide, Model Comparison &amp; Reviews | {{ shop.name }}</title>
    <meta name="description" content="The definitive Cozzia massage chair guide. Compare models, prices, features, and buyer fit from the Qi XE Pro Duo to the Fusion Pro. Try every Cozzia chair in person at our San Jose or Pleasanton showroom. Authorized dealer.">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ shop.url }}/collections/cozzia">

    <meta property="og:title" content="Cozzia Massage Chairs — Expert Brand Guide | {{ shop.name }}">
    <meta property="og:description" content="Compare every Cozzia massage chair model. Qi SE, Qi XE Pro Duo, Zen Duo, Zen 2, Fusion Pro. Find your best fit at our Bay Area showrooms.">
    <meta property="og:url" content="{{ shop.url }}/collections/cozzia">
    <meta property="og:type" content="website">
    {% if collection.image %}
    <meta property="og:image" content="{{ collection.image | image_url: width: 1200 }}">
    {% endif %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">

    <!-- Schema: LocalBusiness + BreadcrumbList + Brand -->
    <script type="application/ld+json">
    [
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "{{ shop.name | escape }}",
        "description": "Authorized Cozzia massage chair dealer with showrooms in San Jose and Pleasanton, CA.",
        "url": "{{ shop.url }}",
        "telephone": "+16692148889",
        "address": [
          {
            "@type": "PostalAddress",
            "streetAddress": "925 Blossom Hill Road, Westfield Oakridge Mall",
            "addressLocality": "San Jose",
            "addressRegion": "CA",
            "postalCode": "95123",
            "addressCountry": "US"
          },
          {
            "@type": "PostalAddress",
            "streetAddress": "1116 Stoneridge Mall Rd",
            "addressLocality": "Pleasanton",
            "addressRegion": "CA",
            "postalCode": "94566",
            "addressCountry": "US"
          }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Cozzia Massage Chairs",
          "url": "{{ shop.url }}/collections/cozzia"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}"},
          {"@type":"ListItem","position":2,"name":"Massage Chairs","item":"{{ shop.url }}/collections/massage-chairs"},
          {"@type":"ListItem","position":3,"name":"Cozzia Massage Chairs","item":"{{ shop.url }}/collections/cozzia"}
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "Brand",
        "name": "Cozzia",
        "description": "Cozzia is a premium massage chair brand known for VarioMotion™ technology, Li Flex Track spine coverage, 4D and dual-mechanism designs, and zero gravity recline.",
        "url": "{{ shop.url }}/collections/cozzia"
      }
    ]
    </script>

    <!-- Schema: ItemList (live from Shopify collection) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Cozzia Massage Chairs Collection",
      "url": "{{ shop.url }}/collections/cozzia",
      "numberOfItems": {{ collection.products_count }},
      "itemListElement": [
        {% for product in collection.products %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ product.title | json }},
          "url": "{{ shop.url }}{{ product.url }}",
          "offers": {
            "@type": "Offer",
            "priceCurrency": "USD",
            "price": "{{ product.price | money_without_currency }}",
            "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
          }
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
    </script>

    <style>
        /* ===== DESIGN TOKENS ===== */
        :root {
            --bg: #ffffff;
            --surface: #f7f8fc;
            --surface2: #f0f2f8;
            --dark: #09090b;
            --dark2: #18181b;
            --muted: #52525b;
            --muted-light: #71717a;
            --accent: #c4954a;
            --accent2: #e8b96a;
            --accent-dark: #8a6232;
            --accent-pale: rgba(196,149,74,0.10);
            --accent-pale2: rgba(196,149,74,0.06);
            --border: #e4e4e7;
            --border-strong: #d4d4d8;
            --white: #ffffff;
            --radius-sm: 10px;
            --radius-md: 18px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
            --shadow-md: 0 8px 30px rgba(0,0,0,0.08);
            --shadow-lg: 0 20px 60px rgba(0,0,0,0.12);
            --shadow-gold: 0 8px 32px rgba(196,149,74,0.22);
        }

        /* ===== RESET ===== */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background: var(--bg);
            color: var(--dark);
            line-height: 1.7;
            font-size: 16px;
            font-weight: 450;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }
        h1,h2,h3,h4,h5 { font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; color: var(--dark); }
        h1 { font-size: clamp(2rem, 5vw, 3.8rem); }
        h2 { font-size: clamp(1.6rem, 3vw, 2.6rem); }
        h3 { font-size: clamp(1.1rem, 2vw, 1.45rem); }
        a { color: inherit; text-decoration: none; }
        img { max-width: 100%; display: block; }

        /* ===== LAYOUT ===== */
        .container { max-width: 1220px; margin: 0 auto; padding: 0 2rem; }
        .container-narrow { max-width: 880px; margin: 0 auto; padding: 0 2rem; }
        .container-wide { max-width: 1440px; margin: 0 auto; padding: 0 2rem; }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes shimmer { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
        @keyframes pulseDot { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.4); opacity: 0.7; } }

        .fade-up { animation: fadeUp 0.6s ease both; }
        .fade-up-1 { animation-delay: 0.1s; }
        .fade-up-2 { animation-delay: 0.2s; }
        .fade-up-3 { animation-delay: 0.3s; }
        .fade-up-4 { animation-delay: 0.4s; }

        /* ===== NAV ===== */
        .site-nav {
            padding: 0.9rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 200;
            box-shadow: 0 1px 20px rgba(0,0,0,0.06);
        }
        .nav-logo img { height: 38px; width: auto; }
        .nav-links { display: flex; gap: 1.75rem; align-items: center; }
        .nav-links a { font-size: 0.84rem; font-weight: 600; color: var(--muted); transition: color 0.2s; letter-spacing: 0.01em; }
        .nav-links a:hover { color: var(--dark); }
        .nav-cta {
            background: var(--dark);
            color: #fff !important;
            padding: 0.55rem 1.4rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.82rem;
            transition: all 0.25s;
            letter-spacing: 0.02em;
        }
        .nav-cta:hover { background: var(--accent) !important; transform: translateY(-1px); box-shadow: var(--shadow-gold); }

        /* ===== STICKY SUBNAV ===== */
        .page-subnav {
            position: sticky;
            top: 61px;
            z-index: 150;
            background: rgba(255,255,255,0.97);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            overflow-x: auto;
            scrollbar-width: none;
        }
        .page-subnav::-webkit-scrollbar { display: none; }
        .page-subnav-inner { display: flex; padding: 0 2rem; min-width: max-content; }
        .page-subnav-inner a {
            display: block;
            padding: 0.8rem 1.1rem;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--muted);
            border-bottom: 2.5px solid transparent;
            white-space: nowrap;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }
        .page-subnav-inner a:hover { color: var(--dark); border-bottom-color: var(--accent); }

        /* ===== BUTTONS ===== */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0.9rem 2.2rem;
            font-size: 0.95rem;
            font-weight: 700;
            border-radius: 50px;
            transition: all 0.25s;
            border: 2px solid transparent;
            cursor: pointer;
            letter-spacing: 0.02em;
            text-decoration: none;
        }
        .btn-dark { background: var(--dark); color: #fff; border-color: var(--dark); }
        .btn-dark:hover { background: #1a1a2e; border-color: #1a1a2e; transform: translateY(-2px); box-shadow: 0 10px 28px rgba(0,0,0,0.2); }
        .btn-gold { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff !important; border-color: transparent; }
        .btn-gold:hover { transform: translateY(-2px); box-shadow: var(--shadow-gold); filter: brightness(1.08); }
        .btn-ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,0.35); }
        .btn-ghost:hover { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.6); transform: translateY(-1px); }
        .btn-outline { background: transparent; color: var(--dark); border-color: var(--border-strong); }
        .btn-outline:hover { border-color: var(--dark); background: var(--surface); transform: translateY(-1px); }
        .btn-sm { padding: 0.6rem 1.6rem; font-size: 0.85rem; }

        /* ===== HERO ===== */
        .hero {
            position: relative;
            min-height: 92vh;
            display: flex;
            align-items: center;
            overflow: hidden;
            background: var(--dark);
        }
        .hero-bg {
            position: absolute;
            inset: 0;
            background: url('{{ "cozzia-hero-bg.png" | asset_url }}') center/cover no-repeat;
            opacity: 0.38;
            z-index: 0;
        }
        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(110deg, rgba(5,5,15,0.92) 30%, rgba(15,10,5,0.6) 70%, rgba(196,149,74,0.08) 100%);
            z-index: 1;
        }
        .hero-glow {
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(196,149,74,0.15) 0%, transparent 70%);
            right: -100px;
            top: -100px;
            z-index: 1;
            animation: shimmer 4s ease-in-out infinite;
        }
        .hero-content {
            position: relative;
            z-index: 2;
            padding: 5rem 0 6rem;
        }
        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.75rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--accent2);
            font-weight: 800;
            margin-bottom: 1.5rem;
            background: rgba(196,149,74,0.12);
            padding: 6px 14px;
            border-radius: 50px;
            border: 1px solid rgba(196,149,74,0.2);
        }
        .hero-eyebrow::before { content: '●'; font-size: 0.5rem; animation: pulseDot 2s infinite; }
        .hero h1 { color: #fff; max-width: 800px; margin-bottom: 1.5rem; text-shadow: 0 4px 30px rgba(0,0,0,0.4); }
        .hero-tag {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-sub { font-size: 1.15rem; color: rgba(255,255,255,0.78); max-width: 640px; margin-bottom: 0.75rem; font-weight: 500; line-height: 1.65; }
        .hero-note { font-size: 0.9rem; color: rgba(255,255,255,0.5); max-width: 580px; margin-bottom: 2.5rem; line-height: 1.7; }
        .hero-ctas { display: flex; gap: 0.875rem; flex-wrap: wrap; margin-bottom: 3.5rem; }
        .hero-stats { display: flex; gap: 0; padding-top: 2.5rem; border-top: 1px solid rgba(255,255,255,0.10); flex-wrap: wrap; }
        .hero-stat { padding-right: 2.5rem; margin-right: 2.5rem; border-right: 1px solid rgba(255,255,255,0.10); }
        .hero-stat:last-child { border-right: none; margin-right: 0; }
        .hero-stat-num {
            font-size: 2rem; font-weight: 900; color: #fff; display: block; line-height: 1; margin-bottom: 5px;
            background: linear-gradient(135deg, #fff, rgba(255,255,255,0.7));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .hero-stat-label { font-size: 0.73rem; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; }

        /* ===== TRUST BAR ===== */
        .trust-bar { display: flex; justify-content: center; align-items: center; gap: 0; background: linear-gradient(90deg, var(--dark) 0%, var(--dark2) 100%); padding: 0; overflow: hidden; }
        .trust-item { display: flex; align-items: center; gap: 8px; padding: 1rem 1.75rem; font-size: 0.82rem; font-weight: 700; color: rgba(255,255,255,0.75); letter-spacing: 0.03em; border-right: 1px solid rgba(255,255,255,0.07); transition: all 0.2s; white-space: nowrap; }
        .trust-item:last-child { border-right: none; }
        .trust-item:hover { color: #fff; background: rgba(196,149,74,0.1); }
        .trust-item svg { width: 15px; height: 15px; fill: var(--accent2); flex-shrink: 0; }

        /* ===== PRODUCT COLLECTION ===== */
        .collection-section { background: var(--surface); padding: 5rem 0; }
        .collection-header { text-align: center; margin-bottom: 3rem; }
        .collection-intro-label { display: inline-flex; align-items: center; gap: 8px; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); font-weight: 800; margin-bottom: 1rem; }
        .collection-intro-label span { width: 24px; height: 2px; background: linear-gradient(90deg, var(--accent), var(--accent2)); border-radius: 2px; display: inline-block; }
        .collection-header h2 { margin-bottom: 0.75rem; }
        .collection-header p { font-size: 1.05rem; color: var(--muted); max-width: 620px; margin: 0 auto; }
        .collection-footer { text-align: center; margin-top: 2.5rem; }

        /* ===== PRODUCT CARDS ===== */
        .product-grid-main { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
        .pcard {
            background: var(--white);
            border-radius: var(--radius-lg);
            overflow: hidden;
            border: 1px solid var(--border);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-sm);
        }
        .pcard:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: var(--accent); }
        .pcard-accent-line { height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent2)); opacity: 0; transition: opacity 0.3s; }
        .pcard:hover .pcard-accent-line { opacity: 1; }
        .flagship-card-top { height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent2), #f0d090); border-radius: var(--radius-lg) var(--radius-lg) 0 0; flex-shrink: 0; }

        .pcard-img-zone {
            position: relative;
            background: #fafafa;
            padding: 2rem 2rem 1.5rem;
            overflow: hidden;
        }
        .pcard-img-zone::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 50% 100%, rgba(196,149,74,0.06) 0%, transparent 70%);
            pointer-events: none;
        }
        .pcard-img-zone img { width: 100%; height: 260px; object-fit: contain; mix-blend-mode: multiply; transition: transform 0.4s ease; }
        .pcard:hover .pcard-img-zone img { transform: scale(1.04); }

        .pcard-badge {
            position: absolute; top: 14px; left: 14px;
            font-size: 0.66rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
            padding: 5px 12px; border-radius: 50px; z-index: 2;
        }
        .pcard-badge.flagship { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; box-shadow: 0 4px 12px rgba(196,149,74,0.4); }
        .pcard-badge.value { background: #10b981; color: #fff; }
        .pcard-badge.standard { background: var(--dark); color: #fff; }
        .pcard-badge.dual { background: #6366f1; color: #fff; }

        .pcard-savings { position: absolute; top: 14px; right: 14px; font-size: 0.65rem; font-weight: 800; background: rgba(16,185,129,0.12); color: #059669; padding: 4px 10px; border-radius: 50px; z-index: 2; }

        .pcard-body { padding: 1.5rem 1.75rem 1.75rem; flex: 1; display: flex; flex-direction: column; }
        .pcard-tier { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.15em; font-weight: 800; color: var(--accent); margin-bottom: 0.35rem; }
        .pcard-name { font-size: 0.98rem; font-weight: 800; margin-bottom: 0.85rem; line-height: 1.3; }
        .pcard-name a { color: var(--dark); transition: color 0.2s; }
        .pcard-name a:hover { color: var(--accent); }

        .pcard-feats { list-style: none; padding: 0; margin: 0 0 1.25rem; flex: 1; }
        .pcard-feats li { display: flex; align-items: flex-start; gap: 8px; font-size: 0.82rem; color: var(--muted); padding: 4px 0; border-bottom: 1px solid var(--border); line-height: 1.5; }
        .pcard-feats li:last-child { border-bottom: none; }
        .pcard-feats li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent2)); flex-shrink: 0; margin-top: 5px; }

        .pcard-pricing { display: flex; align-items: baseline; gap: 10px; margin-bottom: 1rem; }
        .pcard-price { font-size: 1.5rem; font-weight: 900; color: var(--dark); letter-spacing: -0.03em; }
        .pcard-compare { font-size: 0.875rem; color: #a1a1aa; text-decoration: line-through; font-weight: 500; }

        .pcard-cta { display: block; text-align: center; background: var(--dark); color: #fff; padding: 0.8rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 0.875rem; transition: all 0.25s; border: 2px solid var(--dark); letter-spacing: 0.02em; }
        .pcard-cta:hover { background: transparent; color: var(--dark); }

        /* ===== SECTIONS ===== */
        .section { padding: 6rem 0; }
        .section-alt { background: var(--surface); }
        .section-sm { padding: 4rem 0; }

        .section-label { display: inline-flex; align-items: center; gap: 8px; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); font-weight: 800; margin-bottom: 1rem; }
        .section-label::before { content: ''; width: 20px; height: 2px; background: linear-gradient(90deg, var(--accent), var(--accent2)); border-radius: 2px; display: inline-block; }
        .section-header { margin-bottom: 3.5rem; }
        .section-header.centered { text-align: center; }
        .section-header.centered .section-label { display: inline-flex; justify-content: center; }
        .section-header h2 { margin-bottom: 1rem; }
        .section-header p { font-size: 1.05rem; color: var(--muted); max-width: 700px; line-height: 1.8; }
        .section-header.centered p { margin-left: auto; margin-right: auto; }
        .accent-heading::after { content: ''; display: block; width: 48px; height: 3px; margin-top: 0.75rem; background: linear-gradient(90deg, var(--accent), var(--accent2)); border-radius: 4px; }
        .section-header.centered .accent-heading::after { margin-left: auto; margin-right: auto; }

        /* ===== QUICK ANSWER ===== */
        .quick-answer { background: linear-gradient(135deg, #09090f 0%, #1a1208 100%); border-radius: var(--radius-xl); padding: 3.5rem; border: 1px solid rgba(196,149,74,0.18); position: relative; overflow: hidden; }
        .quick-answer::before { content: ''; position: absolute; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(196,149,74,0.1) 0%, transparent 70%); right: -100px; bottom: -100px; pointer-events: none; }
        .quick-answer h2 { color: #fff; margin-bottom: 0.5rem; font-size: clamp(1.4rem, 2.5vw, 2.1rem); }
        .qa-intro { color: rgba(255,255,255,0.58); font-size: 1rem; max-width: 600px; margin-bottom: 2.5rem; line-height: 1.75; }
        .qa-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
        .qa-item { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-md); padding: 1.75rem; transition: all 0.3s; }
        .qa-item:hover { background: rgba(196,149,74,0.08); border-color: rgba(196,149,74,0.2); transform: translateY(-2px); }
        .qa-item h3 { color: var(--accent2); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 0.75rem; font-weight: 800; }
        .qa-item p { font-size: 0.92rem; color: rgba(255,255,255,0.7); line-height: 1.8; margin: 0; }

        /* ===== VALUE PILLARS ===== */
        .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
        .pillar-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2.25rem; transition: all 0.35s; position: relative; overflow: hidden; }
        .pillar-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent2)); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
        .pillar-card:hover::before { transform: scaleX(1); }
        .pillar-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: transparent; }
        .pillar-icon { width: 54px; height: 54px; background: var(--accent-pale); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; transition: all 0.3s; }
        .pillar-card:hover .pillar-icon { background: linear-gradient(135deg, var(--accent), var(--accent2)); }
        .pillar-icon svg { width: 26px; height: 26px; fill: var(--accent); transition: fill 0.3s; }
        .pillar-card:hover .pillar-icon svg { fill: #fff; }
        .pillar-card h3 { font-size: 1rem; margin-bottom: 0.6rem; }
        .pillar-card p { font-size: 0.875rem; color: var(--muted); margin: 0; line-height: 1.75; }

        /* ===== AT A GLANCE ===== */
