        .for-card.is-for { background: var(--white); }
        .for-card.not-for { background: var(--surface2); }
        .for-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
        .for-card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 1.5rem; }
        .for-badge { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; padding: 5px 14px; border-radius: 50px; }
        .for-badge.yes { background: rgba(16,185,129,0.1); color: #059669; border: 1px solid rgba(16,185,129,0.2); }
        .for-badge.no { background: rgba(239,68,68,0.08); color: #dc2626; border: 1px solid rgba(239,68,68,0.15); }
        .for-card h3 { font-size: 1rem; color: var(--dark); margin: 0; }
        .for-list { list-style: none; padding: 0; }
        .for-list li { display: flex; align-items: flex-start; gap: 10px; padding: 0.65rem 0; border-bottom: 1px solid var(--border); font-size: 0.875rem; color: var(--muted); line-height: 1.6; }
        .for-list li:last-child { border-bottom: none; }
        .for-list-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 7px; }
