        .model-entry-body { display: grid; grid-template-columns: 360px 1fr; gap: 0; }
        .model-entry-sidebar { background: linear-gradient(160deg, #09090f 0%, #1c1408 100%); padding: 2.25rem; display: flex; flex-direction: column; }
        .model-tier-label { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.16em; color: var(--accent); margin-bottom: 0.5rem; }
        .model-entry-sidebar h3 { color: #fff; font-size: 1.15rem; line-height: 1.3; margin-bottom: 0.5rem; }
        .model-entry-sidebar .model-sidebar-desc { color: rgba(255,255,255,0.5); font-size: 0.82rem; line-height: 1.65; margin-bottom: 1.25rem; }
        .model-sidebar-imgbox { background: #fff; border-radius: 16px; padding: 1.5rem 1.25rem; margin-bottom: 1.5rem; overflow: hidden; flex: 1; display: flex; align-items: center; justify-content: center; min-height: 220px; max-height: 280px; }
        .model-sidebar-imgbox img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transition: transform 0.4s ease; }
        .model-entry:hover .model-sidebar-imgbox img { transform: scale(1.05); }
