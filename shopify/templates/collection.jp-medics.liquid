{% comment %}
==========================================================================
  FILE:    templates/collection.jp-medics.liquid
  PURPOSE: Custom editorial landing page for the JP Medics collection.
           Assign in Shopify Admin:
           Online Store → Themes → Customize → Collections → jp-medics
           → Template: collection.jp-medics
  NOTES:
  - Uses {% layout none %} for full-page control (own nav/footer/head).
  - {{ content_for_header }} is REQUIRED for Shopify analytics, pixels etc.
  - Product grid rendered natively via {% for product in collection.products %}.
  - Feature bullets assigned per product handle (no metafields required).
  - Prices: product.price | money (live from Shopify, always accurate).
  - Images: product.featured_image | image_url (Shopify CDN).
  - FONT SIZES: All in px (never rem/em) to prevent theme-level font scaling.

  IMAGES TO UPLOAD TO SHOPIFY ASSETS (Admin → Online Store → Files):
  ─────────────────────────────────────────────────────────────────
  1. jp-medics-hero-bg.jpg
     → Hero section background image.
     → Recommended: lifestyle/showroom photo of a JP Medics chair.
     → Suggested source: use the Kozue chair product image cropped wide,
       or any high-res JP Medics lifestyle photo.
     → Dimensions: 1920×1080 minimum. JPG, compressed to <400KB.

  2. jp-medics-kozue-technology-visual.jpg
     → The AI-generated feature visual (Kozue chair with holographic
       sensor overlay, Japanese interior, gold+blue lighting).
     → You already have this file saved as:
       /Users/tulu/Desktop/homc_landing_page/assets/jp-medics-kozue-technology-visual.png
     → Convert to JPG and upload to Shopify Files.
     → Dimensions: 1920×1920 (square). JPG, compressed to <500KB.
  ─────────────────────────────────────────────────────────────────
  NOTE: Product images are served directly from the Shopify CDN via
  product.featured_image — no manual upload needed for those.
==========================================================================
{% endcomment %}

    <script type="application/ld+json">
    [
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "{{ shop.name | escape }}",
        "description": "Authorized JP Medics massage chair dealer with showrooms in San Jose and Pleasanton, CA.",
        "url": "{{ shop.url }}",
        "telephone": "+16692148889",
        "address": [
          {
            "@type": "PostalAddress",
            "streetAddress": "925 Blossom Hill Road, Westfield Oakridge Mall",
            "addressLocality": "San Jose",
            "addressRegion": "CA",
            "postalCode": "95123",
            "addressCountry": "US"
          },
          {
            "@type": "PostalAddress",
            "streetAddress": "1116 Stoneridge Mall Rd",
            "addressLocality": "Pleasanton",
            "addressRegion": "CA",
            "postalCode": "94566",
            "addressCountry": "US"
          }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "JP Medics Massage Chairs",
          "url": "{{ shop.url }}/collections/jp-medics"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}"},
          {"@type":"ListItem","position":2,"name":"Massage Chairs","item":"{{ shop.url }}/collections/massage-chairs"},
          {"@type":"ListItem","position":3,"name":"JP Medics Massage Chairs","item":"{{ shop.url }}/collections/jp-medics"}
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "Brand",
        "name": "JP Medics",
        "description": "JP Medics is a premium Japanese massage chair brand known for fifth-generation 5D robotics, AI-guided Chair Doctor personalization, Li Flex Track coverage, and a curated lineup of flagship-tier models.",
        "url": "{{ shop.url }}/collections/jp-medics"
      }
    ]
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"Are JP Medics massage chairs good?","acceptedAnswer":{"@type":"Answer","text":"Yes. JP Medics is a premium Japanese massage chair brand known for fifth-generation 5D robotics, AI-guided Chair Doctor personalization, precision pressure sensing, and a refined full-body massage feel. Their chairs are designed for buyers who want precision and personalization over broad feature lists."}},
        {"@type":"Question","name":"What is the best JP Medics massage chair?","acceptedAnswer":{"@type":"Answer","text":"The JP Medics Kozue is the brand's current flagship, featuring fifth-generation 5D Human-like Vario Motion with 27 pressure sensors and a Li Flex Track. The KaZe Duo is the premium dual-engine model with a 4D+3D Duo Vario Motion system and broader automation features. The best choice depends on whether you prioritize sensor-led precision (Kozue) or dual-engine coverage with smart automation (KaZe Duo)."}},
        {"@type":"Question","name":"What is the difference between the JP Medics Kozue and KaZe Duo?","acceptedAnswer":{"@type":"Answer","text":"The Kozue uses a fifth-generation 5D mechanism with 27 live pressure sensors and a Li Flex Track with 170-degree recline — optimized for precision-led personalization. The KaZe Duo uses a dual 4D+3D engine with L-Track, voice control, wireless charging, and a 1-inch wall saver — optimized for daily home automation and convenience."}},
        {"@type":"Question","name":"Where can I try JP Medics massage chairs in person?","acceptedAnswer":{"@type":"Answer","text":"House of Massage Chairs carries JP Medics massage chairs at showrooms in San Jose (Westfield Oakridge Mall) and Pleasanton (Stoneridge Mall). You can try and compare models in person with specialist guidance before purchasing."}},
        {"@type":"Question","name":"Are JP Medics massage chairs worth the money?","acceptedAnswer":{"@type":"Answer","text":"JP Medics chairs are worth considering for buyers who prioritize Japanese-engineered precision, AI-guided body adaptation, and a refined massage feel. The Kozue and KaZe Duo compete at the upper end of the premium segment and deliver strong feature profiles at their price points."}}
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "JP Medics Massage Chairs Collection",
      "url": "{{ shop.url }}/collections/jp-medics",
      "numberOfItems": {{ collection.products_count }},
      "itemListElement": [
        {% for product in collection.products %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ product.title | json }},
          "url": "{{ shop.url }}{{ product.url }}",
          "offers": {
            "@type": "Offer",
            "priceCurrency": "USD",
            "price": "{{ product.price | money_without_currency }}",
            "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
          }
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
        /* ============================================================
           DESIGN TOKENS
           ============================================================ */
        :root {
            --bg: #ffffff;
            --surface: #f7f8fc;
            --surface2: #f0f2f8;
            --dark: #09090b;
            --dark2: #18181b;
            --muted: #52525b;
            --muted-light: #71717a;
            --accent: #c4954a;
            --accent2: #e8b96a;
            --accent-dark: #8a6232;
            --accent-pale: rgba(196,149,74,0.10);
            --accent-pale2: rgba(196,149,74,0.06);
            --border: #e4e4e7;
            --border-strong: #d4d4d8;
            --white: #ffffff;
            --radius-sm: 10px;
            --radius-md: 18px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
            --shadow-md: 0 8px 30px rgba(0,0,0,0.08);
            --shadow-lg: 0 20px 60px rgba(0,0,0,0.12);
            --shadow-gold: 0 8px 32px rgba(196,149,74,0.22);
        }

        /* ============================================================
           RESET — scoped to .jpm-wrap (does NOT affect theme footer)
           All font-sizes in px to prevent Shopify rem scaling.
           ============================================================ */
        .jpm-wrap *, .jpm-wrap *::before, .jpm-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
        .jpm-wrap {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--dark);
            line-height: 1.7;
            font-size: 16px;
            font-weight: 450;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }
        /* headings — all px, scoped */
        .jpm-wrap h1, .jpm-wrap h2, .jpm-wrap h3, .jpm-wrap h4, .jpm-wrap h5, .jpm-wrap h6 {
            font-family: 'Inter', -apple-system, sans-serif;
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1.15;
            color: var(--dark);
            margin: 0;
        }
        .jpm-wrap h1 { font-size: 52px; }
        .jpm-wrap h2 { font-size: 38px; }
        .jpm-wrap h3 { font-size: 22px; }
        .jpm-wrap h4 { font-size: 18px; }
        .jpm-wrap p  { font-size: 16px; line-height: 1.8; margin: 0; }
        .jpm-wrap a  { color: inherit; text-decoration: none; }
        .jpm-wrap img { max-width: 100%; display: block; }

        /* ─── responsive heading sizes ─── */
        @media(max-width:900px) {
            .jpm-wrap h1 { font-size: 36px; }
            .jpm-wrap h2 { font-size: 28px; }
            .jpm-wrap h3 { font-size: 19px; }
        }
        @media(max-width:600px) {
            .jpm-wrap h1 { font-size: 28px; }
            .jpm-wrap h2 { font-size: 24px; }
            .jpm-wrap h3 { font-size: 17px; }
        }

        /* ============================================================
           LAYOUT
           ============================================================ */
        .jpm-wrap .container        { max-width: 1220px; margin: 0 auto; padding: 0 2rem; }
        .jpm-wrap .container-narrow { max-width: 880px;  margin: 0 auto; padding: 0 2rem; }

        /* ============================================================
           ANIMATIONS
           ============================================================ */
        @keyframes fadeUp    { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
        @keyframes shimmer   { 0%,100% { opacity:.5; } 50% { opacity:1; } }
        @keyframes pulseDot  { 0%,100% { transform:scale(1); opacity:1; } 50% { transform:scale(1.4); opacity:.7; } }
        .fade-up   { animation: fadeUp .6s ease both; }
        .fade-up-1 { animation-delay:.10s; }
        .fade-up-2 { animation-delay:.20s; }
        .fade-up-3 { animation-delay:.30s; }
        .fade-up-4 { animation-delay:.40s; }

        /* ============================================================
           NAV
           ============================================================ */
        .site-nav {
            padding: 14px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.96);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 300;
            box-shadow: 0 1px 20px rgba(0,0,0,0.06);
        }
        .nav-logo img { height: 38px; width: auto; display: block; }
        .nav-links { display: flex; gap: 28px; align-items: center; }
        .nav-links a { font-size: 13px !important; font-weight: 600; color: var(--muted); transition: color .2s; letter-spacing: .01em; }
        .nav-links a:hover { color: var(--dark); }
        .nav-cta {
            background: var(--dark);
            color: #fff !important;
            padding: 9px 22px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 13px !important;
            transition: all .25s;
            letter-spacing: .02em;
        }
        .nav-cta:hover { background: var(--accent) !important; transform: translateY(-1px); box-shadow: var(--shadow-gold); }

        /* ============================================================
           STICKY SUBNAV
           ============================================================ */
        .jpm-wrap { margin-top: 0; padding-top: 0; }
        .page-subnav {
            position: sticky;
            top: 0;
            z-index: 200;
            background: rgba(255,255,255,0.97);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            overflow-x: auto;
            scrollbar-width: none;
        }
        .page-subnav::-webkit-scrollbar { display: none; }
        .page-subnav-inner { display: flex; padding: 0 32px; min-width: max-content; }
        .page-subnav-inner a {
            display: block;
            padding: 13px 17px;
            font-size: 11px !important;
            font-weight: 700;
            color: var(--muted);
            border-bottom: 2.5px solid transparent;
            white-space: nowrap;
            transition: all .2s;
            text-transform: uppercase;
            letter-spacing: .08em;
        }
        .page-subnav-inner a:hover { color: var(--dark); border-bottom-color: var(--accent); }

        /* ============================================================
           BUTTONS
           ============================================================ */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 15px 36px;
            font-size: 15px !important;
            font-family: 'Inter', sans-serif !important;
            font-weight: 700;
            border-radius: 50px;
            transition: all .25s;
            border: 2px solid transparent;
            cursor: pointer;
            letter-spacing: .02em;
            text-decoration: none;
            line-height: 1;
        }
        .btn-dark  { background: var(--dark); color: #fff !important; border-color: var(--dark); }
        .btn-dark:hover  { background: #1a1a2e; border-color: #1a1a2e; transform: translateY(-2px); box-shadow: 0 10px 28px rgba(0,0,0,.2); }
        .btn-gold  { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff !important; border-color: transparent; }
        .btn-gold:hover  { transform: translateY(-2px); box-shadow: var(--shadow-gold); filter: brightness(1.08); }
        .btn-ghost { background: transparent; color: #fff !important; border-color: rgba(255,255,255,.35); }
        .btn-ghost:hover { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.6); transform: translateY(-1px); }
        .btn-outline { background: transparent; color: var(--dark) !important; border-color: var(--border-strong); }
        .btn-outline:hover { border-color: var(--dark); background: var(--surface); transform: translateY(-1px); }
        .btn-sm { padding: 10px 26px; font-size: 13px !important; }

        /* ============================================================
           HERO
           ============================================================ */
        .hero {
            position: relative;
            min-height: 90vh;
            display: flex;
            align-items: center;
            overflow: hidden;
            background: var(--dark);
        }
        .hero-bg {
            position: absolute;
            inset: 0;
            background: url('https://cdn.shopify.com/s/files/1/0649/9516/4367/files/jp-medics-hero-bg.jpg?v=1776369580') center/cover no-repeat;
            opacity: 0.32;
            z-index: 0;
        }
        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(110deg, rgba(5,5,15,0.94) 30%, rgba(15,10,5,0.55) 75%, rgba(196,149,74,0.06) 100%);
            z-index: 1;
        }
        .hero-glow {
            position: absolute;
            width: 700px; height: 700px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(196,149,74,0.12) 0%, transparent 70%);
            right: -150px; top: -100px;
            z-index: 1;
            animation: shimmer 5s ease-in-out infinite;
        }
        .hero-content { position: relative; z-index: 2; padding: 88px 0 104px; }

        .hero-bc { font-size: 12px !important; color: rgba(255,255,255,0.4); margin-bottom: 28px; }
        .hero-bc a { color: var(--accent2); transition: color .2s; }
        .hero-bc a:hover { color: #fff; }
        .hero-bc span { margin: 0 6px; opacity: .5; }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 11px !important;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--accent2);
            font-weight: 800;
            margin-bottom: 24px;
            background: rgba(196,149,74,.12);
            padding: 6px 14px;
            border-radius: 50px;
            border: 1px solid rgba(196,149,74,.2);
        }
        .hero-eyebrow::before { content: '●'; font-size: 8px; animation: pulseDot 2s infinite; }
        .hero h1 { color: #fff; max-width: 840px; margin-bottom: 24px; text-shadow: 0 4px 30px rgba(0,0,0,.4); }
        .hero-tag {
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-lead { font-size: 18px !important; color: rgba(255,255,255,.82); max-width: 660px; margin-bottom: 12px; font-weight: 600; line-height: 1.65; }
        .hero-note { font-size: 15px !important; color: rgba(255,255,255,.5); max-width: 600px; margin-bottom: 40px; line-height: 1.75; }

        .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 56px; }
        .hero-stats { display: flex; gap: 0; padding-top: 40px; border-top: 1px solid rgba(255,255,255,.10); flex-wrap: wrap; }
        .hero-stat { padding-right: 40px; margin-right: 40px; border-right: 1px solid rgba(255,255,255,.10); }
        .hero-stat:last-child { border-right: none; margin-right: 0; }
        .hero-stat-num { font-size: 30px !important; font-weight: 900; color: #fff; display: block; line-height: 1; margin-bottom: 6px; letter-spacing: -.04em; }
        .hero-stat-label { font-size: 11px !important; color: rgba(255,255,255,.42); text-transform: uppercase; letter-spacing: .13em; font-weight: 700; }

        /* ============================================================
           TRUST BAR
           ============================================================ */
        .trust-bar { display: flex; justify-content: center; background: linear-gradient(90deg,var(--dark),var(--dark2)); overflow-x: auto; scrollbar-width: none; }
        .trust-bar::-webkit-scrollbar { display: none; }
        .trust-bar-inner { display: flex; min-width: max-content; }
        .trust-item { display: flex; align-items: center; gap: 8px; padding: 16px 28px; font-size: 13px !important; font-weight: 700; color: rgba(255,255,255,.72); letter-spacing: .03em; border-right: 1px solid rgba(255,255,255,.07); transition: all .2s; white-space: nowrap; }
        .trust-item:last-child { border-right: none; }
        .trust-item:hover { color: #fff; background: rgba(196,149,74,.1); }
        .trust-item svg { width: 15px; height: 15px; fill: var(--accent2); flex-shrink: 0; }

        /* ============================================================
           SECTIONS
           ============================================================ */
        .section { padding: 96px 0; }
        .section-alt { background: var(--surface); }
        .section-dark { background: var(--dark); }
        .section-sm { padding: 64px 0; }

        .section-label { display: inline-flex; align-items: center; gap: 8px; font-size: 11px !important; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); font-weight: 800; margin-bottom: 16px; }
        .section-label::before { content: ''; width: 20px; height: 2px; background: linear-gradient(90deg,var(--accent),var(--accent2)); border-radius: 2px; display: inline-block; }
        .section-header { margin-bottom: 56px; }
        .section-header.centered { text-align: center; }
        .section-header.centered .section-label { display: inline-flex; }
        .section-header h2 { margin-bottom: 16px; }
        .section-header p { font-size: 17px !important; color: var(--muted); max-width: 700px; line-height: 1.8; }
        .section-header.centered p { margin-left: auto; margin-right: auto; }
        .underline { position: relative; display: inline-block; }
        .underline::after { content: ''; position: absolute; bottom: -4px; left: 0; right: 0; height: 3px; background: var(--accent); border-radius: 2px; }
        .accent-heading::after { content: ''; display: block; width: 48px; height: 3px; margin-top: 12px; background: linear-gradient(90deg,var(--accent),var(--accent2)); border-radius: 4px; }
        .section-header.centered .accent-heading::after { margin-left: auto; margin-right: auto; }

        /* ============================================================
           PRODUCT COLLECTION (Liquid-rendered)
           ============================================================ */
        .collection-section { background: var(--surface); padding: 80px 0; }
        .collection-header { text-align: center; margin-bottom: 48px; }
        .collection-intro-label { display: inline-flex; align-items: center; gap: 8px; font-size: 11px !important; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); font-weight: 800; margin-bottom: 16px; }
        .collection-intro-label span { width: 24px; height: 2px; background: linear-gradient(90deg,var(--accent),var(--accent2)); border-radius: 2px; display: inline-block; }
        .collection-header h2 { margin-bottom: 12px; }
        .collection-header p { font-size: 17px !important; color: var(--muted); max-width: 580px; margin: 0 auto; }

        .product-grid-main { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }

        /* ── premium product card ── */
        .pcard { background: var(--white); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); transition: all .35s cubic-bezier(.4,0,.2,1); position: relative; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); }
        .pcard:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); border-color: rgba(196,149,74,.35); }
        .pcard-accent-line { height: 3px; background: linear-gradient(90deg,var(--accent),var(--accent2)); opacity: 0; transition: opacity .3s; }
        .pcard:hover .pcard-accent-line { opacity: 1; }

        .pcard-img-zone { position: relative; background: #fafafa; padding: 40px 40px 32px; overflow: hidden; }
        .pcard-img-zone::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 100%, rgba(196,149,74,.05) 0%, transparent 70%); pointer-events: none; }
        .pcard-img-zone img { width: 100%; height: 280px; object-fit: contain; mix-blend-mode: multiply; transition: transform .4s ease; }
        .pcard:hover .pcard-img-zone img { transform: scale(1.04); }

        .pcard-badge { position: absolute; top: 14px; left: 14px; font-size: 10px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; padding: 5px 12px; border-radius: 50px; z-index: 2; }
        .pcard-badge.flagship { background: linear-gradient(135deg,var(--accent),var(--accent2)); color: #fff; box-shadow: 0 4px 12px rgba(196,149,74,.4); }
        .pcard-badge.premium  { background: var(--dark); color: #fff; }

        .pcard-savings { position: absolute; top: 14px; right: 14px; font-size: 10px !important; font-weight: 800; background: rgba(16,185,129,.12); color: #059669; padding: 4px 10px; border-radius: 50px; z-index: 2; }

        .pcard-body { padding: 24px 28px 28px; flex: 1; display: flex; flex-direction: column; }
        .pcard-tier { font-size: 11px !important; text-transform: uppercase; letter-spacing: .15em; font-weight: 800; color: var(--accent); margin-bottom: 6px; }
        .pcard-name { font-size: 16px !important; font-weight: 800; margin-bottom: 14px; line-height: 1.3; }
        .pcard-name a { color: var(--dark); transition: color .2s; }
        .pcard-name a:hover { color: var(--accent); }

        .pcard-feats { list-style: none; padding: 0; margin: 0 0 20px; flex: 1; }
        .pcard-feats li { display: flex; align-items: flex-start; gap: 8px; font-size: 13px !important; color: var(--muted); padding: 5px 0; border-bottom: 1px solid var(--border); line-height: 1.5; }
        .pcard-feats li:last-child { border-bottom: none; }
        .pcard-feats li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: linear-gradient(135deg,var(--accent),var(--accent2)); flex-shrink: 0; margin-top: 5px; }

        .pcard-pricing { display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px; }
        .pcard-price { font-size: 28px !important; font-weight: 900; color: var(--dark); letter-spacing: -.03em; }
        .pcard-compare { font-size: 14px !important; color: #a1a1aa; text-decoration: line-through; font-weight: 500; }

        .pcard-cta { display: block; text-align: center; background: var(--dark); color: #fff !important; padding: 13px; border-radius: var(--radius-sm); font-weight: 700; font-size: 14px !important; transition: all .25s; border: 2px solid var(--dark); letter-spacing: .02em; }
        .pcard-cta:hover { background: transparent; color: var(--dark) !important; }

        .collection-footer { text-align: center; margin-top: 40px; }

        /* ============================================================
           QUICK ANSWER
           ============================================================ */
        .quick-answer { background: linear-gradient(135deg,#09090f 0%,#1a1208 100%); border-radius: var(--radius-xl); padding: 56px; border: 1px solid rgba(196,149,74,.18); position: relative; overflow: hidden; }
        .quick-answer::before { content: ''; position: absolute; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle,rgba(196,149,74,.09) 0%,transparent 70%); right: -120px; bottom: -120px; pointer-events: none; }
        .qa-heading { color: #fff; margin-bottom: 8px; font-size: 32px !important; position: relative; z-index: 1; }
        .qa-intro { color: rgba(255,255,255,.52); font-size: 14px !important; max-width: 600px; margin-bottom: 40px; line-height: 1.75; position: relative; z-index: 1; }
        .qa-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; position: relative; z-index: 1; }
        .qa-item { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: var(--radius-md); padding: 28px; transition: all .3s; }
        .qa-item:hover { background: rgba(196,149,74,.08); border-color: rgba(196,149,74,.2); transform: translateY(-2px); }
        .qa-item h3 { color: var(--accent2); font-size: 11px !important; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 12px; font-weight: 800; }
        .qa-item p { font-size: 14px !important; color: rgba(255,255,255,.68); line-height: 1.8; }

        /* ============================================================
           PILLARS
           ============================================================ */
        .pillar-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; }
        .pillar-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 36px; transition: all .35s; position: relative; overflow: hidden; }
        .pillar-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg,var(--accent),var(--accent2)); transform: scaleX(0); transform-origin: left; transition: transform .3s; }
        .pillar-card:hover::before { transform: scaleX(1); }
        .pillar-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: transparent; }
        .pillar-icon { width: 54px; height: 54px; background: var(--accent-pale); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; transition: all .3s; }
        .pillar-card:hover .pillar-icon { background: linear-gradient(135deg,var(--accent),var(--accent2)); }
        .pillar-icon svg { width: 26px; height: 26px; fill: var(--accent); transition: fill .3s; }
        .pillar-card:hover .pillar-icon svg { fill: #fff; }
        .pillar-card h3 { font-size: 16px !important; margin-bottom: 10px; }
        .pillar-card p { font-size: 14px !important; color: var(--muted); line-height: 1.75; }

        /* ============================================================
           FEATURE VISUAL BLOCK
           ============================================================ */
        .feature-visual-wrap { border-radius: var(--radius-xl); overflow: hidden; position: relative; background: linear-gradient(135deg,#06060f 0%,#150f04 60%,#050510 100%); border: 1px solid rgba(196,149,74,.14); box-shadow: 0 40px 100px rgba(0,0,0,.22); }
        .feature-visual-bar { display: flex; align-items: center; justify-content: space-between; padding: 28px 40px; border-bottom: 1px solid rgba(255,255,255,.06); gap: 2rem; }
        .feature-visual-bar-label { font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .22em; color: var(--accent); }
        .feature-visual-bar-sub { font-size: 13px !important; color: rgba(255,255,255,.38); margin-top: 4px; }
        .feature-visual-imgbox { position: relative; overflow: hidden; }
        .feature-visual-imgbox img { width: 100%; display: block; max-height: 680px; object-fit: cover; object-position: center 20%; }
        .feature-visual-imgbox-overlay-bottom { position: absolute; bottom: 0; left: 0; right: 0; height: 45%; background: linear-gradient(to top,#080810 0%,transparent 100%); pointer-events: none; }
        .feature-visual-imgbox-overlay-top    { position: absolute; top: 0; left: 0; right: 0; height: 15%; background: linear-gradient(to bottom,rgba(6,6,15,.6) 0%,transparent 100%); pointer-events: none; }
        .feature-chips { padding: 24px 40px 36px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
        .feature-chip { display: flex; align-items: center; gap: 8px; background: rgba(196,149,74,.1); border: 1px solid rgba(196,149,74,.22); border-radius: 50px; padding: 7px 16px; }
        .feature-chip-dot { width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(135deg,var(--accent),var(--accent2)); flex-shrink: 0; display: inline-block; }
        .feature-chip span { font-size: 12px !important; font-weight: 800; color: var(--accent2); letter-spacing: .04em; }

        /* ============================================================
           AT A GLANCE
           ============================================================ */
        .glance-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
        .glance-table { width: 100%; border-collapse: collapse; }
        .glance-table tr { border-bottom: 1px solid var(--border); transition: background .2s; }
        .glance-table tr:hover { background: var(--surface); }
        .glance-table tr:last-child { border-bottom: none; }
        .glance-table td { padding: 14px 12px; font-size: 14px !important; vertical-align: top; }
        .glance-table td:first-child { font-weight: 800; color: var(--dark); width: 40%; }
        .glance-table td:last-child { color: var(--muted); }
        .glance-verdict { background: linear-gradient(145deg,#09090f 0%,#1c1408 100%); border-radius: var(--radius-xl); padding: 44px; color: #fff; border: 1px solid rgba(196,149,74,.15); position: relative; overflow: hidden; }
        .glance-verdict h3 { color: #fff; font-size: 17px !important; margin-bottom: 24px; }
        .verdict-item { display: flex; align-items: flex-start; gap: 12px; padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,.07); }
        .verdict-item:last-child { border-bottom: none; padding-bottom: 0; }
        .verdict-dot { width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(135deg,var(--accent),var(--accent2)); flex-shrink: 0; margin-top: 9px; }
        .verdict-item p { font-size: 14px !important; color: rgba(255,255,255,.68); line-height: 1.7; }

        /* ============================================================
           WHO IT'S FOR
           ============================================================ */
        .for-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
        .for-card { border-radius: var(--radius-lg); padding: 36px; border: 1px solid var(--border); transition: all .3s; }
        .for-card.is-for { background: var(--white); }
        .for-card.not-for { background: var(--surface2); }
        .for-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
        .for-badge { font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; padding: 5px 14px; border-radius: 50px; display: inline-block; margin-bottom: 24px; }
        .for-badge.yes { background: rgba(16,185,129,.1); color: #059669; border: 1px solid rgba(16,185,129,.2); }
        .for-badge.no  { background: rgba(239,68,68,.08); color: #dc2626; border: 1px solid rgba(239,68,68,.15); }
        .for-list { list-style: none; padding: 0; }
        .for-list li { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 14px !important; color: var(--muted); line-height: 1.6; }
        .for-list li:last-child { border-bottom: none; }
        .for-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 7px; }
        .for-dot.yes { background: #10b981; }
        .for-dot.no  { background: #ef4444; }

        /* ============================================================
           MODEL ENTRIES
           ============================================================ */
        .model-entry { border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--border); background: var(--white); margin-bottom: 40px; transition: box-shadow .35s; box-shadow: var(--shadow-sm); }
        .model-entry:hover { box-shadow: var(--shadow-lg); }
        .model-entry-body { display: grid; grid-template-columns: 360px 1fr; gap: 0; }
        .model-entry-sidebar { background: linear-gradient(160deg,#09090f 0%,#1c1408 100%); padding: 40px 36px; display: flex; flex-direction: column; }
        .model-tier-label { font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .16em; color: var(--accent); margin-bottom: 8px; }
        .model-entry-sidebar h3 { color: #fff; font-size: 20px !important; line-height: 1.3; margin-bottom: 8px; }
        .model-sidebar-desc { color: rgba(255,255,255,.48); font-size: 13px !important; line-height: 1.65; margin-bottom: 24px; }
        .model-sidebar-imgbox { background: #fff; border-radius: 16px; padding: 24px; margin-bottom: 24px; overflow: hidden; flex: 1; display: flex; align-items: center; justify-content: center; min-height: 220px; max-height: 280px; }
        .model-sidebar-imgbox img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transition: transform .4s ease; }
        .model-entry:hover .model-sidebar-imgbox img { transform: scale(1.05); }
        .model-price-display { padding-top: 20px; border-top: 1px solid rgba(255,255,255,.08); }
        .model-price-main { font-size: 32px !important; font-weight: 900; color: #fff; letter-spacing: -.04em; }
        .model-price-compare { font-size: 13px !important; color: rgba(255,255,255,.32); text-decoration: line-through; margin-top: 4px; }
        .model-price-save { font-size: 11px !important; font-weight: 800; color: #10b981; background: rgba(16,185,129,.12); padding: 3px 9px; border-radius: 50px; display: inline-block; margin-top: 8px; }
        .model-sidebar-cta { display: block; margin-top: 14px; text-align: center; background: linear-gradient(135deg,var(--accent),var(--accent2)); color: #fff !important; padding: 12px; border-radius: var(--radius-sm); font-size: 13px !important; font-weight: 700; transition: all .25s; letter-spacing: .03em; }
        .model-sidebar-cta:hover { transform: translateY(-2px); box-shadow: var(--shadow-gold); filter: brightness(1.08); }
        .model-entry-content { padding: 40px; }
        .model-best-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; color: var(--accent); background: var(--accent-pale); padding: 5px 14px; border-radius: 50px; margin-bottom: 20px; border: 1px solid rgba(196,149,74,.2); }
        .model-entry-content h4 { font-size: 18px !important; margin-bottom: 12px; }
        .model-entry-content p { font-size: 14px !important; color: var(--muted); line-height: 1.8; margin-bottom: 16px; }
        .model-traits { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
        .trait-pill { font-size: 11px !important; font-weight: 700; padding: 5px 12px; border-radius: 20px; background: var(--surface); border: 1px solid var(--border); color: var(--muted); transition: all .2s; }
        .trait-pill:hover { background: var(--accent-pale); border-color: var(--accent); color: var(--accent); }
        .model-tradeoff { margin-top: 24px; padding: 18px 22px; border-radius: var(--radius-sm); background: var(--surface2); border-left: 3px solid var(--border-strong); font-size: 13px !important; color: var(--muted-light); line-height: 1.7; }
        .model-tradeoff strong { color: var(--muted); }
        .model-link { display: inline-flex; align-items: center; gap: 5px; font-size: 13px !important; font-weight: 700; color: var(--accent); margin-top: 20px; border-bottom: 1px solid rgba(196,149,74,.3); padding-bottom: 2px; transition: all .2s; }
        .model-link:hover { gap: 9px; border-bottom-color: var(--accent); }

        /* ============================================================
           COMPARE TABLE
           ============================================================ */
        .compare-wrap { overflow-x: auto; border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-sm); }
        .compare-table { width: 100%; border-collapse: collapse; font-size: 13px !important; min-width: 700px; }
        .compare-table th { background: var(--dark); color: #fff; padding: 14px 20px; text-align: left; font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
        .compare-table td { padding: 14px 20px; border-bottom: 1px solid var(--border); color: var(--muted); vertical-align: middle; font-size: 13px !important; }
        .compare-table tr:last-child td { border-bottom: none; }
        .compare-table tr:hover td { background: var(--surface); }
        .col-feature { font-weight: 800; color: var(--dark) !important; white-space: nowrap; }
        .kozue-col { background: rgba(196,149,74,.04) !important; }
        .check  { color: var(--accent); font-weight: 800; }
        .winner { color: #10b981; font-weight: 800; }

        /* ============================================================
           EXPERT CALLOUT
           ============================================================ */
        .expert-callout { background: var(--white); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; padding: 24px 28px; display: flex; align-items: flex-start; gap: 14px; }
        .expert-callout svg { width: 26px; height: 26px; fill: var(--accent); flex-shrink: 0; margin-top: 1px; }
        .expert-callout p { font-size: 14px !important; color: var(--muted); line-height: 1.8; }
        .expert-callout strong { color: var(--dark); }

        /* ============================================================
           BUYER TYPES
           ============================================================ */
        .buyer-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
        .buyer-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; transition: all .3s; position: relative; overflow: hidden; }
        .buyer-card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg,var(--accent),var(--accent2)); transform: scaleX(0); transform-origin: left; transition: transform .3s; }
        .buyer-card:hover::after { transform: scaleX(1); }
        .buyer-card:hover { border-color: rgba(196,149,74,.3); box-shadow: var(--shadow-md); transform: translateY(-4px); }
        .buyer-icon { width: 46px; height: 46px; background: var(--accent-pale); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
        .buyer-icon svg { width: 22px; height: 22px; fill: var(--accent); }
        .buyer-type-label { font-size: 11px !important; font-weight: 800; color: var(--muted-light); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 6px; }
        .buyer-card h3 { font-size: 15px !important; margin-bottom: 6px; }
        .buyer-card p { font-size: 13px !important; color: var(--muted); margin: 0 0 12px; line-height: 1.7; }
        .buyer-rec { font-size: 12px !important; font-weight: 800; color: var(--accent); display: flex; align-items: center; gap: 6px; }
        .buyer-rec::before { content: '→'; }

        /* ============================================================
           VS BRANDS
           ============================================================ */
        .brand-compare-grid { display: grid; gap: 16px; }
        .brand-row { display: grid; grid-template-columns: 180px 1fr; border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--border); transition: box-shadow .2s; }
        .brand-row:hover { box-shadow: var(--shadow-md); }
        .brand-label { background: var(--dark); padding: 20px 24px; display: flex; flex-direction: column; justify-content: center; }
        .brand-name { font-size: 12px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--accent); margin-bottom: 4px; }
        .brand-vs   { font-size: 11px !important; color: rgba(255,255,255,.38); font-weight: 600; }
        .brand-body { padding: 20px 28px; background: var(--white); }
        .brand-body p { font-size: 14px !important; color: var(--muted); line-height: 1.7; }
        .brand-verdict { display: inline-flex; align-items: center; gap: 5px; font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--accent); margin-top: 10px; }

        /* ============================================================
           PRICE LADDER
           ============================================================ */
        .price-ladder { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
        .price-rung { display: grid; grid-template-columns: 160px 1fr; border-bottom: 1px solid var(--border); transition: background .2s; }
        .price-rung:last-child { border-bottom: none; }
        .price-rung:hover { background: var(--surface); }
        .price-rung-label { background: var(--dark); padding: 24px; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid rgba(255,255,255,.07); }
        .price-tier-name { font-size: 10px !important; text-transform: uppercase; letter-spacing: .12em; color: rgba(255,255,255,.42); font-weight: 700; margin-bottom: 4px; }
        .price-amount { font-size: 17px !important; font-weight: 900; color: var(--accent); letter-spacing: -.02em; }
        .price-rung-body { padding: 24px 32px; }
        .price-rung-body h4 { font-size: 15px !important; margin-bottom: 6px; }
        .price-rung-body p { font-size: 13px !important; color: var(--muted); line-height: 1.65; }
        .price-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
        .price-tag { font-size: 10px !important; font-weight: 700; padding: 3px 9px; border-radius: 20px; background: var(--accent-pale); color: var(--accent); }

        /* ============================================================
           TRUST CARDS
           ============================================================ */
        .trust-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
        .trust-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px; transition: all .3s; }
        .trust-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
        .trust-card-icon { width: 44px; height: 44px; background: var(--accent-pale); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
        .trust-card-icon svg { width: 22px; height: 22px; fill: var(--accent); }
        .trust-card h3 { font-size: 15px !important; margin-bottom: 8px; }
        .trust-card p { font-size: 13px !important; color: var(--muted); line-height: 1.7; }

        /* ============================================================
           SHOWROOMS
           ============================================================ */
        .showroom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
        .showroom-card { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: all .3s; }
        .showroom-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
        .showroom-head { background: linear-gradient(135deg,#080808,#171208); padding: 32px 36px 28px; }
        .showroom-pill { font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--accent); background: rgba(196,149,74,.15); padding: 4px 12px; border-radius: 20px; display: inline-block; margin-bottom: 10px; }
        .showroom-head h3 { color: #fff; font-size: 17px !important; margin-bottom: 5px; }
        .showroom-head p { color: rgba(255,255,255,.48); font-size: 13px !important; }
        .showroom-body { background: var(--white); padding: 28px 36px; }
        .showroom-row { display: flex; align-items: flex-start; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px !important; }
        .showroom-row:last-child { border-bottom: none; }
        .showroom-row svg { width: 16px; height: 16px; fill: var(--accent); flex-shrink: 0; margin-top: 2px; }
        .showroom-row strong { color: var(--dark); }
        .showroom-btns { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; }

        /* ============================================================
           FAQ
           ============================================================ */
        .faq-item { border-bottom: 1px solid var(--border); }
        .faq-q { display: flex; justify-content: space-between; align-items: center; padding: 22px 0; cursor: pointer; gap: 1rem; }
        .faq-q h3 { font-size: 15px !important; margin: 0; font-weight: 700; transition: color .2s; line-height: 1.4; }
        .faq-q:hover h3 { color: var(--accent); }
        .faq-icon { width: 22px; height: 22px; fill: var(--muted-light); flex-shrink: 0; transition: transform .3s; }
        .faq-q.active .faq-icon { transform: rotate(45deg); }
        .faq-a { max-height: 0; overflow: hidden; transition: max-height .4s ease; }
        .faq-a.open { max-height: 600px; }
        .faq-a p { margin: 0; padding-bottom: 22px; font-size: 14px !important; color: var(--muted); line-height: 1.85; }
        .faq-a a { color: var(--accent); font-weight: 700; }

        /* ============================================================
           LINK PILLS
           ============================================================ */
        .link-pills { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
        .link-pill { padding: 9px 20px; border: 1.5px solid var(--border); border-radius: 50px; font-size: 13px !important; font-weight: 700; color: var(--dark); background: var(--white); transition: all .3s; }
        .link-pill:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-pale); transform: translateY(-2px); }

        /* ============================================================
           FINAL CTA
           ============================================================ */
        .final-cta { background: linear-gradient(135deg,#050505 0%,#1a110a 60%,#050505 100%); border-radius: var(--radius-xl); padding: 72px; position: relative; overflow: hidden; }
        .final-cta::before { content: ''; position: absolute; top: -40%; right: -8%; width: 650px; height: 650px; border-radius: 50%; background: radial-gradient(circle,rgba(196,149,74,.09) 0%,transparent 70%); pointer-events: none; }
        .final-cta-inner { position: relative; z-index: 1; }
        .final-cta-eyebrow { font-size: 11px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .2em; color: var(--accent); margin-bottom: 16px; display: block; }
        .final-cta h2 { color: #fff; font-size: 40px !important; margin-bottom: 14px; line-height: 1.12; }
        .final-cta p { color: rgba(255,255,255,.62); font-size: 17px !important; max-width: 660px; margin-bottom: 36px; line-height: 1.75; }
        .cta-points { display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 36px; }
        .cta-point { display: flex; align-items: center; gap: 7px; }
        .cta-point svg { width: 16px; height: 16px; fill: var(--accent); flex-shrink: 0; }
        .cta-point span { font-size: 13px !important; color: rgba(255,255,255,.6); font-weight: 600; }
        .final-cta-btns { display: flex; gap: 14px; flex-wrap: wrap; }



        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media(max-width:1100px) {
            .pillar-grid { grid-template-columns: 1fr 1fr; }
            .trust-grid  { grid-template-columns: 1fr 1fr; }
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
