                {%- endif -%}
                {%- assign feat_array = prod_features | split: '|' -%}

                {%- comment %} ── Savings ── {% endcomment -%}
                {%- assign prod_savings_pct = '' -%}
                {%- if product.compare_at_price > product.price -%}
                    {%- assign savings_amt = product.compare_at_price | minus: product.price -%}
                    {%- assign savings_pct = savings_amt | times: 100 | divided_by: product.compare_at_price -%}
                    {%- assign prod_savings_pct = savings_pct | append: '% off' -%}
                {%- endif -%}

                <div class="pcard">
