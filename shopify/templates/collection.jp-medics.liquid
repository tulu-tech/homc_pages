                {%- assign prod_tier = '5D Precision · Li Flex Track' -%}
                {%- if product.handle contains 'kaze' -%}
                    {%- assign prod_tier = 'Dual-Engine Premium · Smart Automation' -%}
                {%- endif -%}

                {%- comment %} ── Feature bullets per handle ── {% endcomment -%}
                {%- assign prod_features = '5th Gen 5D Human-like Vario Motion with 27 sensors|Li Flex Track — near lay-flat 170° recline|73 airbags + heat in legs, lumbar & seat|Chair Doctor Powered by AI biofeedback|Aromatherapy, chromotherapy & Monster Bluetooth|12.3" HD touchscreen + Smart Dial control' -%}
                {%- if product.handle contains 'kaze' -%}
