{% comment %}
  ╔══════════════════════════════════════════════════════════════════╗
  ║  FILE:    templates/collection.fujiiryoki.liquid                 ║
  ║  PURPOSE: Custom standalone editorial landing page for Fujiiryoki║
  ║  USAGE:   Assign in Shopify Admin → Collections → Fujiiryoki     ║
  ║           → Template → collection.fujiiryoki                     ║
  ║  NOTES:                                                           ║
  ║  - {% layout none %} for full-page control.                      ║
  ║  - {{ content_for_header }} required for Shopify analytics.      ║
  ║  - Product grid hydrated via Liquid → JS data array.             ║
  ║  - Feature bullets fall back to JSON if metafield absent.        ║
  ║  - Badge/tier auto-detected from product tags and title.          ║
  ║  - Optional metafields (custom.*) enrich Model Guide entries.    ║
  ╚══════════════════════════════════════════════════════════════════╝
{% endcomment %}
{% layout none %}
{%- paginate collection.products by 50 -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fujiiryoki Massage Chairs — Expert Guide, Reviews &amp; Model Comparison | {{ shop.name }}</title>
  <meta name="description" content="Compare every Fujiiryoki massage chair: Cyber Relax Ai, Elite, Pro 4D Dual &amp; MR-6000 Calm Plus. Expert guidance, honest reviews &amp; pricing from an authorized dealer. Try in person in San Jose or Pleasanton.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ shop.url }}/collections/fujiiryoki">

  <meta property="og:title" content="Fujiiryoki Massage Chairs — Expert Guide &amp; Comparison | {{ shop.name }}">
  <meta property="og:description" content="The complete Fujiiryoki buyer's guide. Cyber Relax Ai, Elite, Pro 4D Dual, MR-6000 Calm Plus — compared, explained, and available to try in San Jose &amp; Pleasanton.">
  <meta property="og:url" content="{{ shop.url }}/collections/fujiiryoki">
  <meta property="og:type" content="website">
  {% if collection.image %}<meta property="og:image" content="{{ collection.image | image_url: width: 1200 }}">{% endif %}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Schema: LocalBusiness + BreadcrumbList + Brand + FAQPage -->
  <script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "{{ shop.name | escape }}",
      "url": "{{ shop.url }}",
      "telephone": "+16692148889",
      "email": "info@houseofmassagechairs.com",
      "description": "Authorized Fujiiryoki massage chair dealer with showrooms in San Jose and Pleasanton, CA.",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "925 Blossom Hill Road, Westfield Oakridge Mall",
          "addressLocality": "San Jose",
          "addressRegion": "CA",
          "postalCode": "95123",
          "addressCountry": "US"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "1116 Stoneridge Mall Rd",
          "addressLocality": "Pleasanton",
          "addressRegion": "CA",
          "postalCode": "94566",
          "addressCountry": "US"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Fujiiryoki Massage Chairs",
        "url": "{{ shop.url }}/collections/fujiiryoki"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}"},
        {"@type":"ListItem","position":2,"name":"Massage Chairs","item":"{{ shop.url }}/collections/massage-chairs"},
        {"@type":"ListItem","position":3,"name":"Fujiiryoki","item":"{{ shop.url }}/collections/fujiiryoki"}
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Brand",
      "name": "Fujiiryoki",
      "description": "Fujiiryoki is a Japanese massage chair brand established in 1954, known for precision engineering, refined massage feel, AI-guided body scanning, and its Cyber Relax lineup of premium massage chairs.",
      "url": "{{ shop.url }}/collections/fujiiryoki"
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"Are Fujiiryoki massage chairs worth it?","acceptedAnswer":{"@type":"Answer","text":"Yes — for buyers who value precision and quality of massage feel over feature quantity. Fujiiryoki massage chairs reflect 70+ years of Japanese engineering heritage and deliver a refined, consistent massage experience that stands apart from feature-dense competitors."}},
        {"@type":"Question","name":"What is the best Fujiiryoki massage chair?","acceptedAnswer":{"@type":"Answer","text":"The best Fujiiryoki chair depends on your needs. For AI-guided precision: Cyber Relax Ai. For 4D dual performance: Cyber Relax Pro 4D Dual. For refined premium comfort: Cyber Relax Elite. For accessible Japanese quality: MR-6000 Calm Plus."}},
        {"@type":"Question","name":"Are Fujiiryoki massage chairs good?","acceptedAnswer":{"@type":"Answer","text":"Yes. Fujiiryoki is one of the most respected Japanese massage chair brands globally, with a heritage dating to 1954. Their chairs are known for precision engineering, refined massage feel, and long-term reliability."}},
        {"@type":"Question","name":"Can I try Fujiiryoki massage chairs in person?","acceptedAnswer":{"@type":"Answer","text":"Yes. House of Massage Chairs carries Fujiiryoki models at our San Jose showroom at Westfield Oakridge Mall and our Pleasanton location at Stoneridge Shopping Center."}},
        {"@type":"Question","name":"Where can I buy authentic Fujiiryoki massage chairs?","acceptedAnswer":{"@type":"Answer","text":"House of Massage Chairs is an authorized Fujiiryoki dealer with showrooms in San Jose and Pleasanton, CA. Buying from an authorized specialist ensures genuine products, valid manufacturer warranties, and professional setup."}}
      ]
    }
  ]
  </script>

  <!-- Schema: ItemList (live pricing from Shopify) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Fujiiryoki Massage Chairs",
    "url": "{{ shop.url }}/collections/fujiiryoki",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "name": {{ product.title | json }},
        "url": "{{ shop.url }}{{ product.url }}",
        "offers": {
          "@type": "Offer",
          "priceCurrency": "USD",
          "price": "{{ product.price | money_without_currency }}",
          "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
        }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>

  <style>
    /* ===== DESIGN TOKENS ===== */
    :root {
      --fji-bg: #fff;
      --fji-surface: #f8fafc;
      --fji-surface2: #f1f5f9;
      --fji-dark: #09090b;
      --fji-dark2: #18181b;
      --fji-muted: #555;
      --fji-muted2: #888;
      --fji-accent: #b38b4d;
      --fji-accent-h: #96723e;
      --fji-accent2: #d4a96a;
      --fji-accent-pale: rgba(179,139,77,0.10);
      --fji-accent-pale2: rgba(179,139,77,0.06);
      --fji-border: #e5e9f0;
      --fji-border2: #d0d8e4;
      --fji-radius: 20px;
      --fji-radius-sm: 12px;
      --fji-shadow: 0 8px 30px rgba(0,0,0,0.07);
      --fji-shadow-lg: 0 20px 50px rgba(0,0,0,0.11);
      --fji-shadow-gold: 0 8px 24px rgba(179,139,77,0.25);
    }

    /* ===== RESET ===== */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',-apple-system,sans-serif;background:var(--fji-bg);color:var(--fji-dark);line-height:1.75;font-size:16px;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    h1,h2,h3,h4{font-weight:800;letter-spacing:-0.03em;line-height:1.15;color:var(--fji-dark)}
    h1{font-size:clamp(2rem,5vw,3.75rem)}
    h2{font-size:clamp(1.6rem,3vw,2.6rem)}
    h3{font-size:clamp(1.05rem,2vw,1.35rem)}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}

    /* ===== LAYOUT ===== */
    .container{max-width:1220px;margin:0 auto;padding:0 2rem}
    .container-narrow{max-width:860px;margin:0 auto;padding:0 2rem}

    /* ===== ANIMATIONS ===== */
    @keyframes fjiPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.5)}}
    @keyframes fjiShimmer{0%,100%{opacity:.5}50%{opacity:1}}

    /* ===== NAV ===== */
    .site-nav{padding:.9rem 2rem;display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,0.96);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--fji-border);position:sticky;top:0;z-index:200;box-shadow:0 1px 20px rgba(0,0,0,0.05)}
    .nav-logo img{height:38px;width:auto}
    .nav-links{display:flex;gap:1.75rem;align-items:center}
    .nav-links a{font-size:.84rem;font-weight:600;color:var(--fji-muted);transition:color .2s;letter-spacing:.01em}
    .nav-links a:hover{color:var(--fji-dark)}
    .nav-cta{background:var(--fji-dark);color:#fff!important;padding:.55rem 1.4rem;border-radius:50px;font-weight:700;font-size:.82rem;transition:all .25s;letter-spacing:.02em}
    .nav-cta:hover{background:var(--fji-accent)!important;transform:translateY(-1px);box-shadow:var(--fji-shadow-gold)}

    /* ===== SUBNAV ===== */
    .page-subnav{position:sticky;top:61px;z-index:150;background:rgba(255,255,255,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--fji-border);overflow-x:auto;scrollbar-width:none}
    .page-subnav::-webkit-scrollbar{display:none}
    .subnav-inner{display:flex;padding:0 2rem;min-width:max-content}
    .subnav-inner a{display:block;padding:.75rem 1rem;font-size:.76rem;font-weight:700;color:var(--fji-muted2);border-bottom:2.5px solid transparent;white-space:nowrap;transition:all .2s;text-transform:uppercase;letter-spacing:.08em}
    .subnav-inner a:hover,.subnav-inner a.active{color:var(--fji-dark);border-bottom-color:var(--fji-accent)}

    /* ===== BUTTONS ===== */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:.9rem 2.2rem;font-size:.95rem;font-weight:700;border-radius:50px;transition:all .25s;border:2px solid transparent;cursor:pointer;letter-spacing:.02em;font-family:'Inter',sans-serif}
    .btn-dark{background:var(--fji-dark);color:#fff;border-color:var(--fji-dark)}
    .btn-dark:hover{background:#222;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.2)}
    .btn-gold{background:var(--fji-accent);color:#fff!important;border-color:var(--fji-accent)}
    .btn-gold:hover{background:var(--fji-accent-h);border-color:var(--fji-accent-h);transform:translateY(-2px);box-shadow:var(--fji-shadow-gold)}
    .btn-ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.35)}
    .btn-ghost:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.7);transform:translateY(-1px)}
    .btn-outline{background:transparent;color:var(--fji-dark);border-color:var(--fji-border2)}
    .btn-outline:hover{border-color:var(--fji-dark);background:var(--fji-surface);transform:translateY(-1px)}
    .btn-sm{padding:.6rem 1.6rem;font-size:.85rem}

    /* ===== HERO ===== */
    .hero{position:relative;min-height:88vh;display:flex;align-items:center;overflow:hidden;background:#060608}
    .hero-bg{position:absolute;inset:0;background:url('{{ "fujiiryoki-hero-bg.jpg" | asset_url }}') center/cover no-repeat;opacity:.28;z-index:0}
    .hero-grad{position:absolute;inset:0;background:linear-gradient(115deg,rgba(0,0,0,.95) 28%,rgba(0,0,0,.55) 65%,rgba(10,8,4,.8) 100%);z-index:1}
    .hero-glow{position:absolute;top:-10%;right:-8%;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.07) 0%,transparent 70%);z-index:2;animation:fjiShimmer 5s ease-in-out infinite;pointer-events:none}
    .hero-content{position:relative;z-index:3;padding:5rem 0 5.5rem}
    .hero-bc{font-size:.75rem;color:rgba(255,255,255,.38);margin-bottom:1.5rem}
    .hero-bc a{color:var(--fji-accent);transition:color .2s}
    .hero-bc a:hover{color:#fff}
    .hero-bc span{margin:0 .4rem}
    .hero-eye{display:inline-flex;align-items:center;gap:8px;font-size:.72rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--fji-accent);margin-bottom:1.25rem;background:rgba(179,139,77,.1);padding:5px 14px;border-radius:50px;border:1px solid rgba(179,139,77,.18)}
    .hero-eye::before{content:'●';font-size:.42rem;animation:fjiPulse 2.2s ease-in-out infinite}
    .hero h1{color:#fff;max-width:800px;margin-bottom:1.25rem;text-shadow:0 4px 30px rgba(0,0,0,.4);line-height:1.1}
    .hero-lead{font-size:clamp(1rem,1.5vw,1.2rem);color:rgba(255,255,255,.8);max-width:630px;margin-bottom:.75rem;font-weight:600;line-height:1.65}
    .hero-sub{font-size:.94rem;color:rgba(255,255,255,.48);max-width:580px;margin-bottom:2.5rem;line-height:1.8}
    .hero-ctas{display:flex;gap:.875rem;flex-wrap:wrap;margin-bottom:3rem}
    .hero-stats{display:flex;border-top:1px solid rgba(255,255,255,.08);padding-top:2.5rem;flex-wrap:wrap}
    .hero-stat{padding:0 2.5rem 0 0;border-right:1px solid rgba(255,255,255,.08);margin-right:2.5rem}
    .hero-stat:last-child{border-right:none;margin-right:0}
    .hero-stat-n{font-size:2rem;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:4px;letter-spacing:-.04em}
    .hero-stat-l{font-size:.7rem;color:rgba(255,255,255,.38);text-transform:uppercase;letter-spacing:.14em;font-weight:700}

    /* ===== TRUST BAR ===== */
    .trust-bar{display:flex;justify-content:center;align-items:center;gap:0;background:var(--fji-dark2);overflow:hidden;flex-wrap:wrap}
    .trust-item{display:flex;align-items:center;gap:8px;padding:1rem 1.75rem;font-size:.82rem;font-weight:700;color:rgba(255,255,255,.7);border-right:1px solid rgba(255,255,255,.07);transition:all .2s;white-space:nowrap}
    .trust-item:last-child{border-right:none}
    .trust-item:hover{color:#fff;background:rgba(179,139,77,.1)}
    .trust-item svg{width:15px;height:15px;fill:var(--fji-accent2);flex-shrink:0}

    /* ===== SECTIONS ===== */
    .section{padding:5.5rem 0}
    .section-alt{background:var(--fji-surface)}
    .section-sm{padding:3.5rem 0}
    .section-label{display:inline-block;font-size:.7rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--fji-accent);margin-bottom:.875rem}
    .section-header{margin-bottom:3rem}
    .section-header.center{text-align:center}
    .section-header.center .section-label{display:block}
    .section-header h2{margin-bottom:.875rem}
    .section-header p{font-size:1.05rem;color:var(--fji-muted);max-width:700px;line-height:1.8}
    .section-header.center p{margin:0 auto}
    .accent-u{display:inline-block;background:linear-gradient(90deg,var(--fji-accent),var(--fji-accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

    /* ===== PRODUCT SECTION ===== */
    .product-header{background:linear-gradient(135deg,#040406,#130e06 60%,#080808);padding:3rem 3rem 0;border-radius:var(--fji-radius) var(--fji-radius) 0 0;position:relative;overflow:hidden}
    .product-header::before{content:'';position:absolute;top:-40%;right:-10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.06),transparent 70%);pointer-events:none}
    .product-header-inner{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding-bottom:2.5rem}
    .product-header h2{color:#fff;font-size:clamp(1.5rem,2.5vw,2rem)}
    .product-header p{color:rgba(255,255,255,.5);font-size:.88rem;max-width:520px;margin-top:.5rem;line-height:1.7}

    /* ===== FILTER BAR ===== */
    .filter-bar{background:#fff;border:1px solid var(--fji-border);border-top:none;padding:.875rem 1.5rem;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
    .filter-label{font-size:.67rem;font-weight:800;text-transform:uppercase;letter-spacing:.16em;color:var(--fji-muted2);white-space:nowrap}
    .filter-sep{width:1px;height:20px;background:var(--fji-border);flex-shrink:0}
    .filter-btn{padding:5px 14px;border:1.5px solid var(--fji-border);border-radius:50px;font-size:.75rem;font-weight:700;cursor:pointer;transition:all .2s;background:transparent;color:var(--fji-muted);font-family:'Inter',sans-serif;white-space:nowrap}
    .filter-btn:hover{border-color:var(--fji-accent);color:var(--fji-accent);background:var(--fji-accent-pale2)}
    .filter-btn.active{background:var(--fji-dark);color:#fff;border-color:var(--fji-dark)}
    .filter-count{margin-left:auto;font-size:.78rem;color:var(--fji-muted2);font-weight:600}

    /* ===== PRODUCT GRID ===== */
    .product-grid-wrap{background:var(--fji-surface);border:1px solid var(--fji-border);border-top:none;border-radius:0 0 var(--fji-radius) var(--fji-radius);padding:2rem}
    .product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;transition:opacity .3s}

    /* ===== PRODUCT CARD ===== */
    .pcard{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);overflow:hidden;transition:all .3s cubic-bezier(.25,.8,.25,1);position:relative;display:flex;flex-direction:column}
    .pcard:hover{transform:translateY(-7px);box-shadow:var(--fji-shadow-lg);border-color:transparent;outline:2px solid var(--fji-accent)}
    .pcard-badge{position:absolute;top:10px;left:10px;font-size:.62rem;font-weight:800;padding:3px 10px;border-radius:50px;text-transform:uppercase;letter-spacing:.1em;z-index:2}
    .pcard-badge.gold{background:var(--fji-accent);color:#fff}
    .pcard-badge.flagship{background:linear-gradient(135deg,#1a0f00,#3d2800);color:var(--fji-accent2);border:1px solid rgba(179,139,77,.3)}
    .pcard-badge.standard{background:var(--fji-dark);color:#fff}
    .pcard-img-zone{height:240px;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:linear-gradient(145deg,#fafafa,#fff);position:relative;overflow:hidden}
    .pcard-img-zone img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s ease}
    .pcard:hover .pcard-img-zone img{transform:scale(1.06)}
    .pcard-body{padding:1.1rem 1.25rem 1.25rem;flex:1;display:flex;flex-direction:column}
    .pcard-for{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--fji-accent);background:var(--fji-accent-pale);display:inline-block;padding:3px 8px;border-radius:20px;margin-bottom:.6rem}
    .pcard-name{font-size:14px;font-weight:700;line-height:1.35;margin-bottom:.75rem}
    .pcard-name a{color:var(--fji-dark)}
    .pcard-feats{list-style:none;padding:0;margin:0 0 .875rem;flex:1}
    .pcard-feats li{display:flex;align-items:flex-start;gap:5px;font-size:13px;color:var(--fji-muted);padding:2px 0;line-height:1.5}
    .pcard-feats li::before{content:'✓';color:var(--fji-accent);font-weight:900;font-size:.68rem;flex-shrink:0;margin-top:2px}
    .pcard-prices{display:flex;align-items:baseline;gap:7px;margin-bottom:.875rem;flex-wrap:wrap}
    .pcard-price{font-size:18px;font-weight:900;color:var(--fji-dark);letter-spacing:-.02em}
    .pcard-was{font-size:.82rem;color:#adb5bd;text-decoration:line-through;font-weight:500}
    .pcard-save{font-size:.65rem;font-weight:800;color:#16a34a;background:rgba(22,163,74,.08);padding:2px 7px;border-radius:20px}
    .pcard-cta{display:block;text-align:center;background:var(--fji-dark);color:#fff;padding:.65rem;border-radius:var(--fji-radius-sm);font-weight:700;font-size:.82rem;transition:background .2s}
    .pcard-cta:hover{background:var(--fji-accent)}
    .no-results{grid-column:1/-1;text-align:center;padding:4rem 0;color:var(--fji-muted)}

    /* ===== QUICK ANSWER ===== */
    .quick-answer{background:linear-gradient(135deg,#040406,#16100a);border-radius:24px;padding:3rem;border:1px solid rgba(179,139,77,.12);position:relative;overflow:hidden}
    .quick-answer::before{content:'';position:absolute;top:-30%;right:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.055),transparent 70%);pointer-events:none}
    .qa-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:2rem;position:relative;z-index:1}
    .qa-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:1.5rem;transition:all .3s}
    .qa-item:hover{background:rgba(179,139,77,.07);border-color:rgba(179,139,77,.2)}
    .qa-item h3{font-size:.72rem;text-transform:uppercase;letter-spacing:.14em;color:var(--fji-accent2);margin-bottom:.625rem;font-weight:800}
    .qa-item p{font-size:.88rem;color:rgba(255,255,255,.65);line-height:1.78;margin:0}

    /* ===== PILLARS ===== */
    .pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
    .pillar-card{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:2rem;transition:all .3s;position:relative;overflow:hidden}
    .pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--fji-accent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
    .pillar-card:hover{transform:translateY(-5px);box-shadow:var(--fji-shadow)}
    .pillar-card:hover::before{transform:scaleX(1)}
    .pillar-icon{width:48px;height:48px;background:var(--fji-accent-pale);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:1.125rem}
    .pillar-icon svg{width:24px;height:24px;fill:var(--fji-accent)}
    .pillar-card h3{font-size:16px;margin-bottom:.5rem}
    .pillar-card p{font-size:.875rem;color:var(--fji-muted);margin:0;line-height:1.75}

    /* ===== AT A GLANCE ===== */
    .glance-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
    .glance-table{width:100%;border-collapse:collapse}
    .glance-table tr{border-bottom:1px solid var(--fji-border)}
    .glance-table tr:last-child{border-bottom:none}
    .glance-table td{padding:.875rem .5rem;font-size:.875rem;vertical-align:top}
    .glance-table td:first-child{font-weight:800;color:var(--fji-dark);width:38%}
    .glance-table td:last-child{color:var(--fji-muted)}
    .glance-verdict{background:linear-gradient(145deg,#060608,#14100a);border-radius:var(--fji-radius);padding:2.25rem;border:1px solid rgba(179,139,77,.1)}
    .glance-verdict h3{color:#fff;font-size:17px;margin-bottom:1.25rem}
    .verdict-item{display:flex;align-items:flex-start;gap:10px;padding:.625rem 0;border-bottom:1px solid rgba(255,255,255,.06)}
    .verdict-item:last-child{border-bottom:none;padding-bottom:0}
    .verdict-dot{width:7px;height:7px;border-radius:50%;background:var(--fji-accent);flex-shrink:0;margin-top:8px}
    .verdict-item p{font-size:.83rem;color:rgba(255,255,255,.6);margin:0;line-height:1.7}

    /* ===== WHO IT'S FOR ===== */
    .for-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
    .for-card{border-radius:var(--fji-radius);padding:2rem;border:1px solid var(--fji-border);background:#fff}
    .for-card.alt{background:var(--fji-surface)}
    .for-badge{font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:4px 12px;border-radius:50px;display:inline-block;margin-bottom:1.125rem}
    .for-badge.yes{background:rgba(34,197,94,.1);color:#16a34a}
    .for-badge.no{background:rgba(239,68,68,.08);color:#dc2626}
    .for-list{list-style:none;padding:0}
    .for-list li{display:flex;align-items:flex-start;gap:8px;padding:.55rem 0;border-bottom:1px solid var(--fji-border);font-size:.875rem;color:var(--fji-muted);line-height:1.6}
    .for-list li:last-child{border-bottom:none}
    .for-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:7px}
    .for-dot.yes{background:#16a34a}
    .for-dot.no{background:#dc2626}

    /* ===== MODEL ENTRIES ===== */
    .model-entry{display:grid;grid-template-columns:280px 1fr;border-radius:var(--fji-radius);overflow:hidden;border:1px solid var(--fji-border);background:#fff;margin-bottom:2rem;transition:box-shadow .3s}
    .model-entry:hover{box-shadow:var(--fji-shadow-lg)}
    .model-side{background:linear-gradient(160deg,#060608,#16100a);padding:2.25rem 1.75rem;display:flex;flex-direction:column;justify-content:space-between}
    .model-side-imgbox{background:#fff;border-radius:14px;padding:1.25rem;margin:.75rem 0 .5rem;display:flex;align-items:center;justify-content:center;min-height:200px;max-height:240px;overflow:hidden}
    .model-side-img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s}
    .model-entry:hover .model-side-img{transform:scale(1.07)}
    .model-tier{font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.16em;color:var(--fji-accent);margin-bottom:.4rem}
    .model-side h3{color:#fff;font-size:1rem;line-height:1.3}
    .model-side .model-desc{font-size:.78rem;color:rgba(255,255,255,.42);line-height:1.65;margin-top:.4rem}
    .model-price-band{display:inline-flex;gap:5px;margin-top:1rem;font-size:.75rem;font-weight:700;color:rgba(255,255,255,.42);background:rgba(255,255,255,.05);padding:5px 11px;border-radius:20px}
    .model-price-band span{color:var(--fji-accent)}
    .model-body{padding:2.25rem}
    .model-best{font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--fji-accent);background:var(--fji-accent-pale);display:inline-block;padding:3px 10px;border-radius:20px;margin-bottom:.875rem}
    .model-body h4{font-size:16px;margin-bottom:.625rem}
    .model-body p{font-size:.875rem;color:var(--fji-muted);line-height:1.78;margin-bottom:.875rem}
    .model-traits{display:flex;gap:.4rem;flex-wrap:wrap;margin:.875rem 0}
    .trait{font-size:.68rem;font-weight:700;padding:3px 10px;border-radius:20px;background:var(--fji-surface2);border:1px solid var(--fji-border);color:var(--fji-muted2)}
    .model-tradeoff{margin-top:1rem;padding:.875rem 1.125rem;border-radius:10px;background:var(--fji-surface);border-left:3px solid var(--fji-border2);font-size:.82rem;color:var(--fji-muted2);line-height:1.65}
    .model-link{display:inline-flex;align-items:center;gap:5px;font-size:.82rem;font-weight:700;color:var(--fji-accent);margin-top:1.25rem;border-bottom:1px solid rgba(179,139,77,.3);padding-bottom:2px;transition:all .2s}
    .model-link:hover{gap:9px;border-bottom-color:var(--fji-accent)}

    /* ===== BUYER TYPES ===== */
    .buyer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
    .buyer-card{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:1.75rem;transition:all .3s;position:relative;overflow:hidden}
    .buyer-card:hover{border-color:rgba(179,139,77,.3);box-shadow:0 10px 30px rgba(179,139,77,.1)}
    .buyer-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--fji-accent),transparent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
    .buyer-card:hover::after{transform:scaleX(1)}
    .buyer-icon{width:42px;height:42px;background:var(--fji-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:.875rem}
    .buyer-icon svg{width:20px;height:20px;fill:var(--fji-accent)}
    .buyer-type{font-size:.67rem;font-weight:800;color:var(--fji-muted2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}
    .buyer-card h3{font-size:.9rem;margin-bottom:.4rem}
    .buyer-card p{font-size:.83rem;color:var(--fji-muted);margin:0;line-height:1.7}
    .buyer-rec{margin-top:.625rem;font-size:.75rem;font-weight:700;color:var(--fji-accent)}

    /* ===== COMPARE TABLE ===== */
    .compare-wrap{overflow-x:auto;border-radius:14px;border:1px solid var(--fji-border)}
    .compare-table{width:100%;border-collapse:collapse;font-size:.83rem;min-width:700px}
    .compare-table th{background:var(--fji-dark);color:#fff;padding:.875rem 1.125rem;text-align:left;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}
    .compare-table td{padding:.8rem 1.125rem;border-bottom:1px solid var(--fji-border);color:var(--fji-muted);vertical-align:middle}
    .compare-table tr:last-child td{border-bottom:none}
    .compare-table tr:hover td{background:var(--fji-surface)}
    .col-feat{font-weight:800;color:var(--fji-dark)!important;white-space:nowrap}
    .fji-col{background:rgba(179,139,77,.04)!important}
    thead .fji-col{background:rgba(179,139,77,.14)!important;color:var(--fji-accent)!important;border-bottom:3px solid var(--fji-accent)!important}
    .chk{color:var(--fji-accent);font-weight:800}

    /* ===== EXPERT CALLOUT ===== */
    .expert-callout{background:#fff;border:1px solid var(--fji-border);border-left:4px solid var(--fji-accent);border-radius:0 12px 12px 0;padding:1.5rem 1.75rem;display:flex;align-items:flex-start;gap:.875rem}
    .expert-callout svg{width:26px;height:26px;fill:var(--fji-accent);flex-shrink:0;margin-top:1px}
    .expert-callout p{font-size:.875rem;color:var(--fji-muted);line-height:1.78;margin:0}
    .expert-callout strong{color:var(--fji-dark)}

    /* ===== PRICE LADDER ===== */
    .price-ladder{border:1px solid var(--fji-border);border-radius:var(--fji-radius);overflow:hidden}
    .price-rung{display:grid;grid-template-columns:140px 1fr;border-bottom:1px solid var(--fji-border)}
    .price-rung:last-child{border-bottom:none}
    .price-rung:hover{background:var(--fji-surface)}
    .price-rung-label{background:var(--fji-dark);padding:1.5rem;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.07)}
    .price-tier-name{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.4);font-weight:700;margin-bottom:3px}
    .price-amount{font-size:1rem;font-weight:900;color:var(--fji-accent);letter-spacing:-.02em}
    .price-rung-body{padding:1.5rem 2rem}
    .price-rung-body h4{font-size:.9rem;margin-bottom:.35rem}
    .price-rung-body p{font-size:.82rem;color:var(--fji-muted);margin:0;line-height:1.65}
    .price-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.625rem}
    .price-tag{font-size:.65rem;font-weight:700;padding:2px 9px;border-radius:20px;background:var(--fji-accent-pale);color:var(--fji-accent)}

    /* ===== TRUST CARDS ===== */
    .trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
    .tcard{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:1.75rem;transition:all .3s}
    .tcard:hover{transform:translateY(-4px);box-shadow:var(--fji-shadow)}
    .tcard-icon{width:44px;height:44px;background:var(--fji-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem}
    .tcard-icon svg{width:22px;height:22px;fill:var(--fji-accent)}
    .tcard h3{font-size:15px;margin-bottom:.5rem}
    .tcard p{font-size:.875rem;color:var(--fji-muted);margin:0;line-height:1.75}

    /* ===== REVIEWS ===== */
    .review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
    .rcard{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:1.75rem;transition:all .3s;position:relative}
    .rcard:hover{transform:translateY(-3px);box-shadow:var(--fji-shadow)}
    .rcard::before{content:'"';position:absolute;top:1rem;right:1.25rem;font-size:4rem;color:var(--fji-accent-pale);font-weight:900;line-height:1;pointer-events:none}
    .rcard-stars{color:var(--fji-accent);letter-spacing:2px;font-size:.8rem;margin-bottom:.625rem}
    .rcard-text{font-size:.875rem;color:var(--fji-muted);line-height:1.78;margin-bottom:1.125rem;font-style:italic}
    .rcard-author{display:flex;align-items:center;gap:9px}
    .rcard-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.85rem;color:#fff;flex-shrink:0}
    .rcard-name{font-weight:700;font-size:.84rem}
    .rcard-meta{font-size:.72rem;color:var(--fji-muted2)}

    /* ===== SHOWROOM ===== */
    .showroom-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
    .showroom-card{border:1px solid var(--fji-border);border-radius:var(--fji-radius);overflow:hidden;transition:all .3s}
    .showroom-card:hover{transform:translateY(-4px);box-shadow:var(--fji-shadow-lg)}
    .showroom-head{background:linear-gradient(135deg,#060608,#16100a);padding:2rem 2.25rem 1.75rem}
    .showroom-pill{font-size:.67rem;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--fji-accent2);background:rgba(179,139,77,.14);padding:3px 10px;border-radius:20px;display:inline-block;margin-bottom:.625rem;border:1px solid rgba(179,139,77,.2)}
    .showroom-head h3{color:#fff;font-size:1.05rem;margin-bottom:.3rem}
    .showroom-head p{color:rgba(255,255,255,.48);font-size:.82rem;margin:0}
    .showroom-body{background:#fff;padding:1.75rem 2.25rem}
    .showroom-row{display:flex;align-items:flex-start;gap:8px;padding:.5rem 0;border-bottom:1px solid var(--fji-border);font-size:.82rem}
    .showroom-row:last-of-type{border-bottom:none}
    .showroom-row svg{width:16px;height:16px;fill:var(--fji-accent);flex-shrink:0;margin-top:2px}
    .showroom-btns{margin-top:1.25rem;display:flex;gap:.625rem;flex-wrap:wrap}

    /* ===== ANSWER BLOCKS ===== */
    .answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
    .answer-block{background:#fff;border:1px solid var(--fji-border);border-radius:14px;padding:1.75rem;transition:all .3s}
    .answer-block:hover{border-color:var(--fji-border2);box-shadow:0 4px 16px rgba(0,0,0,.05)}
    .answer-block h3{font-size:.9rem;margin-bottom:.5rem}
    .answer-block p{font-size:.83rem;color:var(--fji-muted);margin:0;line-height:1.78}

    /* ===== FAQ ===== */
    .faq-item{border-bottom:1px solid var(--fji-border)}
    .faq-q{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;cursor:pointer;gap:1rem}
    .faq-q h3{font-size:16px;margin:0;font-weight:700;transition:color .2s;line-height:1.4}
    .faq-q:hover h3{color:var(--fji-accent)}
    .faq-icon{width:22px;height:22px;fill:var(--fji-muted2);flex-shrink:0;transition:transform .3s}
    .faq-q.active .faq-icon{transform:rotate(45deg)}
    .faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease}
    .faq-a.open{max-height:600px}
    .faq-a p{margin:0;padding-bottom:1.4rem;font-size:.925rem;color:var(--fji-muted);line-height:1.82}
    .faq-a a{color:var(--fji-accent);font-weight:700}

    /* ===== FINAL CTA ===== */
    .final-cta{background:linear-gradient(135deg,#040406,#16100a 55%,#040406);border-radius:28px;padding:4rem;position:relative;overflow:hidden}
    .final-cta::before{content:'';position:absolute;top:-40%;right:-8%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.08),transparent 70%);pointer-events:none}
    .final-cta-inner{position:relative;z-index:1}
    .final-cta h2{color:#fff;font-size:clamp(1.75rem,3vw,2.6rem);margin-bottom:.875rem;line-height:1.12}
    .final-cta p{color:rgba(255,255,255,.62);font-size:1rem;max-width:640px;margin-bottom:2rem;line-height:1.78}
    .cta-points{display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:2rem}
    .cta-point{display:flex;align-items:center;gap:7px}
    .cta-point svg{width:15px;height:15px;fill:var(--fji-accent);flex-shrink:0}
    .cta-point span{font-size:.82rem;color:rgba(255,255,255,.58);font-weight:600}
    .final-cta-btns{display:flex;gap:.875rem;flex-wrap:wrap}

    /* ===== LINK PILLS ===== */
    .link-pills{display:flex;flex-wrap:wrap;gap:.625rem;justify-content:center}
    .link-pill{padding:.55rem 1.25rem;border:1.5px solid var(--fji-border);border-radius:50px;font-size:.82rem;font-weight:700;color:var(--fji-dark);background:#fff;transition:all .3s}
    .link-pill:hover{border-color:var(--fji-accent);color:var(--fji-accent);background:var(--fji-accent-pale);transform:translateY(-2px)}

    /* ===== FOOTER ===== */
    .site-footer{background:var(--fji-dark);color:#fff;padding:4rem 0 2rem}
    .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:3rem;margin-bottom:3rem}
    .site-footer h4{font-size:.75rem;text-transform:uppercase;letter-spacing:.18em;margin-bottom:1rem;color:var(--fji-accent2);font-weight:800}
    .site-footer p,.site-footer a{color:rgba(255,255,255,.5);font-size:.84rem}
    .site-footer a{display:block;margin-bottom:.5rem;transition:color .2s}
    .site-footer a:hover{color:#fff}
    .footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:1.5rem;text-align:center;color:rgba(255,255,255,.28);font-size:.8rem}

    /* ===== RESPONSIVE ===== */
    @media(max-width:1024px){
      .pillar-grid,.trust-grid{grid-template-columns:1fr 1fr}
      .product-grid{grid-template-columns:1fr 1fr}
    }
    @media(max-width:900px){
      .hero{min-height:65vh}
      .qa-grid,.glance-grid,.for-grid,.model-entry,.buyer-grid,.showroom-grid,.review-grid,.answer-grid{grid-template-columns:1fr}
      .pillar-grid,.trust-grid{grid-template-columns:1fr}
      .product-grid{grid-template-columns:1fr 1fr;gap:1rem}
      .section{padding:3.5rem 0}
      .final-cta{padding:2.5rem 2rem}
      .product-header-inner{flex-direction:column;align-items:flex-start}
      .price-rung{grid-template-columns:1fr}
      .price-rung-label{border-right:none;border-bottom:1px solid rgba(255,255,255,.07)}
      .footer-grid{grid-template-columns:1fr 1fr}
      .nav-links{display:none}
    }
    @media(max-width:600px){
      .product-grid{grid-template-columns:1fr}
      .container{padding:0 1.25rem}
      .product-header{padding:2rem 1.5rem 0}
      .product-grid-wrap{padding:1.25rem}
    }
  </style>
</head>
