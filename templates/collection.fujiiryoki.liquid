<!-- JAVASCRIPT                              -->
<!-- ═══════════════════════════════════════ -->
<script>
// ── PRODUCT DATA FROM LIQUID ──────────────────────────────────────────────
var FUJI_PRODUCTS = [
  {%- for product in collection.products -%}
    {%- assign feat_img = product.featured_image | image_url: width: 600 -%}
    {%- assign tags_low = product.tags | join: ',' | downcase -%}
    {%- assign filter_tags_arr = "" -%}
    {%- if tags_low contains 'cyber-relax' or product.title contains 'Cyber' -%}{%- assign filter_tags_arr = filter_tags_arr | append: '"cyber-relax",' -%}{%- endif -%}
    {%- if tags_low contains 'ai' or product.title contains ' Ai' -%}{%- assign filter_tags_arr = filter_tags_arr | append: '"ai",' -%}{%- endif -%}
    {%- if tags_low contains '4d' or product.title contains '4D' -%}{%- assign filter_tags_arr = filter_tags_arr | append: '"4d",' -%}{%- endif -%}
    {%- assign filter_tags_arr = filter_tags_arr | remove_last: ',' -%}

    {%- assign auto_badge = "" -%}{%- assign auto_class = "standard" -%}
    {%- assign title_l = product.title | downcase -%}
    {%- if title_l contains ' ai' or tags_low contains 'ai' -%}{%- assign auto_badge = "AI" -%}{%- assign auto_class = "gold" -%}
    {%- elsif title_l contains 'pro' or tags_low contains 'flagship' -%}{%- assign auto_badge = "Flagship" -%}{%- assign auto_class = "flagship" -%}
    {%- elsif title_l contains '4d' or tags_low contains '4d' -%}{%- assign auto_badge = "4D" -%}{%- assign auto_class = "gold" -%}
    {%- endif -%}

    {
      n: {{ product.title | json }},
      u: {{ product.url | prepend: shop.url | json }},
      img: {{ feat_img | json }},
      p: {{ product.price | money | json }},
      pc: {{ product.price }},
      cp: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      tags: [{{ filter_tags_arr }}],
      badge: {{ auto_badge | json }},
      bc: {{ auto_class | json }},
      bFor: {{ product.metafields.custom.buyer_for.value | default: product.type | default: 'Japanese Premium' | json }},
      feats: {{ product.metafields.custom.key_features.value | default: '["Premium Japanese engineering","Refined massage feel","Advanced body scanning","Premium build quality"]' }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];

// ── FILTER ─────────────────────────────────────────────────────────────────
var _filter = {type:'all',value:'all'};

function fujiFilter(btn,type,value){
  document.querySelectorAll('#filterBar .filter-btn').forEach(function(b){b.classList.remove('active')});
  btn.classList.add('active');
  _filter={type:type,value:value};
  renderGrid();
}

function filtered(){
  return FUJI_PRODUCTS.filter(function(p){
    if(_filter.type==='all') return true;
    if(_filter.type==='price'){
      var pc=p.pc/100;
      if(_filter.value==='under5') return pc<5000;
      if(_filter.value==='5to8') return pc>=5000&&pc<8000;
      if(_filter.value==='over8') return pc>=8000;
    }
    if(_filter.type==='type') return p.tags.indexOf(_filter.value)!==-1;
    return true;
  });
}

function renderGrid(){
  var grid=document.getElementById('fujiGrid');
  var countEl=document.getElementById('fujiCount');
  var prods=filtered();
  if(countEl) countEl.textContent=prods.length+' model'+(prods.length!==1?'s':'');
  if(!grid) return;
  if(prods.length===0){
    grid.innerHTML='<div class="no-results"><p>No models match this filter. <a href="#" onclick="fujiFilter(document.querySelector(\'.filter-btn\'),\'all\',\'all\');return false;" style="color:var(--fji-accent);font-weight:700">View all models</a></p></div>';
    return;
  }
  grid.style.opacity='0';
  grid.innerHTML='';
  prods.forEach(function(p){
    var badgeHtml=p.badge?'<span class="pcard-badge '+p.bc+'">'+p.badge+'</span>':'';
    var cpHtml=p.cp?'<span class="pcard-was">'+p.cp+'</span>':'';
    var saveHtml='';
    if(p.cp){
      var orig=parseFloat(p.cp.replace(/[^0-9.]/g,'')),sale=parseFloat(p.p.replace(/[^0-9.]/g,''));
      if(orig>sale) saveHtml='<span class="pcard-save">Save '+Math.round((orig-sale)/orig*100)+'%</span>';
    }
    var featsHtml=Array.isArray(p.feats)?p.feats.map(function(f){return '<li>'+f+'</li>';}).join(''):'';
    var card=document.createElement('article');
    card.className='pcard';
    card.innerHTML=
      badgeHtml+
      '<a href="'+p.u+'" style="display:block"><div class="pcard-img-zone"><img src="'+p.img+'" alt="'+p.n+'" loading="lazy" style="width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s"></div></a>'+
      '<div class="pcard-body">'+
        '<div class="pcard-for">'+p.bFor+'</div>'+
        '<div class="pcard-name"><a href="'+p.u+'">'+p.n+'</a></div>'+
        '<ul class="pcard-feats">'+featsHtml+'</ul>'+
        '<div class="pcard-prices"><span class="pcard-price">'+p.p+'</span>'+cpHtml+saveHtml+'</div>'+
        '<a href="'+p.u+'" class="pcard-cta">View Details &rarr;</a>'+
      '</div>';
    grid.appendChild(card);
  });
  setTimeout(function(){grid.style.transition='opacity .3s';grid.style.opacity='1';},40);
}

// ── FAQ ────────────────────────────────────────────────────────────────────
function fujiFaq(el){
  var a=el.nextElementSibling,open=a.classList.contains('open');
  document.querySelectorAll('.faq-a').forEach(function(x){x.classList.remove('open')});
  document.querySelectorAll('.faq-q').forEach(function(x){x.classList.remove('active')});
  if(!open){a.classList.add('open');el.classList.add('active');}
}

// ── SUBNAV SCROLL SPY ─────────────────────────────────────────────────────
(function(){
  var links=document.querySelectorAll('.subnav-inner a');
  var ids=['collection','overview','why-fujiiryoki','model-guide','buyer-types','vs-brands','pricing','trust','showrooms','faq'];
  window.addEventListener('scroll',function(){
    var pos=window.scrollY+140,active='';
    ids.forEach(function(id){var el=document.getElementById(id);if(el&&pos>=el.offsetTop)active=id;});
    links.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+active)l.classList.add('active');});
  });
})();

// ── INIT ──────────────────────────────────────────────────────────────────
renderGrid();
</script>

</body>
</html>
