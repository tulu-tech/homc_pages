<style>
  /* ═══ FONT & RESET ISOLATION — resolves Shopify theme rem cascade ═══ */
  .oga-wrap *{box-sizing:border-box;margin:0;padding:0}
  .oga-wrap{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    color:#0a0a08;
    line-height:1.75;
    font-size:16px;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  /* Override theme root font-size (prevents rem shrink) */
  .oga-wrap p{font-size:15px;color:#52565e;line-height:1.82;margin:0}
  .oga-wrap li{font-size:14px;line-height:1.6}
  .oga-wrap h1{font-size:clamp(36px,5.5vw,64px);line-height:1.08;font-weight:800;letter-spacing:-0.035em}
  .oga-wrap h2{font-size:clamp(26px,3vw,38px);line-height:1.15;font-weight:800;letter-spacing:-0.03em}
  .oga-wrap h3{font-size:clamp(15px,1.8vw,20px);line-height:1.22;font-weight:800;letter-spacing:-0.02em}
  .oga-wrap h4{font-size:16px;line-height:1.3;font-weight:800;letter-spacing:-0.015em}
  .oga-wrap img{max-width:100%;display:block}
  .oga-wrap a{text-decoration:none;color:inherit}

  /* ═══ VARIABLES ═══ */
  .oga-wrap{
    --oga-bg:#fff;
    --oga-surface:#f8fafb;
    --oga-surface2:#f1f4f8;
    --oga-dark:#0a0a08;
    --oga-muted:#52565e;
    --oga-muted2:#8a8f9a;
    --oga-accent:#8b6f47;
    --oga-accent-h:#73593a;
    --oga-accent-pale:rgba(139,111,71,0.09);
    --oga-border:#e8ecf1;
    --oga-border2:#cdd5e0;
    --oga-radius:20px;
    --oga-radius-sm:12px;
    --oga-shadow:0 8px 32px rgba(0,0,0,0.06);
    --oga-shadow-hover:0 22px 54px rgba(0,0,0,0.12);
    --oga-gold-glow:0 8px 32px rgba(139,111,71,0.28);
  }

  /* ── LAYOUT ── */
  .oga-container{max-width:1200px;margin:0 auto;padding:0 32px}
  .oga-container-narrow{max-width:860px;margin:0 auto;padding:0 32px}

  /* ── ANIMATIONS ── */
  @keyframes oga-fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
  @keyframes oga-pulseDot{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:.5}}
  @keyframes oga-shimmer{0%,100%{opacity:.5}50%{opacity:1}}
  .oga-fade-up{animation:oga-fadeUp .7s ease both}
  .oga-fade-up-1{animation-delay:.12s}
  .oga-fade-up-2{animation-delay:.24s}
  .oga-fade-up-3{animation-delay:.36s}
  .oga-fade-up-4{animation-delay:.48s}

  /* ── SUBNAV ── */
  .oga-subnav{background:rgba(255,255,255,.97);backdrop-filter:blur(14px);border-bottom:1px solid var(--oga-border);overflow-x:auto;scrollbar-width:none;position:sticky;top:0;z-index:150}
  .oga-subnav::-webkit-scrollbar{display:none}
  .oga-subnav-inner{display:flex;padding:0 32px;min-width:max-content}
  .oga-subnav-inner a{display:block;padding:12px 16px;font-size:12px;font-weight:700;color:var(--oga-muted2);border-bottom:2px solid transparent;white-space:nowrap;transition:all .2s;text-transform:uppercase;letter-spacing:.08em}
  .oga-subnav-inner a:hover,.oga-subnav-inner a.oga-active{color:var(--oga-dark);border-bottom-color:var(--oga-accent)}

  /* ── BUTTONS ── */
  .oga-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:14px 32px;font-size:15px;font-weight:700;border-radius:50px;transition:all .25s;border:2px solid transparent;cursor:pointer;font-family:'Inter',sans-serif;letter-spacing:.01em;white-space:nowrap;text-decoration:none!important;color:#fff!important}
  .oga-btn-dark{background:var(--oga-dark);color:#fff!important;border-color:var(--oga-dark)}
  .oga-btn-dark:hover{background:#1c1c1a;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.16);color:#fff!important}
  .oga-btn-warm{background:var(--oga-accent);color:#fff!important;border-color:var(--oga-accent)}
  .oga-btn-warm:hover{background:var(--oga-accent-h);transform:translateY(-2px);box-shadow:var(--oga-gold-glow);color:#fff!important}
  .oga-btn-outline{background:transparent;color:var(--oga-dark)!important;border-color:var(--oga-border2)}
  .oga-btn-outline:hover{border-color:var(--oga-dark);background:var(--oga-surface);color:var(--oga-dark)!important}
  .oga-btn-ghost{background:transparent;color:#fff!important;border:2px solid rgba(255,255,255,.5)}
  .oga-btn-ghost:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.85);color:#fff!important}
  .oga-btn-sm{padding:10px 24px;font-size:14px}

  /* ── HERO ── */
  .oga-hero{position:relative;min-height:90vh;display:flex;align-items:center;overflow:hidden;background:#06060a}
  .oga-hero-bg{position:absolute;inset:0;z-index:0}
  .oga-hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:.28;mix-blend-mode:luminosity}
  .oga-hero-overlay{position:absolute;inset:0;background:linear-gradient(108deg,rgba(6,6,10,.96) 0%,rgba(6,6,10,.72) 55%,rgba(6,6,10,.45) 100%);z-index:1}
  .oga-hero-glow{position:absolute;width:650px;height:650px;border-radius:50%;background:radial-gradient(circle,rgba(139,111,71,.12) 0%,transparent 70%);right:-80px;top:-120px;z-index:1;animation:oga-shimmer 7s ease-in-out infinite}
  .oga-hero-content{position:relative;z-index:3;padding:88px 0 96px;width:100%}
  .oga-hero-bc{font-size:12px;color:rgba(255,255,255,.38);margin-bottom:24px}
  .oga-hero-bc a{color:var(--oga-accent);transition:opacity .2s}
  .oga-hero-bc span{margin:0 6px}
  .oga-hero-eye{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--oga-accent);margin-bottom:20px;background:rgba(139,111,71,.1);padding:6px 16px;border-radius:50px;border:1px solid rgba(139,111,71,.22)}
  .oga-hero-eye::before{content:'';display:block;width:6px;height:6px;border-radius:50%;background:var(--oga-accent);animation:oga-pulseDot 2.5s infinite}
  .oga-hero h1{color:#fff;max-width:860px;margin-bottom:20px}
  .oga-hero-gold{background:linear-gradient(135deg,#c9a45a,#e2c47d,#a8824b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .oga-hero-lead{font-size:clamp(17px,1.6vw,21px);color:rgba(255,255,255,.82);max-width:640px;margin-bottom:12px;font-weight:600;line-height:1.62}
  .oga-hero-sub{font-size:15px;color:rgba(255,255,255,.48);max-width:580px;margin-bottom:40px;line-height:1.8}
  .oga-hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:52px}
  .oga-hero-stats{display:flex;border-top:1px solid rgba(255,255,255,.09);padding-top:40px;flex-wrap:wrap;gap:0}
  .oga-hero-stat{padding-right:40px;margin-right:40px;border-right:1px solid rgba(255,255,255,.09)}
  .oga-hero-stat:last-child{border-right:none;margin-right:0}
  .oga-hero-stat-n{font-size:30px;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:4px;letter-spacing:-.04em}
  .oga-hero-stat-l{font-size:11px;color:rgba(255,255,255,.38);text-transform:uppercase;letter-spacing:.12em;font-weight:700}

  /* ── TRUST BAR ── */
  .oga-trust-bar{display:flex;justify-content:center;gap:48px;padding:19px 32px;border-bottom:1px solid var(--oga-border);background:#fff;font-size:13px;font-weight:700;flex-wrap:wrap}
  .oga-trust-item{display:flex;align-items:center;gap:7px;color:var(--oga-muted)}
  .oga-trust-item svg{width:15px;height:15px;fill:var(--oga-accent);flex-shrink:0}

  /* ── SECTION ── */
  .oga-section{padding:88px 0}
  .oga-section-alt{background:var(--oga-surface)}
  .oga-section-label{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--oga-accent);margin-bottom:14px}
  .oga-section-header{margin-bottom:48px}
  .oga-section-header.oga-center{text-align:center}
  .oga-section-header.oga-center .oga-section-label{display:block}
  .oga-section-header h2{margin-bottom:14px}
  .oga-section-header p{font-size:16px;max-width:680px;line-height:1.82}
  .oga-section-header.oga-center p{margin:0 auto}

  /* ── PRODUCT AREA ── */
  .oga-product-head{background:linear-gradient(140deg,#06060a 0%,#130e05 60%,#08080a 100%);border-radius:20px 20px 0 0;padding:40px 48px 0;position:relative;overflow:hidden}
  .oga-product-head::before{content:'';position:absolute;top:-40%;right:-10%;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(139,111,71,.08) 0%,transparent 70%);pointer-events:none}
  .oga-product-head-inner{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding-bottom:40px}
  .oga-product-head h2{color:#fff;font-size:clamp(22px,2.5vw,30px)}
  .oga-product-head p{color:rgba(255,255,255,.45);font-size:14px;max-width:560px;margin-top:6px;line-height:1.72}
  .oga-product-grid-wrap{background:var(--oga-surface);border:1px solid var(--oga-border);border-top:none;border-radius:0 0 20px 20px;padding:32px}
  .oga-product-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28px}

  /* ── PRODUCT CARD ── */
  .oga-product-card{background:#fff;border:1px solid var(--oga-border);border-radius:var(--oga-radius);overflow:hidden;transition:all .35s cubic-bezier(.4,0,.2,1);position:relative;display:flex;flex-direction:column;box-shadow:var(--oga-shadow)}
  .oga-product-card:hover{transform:translateY(-8px);box-shadow:var(--oga-shadow-hover);border-color:rgba(139,111,71,.28)}
  .oga-product-badge{position:absolute;top:14px;left:14px;font-size:10px;font-weight:800;padding:4px 11px;border-radius:50px;text-transform:uppercase;letter-spacing:.1em;z-index:3}
  .oga-badge-flagship{background:linear-gradient(135deg,#1a0f00,#2e1a05);color:var(--oga-accent);border:1px solid rgba(139,111,71,.35)}
  .oga-badge-accent{background:var(--oga-accent);color:#fff}
  .oga-badge-sale{position:absolute;top:14px;right:14px;background:rgba(220,38,38,.9);color:#fff;font-size:10px;font-weight:900;padding:4px 10px;border-radius:50px;z-index:3}
  .oga-prod-gallery{height:300px;background:linear-gradient(145deg,#fafaf8,#f3f1ec);position:relative;overflow:hidden;cursor:pointer}
  .oga-prod-gallery-img{display:none;width:100%;height:100%;object-fit:contain;padding:28px;mix-blend-mode:multiply;transition:transform .45s ease}
  .oga-prod-gallery-img.oga-active{display:block}
  .oga-product-card:hover .oga-prod-gallery-img.oga-active{transform:scale(1.06)}
  .oga-color-swatches{position:absolute;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:7px;z-index:2}
  .oga-swatch{width:22px;height:22px;border-radius:50%;border:2.5px solid transparent;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(0,0,0,.18)}
  .oga-swatch.oga-active{border-color:var(--oga-accent);transform:scale(1.18)}
  .oga-swatch-label{position:absolute;bottom:38px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.72);color:#fff;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;opacity:0;transition:opacity .2s;pointer-events:none}
  .oga-swatch-label.oga-show{opacity:1}
  .oga-prod-body{padding:22px 28px 28px;flex:1;display:flex;flex-direction:column}
  .oga-prod-for{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--oga-accent);background:var(--oga-accent-pale);display:inline-block;padding:3px 9px;border-radius:20px;margin-bottom:10px;border:1px solid rgba(139,111,71,.15)}
  .oga-prod-name{font-size:16px;font-weight:800;line-height:1.3;margin-bottom:8px;color:var(--oga-dark);letter-spacing:-.02em}
  .oga-prod-name a{color:inherit;transition:color .2s}
  .oga-prod-name a:hover{color:var(--oga-accent)}
  .oga-prod-tagline{font-size:13px;color:var(--oga-muted2);line-height:1.6;margin-bottom:14px;font-style:italic}
  .oga-prod-feats{list-style:none;padding:0;margin:0 0 18px;border-top:1px solid var(--oga-border);padding-top:14px;flex:1}
  .oga-prod-feats li{display:flex;align-items:flex-start;gap:6px;font-size:13px;color:var(--oga-muted);padding:3px 0;line-height:1.5}
  .oga-prod-feats li::before{content:'✓';color:var(--oga-accent);font-weight:900;font-size:11px;flex-shrink:0;margin-top:2px}
  .oga-prod-specs-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:18px;background:var(--oga-surface);border-radius:10px;padding:11px 14px}
  .oga-prod-spec{text-align:center}
  .oga-prod-spec-val{font-size:13px;font-weight:800;color:var(--oga-dark);display:block}
  .oga-prod-spec-key{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--oga-muted2);font-weight:600}
  .oga-prod-prices{display:flex;align-items:baseline;gap:8px;margin-bottom:18px;flex-wrap:wrap}
  .oga-price-sale{font-size:24px;font-weight:900;color:var(--oga-dark);letter-spacing:-.025em}
  .oga-price-was{font-size:14px;color:#b0b8c4;text-decoration:line-through;font-weight:500}
  .oga-price-save{font-size:12px;font-weight:800;color:#15803d;background:rgba(21,128,61,.08);padding:2px 8px;border-radius:20px}
  .oga-prod-cta{display:block;text-align:center;background:var(--oga-dark);color:#fff!important;padding:13px;border-radius:11px;font-weight:700;font-size:14px;transition:all .25s;letter-spacing:.02em;text-decoration:none!important}
  .oga-prod-cta:hover{background:var(--oga-accent);color:#fff!important;transform:translateY(-1px);box-shadow:var(--oga-gold-glow)}
  .oga-prod-secondary{display:block;text-align:center;color:var(--oga-muted2)!important;font-size:12px;font-weight:600;margin-top:8px;transition:color .2s;text-decoration:none!important}
  .oga-prod-secondary:hover{color:var(--oga-accent)!important}

  /* ── QUICK ANSWER (dark card) ── */
  .oga-quick-answer{background:linear-gradient(135deg,#06060a 0%,#18120a 100%);border-radius:24px;padding:48px;border:1px solid rgba(139,111,71,.13);position:relative;overflow:hidden}
  .oga-quick-answer::before{content:'';position:absolute;top:-30%;right:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(139,111,71,.05) 0%,transparent 70%);pointer-events:none}
  .oga-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:32px;position:relative;z-index:1}
  .oga-qa-item{background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.065);border-radius:14px;padding:24px;transition:all .3s}
  .oga-qa-item:hover{background:rgba(255,255,255,.065);border-color:rgba(139,111,71,.22)}
  .oga-qa-item h3{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--oga-accent);margin-bottom:10px;font-weight:800;line-height:1.3}
  .oga-qa-item p{font-size:14px;color:rgba(255,255,255,.62);line-height:1.78;margin:0}

  /* ── PILLARS ── */
  .oga-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .oga-pillar-card{background:#fff;border:1px solid var(--oga-border);border-radius:var(--oga-radius);padding:32px;transition:all .3s;position:relative;overflow:hidden}
  .oga-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--oga-accent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .oga-pillar-card:hover{transform:translateY(-5px);box-shadow:var(--oga-shadow)}
  .oga-pillar-card:hover::before{transform:scaleX(1)}
  .oga-pillar-icon{width:48px;height:48px;background:var(--oga-accent-pale);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:18px}
  .oga-pillar-icon svg{width:24px;height:24px;fill:var(--oga-accent)}
  .oga-pillar-card h3{font-size:15px;margin-bottom:8px}
  .oga-pillar-card p{font-size:14px;color:var(--oga-muted);margin:0;line-height:1.72}

  /* ── FEATURE VISUAL SECTION ── */
  .oga-fv-wrap{background:linear-gradient(140deg,#06060a 0%,#130e05 55%,#0a0a08 100%);border-radius:28px;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;position:relative;border:1px solid rgba(139,111,71,.12);box-shadow:0 32px 80px rgba(0,0,0,.22)}
  .oga-fv-glow{position:absolute;inset:0;background:radial-gradient(ellipse at 70% 50%,rgba(139,111,71,.07) 0%,transparent 65%);pointer-events:none;z-index:0}
  .oga-fv-left{padding:56px 48px;position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center}
  .oga-fv-item{display:flex;align-items:flex-start;gap:14px;padding:16px 18px;background:rgba(255,255,255,.04);border:1px solid rgba(139,111,71,.14);border-radius:12px;transition:all .3s;margin-bottom:18px}
  .oga-fv-item:hover{background:rgba(139,111,71,.08)}
  .oga-fv-item:last-of-type{margin-bottom:0}
  .oga-fv-icon{width:38px;height:38px;background:rgba(139,111,71,.15);border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .oga-fv-icon svg{width:18px;height:18px;fill:#c9a45a}
  .oga-fv-label{font-size:12px;font-weight:800;color:var(--oga-accent);text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px}
  .oga-fv-desc{font-size:13px;color:rgba(255,255,255,.62);line-height:1.65;margin:0}
  .oga-fv-right{position:relative;overflow:hidden;min-height:580px}
  .oga-fv-right img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .6s ease}
  .oga-fv-right:hover img{transform:scale(1.04)}
