<script>
/* ── Color / Image Switcher ── */
function ogaSwitchColor(handle, idx, swatchEl) {
  var gallery = document.getElementById('oga-gallery-' + handle);
  if (!gallery) return;
  gallery.querySelectorAll('.oga-prod-gallery-img').forEach(function(img) {
    img.classList.remove('oga-active');
  });
  var target = document.getElementById('oga-img-' + handle + '-' + idx);
  if (target) target.classList.add('oga-active');
  gallery.querySelectorAll('.oga-swatch').forEach(function(s) { s.classList.remove('oga-active'); });
  swatchEl.classList.add('oga-active');
  var label = document.getElementById('oga-swatch-label-' + handle);
  if (label) {
    label.textContent = swatchEl.getAttribute('data-label');
    label.classList.add('oga-show');
    clearTimeout(window['_ogaSwTimer_' + handle]);
    window['_ogaSwTimer_' + handle] = setTimeout(function() {
      label.classList.remove('oga-show');
    }, 2200);
  }
}

/* ── FAQ Accordion ── */
function ogaToggleFaq(btn) {
  var a = btn.nextElementSibling;
  var isOpen = a.classList.contains('oga-faq-show');
  document.querySelectorAll('.oga-faq-a').forEach(function(x) { x.classList.remove('oga-faq-show'); });
  document.querySelectorAll('.oga-faq-q').forEach(function(x) { x.classList.remove('oga-faq-open'); });
  if (!isOpen) { a.classList.add('oga-faq-show'); btn.classList.add('oga-faq-open'); }
}

/* ── Subnav Scroll Spy ── */
(function() {
  var links = document.querySelectorAll('#ogaSubnav .oga-subnav-inner a');
  var ids = ['oga-shop','oga-hero','oga-why','oga-models','oga-buyers','oga-vs','oga-pricing','oga-trust','oga-showrooms','oga-faq'];
  window.addEventListener('scroll', function() {
    var pos = window.scrollY + 180, active = '';
    ids.forEach(function(id) {
      var el = document.getElementById(id);
      if (el && pos >= el.offsetTop) active = id;
    });
    links.forEach(function(l) {
      l.classList.remove('oga-active');
      if (l.getAttribute('href') === '#' + active) l.classList.add('oga-active');
    });
  });
})();
</script>

