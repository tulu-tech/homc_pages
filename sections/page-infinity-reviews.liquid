<script>
// Review category toggle
function hcmOrToggle(el){
  var body=el.nextElementSibling;
  var isOpen=body.classList.contains('open');
  el.classList.toggle('active',!isOpen);
  body.classList.toggle('open',!isOpen);
}
// Rating bar animation
(function(){
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.querySelectorAll('.hcm-or-bar').forEach(function(bar){bar.style.width=bar.dataset.width+'%';});
        obs.unobserve(e.target);
      }
    });
  },{threshold:0.3});
  var rc=document.getElementById('ratingChart');
  if(rc) obs.observe(rc);
})();
// Subnav active
(function(){
  var links=document.querySelectorAll('.hcm-or-nav a');
  var ids=['overview','verdict','best-model','compare','features','quality','ratings','themes','model-summaries','space-fit','warranty','pros-cons','best-for','buyer-reviews','editorial','timeline','showrooms','faq'];
  window.addEventListener('scroll',function(){
    var pos=window.scrollY+160;var active='';
    ids.forEach(function(id){var el=document.getElementById(id);if(el&&pos>=el.offsetTop) active=id;});
    links.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+active) l.classList.add('active');});
  });
})();
// Scroll reveal
(function(){
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){e.target.style.opacity='1';e.target.style.transform='translateY(0)';obs.unobserve(e.target);}
    });
  },{threshold:0.1});
  document.querySelectorAll('.hcm-or-cat,.hcm-or-buyer,.hcm-or-pros,.hcm-or-cons,.hcm-or-fit,.hcm-or-showroom,.hcm-or-tl').forEach(function(el){
    el.style.opacity='0';el.style.transform='translateY(20px)';el.style.transition='opacity 0.5s ease, transform 0.5s ease';obs.observe(el);
  });
})();
</script>

