}
@media(max-width:760px) {
  .hcm-vs-wrap,.hcm-vs-wrap-sm { padding:0 22px; }
  .hcm-vs-section { padding:72px 0; }
  .hcm-vs-hero-inner { padding:64px 22px 56px; }
  .hcm-vs-hero { min-height:auto; }
  .hcm-vs-hero-content { max-width:100%; }
  .hcm-vs-hero h1 { font-size:38px; }
  .hcm-vs-btn { width:100%; }
  .hcm-vs-hero-trust { grid-template-columns:1fr; }
  .hcm-vs-strip-inner { grid-template-columns:1fr; padding:18px 22px; gap:8px; }
  .hcm-vs-nav { display:none; }
  .hcm-vs-card-grid { grid-template-columns:1fr; }
  .hcm-vs-pers,.hcm-vs-price-card,.hcm-vs-quiz { padding:28px; }
  .hcm-vs-pers h2 { font-size:28px; }
  .hcm-vs-checklist,.hcm-vs-locations { grid-template-columns:1fr; }
  .hcm-vs-showroom-img,.hcm-vs-showroom-img img { min-height:300px; }
  .hcm-vs-showroom-copy { padding:34px 28px; }
  .hcm-vs-stepbar { grid-template-columns:1fr 1fr; }
