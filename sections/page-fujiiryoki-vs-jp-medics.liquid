.hcm-vs-checklist li { padding:12px 14px 12px 38px; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.10); border-radius:10px; color:#fff; font-size:12.5px; line-height:1.45; position:relative; }
.hcm-vs-checklist li:before { content:""; position:absolute; left:14px; top:16px; width:12px; height:6px; border-left:2px solid var(--gold-3); border-bottom:2px solid var(--gold-3); transform:rotate(-45deg); }
.hcm-vs-locations { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin:28px 0; }
.hcm-vs-location { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:20px; }
.hcm-vs-location h3 { color:#fff; font-size:15.5px; margin-bottom:6px; }
.hcm-vs-location p { color:rgba(255,255,255,.58); font-size:12.5px; line-height:1.55; }

.hcm-vs-stepbar { display:grid; grid-template-columns:repeat(6,1fr); background:linear-gradient(135deg,#0a0a0c 0%,#1a140d 100%); border-radius:24px; overflow:hidden; box-shadow:var(--shadow-lift); }
.hcm-vs-step { padding:32px 18px; text-align:center; border-right:1px solid rgba(255,255,255,.06); }
.hcm-vs-step:last-child { border-right:0; }
.hcm-vs-step b { display:flex; align-items:center; justify-content:center; width:48px; height:48px; margin:0 auto 16px; border-radius:50%; color:var(--gold-3); background:rgba(217,189,126,.10); border:1px solid rgba(217,189,126,.28); font-family:"Playfair Display",serif; font-size:16px; font-weight:900; }
.hcm-vs-step strong { display:block; color:#fff; font-size:13px; margin-bottom:6px; }
.hcm-vs-step span { display:block; color:rgba(255,255,255,.5); font-size:11.5px; line-height:1.5; }

.hcm-vs-quiz { background:#fff; border:1px solid var(--line); border-radius:28px; padding:50px; box-shadow:var(--shadow-soft); position:relative; overflow:hidden; }
.hcm-vs-quiz:before { content:""; position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg,var(--gold) 0%,var(--gold) 50%,var(--green) 50%,var(--green) 100%); }
.hcm-vs-quiz-head { max-width:780px; margin:0 auto 38px; padding-bottom:36px; border-bottom:1px solid var(--line); text-align:center; }
.hcm-vs-quiz-head .hcm-vs-eyebrow { justify-content:center; }
