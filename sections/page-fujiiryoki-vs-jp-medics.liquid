.hcm-vs-quiz-card-best { display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border-radius:999px; background:var(--gold-soft); color:var(--gold); font-size:10px; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px; width:fit-content; }
.hcm-vs-quiz-card.kyota .hcm-vs-quiz-card-best { background:var(--green-soft); color:var(--green); }
.hcm-vs-quiz-card h4 { font-family:"Playfair Display",serif; font-size:19px; font-weight:800; line-height:1.2; margin-bottom:12px; color:var(--ink); }
.hcm-vs-quiz-card ul { display:grid; gap:6px; margin-bottom:16px; }
.hcm-vs-quiz-card ul li { color:var(--muted); font-size:12.5px; line-height:1.5; padding-left:16px; position:relative; }
.hcm-vs-quiz-card ul li:before { content:""; position:absolute; left:0; top:7px; width:8px; height:2px; background:var(--gold); }
.hcm-vs-quiz-card.kyota ul li:before { background:var(--green); }
.hcm-vs-quiz-card-why { margin:0 0 14px; padding:12px 14px; background:#fbf9f4; border:1px dashed var(--line); border-radius:12px; }
.hcm-vs-quiz-card-why small { display:inline-flex; align-items:center; gap:6px; color:var(--gold); font-size:9.5px; font-weight:900; letter-spacing:.16em; text-transform:uppercase; margin-bottom:8px; }
