.hcm-vs-quote.kyota:before { background:var(--green); }
.hcm-vs-quote-avatar { display:flex; align-items:center; justify-content:center; width:60px; height:60px; border-radius:50%; background:linear-gradient(145deg,var(--gold-soft) 0%,#f0e2c0 100%); color:var(--gold); font-family:"Playfair Display",serif; font-weight:900; font-size:22px; flex-shrink:0; border:2px solid #fff; box-shadow:0 6px 14px rgba(154,128,80,.16); }
.hcm-vs-quote.kyota .hcm-vs-quote-avatar { background:linear-gradient(145deg,var(--green-soft) 0%,#cfdfd4 100%); color:var(--green); }
