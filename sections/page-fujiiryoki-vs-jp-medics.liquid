.hcm-vs-quote-tag { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:14px; }
.hcm-vs-quote-tag span { padding:4px 10px; border-radius:6px; background:#f7f3eb; color:var(--soft); font-size:10px; font-weight:850; letter-spacing:.10em; text-transform:uppercase; border:1px solid var(--line); }
