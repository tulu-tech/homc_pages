      } else {
        html += '<div class="hcm-vs-quiz-results-grid">';
        matches.forEach(function(p,i){
          var brandClass = (p.brand === 'Fujiiryoki') ? '' : 'kyota';
          var btnClass = (p.brand === 'Fujiiryoki') ? 'gold' : 'green';
          var hits = reasons(p, ans);
          html += '<article class="hcm-vs-quiz-card ' + brandClass + (i===0 ? ' top' : '') + '">';
          if (i === 0 && matches.length > 1) html += '<span class="hcm-vs-quiz-card-flag">Top Pick</span>';
          html += '<div class="hcm-vs-quiz-card-img"><span class="hcm-vs-quiz-card-brand">' + p.brand + '</span><img src="' + p.img + '" alt="' + p.name + '" loading="lazy"></div>';
          html += '<div class="hcm-vs-quiz-card-body">';
          html += '<span class="hcm-vs-quiz-card-best">' + p.best + '</span>';
          html += '<h4>' + p.name + '</h4>';
          html += '<ul>';
          p.features.forEach(function(f){ html += '<li>' + f + '</li>'; });
          html += '</ul>';
          if (hits.length){
            html += '<div class="hcm-vs-quiz-card-why"><small>Why this fits:</small><div class="hcm-vs-quiz-why-tags">';
            hits.forEach(function(h){ html += '<span>' + h + '</span>'; });
            html += '</div></div>';
          }
          html += '<div class="hcm-vs-quiz-card-foot"><strong>' + p.price + '</strong><a class="hcm-vs-btn small ' + btnClass + '" href="' + p.url + '">View Details <span class="hcm-vs-btn-arrow">→</span></a></div>';
          html += '</div></article>';
        });
