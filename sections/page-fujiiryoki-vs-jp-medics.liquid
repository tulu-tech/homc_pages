.hcm-vs-q-options label:has(input:checked) { background:linear-gradient(135deg,var(--gold-soft) 0%,#f0e2c0 100%); border-color:var(--gold); color:var(--gold); }
.hcm-vs-quiz-cta { margin-top:30px; display:flex; justify-content:center; flex-wrap:wrap; gap:12px; padding-top:30px; border-top:1px solid var(--line); }
.hcm-vs-quiz-cta-btn { font-size:14.5px; min-height:56px; padding:16px 36px; }
.hcm-vs-quiz-results { margin-top:32px; padding-top:36px; border-top:1px solid var(--line); animation:hcm-vs-fade .45s ease; }
@keyframes hcm-vs-fade { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
.hcm-vs-quiz-results-head { text-align:center; max-width:720px; margin:0 auto 32px; }
.hcm-vs-quiz-results-head .hcm-vs-eyebrow { justify-content:center; }
.hcm-vs-quiz-results-head h3 { font-family:"Playfair Display",serif; font-size:30px; margin-bottom:10px; line-height:1.1; }
.hcm-vs-quiz-results-head p { color:var(--muted); font-size:15px; line-height:1.6; }
.hcm-vs-quiz-results-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:18px; }
.hcm-vs-quiz-card { background:#fff; border:1.5px solid var(--line); border-radius:20px; padding:18px; display:flex; flex-direction:column; transition:all .35s ease; position:relative; overflow:hidden; }
