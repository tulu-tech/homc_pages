      '10plus': { label:'$10K+', subtitle:'Flagship comparison tier — top dual-mechanism and premium chairs.' }
    };
    var ANSWER_MAP = {
      feel:     { deep:'deep', balanced:'balanced', relax:'relax' },
      height:   { tall:'tall', average:'average', petite:'petite' },
      footcalf: { footcalf:'footcalf', neutral:null, back:null },
      tech:     { tech:'tech', simple:'simple', balanced:'balanced' },
      usage:    { flagship:'flagship', daily:'daily', balanced:'balanced' }
    };
    var WEIGHTS = { feel:2, height:2, footcalf:2, tech:1, usage:1 };
    function score(p, ans){
      if (!p.tags) return 0;
      var s = 0;
      Object.keys(WEIGHTS).forEach(function(k){
        var v = ans[k]; if (!v) return;
        var tag = ANSWER_MAP[k] && ANSWER_MAP[k][v];
        if (tag && p.tags.indexOf(tag) !== -1) s += WEIGHTS[k];
      });
      return s;
    }
    function reasons(p, ans){
      var hits = [];
