.hcm-vs-quiz-card.top.kyota { border-color:var(--green); }
.hcm-vs-quiz-card-flag { position:absolute; top:14px; right:14px; z-index:4; padding:5px 12px; border-radius:999px; background:linear-gradient(135deg,var(--gold-2) 0%,var(--gold) 100%); color:#fff; font-size:10px; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
.hcm-vs-quiz-card.kyota .hcm-vs-quiz-card-flag { background:linear-gradient(135deg,var(--green-2) 0%,var(--green) 100%); }
.hcm-vs-quiz-card-img { position:relative; aspect-ratio:1/1; background:linear-gradient(180deg,#fdfaf2 0%,var(--gold-soft) 100%); border-radius:14px; padding:14px; margin-bottom:16px; overflow:hidden; }
.hcm-vs-quiz-card.kyota .hcm-vs-quiz-card-img { background:linear-gradient(180deg,#f4f8f5 0%,var(--green-soft) 100%); }
.hcm-vs-quiz-card-img img { width:100%; height:100%; object-fit:contain; }
.hcm-vs-quiz-card-brand { position:absolute; top:10px; left:10px; padding:5px 11px; border-radius:999px; background:rgba(255,255,255,.95); border:1px solid var(--line); color:var(--gold); font-size:10px; font-weight:900; letter-spacing:.18em; text-transform:uppercase; }
