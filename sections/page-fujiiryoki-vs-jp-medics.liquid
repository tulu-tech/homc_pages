.hcm-vs-quiz-card.kyota .hcm-vs-quiz-why-tags span { background:var(--green-soft); color:var(--green); }
.hcm-vs-quiz-card-foot { display:flex; justify-content:space-between; align-items:center; gap:10px; padding-top:14px; border-top:1px solid var(--line); margin-top:auto; }
.hcm-vs-quiz-card-foot strong { font-family:"Playfair Display",serif; font-size:20px; color:var(--ink); }
.hcm-vs-quiz-card-foot .hcm-vs-btn { padding:10px 14px; min-height:38px; font-size:11.5px; }
.hcm-vs-quiz-results-foot { margin-top:30px; padding:24px 28px; border-radius:18px; background:linear-gradient(135deg,#fbf9f4 0%,#fff 100%); border:1px dashed var(--line); display:flex; justify-content:space-between; align-items:center; gap:18px; flex-wrap:wrap; }
.hcm-vs-quiz-results-foot p { color:var(--muted); font-size:14px; max-width:460px; line-height:1.55; }
.hcm-vs-quiz-empty { text-align:center; padding:40px 20px; background:#fbf9f4; border-radius:18px; border:1px dashed var(--line); }

.hcm-vs-faq { display:grid; gap:12px; }
.hcm-vs-faq details { background:#fff; border:1px solid var(--line); border-radius:16px; box-shadow:0 4px 14px rgba(0,0,0,.03); transition:all .25s ease; }
.hcm-vs-faq details:hover { border-color:var(--gold); }
.hcm-vs-faq details[open] { box-shadow:var(--shadow-soft); border-color:var(--gold); }
.hcm-vs-faq summary { cursor:pointer; list-style:none; padding:22px 26px; color:var(--ink); font-size:15.5px; font-weight:850; line-height:1.4; display:flex; justify-content:space-between; align-items:flex-start; gap:18px; }
.hcm-vs-faq summary::-webkit-details-marker { display:none; }
.hcm-vs-faq summary:after { content:"+"; flex-shrink:0; color:var(--gold); font-size:24px; line-height:1; margin-top:-2px; transition:transform .25s ease; width:28px; height:28px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--gold-soft); }
.hcm-vs-faq details[open] summary:after { content:"−"; transform:rotate(180deg); background:var(--gold); color:#fff; }
.hcm-vs-faq div.answer { padding:0 26px 24px; }
.hcm-vs-faq div.answer p { font-size:14.5px; line-height:1.75; }
.hcm-vs-faq a { color:var(--gold); text-decoration:underline; text-underline-offset:3px; font-weight:700; }
.hcm-vs-disclaimer { margin-top:28px; background:linear-gradient(135deg,var(--gold-soft) 0%,#fff 100%); border:1px solid var(--line); border-radius:16px; padding:20px 24px; color:var(--osaki-deep); font-size:13px; line-height:1.7; display:flex; gap:14px; align-items:flex-start; }
.hcm-vs-disclaimer:before { content:"!"; flex-shrink:0; display:inline-flex; align-items:center; justify-content:center; width:24px; height:24px; border-radius:50%; background:var(--gold); color:#fff; font-weight:900; font-size:12px; }

.hcm-vs-final { background:linear-gradient(135deg,#050509 0%,#15110a 50%,#1a140d 100%); color:#fff; text-align:center; padding:120px 0 110px; position:relative; overflow:hidden; }
.hcm-vs-final:before { content:""; position:absolute; inset:0; background:radial-gradient(900px 600px at 50% -10%,rgba(196,164,100,.20),transparent 70%),radial-gradient(700px 500px at 80% 100%,rgba(108,141,124,.14),transparent 70%); }
.hcm-vs-final-eyebrow { display:inline-flex; align-items:center; gap:10px; color:var(--gold-3); font-size:11px; font-weight:900; letter-spacing:.30em; text-transform:uppercase; margin-bottom:22px; }
.hcm-vs-final-eyebrow:before,.hcm-vs-final-eyebrow:after { content:""; display:inline-block; width:30px; height:1px; background:var(--gold-3); }
.hcm-vs-final h2 { color:#fff; font-size:clamp(34px,4vw,58px); margin-bottom:18px; position:relative; line-height:1.05; }
.hcm-vs-final h2 em { color:var(--gold-3); font-style:italic; font-weight:800; }
.hcm-vs-final p { color:rgba(255,255,255,.74); font-size:17.5px; max-width:760px; margin:0 auto 36px; position:relative; line-height:1.7; }
.hcm-vs-final .hcm-vs-btns { justify-content:center; position:relative; }

.hcm-vs-mobile-cta { display:none; }

@media(max-width:1080px) {
  .hcm-vs-hero-inner { padding:88px 44px 80px; }
  .hcm-vs-hero-bg:after { background:linear-gradient(180deg,rgba(6,6,10,.78) 0%,rgba(8,8,12,.86) 50%,rgba(12,10,8,.94) 100%),radial-gradient(900px 600px at 50% 20%,rgba(196,164,100,.16),transparent 65%); }
  .hcm-vs-hero-bg:before { background-position:center center; }
  .hcm-vs-pers-grid,.hcm-vs-verdict-grid,.hcm-vs-score-grid,.hcm-vs-quote-grid,.hcm-vs-price-grid { grid-template-columns:1fr; }
  .hcm-vs-card-grid { grid-template-columns:repeat(2,1fr); }
  .hcm-vs-showroom { grid-template-columns:1fr; }
  .hcm-vs-stepbar { grid-template-columns:repeat(3,1fr); }
  .hcm-vs-q-options-4 { grid-template-columns:repeat(2,1fr); }
  .hcm-vs-expert-note { grid-template-columns:1fr; text-align:center; }
  .hcm-vs-expert-note .badge { margin:0 auto; }
