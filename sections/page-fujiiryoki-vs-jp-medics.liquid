.hcm-vs-showroom-img:after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,transparent 50%,rgba(5,5,9,.6) 100%); }
.hcm-vs-showroom-img-stamp { position:absolute; top:24px; left:24px; z-index:2; padding:8px 14px; border-radius:999px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.22); backdrop-filter:blur(10px); color:#fff; font-size:10.5px; font-weight:900; letter-spacing:.22em; text-transform:uppercase; display:inline-flex; align-items:center; gap:8px; }
