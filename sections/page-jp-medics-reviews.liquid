<script>
function tog(el){var b=el.nextElementSibling;var o=b.classList.contains('open');el.classList.toggle('active',!o);b.classList.toggle('open',!o);}
(function(){var obs=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.querySelectorAll('.bar').forEach(function(b){b.style.width=b.dataset.width+'%';});obs.unobserve(x.target);}});},{threshold:0.3});var r=document.getElementById('ratingChart');if(r)obs.observe(r);})();
(function(){var links=document.querySelectorAll('.nav a');var ids=['overview','verdict','guide','compare','kozue','kaze','price','ratings','themes','reviews','try','brands','checklist','pros-cons','best-for','buyer-reviews','editorial','timeline','showrooms','faq'];window.addEventListener('scroll',function(){var pos=window.scrollY+160;var a='';ids.forEach(function(id){var el=document.getElementById(id);if(el&&pos>=el.offsetTop)a=id;});links.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+a)l.classList.add('active');});});})();
(function(){var obs=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.style.opacity='1';x.target.style.transform='translateY(0)';obs.unobserve(x.target);}});},{threshold:0.1});document.querySelectorAll('.cat,.bu,.pros,.cons,.fit,.sc,.te').forEach(function(el){el.style.opacity='0';el.style.transform='translateY(20px)';el.style.transition='opacity 0.5s ease, transform 0.5s ease';obs.observe(el);});})();
</script>



