<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,800;1,700;1,800&display=swap');

/* ============================================================
   SHOPIFY CONTAINER OVERRIDES
   ============================================================ */
.template-page main,
.template-page #MainContent,
.template-page .page-width,
.template-page .container,
.template-page .main-content { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }

.template-page .site-footer,
.template-page footer.footer,
.template-page .footer:not(.plstn-footer),
.template-page #shopify-section-footer,
.template-page [id^="shopify-section"][id$="footer"],
.template-page .site-footer__inner { display: none !important; }

.template-page .content-for-layout { padding-top: 0 !important; margin-top: 0 !important; }

/* Full-bleed for Shopify theme container */
.plstn-hero,
.plstn-statsbar,
.plstn-section,
.plstn-section-alt,
.plstn-darkstrip,
.plstn-ctaband,
.plstn-finalcta,
.plstn-footer {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}

/* ============================================================
   BASE STYLES — ABSOLUTE px UNITS (prevent theme inheritance)
   ============================================================ */
.plstn {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 16px;
  line-height: 1.75;
  color: #1a1a1a;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;

  /* CSS Variables */
  --gold:        #9a8050;
  --gold-h:      #7d6840;
  --gold-warm:   #c4a464;
  --gold-pale:   rgba(154,128,80,0.10);
  --ink:         #0d0d0d;
  --surface:     #f4f1ed;
  --muted:       #5c5c5c;
  --muted2:      #909090;
  --border:      #e4e0d8;
  --radius:      18px;
  --radius-sm:   10px;
  --shadow:      0 6px 24px rgba(0,0,0,0.07);
  --shadow-lg:   0 18px 48px rgba(0,0,0,0.13);
  --ease:        cubic-bezier(0.25,0.8,0.25,1);
  --trans:       all 0.28s cubic-bezier(0.25,0.8,0.25,1);
}

/* Hard reset scoped only to .plstn */
.plstn *, .plstn *::before, .plstn *::after { box-sizing: border-box; }
.plstn h1,.plstn h2,.plstn h3,.plstn h4,.plstn h5,.plstn h6,
.plstn p,.plstn ul,.plstn ol,.plstn li,.plstn figure,.plstn blockquote {
  margin: 0; padding: 0;
}
.plstn ul,.plstn ol { list-style: none; }
.plstn a { text-decoration: none; color: inherit; }
.plstn img { max-width: 100%; display: block; border: 0; }
.plstn table { border-collapse: collapse; }

/* Typography */
.plstn h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(36px, 5vw, 64px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
}
.plstn h2 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(26px, 3vw, 42px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.025em;
}
.plstn h3 {
  font-family: 'Inter', sans-serif;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.3;
}
.plstn h4 {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.plstn p { font-size: 15px; line-height: 1.8; color: var(--muted); }

/* Layout helpers */
.plstn-wrap    { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.plstn-wrap-sm { max-width: 880px;  margin: 0 auto; padding: 0 40px; }
.plstn-section,
.plstn-section-alt { padding: 80px 0; }
.plstn-section-alt { background: var(--surface); }

/* Eyebrow label */
.plstn-eyebrow {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.plstn-eyebrow-light { color: var(--gold-warm); }

/* Section heading block */
.plstn-hd { margin-bottom: 48px; }
.plstn-hd.ctr { text-align: center; }
.plstn-hd p { font-size: 17px; color: var(--muted); line-height: 1.8; margin-top: 12px; max-width: 680px; }
.plstn-hd.ctr p { margin-left: auto; margin-right: auto; }

/* ─── BUTTONS ─────────────────────────────────────────────── */
.plstn-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 32px;
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.01em;
  border-radius: 50px;
  border: 2px solid transparent;
  text-decoration: none !important;
  cursor: pointer;
  white-space: nowrap;
  transition: var(--trans);
}
.plstn-btn svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }

.plstn-btn-gold  { background: var(--gold);  color: #fff !important; border-color: var(--gold); }
.plstn-btn-gold:hover { background: var(--gold-h); border-color: var(--gold-h); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(154,128,80,0.38); }

.plstn-btn-dark  { background: var(--ink);   color: #fff !important; border-color: var(--ink); }
.plstn-btn-dark:hover { background: #222; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.22); }

.plstn-btn-ghost {
  background: rgba(255,255,255,0.10);
  color: #fff !important;
  border: 2px solid rgba(255,255,255,0.60);
}
.plstn-btn-ghost:hover {
  background: rgba(255,255,255,0.20);
  border-color: rgba(255,255,255,0.95);
  color: #fff !important;
}

/* ─── STICKY CTAs ─────────────────────────────────────────── */
#plstn-sticky {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 9000;
  display: flex;
  flex-direction: column;
  gap: 10px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
#plstn-sticky.visible { opacity: 1; pointer-events: all; }
.plstn-sticky-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 22px;
  border-radius: 50px;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  text-decoration: none !important;
  box-shadow: 0 8px 28px rgba(0,0,0,0.30);
  transition: var(--trans);
  cursor: pointer;
}
.plstn-sticky-btn svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
.plstn-sticky-call { background: var(--ink); color: #fff !important; }
.plstn-sticky-call:hover { background: #222; transform: translateY(-2px); color: #fff !important; }
.plstn-sticky-dir  { background: var(--gold); color: #fff !important; }
.plstn-sticky-dir:hover { background: var(--gold-h); transform: translateY(-2px); color: #fff !important; }

/* ─── HERO ────────────────────────────────────────────────── */
.plstn-hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  background: #06060e;
  overflow: hidden;
}
.plstn-hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.plstn-hero-bg img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 30%;
  display: block;
  filter: brightness(0.40) saturate(0.80);
  animation: plstnZoom 14s ease-in-out infinite alternate;
}
@keyframes plstnZoom { from { transform: scale(1.00); } to { transform: scale(1.06); } }
.plstn-hero-overlay {
  position: absolute; inset: 0; z-index: 1;
  background:
    linear-gradient(to right, rgba(2,2,10,0.94) 0%, rgba(2,2,10,0.60) 55%, rgba(2,2,10,0.10) 100%),
    linear-gradient(to top,   rgba(2,2,10,0.85) 0%, transparent 55%);
}
.plstn-hero-inner {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 100px 40px 110px;
  max-width: 1200px;
  margin: 0 auto;
}
.plstn-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  background: rgba(255,255,255,0.09);
  border: 1px solid rgba(255,255,255,0.18);
  color: rgba(255,255,255,0.88);
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 6px 16px;
  border-radius: 50px;
  margin-bottom: 24px;
}
.plstn-hero-dot {
  width: 7px; height: 7px;
  background: #4ade80;
  border-radius: 50%;
  flex-shrink: 0;
  animation: plstnPulse 2.2s ease-in-out infinite;
}
@keyframes plstnPulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
.plstn-hero h1 { color: #fff; max-width: 840px; margin-bottom: 20px; }
.plstn-hero h1 em { color: var(--gold-warm); font-style: italic; }
.plstn-hero-lead {
  font-family: 'Inter', sans-serif;
  font-size: 18px;
  color: rgba(255,255,255,0.72);
  line-height: 1.75;
  max-width: 580px;
  margin-bottom: 40px;
}
.plstn-hero-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 40px; }
.plstn-hero-trust {
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.10);
}
.plstn-hero-trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.65);
  font-weight: 600;
}
.plstn-hero-trust-item svg { width: 14px; height: 14px; fill: var(--gold-warm); flex-shrink: 0; }

/* ─── STATS BAR ───────────────────────────────────────────── */
.plstn-statsbar { background: #0a0a0a; }
.plstn-stats-inner {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 1200px;
  margin: 0 auto;
  border-top: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.plstn-stat {
  flex: 1;
  min-width: 160px;
  padding: 28px 32px;
  text-align: center;
  border-right: 1px solid rgba(255,255,255,0.08);
}
.plstn-stat:last-child { border-right: none; }
.plstn-stat-num {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 38px;
  font-weight: 900;
  color: #fff;
  line-height: 1;
  letter-spacing: -0.04em;
}
.plstn-stat-num span { color: var(--gold-warm); }
.plstn-stat-label {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.38);
  margin-top: 8px;
}

/* ─── LOCATION CARD ───────────────────────────────────────── */
.plstn-loccard {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  max-width: 1100px;
  margin: 0 auto;
}
.plstn-loccard-head {
  background: linear-gradient(135deg, #0d0d0d 0%, #1a1610 100%);
  padding: 32px 40px;
}
.plstn-loc-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(255,255,255,0.10);
  border: 1px solid rgba(255,255,255,0.18);
  color: var(--gold-warm);
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 5px 13px;
  border-radius: 50px;
  margin-bottom: 14px;
}
.plstn-loc-badge-dot { width: 6px; height: 6px; background: var(--gold-warm); border-radius: 50%; flex-shrink: 0; }
.plstn-loccard-head-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 800;
  color: #fff;
  line-height: 1;
  letter-spacing: -0.03em;
  margin-bottom: 6px;
}
.plstn-loccard-head-sub {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.50);
  font-weight: 500;
}
.plstn-loccard-body {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
}
.plstn-locinfo { padding: 32px 40px; }
.plstn-locrow {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}
.plstn-locrow:last-child { border-bottom: none; }
.plstn-locicon {
  width: 40px; height: 40px;
  background: var(--gold-pale);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.plstn-locicon svg { width: 18px; height: 18px; fill: var(--gold); }
.plstn-loclabel {
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted2);
  display: block;
  margin-bottom: 4px;
}
.plstn-locval {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  display: block;
  line-height: 1.55;
}
.plstn-locval a { color: var(--ink); font-weight: 600; }
.plstn-locval a:hover { color: var(--gold); }
.plstn-hourtbl { border-collapse: collapse; margin-top: 4px; }
.plstn-hourtbl td {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: var(--muted);
  padding: 3px 0;
}
.plstn-hourtbl td:first-child { font-weight: 700; color: var(--ink); padding-right: 24px; white-space: nowrap; }
.plstn-locsub {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: var(--muted);
  display: block;
  margin-top: 3px;
  line-height: 1.6;
}
.plstn-locmap { position: relative; }
.plstn-locmap iframe { width: 100%; height: 100%; min-height: 360px; border: 0; display: block; }
.plstn-loccta {
  padding: 24px 40px;
  background: var(--surface);
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.plstn-loccta-full {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--ink);
  color: #fff !important;
  padding: 16px 24px;
  border-radius: 50px;
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 700;
  line-height: 1;
  text-decoration: none !important;
  transition: var(--trans);
}
.plstn-loccta-full svg { width: 18px; height: 18px; fill: #fff; flex-shrink: 0; }
.plstn-loccta-full:hover { background: #222; transform: translateY(-1px); color: #fff !important; }
.plstn-loccta-row { display: flex; gap: 12px; }
.plstn-loccta-half {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 16px;
  border-radius: 50px;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  text-decoration: none !important;
  border: 2px solid transparent;
  transition: var(--trans);
  cursor: pointer;
}
.plstn-loccta-half svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
.plstn-half-dir  { background: var(--gold);  color: #fff !important; border-color: var(--gold); }
.plstn-half-dir:hover  { background: var(--gold-h); border-color: var(--gold-h); color: #fff !important; }
.plstn-half-call { background: #fff; color: var(--ink) !important; border-color: #d8d4cc; }
.plstn-half-call:hover { border-color: var(--ink); background: #f0ede8; color: var(--ink) !important; }

/* ─── 2-COL GRID (Why Visit / VS Online) ─────────────────── */
.plstn-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.plstn-img-wrap {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.plstn-img-wrap img {
  width: 100%; height: 540px;
  object-fit: cover;
  object-position: center 20%;
  display: block;
  transition: transform 0.6s ease;
}
.plstn-img-wrap:hover img { transform: scale(1.03); }
.plstn-img-badge {
  position: absolute;
  bottom: 24px; left: 24px; right: 24px;
  background: rgba(6,6,14,0.88);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 14px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.plstn-img-badge-ico {
  width: 36px; height: 36px;
  background: var(--gold);
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.plstn-img-badge-ico svg { width: 18px; height: 18px; fill: #fff; }
.plstn-img-badge strong { display: block; font-family: 'Inter', sans-serif; font-size: 14px; color: #fff; font-weight: 700; }
.plstn-img-badge span   { font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.52); }

/* Reason list cards */
.plstn-reasons { display: flex; flex-direction: column; gap: 14px; margin-top: 28px; }
.plstn-reason {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px 20px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  transition: var(--trans);
}
.plstn-reason:hover { border-color: var(--gold); box-shadow: 0 4px 18px rgba(154,128,80,0.12); }
.plstn-reason-ico {
  width: 40px; height: 40px;
  background: var(--gold-pale);
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.plstn-reason-ico svg { width: 18px; height: 18px; fill: var(--gold); }
.plstn-reason strong {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  font-weight: 700;
