<script>
  // FAQ accordion
  document.querySelectorAll('.plstn-faqitem').forEach(function(item) {
    item.querySelector('.plstn-faqq').addEventListener('click', function() {
      var isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.plstn-faqitem.is-open').forEach(function(o) {
        o.classList.remove('is-open');
        o.querySelector('.plstn-faqbody').style.maxHeight = null;
      });
      if (!isOpen) {
        item.classList.add('is-open');
        var body = item.querySelector('.plstn-faqbody');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });

  // Sticky CTA — show after hero passes
  (function() {
    var sticky = document.getElementById('plstn-sticky');
    var hero   = document.getElementById('plstn-hero');
    if (!sticky || !hero) return;
    function check() {
      if (hero.getBoundingClientRect().bottom < 0) {
        sticky.classList.add('visible');
      } else {
        sticky.classList.remove('visible');
      }
    }
    window.addEventListener('scroll', check, { passive: true });
    check();
  })();
</script>

