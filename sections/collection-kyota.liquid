{%- comment -%} ══════════ JAVASCRIPT ══════════ {%- endcomment -%}
<script>
// ─── DYNAMIC PRODUCT DATA FROM LIQUID ─────────────────────────────────────
var KYO_PRODUCTS = [
  {%- for product in collection.products -%}
    {%- assign feat_img = product.featured_image | image_url: width: 600 -%}
    {%- assign sale_price_cents = product.price -%}
    {%- assign compare_price_cents = product.compare_at_price -%}

    {%- comment -%} Build filter tag array {%- endcomment -%}
    {%- assign filter_tags = "" -%}
    {%- for tag in product.tags -%}
      {%- assign tag_low = tag | downcase -%}
      {%- if tag_low == "4d" or tag_low == "ai" or tag_low == "syner-d" or tag_low == "flagship" or tag_low == "genki" or tag_low == "yugana" or tag_low == "hatsumei" or tag_low == "joubu" or tag_low == "nokori" -%}
        {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: "," -%}{%- endif -%}
        {%- assign filter_tags = filter_tags | append: '"' | append: tag_low | append: '"' -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Also detect from title if tags not set {%- endcomment -%}
    {%- assign title_low = product.title | downcase -%}
    {%- if title_low contains 'm980' or title_low contains 'nokori' -%}
      {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: ',' -%}{%- endif -%}
      {%- assign filter_tags = filter_tags | append: '"flagship","syner-d"' -%}
    {%- elsif title_low contains 'm900' or title_low contains 'hatsumei' -%}
      {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: ',' -%}{%- endif -%}
      {%- assign filter_tags = filter_tags | append: '"ai","4d"' -%}
    {%- elsif title_low contains 'm880' or title_low contains 'joubu' -%}
      {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: ',' -%}{%- endif -%}
      {%- assign filter_tags = filter_tags | append: '"4d"' -%}
    {%- elsif title_low contains 'm780' or title_low contains 'yugana' -%}
      {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: ',' -%}{%- endif -%}
      {%- assign filter_tags = filter_tags | append: '"4d"' -%}
    {%- endif -%}

    {%- comment -%} Auto-detect badge {%- endcomment -%}
    {%- assign auto_badge = "" -%}
    {%- assign auto_badge_class = "" -%}
    {%- if product.tags contains "flagship" or title_low contains 'm980' or title_low contains 'nokori' -%}
      {%- assign auto_badge = "Flagship" -%}
      {%- assign auto_badge_class = "flagship" -%}
    {%- elsif product.tags contains "ai" or title_low contains 'm900' or title_low contains 'hatsumei' -%}
      {%- assign auto_badge = "AI" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- elsif product.tags contains "4d" or title_low contains '4d' -%}
      {%- assign auto_badge = "4D" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- elsif title_low contains 'm880' or title_low contains 'joubu' -%}
      {%- assign auto_badge = "4D" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- elsif title_low contains 'm780' or title_low contains 'yugana' -%}
      {%- assign auto_badge = "4D" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- endif -%}

    {%- assign badge_val = product.metafields.custom.badge.value | default: auto_badge -%}
    {%- assign badge_class_val = product.metafields.custom.badge_class.value | default: auto_badge_class -%}
    {%- assign buyer_for_val = product.metafields.custom.buyer_for.value | default: product.type | default: 'Daily Premium Use' -%}

    {%- assign feats_json = product.metafields.custom.key_features.value -%}
    {%- if feats_json == blank -%}
      {%- assign feats_json = '["Premium massage roller technology","Zero gravity positioning","Full body air compression","Strong calf & foot relief"]' -%}
    {%- endif -%}

    {
      n: {{ product.title | json }},
      u: {{ product.url | prepend: shop.url | json }},
      i: {{ feat_img | json }},
      p: {{ product.price | money | json }},
      cp: {% if compare_price_cents > sale_price_cents %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      tags: [{{ filter_tags }}],
      badge: {{ badge_val | json }},
      badgeClass: {{ badge_class_val | json }},
      for: {{ buyer_for_val | json }},
      feats: {{ feats_json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];

// ─── FILTER LOGIC ──────────────────────────────────────────────────────────
var kyoCurrentFilter = {type:'all',value:'all'};

function kyoFilter(btn,type,value){
  document.querySelectorAll('#kyoFilterBar .kyo-filter-btn').forEach(function(b){b.classList.remove('active')});
  btn.classList.add('active');
  kyoCurrentFilter = {type:type,value:value};
  kyoRenderProducts();
}

function kyoFilteredProducts(){
  return KYO_PRODUCTS.filter(function(p){
    if(kyoCurrentFilter.type==='all') return true;
    if(kyoCurrentFilter.type==='price'){
      var num = parseFloat(p.p.replace(/[^0-9.]/g,''));
      if(kyoCurrentFilter.value==='under5') return num<5000;
      if(kyoCurrentFilter.value==='5to8') return num>=5000&&num<8000;
      if(kyoCurrentFilter.value==='over8') return num>=8000;
    }
    if(kyoCurrentFilter.type==='type') return p.tags.indexOf(kyoCurrentFilter.value)!==-1;
    return true;
  });
}

function kyoSaveCalc(p,cp){
  if(!cp) return '';
  var ps=parseFloat(p.replace(/[^0-9.]/g,'')),cs=parseFloat(cp.replace(/[^0-9.]/g,''));
  if(cs<=ps) return '';
  var pct=Math.round((cs-ps)/cs*100);
  return '<span class="kyo-price-save">Save '+pct+'%</span>';
}

function kyoRenderProducts(){
  var grid=document.getElementById('kyoGrid');
  var count=document.getElementById('kyoCount');
  var prods=kyoFilteredProducts();
  if(count) count.textContent=prods.length+' model'+(prods.length!==1?'s':'');
  if(!grid) return;

  if(prods.length===0){
    grid.innerHTML='<div class="kyo-no-results"><p>No models match this filter. <a href="#" onclick="kyoFilter(document.querySelector(\'.kyo-filter-btn\'),\'all\',\'all\');return false;" style="color:var(--kyo-accent);font-weight:700">View all models</a></p></div>';
    return;
  }

  grid.style.opacity='0';
  grid.innerHTML='';

  prods.forEach(function(p){
    var saveHtml=kyoSaveCalc(p.p,p.cp);
    var featsHtml=Array.isArray(p.feats)?p.feats.map(function(f){return '<li>'+f+'</li>';}).join(''):'' ;
    var badgeHtml=p.badge?'<span class="kyo-product-badge '+p.badgeClass+'">'+p.badge+'</span>':'';
    var priceHtml='<span class="kyo-price-sale">'+p.p+'</span>';
    if(p.cp) priceHtml+=' <span class="kyo-price-was">'+p.cp+'</span>';
    if(saveHtml) priceHtml+=' '+saveHtml;

    var card=document.createElement('article');
    card.className='kyo-product-card';
    card.innerHTML=
      badgeHtml+
      '<a href="'+p.u+'" style="display:block"><div class="kyo-product-img-wrap"><img class="kyo-product-img" src="'+p.i+'" alt="'+p.n+'" loading="lazy"></div></a>'+
      '<div class="kyo-product-body">'+
        '<div class="kyo-product-for">'+p.for+'</div>'+
        '<div class="kyo-product-name"><a href="'+p.u+'">'+p.n+'</a></div>'+
        '<ul class="kyo-product-feats">'+featsHtml+'</ul>'+
        '<div class="kyo-product-prices">'+priceHtml+'</div>'+
        '<a href="'+p.u+'" class="kyo-product-cta">View Details</a>'+
      '</div>';
    grid.appendChild(card);
  });

  setTimeout(function(){grid.style.opacity='1';grid.style.transition='opacity .3s';},40);
}

// ─── FAQ ACCORDION ─────────────────────────────────────────────────────────
function kyoFaq(el){
  var a=el.nextElementSibling;
  var isOpen=a.classList.contains('open');
  document.querySelectorAll('.kyo-faq-a').forEach(function(x){x.classList.remove('open')});
  document.querySelectorAll('.kyo-faq-q').forEach(function(x){x.classList.remove('active')});
  if(!isOpen){a.classList.add('open');el.classList.add('active');}
}

// ─── SUBNAV SCROLL SPY ─────────────────────────────────────────────────────
(function(){
  var links=document.querySelectorAll('.kyo-subnav-inner a');
  var ids=['kyo-collection','kyo-overview','kyo-why-kyota','kyo-model-guide','kyo-buyer-types','kyo-vs-brands','kyo-pricing','kyo-trust','kyo-showrooms','kyo-faq'];
  window.addEventListener('scroll',function(){
    var pos=window.scrollY+140,active='';
    ids.forEach(function(id){var el=document.getElementById(id);if(el&&pos>=el.offsetTop)active=id;});
    links.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+active)l.classList.add('active');});
  });
})();

// ─── INIT ──────────────────────────────────────────────────────────────────
kyoRenderProducts();
</script>

{%- endpaginate -%}

