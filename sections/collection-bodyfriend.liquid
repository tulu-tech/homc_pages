{%- comment -%} ── JAVASCRIPT ── {%- endcomment -%}
<script>
  /* FAQ accordion */
  function bfFaq(btn) {
    const item = btn.parentElement;
    const answer = item.querySelector('.bf-faq-a');
    const isOpen = answer.classList.contains('open');
    document.querySelectorAll('.bf-faq-a.open').forEach(el => { el.classList.remove('open'); el.previousElementSibling.classList.remove('active'); });
    if (!isOpen) { answer.classList.add('open'); btn.classList.add('active'); }
  }

  /* Sticky subnav active state */
  (function() {
    const links = document.querySelectorAll('.bf-subnav-inner a');
    const sections = [];
    links.forEach(l => { const id = l.getAttribute('href').replace('#',''); const el = document.getElementById(id); if(el) sections.push({el, l}); });
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        const link = sections.find(s => s.el === e.target);
        if(link) { if(e.isIntersecting) link.l.classList.add('active'); else link.l.classList.remove('active'); }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => io.observe(s.el));
  })();
</script>

