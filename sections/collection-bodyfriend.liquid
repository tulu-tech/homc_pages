      <img
        src="{% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2200 }}{% else %}https://cdn.shopify.com/s/files/1/0649/9516/4367/files/bodyfriend-hero-bg.jpg?v=1776369231{% endif %}"
        alt=""
        aria-hidden="true"
        fetchpriority="high"
      >
    </div>
    <div class="bf-hero-overlay"></div>
    <div class="bf-container bf-hero-content">
      <div class="bf-hero-bc">
        <a href="{{ shop.url }}">Home</a><span>/</span>
        <a href="{{ shop.url }}/collections/massage-chairs">Massage Chairs</a><span>/</span>
        Bodyfriend
      </div>
      <div class="bf-hero-eye">South Korea's Premium, Technology-Forward Massage Chair Brand &middot; Authorized Dealer</div>
      {%- if section.settings.hero_heading != blank -%}
        <h1>{{ section.settings.hero_heading }}</h1>
      {%- else -%}
        <h1>Bodyfriend Massage Chairs<br><span>Price, Reviews &amp; Showroom Guide</span></h1>
      {%- endif -%}
      {%- if section.settings.hero_subheading != blank -%}
        <p class="bf-hero-lead">{{ section.settings.hero_subheading }}</p>
      {%- else -%}
        <p class="bf-hero-lead">Compare Bodyfriend massage chairs by model, price, features, massage mode, gravity recline, and showroom fit. House of Massage Chairs helps you choose the right chair with expert guidance and local showroom trials.</p>
      {%- endif -%}
      <p class="bf-hero-sub">Explore models including the Falcon SV, Phantom Rovo, Leonardo DV, Pharaoh Q, Pharaoh Neo, Palace Neo, and Familie — with delivery support, financing options, and warranty clarity. Also commonly searched as Body Friend massage chair or massage chair Bodyfriend.</p>
      <div class="bf-hero-ctas">
        <a href="#bf-shop" class="bf-btn bf-btn-gold">Shop All Bodyfriend Models</a>
        <a href="#bf-pharaoh-q" class="bf-btn bf-btn-ghost">Explore the Models</a>
        <a href="{{ shop.url }}/pages/our-store" class="bf-btn bf-btn-ghost">Book Showroom Visit</a>
      </div>
      <div class="bf-hero-stats">
        <div class="bf-hero-stat">
          <span class="bf-hero-stat-n">7</span>
          <span class="bf-hero-stat-l">Distinct Models</span>
        </div>
        <div class="bf-hero-stat">
          <span class="bf-hero-stat-n">$5K–$15K</span>
          <span class="bf-hero-stat-l">Price Range</span>
        </div>
        <div class="bf-hero-stat">
          <span class="bf-hero-stat-n">XD-Pro</span>
          <span class="bf-hero-stat-l">Proprietary Technology</span>
        </div>
        <div class="bf-hero-stat">
          <span class="bf-hero-stat-n">2</span>
          <span class="bf-hero-stat-l">Bay Area Showrooms</span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ══════════ SHOP COLLECTION ══════════ {%- endcomment -%}
  <section class="bf-section" id="bf-shop" style="padding-top:4rem;padding-bottom:4rem">
    <div class="bf-container">
      <div class="bf-prod-header">
        <div class="bf-prod-header-inner">
          <div>
            <span class="bf-label">Bodyfriend Collection — Live Pricing</span>
            <h2>Shop All Bodyfriend Models</h2>
            <p>All models available to try in person at our San Jose &amp; Pleasanton showrooms. White-glove delivery nationwide.</p>
          </div>
          <a href="{{ shop.url }}/pages/our-store" class="bf-btn bf-btn-gold bf-btn-sm" style="flex-shrink:0">Book Showroom</a>
        </div>
      </div>
      <div class="bf-prod-grid-wrap">
        <div class="bf-prod-grid">
          {%- for product in collection.products -%}
            {%- assign badge = product.metafields.custom.badge.value | default: '' -%}
            {%- assign buyer_for = product.metafields.custom.buyer_for.value | default: 'Premium Buyers' -%}
            {%- assign sale_price = product.price | money -%}
            {%- assign compare_price = product.compare_at_price | money -%}
            {%- assign img_url = product.featured_image | image_url: width: 600 -%}
            <div class="bf-prod-card">
              {%- if badge != '' -%}
                <div class="bf-prod-badge">{{ badge }}</div>
              {%- endif -%}
              <div class="bf-prod-img-wrap">
                <a href="{{ product.url }}"></a>
                <img class="bf-prod-img" src="{{ img_url }}" alt="{{ product.title }}" loading="lazy">
              </div>
              <div class="bf-prod-body">
                <span class="bf-prod-for">Best for: {{ buyer_for }}</span>
                <h3 class="bf-prod-name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                {%- if product.metafields.custom.key_features.value != blank -%}
                  <ul class="bf-prod-feats">
                    {%- for feat in product.metafields.custom.key_features.value -%}
                      <li>{{ feat }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                <div class="bf-prod-prices">
                  <span class="bf-price-sale">{{ sale_price }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="bf-price-was">{{ compare_price }}</span>
                  {%- endif -%}
                </div>
                <a href="{{ product.url }}" class="bf-prod-cta">Interested in This Product →</a>
              </div>
            </div>
          {%- else -%}
            <p style="grid-column:1/-1;text-align:center;padding:3rem;color:var(--bf-muted)">No products found in this collection.</p>
          {%- endfor -%}
        </div>
      </div>
      <div style="text-align:center;margin-top:2rem">
        <p style="font-size:13px;color:var(--bf-muted2);margin-bottom:1rem">Prices are verified as current. All models include manufacturer warranty and white-glove delivery.</p>
        <a href="{{ shop.url }}/pages/our-store" class="bf-btn bf-btn-gold">Try Any Model in Our Showroom &rarr;</a>
      </div>
    </div>
  </section>

