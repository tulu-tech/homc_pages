<style>
  /* =====================================================
     CRITICAL: ABSOLUTE px FONT OVERRIDES
     Prevents Shopify theme root font-size scaling from
     shrinking all text. Every font-size uses px — never rem.
  ===================================================== */
  .bf-wrap {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #1a1a1a;
    line-height: 1.75;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .bf-wrap * { box-sizing: border-box; margin: 0; padding: 0; }
  /* Reset all inherited font-sizes so theme cannot override */
  .bf-wrap p    { font-size: 15px; line-height: 1.8; }
  .bf-wrap li   { font-size: 14px; line-height: 1.65; }
  .bf-wrap a    { text-decoration: none; }
  .bf-wrap h1   { font-size: clamp(38px, 5.5vw, 64px); line-height: 1.08; font-weight: 800; letter-spacing: -0.03em; }
  .bf-wrap h2   { font-size: clamp(26px, 3vw, 38px); line-height: 1.15; font-weight: 800; letter-spacing: -0.025em; }
  .bf-wrap h3   { font-size: clamp(16px, 2vw, 20px); line-height: 1.3;  font-weight: 700; }
  .bf-wrap h4   { font-size: 16px; line-height: 1.35; font-weight: 700; }
  .bf-wrap img  { max-width: 100%; display: block; }

  /* ── CSS VARIABLES ── */
  .bf-wrap {
    --bf-bg:          #ffffff;
    --bf-surface:     #f6f4f0;
    --bf-surface2:    #eeebe5;
    --bf-dark:        #09090f;
    --bf-dark2:       #0d0b14;
    --bf-muted:       #555;
    --bf-muted2:      #888;
    --bf-accent:      #b8944f;
    --bf-accent-h:    #9a7a3f;
    --bf-accent-warm: #c8a85a;
    --bf-accent-pale: rgba(184,148,79,0.10);
    --bf-border:      #e2dfd8;
    --bf-border2:     #ccc9c0;
    --bf-radius:      20px;
    --bf-radius-sm:   12px;
    --bf-shadow:      0 8px 30px rgba(0,0,0,0.07);
    --bf-shadow-lg:   0 20px 50px rgba(0,0,0,0.13);
  }

  /* ── LAYOUT ── */
  .bf-container       { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .bf-container-sm    { max-width: 860px;  margin: 0 auto; padding: 0 2rem; }
  .bf-section         { padding: 5rem 0; }
  .bf-section-alt     { background: var(--bf-surface); }
  .bf-section-sm      { padding: 3.5rem 0; }
  .bf-section-dark    { background: linear-gradient(135deg,#07070e 0%,#0e0c18 50%,#090b10 100%); }

  /* ── SUBNAV ── */
  .bf-subnav { background: rgba(255,255,255,.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--bf-border); overflow-x: auto; scrollbar-width: none; position: sticky; top: 0; z-index: 90; }
  .bf-subnav::-webkit-scrollbar { display: none; }
  .bf-subnav-inner { display: flex; padding: 0 2rem; min-width: max-content; }
  .bf-subnav-inner a { display: block; padding: .75rem 1rem; font-size: 12px; font-weight: 700; color: var(--bf-muted2); border-bottom: 2px solid transparent; white-space: nowrap; transition: all .2s; text-transform: uppercase; letter-spacing: .08em; }
  .bf-subnav-inner a:hover, .bf-subnav-inner a.active { color: var(--bf-dark); border-bottom-color: var(--bf-accent); }

  /* ── BUTTONS ── */
  .bf-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; background: var(--bf-dark); color: #fff !important; padding: .9rem 2rem; font-size: 15px; font-weight: 700; border-radius: 50px; transition: all .25s; border: 2px solid var(--bf-dark); cursor: pointer; font-family: 'Inter', sans-serif; letter-spacing: .01em; white-space: nowrap; text-decoration: none !important; }
  .bf-btn:hover { background: #1a1a1a; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.18); color: #fff !important; }
  .bf-btn-gold  { background: var(--bf-accent) !important; border-color: var(--bf-accent) !important; color: #fff !important; }
  .bf-btn-gold:hover { background: var(--bf-accent-h) !important; border-color: var(--bf-accent-h) !important; box-shadow: 0 8px 24px rgba(184,148,79,.3); color: #fff !important; }
  .bf-btn-outline { background: transparent !important; color: var(--bf-dark) !important; border: 2px solid var(--bf-border2) !important; }
  .bf-btn-outline:hover { border-color: var(--bf-dark) !important; background: var(--bf-surface) !important; color: var(--bf-dark) !important; }
  .bf-btn-ghost { background: transparent !important; color: #fff !important; border: 2px solid rgba(255,255,255,.35) !important; }
  .bf-btn-ghost:hover { background: rgba(255,255,255,.1) !important; border-color: rgba(255,255,255,.7) !important; color: #fff !important; }
  .bf-btn-sm { padding: .6rem 1.5rem; font-size: 14px; }
  /* Outline buttons on dark backgrounds (model cards, tech section, final CTA) */
  .bf-model-copy .bf-btn-outline,
  .bf-section-dark .bf-btn-outline,
  .bf-final-cta .bf-btn-outline,
  .bf-lifestyle-copy .bf-btn-outline { color: rgba(255,255,255,.85) !important; border-color: rgba(255,255,255,.3) !important; background: transparent !important; }
  .bf-model-copy .bf-btn-outline:hover,
  .bf-section-dark .bf-btn-outline:hover,
  .bf-final-cta .bf-btn-outline:hover,
  .bf-lifestyle-copy .bf-btn-outline:hover { color: #fff !important; border-color: rgba(255,255,255,.7) !important; background: rgba(255,255,255,.08) !important; }
  /* Showroom body (white bg) outline buttons stay dark */

  /* ── HERO ── */
  .bf-hero { position: relative; min-height: 92vh; display: flex; align-items: center; overflow: hidden; background: #09090f; }
  .bf-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .bf-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; display: block; filter: brightness(0.52) saturate(0.88); }
  .bf-hero-overlay { position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(to right,  rgba(5,5,10,0.85) 0%, rgba(5,5,10,0.55) 55%, rgba(5,5,10,0.18) 100%),
      linear-gradient(to top,    rgba(5,5,10,0.78) 0%, transparent 50%);
  }
  .bf-hero-content { position: relative; z-index: 2; padding: 5rem 0 5.5rem; }
  .bf-hero-bc { font-size: 12px; color: rgba(255,255,255,.38); margin-bottom: 1.5rem; }
  .bf-hero-bc a { color: var(--bf-accent); transition: color .2s; }
  .bf-hero-bc a:hover { color: #fff; }
  .bf-hero-bc span { margin: 0 .4rem; }
  .bf-hero-eye { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--bf-accent); margin-bottom: 1.25rem; }
  .bf-hero-eye::before { content: ''; display: block; width: 28px; height: 2px; background: var(--bf-accent); border-radius: 2px; }
  .bf-hero h1 { font-size: clamp(36px, 5vw, 62px); color: #fff; max-width: 820px; margin-bottom: 1.25rem; font-family: 'Playfair Display', serif; font-weight: 700; text-shadow: 0 4px 30px rgba(0,0,0,.5); }
  .bf-hero h1 span { color: var(--bf-accent-warm); font-style: italic; }
  .bf-hero-lead { font-size: clamp(16px, 1.4vw, 19px); color: rgba(255,255,255,.8); max-width: 620px; margin-bottom: .75rem; font-weight: 600; line-height: 1.65; }
  .bf-hero-sub  { font-size: 15px; color: rgba(255,255,255,.5); max-width: 580px; margin-bottom: 2.5rem; line-height: 1.75; }
  .bf-hero-ctas { display: flex; gap: .875rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .bf-hero-stats { display: flex; gap: 0; border-top: 1px solid rgba(255,255,255,.1); padding-top: 2.5rem; flex-wrap: wrap; }
  .bf-hero-stat  { padding: 0 2.5rem 0 0; border-right: 1px solid rgba(255,255,255,.1); margin-right: 2.5rem; }
  .bf-hero-stat:last-child { border-right: none; margin-right: 0; }
  .bf-hero-stat-n { font-size: 32px; font-weight: 900; color: #fff; display: block; line-height: 1; margin-bottom: 4px; letter-spacing: -.04em; font-family: 'Inter', sans-serif; }
  .bf-hero-stat-l { font-size: 12px; color: rgba(255,255,255,.38); text-transform: uppercase; letter-spacing: .12em; font-weight: 700; }

  /* ── TRUST BAR ── */
  .bf-trust-bar { display: flex; justify-content: center; gap: 3rem; padding: 1.25rem 2rem; border-bottom: 1px solid var(--bf-border); background: #fff; flex-wrap: wrap; }
  .bf-trust-item { display: flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 700; color: var(--bf-muted); }
  .bf-trust-item svg { width: 16px; height: 16px; fill: var(--bf-accent); flex-shrink: 0; }

  /* ── SECTION LABELS / HEADERS ── */
  .bf-label { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--bf-accent); margin-bottom: .875rem; }
  .bf-section-header { margin-bottom: 3rem; }
  .bf-section-header.center { text-align: center; }
  .bf-section-header.center .bf-label { display: block; }
  .bf-section-header p { font-size: 17px; color: var(--bf-muted); max-width: 680px; line-height: 1.8; }
  .bf-section-header.center p { margin: 0 auto; }
  .bf-underline { position: relative; display: inline-block; }
  .bf-underline::after { content: ''; position: absolute; bottom: -4px; left: 0; right: 0; height: 3px; background: var(--bf-accent); border-radius: 2px; }

  /* ── PRODUCT GRID ── */
  .bf-prod-header { background: linear-gradient(135deg,#07070e 0%,#12100a 60%,#09090f 100%); padding: 3rem 3rem 0; border-radius: var(--bf-radius) var(--bf-radius) 0 0; position: relative; overflow: hidden; }
  .bf-prod-header::before { content: ''; position: absolute; top:-40%; right:-10%; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle,rgba(184,148,79,.08) 0%,transparent 70%); pointer-events:none; }
  .bf-prod-header-inner { position:relative; z-index:1; display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; padding-bottom:2.5rem; }
  .bf-prod-header h2 { color:#fff; font-size: clamp(22px,2.5vw,30px); }
  .bf-prod-header p  { color:rgba(255,255,255,.5); font-size:14px; max-width:560px; margin-top:.5rem; line-height:1.7; }
  .bf-prod-grid-wrap { background: var(--bf-surface); border:1px solid var(--bf-border); border-top:none; border-radius:0 0 var(--bf-radius) var(--bf-radius); padding:2rem; }
  .bf-prod-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1.25rem; }

  /* ── PRODUCT CARD ── */
  .bf-prod-card { background:#fff; border:1px solid var(--bf-border); border-radius: var(--bf-radius); overflow:hidden; transition:all .3s cubic-bezier(.25,.8,.25,1); position:relative; display:flex; flex-direction:column; }
  .bf-prod-card:hover { transform:translateY(-7px); box-shadow: var(--bf-shadow-lg); border-color:transparent; outline:2px solid var(--bf-accent); }
  .bf-prod-badge { position:absolute; top:10px; left:10px; background:linear-gradient(135deg,#1a0a00,#3d2000); border:1px solid rgba(184,148,79,.4); color:var(--bf-accent-warm); font-size:10px; font-weight:800; padding:3px 10px; border-radius:50px; text-transform:uppercase; letter-spacing:.1em; z-index:2; }
  .bf-prod-img-wrap { height:220px; display:flex; align-items:center; justify-content:center; padding:1.5rem; background:linear-gradient(145deg,#fafafa,#fff); position:relative; overflow:hidden; }
  .bf-prod-img { width:100%; height:100%; object-fit:contain; mix-blend-mode:multiply; transition:transform .4s cubic-bezier(.25,.8,.25,1); }
  .bf-prod-card:hover .bf-prod-img { transform:scale(1.07); }
  .bf-prod-img-wrap a { display:block; width:100%; height:100%; position:absolute; inset:0; z-index:1; }
  .bf-prod-body { padding: 1rem 1.25rem 1.25rem; flex:1; display:flex; flex-direction:column; }
  .bf-prod-for  { font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.1em; color:var(--bf-accent); background:var(--bf-accent-pale); display:inline-block; padding:3px 8px; border-radius:20px; margin-bottom:.6rem; }
  .bf-prod-name { font-size:14px; font-weight:700; line-height:1.35; margin-bottom:.75rem; color:var(--bf-dark); }
  .bf-prod-name a { color:inherit; text-decoration:none; }
  .bf-prod-feats { list-style:none; padding:0; margin:0 0 .875rem; flex:1; }
  .bf-prod-feats li { display:flex; align-items:flex-start; gap:5px; font-size:12px; color:var(--bf-muted); padding:2px 0; line-height:1.5; }
  .bf-prod-feats li::before { content:'✓'; color:var(--bf-accent); font-weight:900; font-size:11px; flex-shrink:0; margin-top:2px; }
  .bf-prod-prices { display:flex; align-items:baseline; gap:7px; margin-bottom:.875rem; flex-wrap:wrap; }
  .bf-price-sale  { font-size:18px; font-weight:900; color:var(--bf-dark); letter-spacing:-.02em; }
  .bf-price-was   { font-size:13px; color:#adb5bd; text-decoration:line-through; font-weight:500; }
  .bf-prod-cta    { display:block; text-align:center; background:var(--bf-dark); color:#fff; padding:.65rem; border-radius:var(--bf-radius-sm); font-weight:700; font-size:13px; transition:background .2s; text-decoration:none; }
  .bf-prod-cta:hover { background:var(--bf-accent); color:#fff; }

  /* ── QUICK ANSWERS ── */
  .bf-qa-wrap { background:linear-gradient(135deg,#050505 0%,#1a140a 100%); border-radius:24px; padding:3rem; border:1px solid rgba(184,148,79,.15); position:relative; overflow:hidden; }
  .bf-qa-wrap::before { content:''; position:absolute; top:-30%; right:-5%; width:400px; height:400px; border-radius:50%; background:radial-gradient(circle,rgba(184,148,79,.06) 0%,transparent 70%); pointer-events:none; }
  .bf-qa-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; margin-top:2rem; position:relative; z-index:1; }
  .bf-qa-item { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.07); border-radius:14px; padding:1.5rem; transition:all .3s; }
  .bf-qa-item:hover { background:rgba(255,255,255,.07); border-color:rgba(184,148,79,.25); }
  .bf-qa-item h3 { font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--bf-accent); margin-bottom:.625rem; font-weight:800; }
  .bf-qa-item p  { font-size:14px; color:rgba(255,255,255,.62); line-height:1.75; margin:0; }
  .bf-qa-item a  { color:var(--bf-accent-warm); font-weight:700; }

  /* ── PILLARS ── */
  .bf-pillar-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
  .bf-pillar-card { background:#fff; border:1px solid var(--bf-border); border-radius:var(--bf-radius); padding:2rem; transition:all .3s; position:relative; overflow:hidden; }
  .bf-pillar-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--bf-accent); transform:scaleX(0); transform-origin:left; transition:transform .3s; }
  .bf-pillar-card:hover { transform:translateY(-5px); box-shadow:var(--bf-shadow); }
  .bf-pillar-card:hover::before { transform:scaleX(1); }
  .bf-pillar-icon { width:48px; height:48px; background:var(--bf-accent-pale); border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:1.125rem; }
  .bf-pillar-icon svg { width:24px; height:24px; fill:var(--bf-accent); }
  .bf-pillar-card h3 { font-size:16px; margin-bottom:.5rem; }
  .bf-pillar-card p  { font-size:14px; color:var(--bf-muted); margin:0; line-height:1.7; }

  /* ── TECHNOLOGY BANNER ── */
  .bf-tech-grid { display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center; }
  .bf-tech-img-wrap { position:relative; }
  .bf-tech-img-wrap::before { content:''; position:absolute; inset:-30px; background:radial-gradient(ellipse at center,rgba(184,148,79,0.08) 0%,transparent 70%); pointer-events:none; }
  .bf-tech-img-wrap img { width:100%; border-radius:var(--bf-radius); display:block; position:relative; z-index:1; box-shadow:0 40px 80px rgba(0,0,0,0.5); }
  .bf-tech-feats { display:flex; flex-direction:column; gap:1rem; }
  .bf-tech-feat { display:flex; align-items:flex-start; gap:1rem; }
  .bf-tech-feat-icon { flex-shrink:0; width:42px; height:42px; background:rgba(184,148,79,0.12); border:1px solid rgba(184,148,79,0.25); border-radius:10px; display:flex; align-items:center; justify-content:center; }
  .bf-tech-feat-icon svg { width:18px; height:18px; fill:var(--bf-accent-warm); }
  .bf-tech-feat-title { font-size:14px; font-weight:700; color:#fff; margin-bottom:2px; }
  .bf-tech-feat-desc  { font-size:13px; color:rgba(255,255,255,.52); line-height:1.6; }

  /* ── MODEL SPOTLIGHTS ── */
  .bf-model-card { background: linear-gradient(135deg,#0a0912,#111020); border:1px solid rgba(184,148,79,.15); border-radius:24px; overflow:hidden; margin-bottom:2rem; display:grid; grid-template-columns:380px 1fr; transition:box-shadow .3s; }
  .bf-model-card:hover { box-shadow:0 20px 60px rgba(0,0,0,.35); }
  .bf-model-card.alt { grid-template-columns:1fr 380px; }
  .bf-model-card.alt .bf-model-img-side { order:2; }
  .bf-model-card.alt .bf-model-copy { order:1; }
  .bf-model-img-side { background:linear-gradient(145deg,#0d0b16,#1a1630); display:flex; align-items:center; justify-content:center; padding:2.5rem 2rem; position:relative; overflow:hidden; }
  .bf-model-img-side::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at center,rgba(184,148,79,.07) 0%,transparent 70%); }
  .bf-model-img-side img { max-width:100%; max-height:320px; object-fit:contain; position:relative; z-index:1; transition:transform .5s ease; }
  .bf-model-card:hover .bf-model-img-side img { transform:scale(1.05); }
  .bf-model-copy { padding:3rem; display:flex; flex-direction:column; justify-content:center; }
  .bf-model-tier { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.2em; color:var(--bf-accent); margin-bottom:.5rem; display:flex; align-items:center; gap:8px; }
  .bf-model-tier::before { content:'—'; }
  .bf-model-copy h3 { font-size: clamp(22px,2.5vw,30px); color:#fff; font-family:'Playfair Display',serif; margin-bottom:.5rem; line-height:1.2; }
  .bf-model-best { display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.1em; color:var(--bf-dark); background:var(--bf-accent); padding:4px 12px; border-radius:20px; margin-bottom:1.25rem; }
  .bf-model-copy p { font-size:15px; color:rgba(255,255,255,.65); line-height:1.8; margin-bottom:1.25rem; }
  .bf-model-traits { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:1.5rem; }
  .bf-trait { font-size:11px; font-weight:700; padding:4px 11px; border-radius:20px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); color:rgba(255,255,255,.55); }
  .bf-model-tradeoff { font-size:13px; color:rgba(255,255,255,.42); line-height:1.65; padding:.875rem 1.125rem; background:rgba(255,255,255,.04); border-left:3px solid rgba(184,148,79,.4); border-radius:0 8px 8px 0; margin-bottom:1.5rem; }
  .bf-model-ctas { display:flex; gap:.75rem; flex-wrap:wrap; }
  .bf-model-price { font-size:22px; font-weight:900; color:var(--bf-accent-warm); letter-spacing:-.03em; margin-bottom:1.25rem; }
  .bf-model-price-was { font-size:14px; color:rgba(255,255,255,.35); text-decoration:line-through; margin-left:8px; font-weight:500; }

  /* ── COMPARE TABLE ── */
  .bf-compare-wrap { overflow-x:auto; border-radius:14px; border:1px solid var(--bf-border); }
  .bf-compare-table { width:100%; border-collapse:collapse; font-size:13px; min-width:700px; }
  .bf-compare-table th { background:var(--bf-dark); color:#fff; padding:.875rem 1.125rem; text-align:left; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.07em; }
  .bf-compare-table td { padding:.8rem 1.125rem; border-bottom:1px solid var(--bf-border); color:var(--bf-muted); vertical-align:middle; }
  .bf-compare-table tr:last-child td { border-bottom:none; }
  .bf-compare-table tr:hover td { background:var(--bf-surface); }
  .bf-col-feat { font-weight:800; color:var(--bf-dark) !important; white-space:nowrap; }
  .bf-bf-col { background:rgba(184,148,79,.04) !important; }
  thead .bf-bf-col { background:rgba(184,148,79,.14) !important; color:var(--bf-accent) !important; border-bottom:3px solid var(--bf-accent) !important; }
  .bf-check { color:var(--bf-accent); font-weight:800; }

  /* ── BUYER TYPES ── */
  .bf-buyer-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
  .bf-buyer-card { background:#fff; border:1px solid var(--bf-border); border-radius:var(--bf-radius); padding:1.75rem; transition:all .3s; position:relative; overflow:hidden; }
  .bf-buyer-card:hover { border-color:var(--bf-accent); box-shadow:0 10px 30px rgba(184,148,79,.1); }
  .bf-buyer-card::after { content:''; position:absolute; bottom:0; left:0; right:0; height:3px; background:linear-gradient(90deg,var(--bf-accent),transparent); transform:scaleX(0); transform-origin:left; transition:transform .3s; }
  .bf-buyer-card:hover::after { transform:scaleX(1); }
  .bf-buyer-icon { width:42px; height:42px; background:var(--bf-accent-pale); border-radius:11px; display:flex; align-items:center; justify-content:center; margin-bottom:.875rem; }
  .bf-buyer-icon svg { width:20px; height:20px; fill:var(--bf-accent); }
  .bf-buyer-type { font-size:11px; font-weight:800; color:var(--bf-muted2); text-transform:uppercase; letter-spacing:.1em; margin-bottom:.4rem; }
  .bf-buyer-card h3 { font-size:14px; margin-bottom:.4rem; }
  .bf-buyer-card p  { font-size:13px; color:var(--bf-muted); margin:0; line-height:1.7; }
  .bf-buyer-rec { margin-top:.625rem; font-size:12px; font-weight:700; color:var(--bf-accent); }

  /* ── BRAND COMPARISON ── */
  .bf-vs-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
  .bf-vs-card { background:#fff; border:1px solid var(--bf-border); border-radius:var(--bf-radius-sm); padding:1.5rem; transition:all .3s; }
  .bf-vs-card:hover { border-color:var(--bf-border2); box-shadow:var(--bf-shadow); }
  .bf-vs-card h3 { font-size:14px; margin-bottom:.5rem; }
  .bf-vs-card p  { font-size:13px; color:var(--bf-muted); line-height:1.75; margin:0; }

  /* ── PRICE LADDER ── */
  .bf-price-ladder { border:1px solid var(--bf-border); border-radius:var(--bf-radius); overflow:hidden; margin-bottom:2rem; }
  .bf-price-rung { display:grid; grid-template-columns:140px 1fr; border-bottom:1px solid var(--bf-border); transition:background .2s; }
  .bf-price-rung:last-child { border-bottom:none; }
  .bf-price-rung:hover { background:var(--bf-surface); }
  .bf-price-label { background:var(--bf-dark); padding:1.5rem; display:flex; flex-direction:column; justify-content:center; border-right:1px solid rgba(255,255,255,.08); }
  .bf-price-tier-name { font-size:10px; text-transform:uppercase; letter-spacing:.12em; color:rgba(255,255,255,.4); font-weight:700; margin-bottom:3px; }
  .bf-price-amount { font-size:16px; font-weight:900; color:var(--bf-accent); letter-spacing:-.02em; }
  .bf-price-body { padding:1.5rem 2rem; }
  .bf-price-body h4 { font-size:14px; margin-bottom:.35rem; }
  .bf-price-body p  { font-size:13px; color:var(--bf-muted); margin:0; line-height:1.65; }
  .bf-price-tags { display:flex; gap:.4rem; flex-wrap:wrap; margin-top:.625rem; }
  .bf-price-tag { font-size:11px; font-weight:700; padding:2px 9px; border-radius:20px; background:var(--bf-accent-pale); color:var(--bf-accent); }

  /* ── TRUST CARDS ── */
  .bf-trust-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
  .bf-trust-card { background:#fff; border:1px solid var(--bf-border); border-radius:var(--bf-radius); padding:1.75rem; transition:all .3s; }
  .bf-trust-card:hover { transform:translateY(-4px); box-shadow:var(--bf-shadow); }
  .bf-trust-card-icon { width:44px; height:44px; background:var(--bf-accent-pale); border-radius:11px; display:flex; align-items:center; justify-content:center; margin-bottom:1rem; }
  .bf-trust-card-icon svg { width:22px; height:22px; fill:var(--bf-accent); }
  .bf-trust-card h3 { font-size:15px; margin-bottom:.5rem; }
  .bf-trust-card p  { font-size:14px; color:var(--bf-muted); margin:0; line-height:1.7; }

  /* ── EXPERT CALLOUT ── */
  .bf-expert { background:#fff; border:1px solid var(--bf-border); border-left:4px solid var(--bf-accent); border-radius:0 12px 12px 0; padding:1.5rem 1.75rem; display:flex; align-items:flex-start; gap:.875rem; }
  .bf-expert svg { width:26px; height:26px; fill:var(--bf-accent); flex-shrink:0; margin-top:1px; }
  .bf-expert p   { font-size:14px; color:var(--bf-muted); line-height:1.75; margin:0; }
  .bf-expert strong { color:var(--bf-dark); }

  /* ── SHOWROOM ── */
  .bf-showroom-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.75rem; }
  .bf-showroom-card { border:1px solid var(--bf-border); border-radius:var(--bf-radius); overflow:hidden; transition:all .3s; }
  .bf-showroom-card:hover { transform:translateY(-4px); box-shadow:var(--bf-shadow-lg); }
  .bf-showroom-head { background:linear-gradient(135deg,#07070e,#12100a); padding:2rem 2.25rem 1.75rem; }
  .bf-showroom-pill { font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.14em; color:var(--bf-accent); background:rgba(184,148,79,.15); padding:3px 10px; border-radius:20px; display:inline-block; margin-bottom:.625rem; }
  .bf-showroom-head h3 { color:#fff; font-size:17px; margin-bottom:.3rem; }
  .bf-showroom-head p  { color:rgba(255,255,255,.5); font-size:13px; margin:0; }
  .bf-showroom-body { background:#fff; padding:1.75rem 2.25rem; }
  .bf-showroom-row { display:flex; align-items:flex-start; gap:8px; padding:.5rem 0; border-bottom:1px solid var(--bf-border); font-size:13px; color:var(--bf-muted); }
  .bf-showroom-row:last-child { border-bottom:none; }
  .bf-showroom-row svg { width:16px; height:16px; fill:var(--bf-accent); flex-shrink:0; margin-top:2px; }
  .bf-showroom-btns { margin-top:1.25rem; display:flex; gap:.625rem; flex-wrap:wrap; }

  /* ── FAQ ── */
  .bf-faq-item { border-bottom:1px solid var(--bf-border); }
  .bf-faq-q { display:flex; justify-content:space-between; align-items:center; padding:1.4rem 0; cursor:pointer; gap:1rem; }
  .bf-faq-q h3 { font-size:16px; margin:0; font-weight:700; transition:color .2s; line-height:1.4; }
  .bf-faq-q:hover h3 { color:var(--bf-accent); }
  .bf-faq-icon { width:22px; height:22px; fill:var(--bf-muted2); flex-shrink:0; transition:transform .3s; }
  .bf-faq-q.active .bf-faq-icon { transform:rotate(45deg); }
  .bf-faq-a { max-height:0; overflow:hidden; transition:max-height .4s ease; }
  .bf-faq-a.open { max-height:600px; }
  .bf-faq-a p { margin:0; padding-bottom:1.4rem; font-size:15px; color:var(--bf-muted); line-height:1.8; }
  .bf-faq-a a { color:var(--bf-accent); font-weight:700; }

  /* ── FINAL CTA ── */
  .bf-final-cta { background:linear-gradient(135deg,#050505 0%,#1a110a 60%,#050505 100%); border-radius:28px; padding:4rem; position:relative; overflow:hidden; }
  .bf-final-cta::before { content:''; position:absolute; top:-40%; right:-8%; width:600px; height:600px; border-radius:50%; background:radial-gradient(circle,rgba(184,148,79,.1) 0%,transparent 70%); pointer-events:none; }
  .bf-final-cta::after  { content:''; position:absolute; bottom:-30%; left:-5%; width:400px; height:400px; border-radius:50%; background:radial-gradient(circle,rgba(184,148,79,.06) 0%,transparent 70%); pointer-events:none; }
  .bf-final-cta-inner { position:relative; z-index:1; }
  .bf-final-cta h2 { color:#fff; font-size:clamp(28px,3vw,42px); margin-bottom:.875rem; line-height:1.12; font-family:'Playfair Display',serif; }
  .bf-final-cta p  { color:rgba(255,255,255,.62); font-size:16px; max-width:640px; margin-bottom:2rem; line-height:1.75; }
  .bf-final-cta-btns { display:flex; gap:.875rem; flex-wrap:wrap; }

  /* ── LIFESTYLE IMAGE BANNER ── */
  .bf-lifestyle-banner { position:relative; border-radius:var(--bf-radius); overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 60px rgba(0,0,0,.13); }
  .bf-lifestyle-banner img { width:100%; height:520px; object-fit:cover; object-position:center 30%; display:block; }
  .bf-lifestyle-overlay { position:absolute; inset:0; background:linear-gradient(to right,rgba(9,9,15,.75) 0%,rgba(9,9,15,.2) 55%,transparent 100%); display:flex; align-items:center; }
  .bf-lifestyle-copy { padding:3rem 3.5rem; max-width:520px; }
  .bf-lifestyle-copy .bf-label { color:var(--bf-accent-warm); }
  .bf-lifestyle-copy h2 { color:#fff; font-size:clamp(1.4rem,2.8vw,2.1rem); margin-bottom:1rem; line-height:1.2; font-family:'Playfair Display',serif; }
  .bf-lifestyle-copy p { color:rgba(255,255,255,.72); font-size:15px; line-height:1.8; margin-bottom:1.75rem; }

  /* ── GRAD DIVIDER ── */
  .bf-divider { height:1px; background:linear-gradient(90deg,transparent,var(--bf-border),transparent); }

  /* ── RESPONSIVE ── */
  @media(max-width:1100px) {
    .bf-prod-grid { grid-template-columns:repeat(2,1fr); }
    .bf-pillar-grid { grid-template-columns:1fr 1fr; }
    .bf-trust-grid { grid-template-columns:1fr 1fr; }
    .bf-tech-grid { gap:2.5rem; }
  }
  @media(max-width:900px) {
    .bf-hero { min-height:70vh; }
    .bf-hero h1 { font-size:34px; }
    .bf-model-card, .bf-model-card.alt { grid-template-columns:1fr; }
    .bf-model-card.alt .bf-model-img-side, .bf-model-card.alt .bf-model-copy { order:unset; }
    .bf-model-img-side { padding:2rem; }
    .bf-model-img-side img { max-height:240px; }
    .bf-tech-grid { grid-template-columns:1fr; }
    .bf-qa-grid, .bf-vs-grid, .bf-showroom-grid { grid-template-columns:1fr; }
    .bf-buyer-grid { grid-template-columns:1fr 1fr; }
    .bf-pillar-grid, .bf-trust-grid { grid-template-columns:1fr; }
    .bf-section { padding:3.5rem 0; }
    .bf-final-cta { padding:2.5rem 2rem; }
    .bf-lifestyle-banner img { height:380px; }
  }
  @media(max-width:640px) {
    .bf-prod-grid { grid-template-columns:1fr; }
    .bf-buyer-grid { grid-template-columns:1fr; }
    .bf-hero h1 { font-size:28px; }
    .bf-container { padding:0 1.25rem; }
    .bf-prod-header { padding:2rem 1.5rem 0; }
    .bf-prod-grid-wrap { padding:1.25rem; }
    .bf-lifestyle-banner img { height:280px; }
    .bf-lifestyle-copy { padding:2rem; }
    .bf-hero-stats { flex-direction:column; gap:1rem; }
    .bf-hero-stat { border-right:none; margin-right:0; padding:0; }
  }
</style>

<div class="bf-wrap">

