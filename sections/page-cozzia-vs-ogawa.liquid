      "ogawa-active-xl": { brand:"Ogawa", name:"Ogawa Active XL 3D Massage Chair", url:SHOP+"/products/ogawa-active-xl-3d-massage-chair", img:"https://cdn.shopify.com/s/files/1/0649/9516/4367/files/ogawa-active-xl-black-and-black-45.webp?v=1772226054", price:"$5,999", best:"Best Ogawa for Tall Users", tier:"3to6", features:["3D roller technology","Extra-long L-track","Air cell massage"], tags:["balanced","daily","tall","average"] },
      "ogawa-master-drive": { brand:"Ogawa", name:"Ogawa Master Drive Duo Massage Chair", url:SHOP+"/products/ogawa-master-drive-duo-massage-chair", img:"https://cdn.shopify.com/s/files/1/0649/9516/4367/files/ogawa-master-drive-duo-black-and-burgundy-3q.webp?v=1772226039", price:"$9,399", best:"Best Ogawa Dual-Engine Flagship", tier:"6to10", features:["Dual engine technology","4D roller massage","Zero gravity recline"], tags:["deep","tech","flagship","footcalf","tall"] }
    };
    var TIER_INFO = {
      'under3': { label:'Under $3K', subtitle:'Most premium massage chairs start at $3K. Here is the strongest match in your range.' },
      '3to6':   { label:'$3K – $6K', subtitle:'Smart premium picks that still feel genuinely high-end.' },
      '6to10':  { label:'$6K – $10K', subtitle:'The mid-premium sweet spot — where most shoppers land.' },
      '10plus': { label:'$10K+', subtitle:'Flagship comparison tier — top dual-mechanism and premium chairs.' }
    };
    var ANSWER_MAP = {
      feel:     { deep:'deep', balanced:'balanced', relax:'relax' },
      height:   { tall:'tall', average:'average', petite:'petite' },
      footcalf: { footcalf:'footcalf', neutral:null, back:null },
      tech:     { tech:'tech', simple:'simple', balanced:'balanced' },
      usage:    { flagship:'flagship', daily:'daily', balanced:'balanced' }
    };
    var WEIGHTS = { feel:2, height:2, footcalf:2, tech:1, usage:1 };
    function score(p, ans){
      if (!p.tags) return 0;
      var s = 0;
      Object.keys(WEIGHTS).forEach(function(k){
        var v = ans[k]; if (!v) return;
        var tag = ANSWER_MAP[k] && ANSWER_MAP[k][v];
        if (tag && p.tags.indexOf(tag) !== -1) s += WEIGHTS[k];
      });
      return s;
    }
    function reasons(p, ans){
      var hits = [];
      var labels = { deep:'Deep pressure', balanced:'Balanced feel', relax:'Gentle relaxation', tall:'Tall-user fit', average:'Average-height fit', petite:'Petite-user fit', footcalf:'Foot & calf focus', tech:'Tech-forward', simple:'Simple controls', flagship:'Flagship experience', daily:'Daily-use ready' };
      Object.keys(WEIGHTS).forEach(function(k){
        var v = ans[k]; if (!v) return;
        var tag = ANSWER_MAP[k] && ANSWER_MAP[k][v];
        if (tag && p.tags && p.tags.indexOf(tag) !== -1 && labels[tag]) hits.push(labels[tag]);
      });
      return hits;
    }
    function render(ans){
      var tier = ans.budget;
      var info = TIER_INFO[tier];
      var matches = Object.keys(PRODUCTS).map(function(id){ return Object.assign({id:id}, PRODUCTS[id]); }).filter(function(p){ return p.tier === tier; });
      matches.sort(function(a,b){ return score(b,ans) - score(a,ans); });
      var box = document.getElementById('hcm-vs-quiz-results');
      var html = '';
      html += '<div class="hcm-vs-quiz-results-head">';
      html += '<span class="hcm-vs-eyebrow">Your Match · ' + info.label + '</span>';
      html += '<h3>' + (matches.length ? matches.length + ' chair' + (matches.length>1?'s':'') + ' match your budget.' : 'Stretch up a tier.') + '</h3>';
      html += '<p>' + info.subtitle + '</p>';
      html += '</div>';
      if (!matches.length){
        html += '<div class="hcm-vs-quiz-empty"><p>No chair sits in this tier — check the next tier up or browse all chairs.</p><a class="hcm-vs-btn gold" href="' + SHOP + '/collections/massage-chairs">Browse All Chairs <span class="hcm-vs-btn-arrow">→</span></a></div>';
      } else {
        html += '<div class="hcm-vs-quiz-results-grid">';
        matches.forEach(function(p,i){
          var brandClass = (p.brand === 'Cozzia') ? '' : 'kyota';
          var btnClass = (p.brand === 'Cozzia') ? 'gold' : 'green';
          var hits = reasons(p, ans);
          html += '<article class="hcm-vs-quiz-card ' + brandClass + (i===0 ? ' top' : '') + '">';
          if (i === 0 && matches.length > 1) html += '<span class="hcm-vs-quiz-card-flag">Top Pick</span>';
          html += '<div class="hcm-vs-quiz-card-img"><span class="hcm-vs-quiz-card-brand">' + p.brand + '</span><img src="' + p.img + '" alt="' + p.name + '" loading="lazy"></div>';
          html += '<div class="hcm-vs-quiz-card-body">';
          html += '<span class="hcm-vs-quiz-card-best">' + p.best + '</span>';
          html += '<h4>' + p.name + '</h4>';
          html += '<ul>';
          p.features.forEach(function(f){ html += '<li>' + f + '</li>'; });
          html += '</ul>';
          if (hits.length){
            html += '<div class="hcm-vs-quiz-card-why"><small>Why this fits:</small><div class="hcm-vs-quiz-why-tags">';
            hits.forEach(function(h){ html += '<span>' + h + '</span>'; });
            html += '</div></div>';
          }
          html += '<div class="hcm-vs-quiz-card-foot"><strong>' + p.price + '</strong><a class="hcm-vs-btn small ' + btnClass + '" href="' + p.url + '">View Details <span class="hcm-vs-btn-arrow">→</span></a></div>';
          html += '</div></article>';
        });
        html += '</div>';
        html += '<div class="hcm-vs-quiz-results-foot"><p>Final answer: try them in person. Pressure, foot rollers, and recline angle only land in a real session.</p><div class="hcm-vs-btns"><a class="hcm-vs-btn light" href="#showroom">Schedule a Showroom Demo</a><button type="button" class="hcm-vs-btn ghost" id="hcm-vs-quiz-reset">Reset Quiz</button></div></div>';
      }
      box.innerHTML = html; box.hidden = false;
      var reset = document.getElementById('hcm-vs-quiz-reset');
      if (reset) reset.addEventListener('click', function(){
        document.getElementById('hcm-vs-quiz-form').querySelectorAll('input[type=radio]').forEach(function(r){ r.checked = false; });
        box.hidden = true;
        document.getElementById('hcm-vs-quiz').scrollIntoView({behavior:'smooth', block:'start'});
      });
      box.scrollIntoView({behavior:'smooth', block:'start'});
    }
    var form = document.getElementById('hcm-vs-quiz-form');
    var btn = document.getElementById('hcm-vs-quiz-submit');
    if (!form || !btn) return;
    btn.addEventListener('click', function(){
      var ans = {};
      form.querySelectorAll('input[type=radio]:checked').forEach(function(r){ ans[r.name] = r.value; });
      var budgetQ = form.querySelector('.hcm-vs-q-budget');
      var msg = budgetQ.querySelector('.hcm-vs-q-required-msg');
      if (!ans.budget){
        budgetQ.classList.add('hcm-vs-q-error'); msg.hidden = false;
        budgetQ.scrollIntoView({behavior:'smooth', block:'center'}); return;
      }
      budgetQ.classList.remove('hcm-vs-q-error'); msg.hidden = true;
      render(ans);
    });
  })();
  </script>

