.hcm-vs-chair-badge { position:absolute; top:14px; left:14px; z-index:4; display:inline-flex; align-items:center; gap:6px; padding:7px 12px; border-radius:999px; background:rgba(255,255,255,.96); border:1px solid var(--line); font-size:10.5px; font-weight:900; letter-spacing:.14em; text-transform:uppercase; box-shadow:0 4px 10px rgba(0,0,0,.08); max-width:calc(100% - 28px); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.hcm-vs-chair-badge.osaki { color:var(--gold); }
.hcm-vs-chair-badge.kyota { color:var(--green); }
.hcm-vs-chair-badge:before { content:""; flex-shrink:0; width:6px; height:6px; border-radius:50%; }
.hcm-vs-chair-badge.osaki:before { background:var(--gold); }
.hcm-vs-chair-badge.kyota:before { background:var(--green); }
/* Chair stage = a square area between the badge (top) and caption (bottom).
   Forced to 1:1 aspect so the chair image fills it exactly and SVG hotspots
   land on the actual chair anatomy regardless of cell width. */
.hcm-vs-chair-stage { position:absolute; top:58px; bottom:78px; left:50%; transform:translateX(-50%); aspect-ratio:1/1; max-width:calc(100% - 36px); display:flex; align-items:center; justify-content:center; z-index:1; }
.hcm-vs-chair-img { position:relative; z-index:2; width:100%; height:100%; object-fit:contain; filter:drop-shadow(0 14px 22px rgba(0,0,0,.16)); }
.hcm-vs-chair-foot { position:absolute; left:14px; right:14px; bottom:12px; z-index:3; display:grid; gap:3px; padding:10px 12px; border-radius:14px; background:rgba(253,251,247,.96); border:1px solid var(--line); box-shadow:0 6px 14px rgba(0,0,0,.06); }
.hcm-vs-chair-foot strong { color:var(--ink); font-size:12.5px; line-height:1.3; }
.hcm-vs-chair-foot span { color:var(--muted); font-size:11px; line-height:1.4; }
/* INTERACTIVE HOTSPOTS — hover/tap to reveal tooltip with zone details. */
.hcm-vs-hot-overlay { position:absolute; inset:0; z-index:4; pointer-events:none; }
.hcm-vs-hotspot {
  position:absolute; width:18px; height:18px;
  margin-left:-9px; margin-top:-9px;
  border-radius:50%; padding:0;
  background:var(--gold); border:2px solid #fff;
  cursor:pointer; pointer-events:auto;
  box-shadow:0 0 0 5px rgba(58,77,114,.18), 0 3px 8px rgba(0,0,0,.22);
  transition:transform .22s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease;
  z-index:5;
}
.kyota .hcm-vs-hotspot {
  background:var(--green);
  box-shadow:0 0 0 5px rgba(138,90,58,.18), 0 3px 8px rgba(0,0,0,.22);
}
.hcm-vs-hotspot:before {
  content:""; position:absolute; inset:-6px;
  border-radius:50%; background:var(--gold); opacity:.16;
  z-index:-1; animation:hcm-vs-hotspot-pulse 2.6s ease-in-out infinite;
}
.kyota .hcm-vs-hotspot:before { background:var(--green); }
@keyframes hcm-vs-hotspot-pulse {
  0%,100% { transform:scale(1); opacity:.18; }
  50%     { transform:scale(1.55); opacity:.04; }
}
@media (prefers-reduced-motion: reduce) { .hcm-vs-hotspot:before { animation:none; } }
.hcm-vs-hotspot:hover, .hcm-vs-hotspot:focus, .hcm-vs-hotspot:focus-visible {
  transform:scale(1.28); outline:none;
  box-shadow:0 0 0 9px rgba(58,77,114,.30), 0 5px 14px rgba(0,0,0,.30);
}
.kyota .hcm-vs-hotspot:hover, .kyota .hcm-vs-hotspot:focus, .kyota .hcm-vs-hotspot:focus-visible {
  box-shadow:0 0 0 9px rgba(138,90,58,.30), 0 5px 14px rgba(0,0,0,.30);
}
.hcm-vs-hotspot-label {
  position:absolute; bottom:calc(100% + 14px); left:50%;
  transform:translateX(-50%) translateY(4px);
  background:linear-gradient(135deg,#0a0a0c 0%,#1a140d 100%);
  color:#fff; padding:10px 14px; border-radius:10px;
  white-space:nowrap; opacity:0; visibility:hidden; pointer-events:none;
  transition:opacity .2s ease, transform .25s cubic-bezier(.2,.8,.2,1), visibility .2s;
  box-shadow:0 10px 26px rgba(0,0,0,.40); z-index:7;
  display:grid; gap:1px;
}
.hcm-vs-hotspot-label strong { display:block; font-size:12px; font-weight:850; color:#fff; letter-spacing:.02em; }
.hcm-vs-hotspot-label small { display:block; font-size:10.5px; font-weight:500; color:rgba(255,255,255,.72); font-style:italic; letter-spacing:0; margin-top:2px; }
.hcm-vs-hotspot-label:after {
  content:""; position:absolute; top:100%; left:50%;
  transform:translateX(-50%);
  width:0; height:0;
  border-left:6px solid transparent; border-right:6px solid transparent;
  border-top:6px solid #1a140d;
}
.hcm-vs-hotspot.flip .hcm-vs-hotspot-label { bottom:auto; top:calc(100% + 14px); transform:translateX(-50%) translateY(-4px); }
.hcm-vs-hotspot.flip .hcm-vs-hotspot-label:after { top:auto; bottom:100%; border-top:none; border-bottom:6px solid #1a140d; }
.hcm-vs-hotspot:hover .hcm-vs-hotspot-label,
.hcm-vs-hotspot:focus .hcm-vs-hotspot-label,
.hcm-vs-hotspot:focus-visible .hcm-vs-hotspot-label {
  opacity:1; visibility:visible; transform:translateX(-50%) translateY(0);
}
.hcm-vs-hotspot.flip:hover .hcm-vs-hotspot-label,
.hcm-vs-hotspot.flip:focus .hcm-vs-hotspot-label,
.hcm-vs-hotspot.flip:focus-visible .hcm-vs-hotspot-label {
  transform:translateX(-50%) translateY(0);
}
.hcm-vs-zonemap-tip { display:flex; align-items:center; justify-content:center; gap:8px; margin-top:18px; padding:10px 16px; background:rgba(255,255,255,.6); border:1px dashed var(--line); border-radius:999px; color:var(--soft); font-size:12px; font-weight:700; letter-spacing:.04em; max-width:fit-content; margin-left:auto; margin-right:auto; }
.hcm-vs-zonemap-tip span { font-size:14px; }

.hcm-vs-zonemap { display:grid; grid-template-columns:1.1fr .9fr; gap:38px; align-items:start; margin-top:54px; padding-top:54px; border-top:1px solid var(--line); }
.hcm-vs-zonemap:first-of-type { margin-top:0; padding-top:0; border-top:0; }
.hcm-vs-zonemap-visual { background:rgba(255,255,255,.65); border:1px solid var(--line); border-radius:28px; padding:28px; box-shadow:var(--shadow-soft); }
.hcm-vs-zonemap-pair { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.hcm-vs-zonemap-cell { position:relative; min-height:420px; background:linear-gradient(180deg,#fdfaf2 0%,var(--gold-soft) 100%); border:1px solid var(--line); border-radius:20px; overflow:visible; transition:transform .35s ease,box-shadow .35s ease; }
.hcm-vs-zonemap-cell.kyota { background:linear-gradient(180deg,#f4f8f5 0%,var(--green-soft) 100%); }
.hcm-vs-zonemap-cell:hover { transform:translateY(-2px); box-shadow:0 16px 32px rgba(0,0,0,.12); }
.hcm-vs-zonemap-copy { display:grid; gap:16px; padding-top:8px; }
.hcm-vs-zonemap-copy h3 { font-family:"Playfair Display",serif; font-size:28px; line-height:1.1; margin-bottom:8px; letter-spacing:-.005em; }
.hcm-vs-zonemap-copy > p { font-size:15.5px; line-height:1.7; }
.hcm-vs-zonemap-chip { display:inline-flex; align-items:center; gap:8px; padding:7px 14px; border-radius:999px; background:linear-gradient(135deg,var(--gold-soft) 0%,#f0e2c0 100%); color:var(--gold); font-size:11px; font-weight:900; letter-spacing:.16em; text-transform:uppercase; margin-bottom:6px; width:fit-content; border:1px solid rgba(154,128,80,.18); }
.hcm-vs-zonemap-chip:before { content:""; width:6px; height:6px; border-radius:50%; background:var(--gold); }
.hcm-vs-zonemap-callouts { display:grid; gap:12px; margin-top:8px; }
.hcm-vs-zonemap-callout { display:grid; grid-template-columns:34px 1fr; gap:14px; padding:16px 18px; background:#fff; border:1px solid var(--line); border-radius:16px; transition:all .25s ease; }
.hcm-vs-zonemap-callout:hover { border-color:var(--gold); box-shadow:0 8px 18px rgba(154,128,80,.10); }
.hcm-vs-zonemap-callout.kyota:hover { border-color:var(--green); box-shadow:0 8px 18px rgba(63,94,79,.10); }
.hcm-vs-zonemap-callout b { display:flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:50%; background:linear-gradient(145deg,var(--gold-2) 0%,var(--gold) 100%); color:#fff; font-size:12px; font-weight:900; box-shadow:0 4px 10px rgba(154,128,80,.32); }
.hcm-vs-zonemap-callout.kyota b { background:linear-gradient(145deg,var(--green-2) 0%,var(--green) 100%); box-shadow:0 4px 10px rgba(63,94,79,.32); }
.hcm-vs-zonemap-callout strong { color:var(--ink); font-size:14.5px; line-height:1.35; }
.hcm-vs-zonemap-callout span { color:var(--muted); font-size:13px; line-height:1.55; display:block; margin-top:3px; }

.hcm-vs-verdict-grid { display:grid; grid-template-columns:1fr 1fr; gap:28px; }
.hcm-vs-verdict { background:#fff; border:1px solid var(--line); border-radius:24px; padding:40px; box-shadow:var(--shadow-soft); position:relative; overflow:hidden; transition:all .35s ease; }
.hcm-vs-verdict:before { content:""; position:absolute; top:0; left:0; right:0; height:5px; background:var(--gold); }
.hcm-vs-verdict.kyota:before { background:var(--green); }
.hcm-vs-verdict:hover { transform:translateY(-4px); box-shadow:var(--shadow-lift); }
.hcm-vs-verdict h2 { font-size:32px; margin-bottom:10px; line-height:1.05; }
.hcm-vs-verdict p.lead { color:var(--charcoal); font-size:16px; margin-bottom:22px; font-weight:600; line-height:1.6; }
.hcm-vs-verdict .hcm-vs-eyebrow { color:var(--gold); }
.hcm-vs-verdict.kyota .hcm-vs-eyebrow { color:var(--green); }
.hcm-vs-verdict.kyota .hcm-vs-eyebrow:before { background:var(--green); }
.hcm-vs-list { display:grid; gap:12px; padding-top:18px; border-top:1px solid var(--line); }
.hcm-vs-list li { color:var(--muted); font-size:14.5px; line-height:1.6; padding-left:26px; position:relative; }
.hcm-vs-list li:before { content:""; position:absolute; left:0; top:9px; width:16px; height:2px; background:var(--gold); }
.hcm-vs-verdict.kyota .hcm-vs-list li:before { background:var(--green); }
.hcm-vs-verdict-cta { margin-top:26px; padding-top:22px; border-top:1px solid var(--line); }
.hcm-vs-expert-note { margin-top:36px; background:linear-gradient(135deg,#06070a 0%,#1d1810 100%); color:#fff; border-radius:22px; padding:34px 38px; display:grid; grid-template-columns:auto 1fr; gap:24px; align-items:center; }
.hcm-vs-expert-note .badge { display:inline-flex; align-items:center; justify-content:center; width:54px; height:54px; border-radius:50%; background:linear-gradient(145deg,var(--gold-3) 0%,var(--gold) 100%); color:#0a0a0c; font-family:"Playfair Display",serif; font-weight:900; font-size:20px; flex-shrink:0; }
.hcm-vs-expert-note p { color:rgba(255,255,255,.86); font-size:16px; line-height:1.72; }
.hcm-vs-expert-note p strong { color:var(--gold-3); font-weight:850; }

.hcm-vs-pers-grid { display:grid; grid-template-columns:1fr 1fr; gap:32px; }
.hcm-vs-pers { background:#fff; border:1px solid var(--line); border-radius:28px; padding:48px; box-shadow:var(--shadow-soft); position:relative; overflow:hidden; transition:all .35s ease; }
.hcm-vs-pers:hover { box-shadow:var(--shadow-lift); transform:translateY(-3px); }
.hcm-vs-pers:before { content:""; position:absolute; top:0; left:0; bottom:0; width:5px; background:var(--gold); }
.hcm-vs-pers.kyota:before { background:var(--green); }
.hcm-vs-pers .hcm-vs-eyebrow { font-size:11px; color:var(--gold); }
.hcm-vs-pers .hcm-vs-eyebrow:before { background:var(--gold); }
.hcm-vs-pers.kyota .hcm-vs-eyebrow { color:var(--green); }
.hcm-vs-pers.kyota .hcm-vs-eyebrow:before { background:var(--green); }
.hcm-vs-pers h2 { font-size:36px; margin-bottom:16px; line-height:1.05; letter-spacing:-.012em; }
.hcm-vs-pers p { font-size:16px; line-height:1.78; margin-bottom:14px; }
.hcm-vs-pers ul { display:grid; gap:12px; margin-top:24px; padding-top:24px; border-top:1px solid var(--line); }
.hcm-vs-pers ul li { color:var(--muted); font-size:14.5px; line-height:1.6; padding-left:26px; position:relative; }
.hcm-vs-pers ul li:before { content:""; position:absolute; left:0; top:8px; width:12px; height:12px; border-radius:50%; background:var(--gold-soft); border:3px solid var(--gold); }
.hcm-vs-pers.kyota ul li:before { background:var(--green-soft); border-color:var(--green); }

.hcm-vs-models { display:grid; gap:50px; }
.hcm-vs-models-block { position:relative; }
.hcm-vs-models-block-head { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:30px; padding-bottom:22px; border-bottom:1px solid var(--line); flex-wrap:wrap; gap:18px; }
.hcm-vs-models-block-head h3.brand-h { font-family:"Playfair Display",serif; font-size:36px; margin-bottom:8px; line-height:1.05; letter-spacing:-.01em; }
.hcm-vs-models-block-head .brand-sub { color:var(--muted); font-size:15px; max-width:560px; line-height:1.6; }
.hcm-vs-models-block-tag { display:inline-flex; align-items:center; gap:8px; padding:8px 14px; border-radius:999px; background:var(--gold-soft); color:var(--gold); font-size:11px; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
.hcm-vs-models-block-tag.kyota { background:var(--green-soft); color:var(--green); }
.hcm-vs-models-block-tag b { display:inline-block; width:6px; height:6px; border-radius:50%; background:currentColor; }
.hcm-vs-card-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.hcm-vs-card { background:#fff; border:1px solid var(--line); border-radius:22px; padding:18px; box-shadow:var(--shadow-soft); display:flex; flex-direction:column; transition:all .35s cubic-bezier(.2,.8,.2,1); position:relative; overflow:hidden; }
.hcm-vs-card:hover { transform:translateY(-6px); box-shadow:var(--shadow-lift); border-color:var(--gold); }
.hcm-vs-card.kyota:hover { border-color:var(--green); }
.hcm-vs-card-img { position:relative; aspect-ratio:1/1; background:linear-gradient(180deg,#fdfaf2 0%,var(--gold-soft) 100%); border-radius:16px; padding:14px; margin-bottom:18px; overflow:hidden; }
.hcm-vs-card.kyota .hcm-vs-card-img { background:linear-gradient(180deg,#f4f8f5 0%,var(--green-soft) 100%); }
.hcm-vs-card-img img { width:100%; height:100%; object-fit:contain; transition:transform .4s cubic-bezier(.2,.8,.2,1); }
.hcm-vs-card:hover .hcm-vs-card-img img { transform:scale(1.05); }
.hcm-vs-card-brand { position:absolute; top:12px; left:12px; padding:6px 12px; border-radius:999px; background:rgba(255,255,255,.95); border:1px solid var(--line); color:var(--gold); font-size:10px; font-weight:900; letter-spacing:.18em; text-transform:uppercase; box-shadow:0 4px 10px rgba(0,0,0,.06); }
.hcm-vs-card.kyota .hcm-vs-card-brand { color:var(--green); }
.hcm-vs-card-best { display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:999px; background:var(--gold-soft); color:var(--gold); font-size:10.5px; font-weight:900; letter-spacing:.12em; text-transform:uppercase; margin-bottom:12px; width:fit-content; border:1px solid var(--line); }
.hcm-vs-card.kyota .hcm-vs-card-best { background:var(--green-soft); color:var(--green); }
.hcm-vs-card-best:before { content:"★"; font-size:9px; }
.hcm-vs-card h4 { font-family:"Playfair Display",serif; font-size:20px; font-weight:800; line-height:1.18; margin-bottom:12px; min-height:48px; letter-spacing:-.005em; color:var(--ink); }
.hcm-vs-card-features { display:grid; gap:7px; margin:6px 0 14px; }
.hcm-vs-card-features li { color:var(--muted); font-size:13px; line-height:1.5; padding-left:18px; position:relative; }
.hcm-vs-card-features li:before { content:""; position:absolute; left:0; top:7px; width:8px; height:2px; background:var(--gold); }
.hcm-vs-card.kyota .hcm-vs-card-features li:before { background:var(--green); }
.hcm-vs-card-price { display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-top:1px solid var(--line); margin-top:auto; margin-bottom:12px; color:var(--soft); font-size:12px; font-weight:850; letter-spacing:.06em; text-transform:uppercase; }
.hcm-vs-card-price em { font-style:normal; color:var(--ink); }
.hcm-vs-card-actions { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.hcm-vs-card-actions .hcm-vs-btn { padding:11px 12px; min-height:42px; font-size:11.5px; }

.hcm-vs-table-shell { background:#fff; border:1px solid var(--line); border-radius:24px; box-shadow:var(--shadow-soft); overflow:hidden; }
.hcm-vs-table-shell + .hcm-vs-table-shell { margin-top:34px; }
.hcm-vs-table-cap { padding:26px 28px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:flex-start; gap:18px; flex-wrap:wrap; background:linear-gradient(180deg,#fbf9f4 0%,#fff 100%); }
.hcm-vs-table-cap h3 { font-family:"Playfair Display",serif; font-size:22px; margin-bottom:6px; line-height:1.1; }
.hcm-vs-table-cap p { font-size:13.5px; color:var(--soft); }
.hcm-vs-table-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }
.hcm-vs-table { width:100%; min-width:780px; border-collapse:collapse; font-size:14px; }
.hcm-vs-table th { background:var(--ink); color:#fff; padding:17px 20px; text-align:left; font-size:11px; letter-spacing:.18em; text-transform:uppercase; font-weight:900; }
.hcm-vs-table th.osaki { background:linear-gradient(135deg,var(--gold) 0%,var(--osaki-deep) 100%); }
.hcm-vs-table th.kyota { background:linear-gradient(135deg,var(--green) 0%,var(--kyota-deep) 100%); }
.hcm-vs-table td { padding:17px 20px; border-bottom:1px solid var(--line); vertical-align:top; color:var(--muted); font-size:13.5px; line-height:1.6; }
.hcm-vs-table tr:last-child td { border-bottom:0; }
.hcm-vs-table tr:hover td { background:#fbf9f4; }
.hcm-vs-table td:first-child { color:var(--ink); font-weight:850; width:24%; }
.hcm-vs-table tr:nth-child(even) td { background:#fdfcf8; }
.hcm-vs-pill { display:inline-flex; align-items:center; gap:5px; padding:4px 11px; border-radius:999px; background:var(--gold-soft); color:var(--gold); font-size:11px; font-weight:900; letter-spacing:.10em; text-transform:uppercase; border:1px solid var(--line); }
.hcm-vs-pill:before { content:""; width:5px; height:5px; border-radius:50%; background:currentColor; }
.hcm-vs-pill.kyota { background:var(--green-soft); color:var(--green); }
.hcm-vs-pill.both { background:#f1ece1; color:var(--ink); }
.hcm-vs-callout { margin-top:24px; background:linear-gradient(135deg,var(--gold-soft) 0%,#fff 100%); border-left:4px solid var(--gold); padding:20px 24px; color:var(--osaki-deep); font-size:14px; line-height:1.72; border-radius:8px; }

.hcm-vs-score-grid { display:grid; grid-template-columns:1fr 1fr; gap:28px; }
.hcm-vs-score-card { background:#fff; border:1px solid var(--line); border-radius:24px; padding:36px; box-shadow:var(--shadow-soft); position:relative; overflow:hidden; }
.hcm-vs-score-card:before { content:""; position:absolute; top:0; left:0; right:0; height:4px; background:var(--gold); }
.hcm-vs-score-card.kyota:before { background:var(--green); }
.hcm-vs-score-card h3 { font-family:"Playfair Display",serif; font-size:26px; margin-bottom:6px; line-height:1.1; }
.hcm-vs-score-note { color:var(--soft); font-size:12.5px; margin-bottom:28px; padding-bottom:20px; border-bottom:1px solid var(--line); line-height:1.5; }
.hcm-vs-meter { margin-top:16px; }
.hcm-vs-meter:first-child { margin-top:0; }
.hcm-vs-meter-top { display:flex; justify-content:space-between; gap:14px; color:var(--ink); font-size:13.5px; font-weight:850; margin-bottom:8px; }
.hcm-vs-meter-top em { font-style:normal; color:var(--soft); font-size:10.5px; font-weight:850; letter-spacing:.10em; text-transform:uppercase; }
.hcm-vs-track { height:8px; border-radius:999px; background:#f1ece1; overflow:hidden; }
.hcm-vs-fill { height:100%; border-radius:999px; background:linear-gradient(90deg,var(--gold) 0%,var(--gold-2) 50%,var(--gold-3) 100%); }
.hcm-vs-fill.green { background:linear-gradient(90deg,var(--green) 0%,var(--green-2) 50%,var(--green-3) 100%); }
.hcm-vs-microcopy { margin-top:22px; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:13px; line-height:1.65; font-style:italic; }

.hcm-vs-quote-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:24px; }
.hcm-vs-quote { background:#fff; border:1px solid var(--line); border-radius:22px; padding:32px; box-shadow:var(--shadow-soft); display:grid; grid-template-columns:auto 1fr; gap:22px; position:relative; overflow:hidden; }
