<script>
function hcmOrToggle(el){var b=el.nextElementSibling;var o=b.classList.contains('open');el.classList.toggle('active',!o);b.classList.toggle('open',!o);}
(function(){var obs=new IntersectionObserver(function(e){e.forEach(function(en){if(en.isIntersecting){en.target.querySelectorAll('.hcm-or-bar').forEach(function(b){b.style.width=b.dataset.width+'%';});obs.unobserve(en.target);}});},{threshold:0.3});var r=document.getElementById('ratingChart');if(r)obs.observe(r);})();
(function(){var ls=document.querySelectorAll('.hcm-or-nav a');var ids=['overview','ratings','themes','reviews','pros-cons','best-for','buyer-reviews','editorial','showrooms','faq'];window.addEventListener('scroll',function(){var p=window.scrollY+160;var a='';ids.forEach(function(id){var el=document.getElementById(id);if(el&&p>=el.offsetTop)a=id;});ls.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+a)l.classList.add('active');});});})();
(function(){var obs=new IntersectionObserver(function(e){e.forEach(function(en){if(en.isIntersecting){en.target.style.opacity='1';en.target.style.transform='translateY(0)';obs.unobserve(en.target);}});},{threshold:0.1});document.querySelectorAll('.hcm-or-cat,.hcm-or-buyer,.hcm-or-pros,.hcm-or-cons,.hcm-or-fit,.hcm-or-showroom,.hcm-or-tl').forEach(function(el){el.style.opacity='0';el.style.transform='translateY(20px)';el.style.transition='opacity 0.5s ease, transform 0.5s ease';obs.observe(el);});})();
</script>

