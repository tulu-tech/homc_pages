<style>
  :root {
    --osa-bg: #fff;
    --osa-surface: #f8fafc;
    --osa-surface2: #f1f5f9;
    --osa-dark: #000;
    --osa-muted: #555;
    --osa-muted2: #888;
    --osa-accent: #b38b4d;
    --osa-accent-h: #96723e;
    --osa-accent-pale: rgba(179,139,77,0.10);
    --osa-accent-pale2: rgba(179,139,77,0.06);
    --osa-border: #e5e9f0;
    --osa-border2: #d0d8e4;
    --osa-radius: 20px;
    --osa-radius-sm: 12px;
    --osa-shadow: 0 8px 30px rgba(0,0,0,0.07);
    --osa-shadow-hover: 0 20px 50px rgba(0,0,0,0.11);
  }

  .osa-wrap *{box-sizing:border-box;margin:0;padding:0}
  .osa-wrap{font-family:'Inter',sans-serif;color:var(--osa-dark);line-height:1.75;font-size:16px;-webkit-font-smoothing:antialiased}
  /* Force correct rem base regardless of theme root font-size */
  .osa-wrap,.osa-wrap p,.osa-wrap span,.osa-wrap li,.osa-wrap a,.osa-wrap h1,.osa-wrap h2,.osa-wrap h3,.osa-wrap h4,.osa-wrap button{box-sizing:border-box}
  /* Override Shopify theme small font-size on html root */
  .osa-wrap p{font-size:15px;color:var(--osa-muted);line-height:1.8}
  .osa-wrap li{font-size:14px}
  .osa-wrap h2{font-size:clamp(26px,3vw,38px)}
  .osa-wrap h3{font-size:clamp(16px,2vw,20px)}
  .osa-wrap h4{font-size:16px}
  .osa-wrap h1,.osa-wrap h2,.osa-wrap h3,.osa-wrap h4{line-height:1.15;font-weight:800;letter-spacing:-0.03em}
  .osa-wrap img{max-width:100%;display:block}

  .osa-container{max-width:1200px;margin:0 auto;padding:0 2rem}
  .osa-container-narrow{max-width:860px;margin:0 auto;padding:0 2rem}

  /* SUBNAV */
  .osa-subnav{background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--osa-border);overflow-x:auto;scrollbar-width:none}
  .osa-subnav::-webkit-scrollbar{display:none}
  .osa-subnav-inner{display:flex;padding:0 2rem;min-width:max-content}
  .osa-subnav-inner a{display:block;padding:.75rem 1rem;font-size:12px;font-weight:700;color:var(--osa-muted2);border-bottom:2px solid transparent;white-space:nowrap;transition:all .2s;text-transform:uppercase;letter-spacing:.08em}
  .osa-subnav-inner a:hover,.osa-subnav-inner a.active{color:var(--osa-dark);border-bottom-color:var(--osa-accent)}

  /* BUTTONS */
  .osa-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--osa-dark);color:#fff;padding:.9rem 2rem;font-size:15px;font-weight:700;border-radius:50px;transition:all .25s;border:2px solid var(--osa-dark);cursor:pointer;font-family:'Inter',sans-serif;letter-spacing:.01em;white-space:nowrap;text-decoration:none}
  .osa-btn:hover{background:#222;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.18)}
  .osa-btn-gold{background:var(--osa-accent);border-color:var(--osa-accent);color:#fff!important}
  .osa-btn-gold:hover{background:var(--osa-accent-h);border-color:var(--osa-accent-h);box-shadow:0 8px 24px rgba(179,139,77,.3)}
  .osa-btn-outline{background:transparent;color:var(--osa-dark);border-color:var(--osa-border2)}
  .osa-btn-outline:hover{border-color:var(--osa-dark);background:var(--osa-surface)}
  .osa-btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.35)}
  .osa-btn-ghost:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.7)}
  .osa-btn-sm{padding:.6rem 1.5rem;font-size:14px}

  /* HERO */
  .osa-hero{position:relative;min-height:84vh;display:flex;align-items:center;overflow:hidden;background:#080808}
  .osa-hero-bg{position:absolute;inset:0;background-image:url({% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2000 }}{% else %}https://cdn.shopify.com/s/files/1/0649/9516/4367/files/osaki-hero-bg.jpg?v=1776183407{% endif %});background-size:cover;background-position:center;opacity:.35;z-index:0;transform:scale(1.04)}
  .osa-hero-grad{position:absolute;inset:0;background:linear-gradient(110deg,rgba(0,0,0,.9) 30%,rgba(0,0,0,.35) 100%);z-index:1}
  .osa-hero-grain{position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");z-index:2;pointer-events:none}
  .osa-hero-content{position:relative;z-index:3;padding:5rem 0 5.5rem}
  .osa-hero-bc{font-size:12px;color:rgba(255,255,255,.4);margin-bottom:1.5rem}
  .osa-hero-bc a{color:var(--osa-accent);transition:color .2s}
  .osa-hero-bc a:hover{color:#fff}
  .osa-hero-bc span{margin:0 .4rem}
  .osa-hero-eye{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--osa-accent);margin-bottom:1.25rem}
  .osa-hero-eye::before{content:'';display:block;width:28px;height:2px;background:var(--osa-accent);border-radius:2px}
  .osa-hero h1{font-size:clamp(38px,5.5vw,64px);color:#fff;max-width:800px;margin-bottom:1.25rem;text-shadow:0 4px 30px rgba(0,0,0,.4);line-height:1.08}
  .osa-hero-lead{font-size:clamp(17px,1.5vw,20px);color:rgba(255,255,255,.8);max-width:620px;margin-bottom:.75rem;font-weight:600;line-height:1.65}
  .osa-hero-sub{font-size:16px;color:rgba(255,255,255,.52);max-width:580px;margin-bottom:2.5rem;line-height:1.75}
  .osa-hero-ctas{display:flex;gap:.875rem;flex-wrap:wrap;margin-bottom:3rem}
  .osa-hero-stats{display:flex;gap:0;border-top:1px solid rgba(255,255,255,.1);padding-top:2.5rem;flex-wrap:wrap}
  .osa-hero-stat{padding:0 2.5rem 0 0;border-right:1px solid rgba(255,255,255,.1);margin-right:2.5rem}
  .osa-hero-stat:last-child{border-right:none;margin-right:0}
  .osa-hero-stat-n{font-size:32px;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:4px;letter-spacing:-.04em}
  .osa-hero-stat-l{font-size:12px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.12em;font-weight:700}

  /* TRUST BAR */
  .osa-trust-bar{display:flex;justify-content:center;gap:3rem;padding:1.25rem 2rem;border-bottom:1px solid var(--osa-border);background:#fff;font-size:14px;font-weight:700;flex-wrap:wrap}
  .osa-trust-item{display:flex;align-items:center;gap:7px;color:var(--osa-muted)}
  .osa-trust-item svg{width:16px;height:16px;fill:var(--osa-accent);flex-shrink:0}

  /* SECTION */
  .osa-section{padding:5.5rem 0}
  .osa-section-alt{background:var(--osa-surface)}
  .osa-section-sm{padding:3.5rem 0}
  .osa-section-label{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--osa-accent);margin-bottom:.875rem}
  .osa-section-header{margin-bottom:3rem}
  .osa-section-header.center{text-align:center}
  .osa-section-header.center .osa-section-label{display:block}
  .osa-section-header h2{font-size:clamp(26px,3vw,38px);margin-bottom:.875rem}
  .osa-underline{position:relative;display:inline-block}
  .osa-underline::after{content:'';position:absolute;bottom:-4px;left:0;right:0;height:3px;background:var(--osa-accent);border-radius:2px}
  .osa-section-header p{font-size:17px;color:var(--osa-muted);max-width:680px;line-height:1.8}
  .osa-section-header.center p{margin:0 auto}

  /* PRODUCT SECTION */
  .osa-product-header{background:linear-gradient(135deg,#050505 0%,#181008 60%,#0a0a0a 100%);padding:3rem 3rem 0;border-radius:var(--osa-radius) var(--osa-radius) 0 0;position:relative;overflow:hidden}
  .osa-product-header::before{content:'';position:absolute;top:-40%;right:-10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.08) 0%,transparent 70%);pointer-events:none}
  .osa-product-header-inner{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding-bottom:2.5rem}
  .osa-product-header h2{color:#fff;font-size:clamp(24px,2.5vw,32px)}
  .osa-product-header p{color:rgba(255,255,255,.55);font-size:14px;max-width:560px;margin-top:.5rem;line-height:1.7}

  /* FILTER BAR */
  .osa-filter-bar{background:#fff;border:1px solid var(--osa-border);border-top:none;padding:1rem 1.5rem;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
  .osa-filter-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.16em;color:var(--osa-muted2);white-space:nowrap}
  .osa-filter-sep{width:1px;height:20px;background:var(--osa-border);flex-shrink:0}
  .osa-filter-btn{padding:6px 14px;border:1.5px solid var(--osa-border);border-radius:50px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;background:transparent;color:var(--osa-muted);font-family:'Inter',sans-serif;white-space:nowrap}
  .osa-filter-btn:hover{border-color:var(--osa-accent);color:var(--osa-accent);background:var(--osa-accent-pale2)}
  .osa-filter-btn.active{background:var(--osa-dark);color:#fff;border-color:var(--osa-dark)}
  .osa-filter-count{margin-left:auto;font-size:13px;color:var(--osa-muted2);font-weight:600}

  /* PRODUCT GRID */
  .osa-product-grid-wrap{background:var(--osa-surface);border:1px solid var(--osa-border);border-top:none;border-radius:0 0 var(--osa-radius) var(--osa-radius);padding:2rem}
  .osa-product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}

  /* PRODUCT CARD */
  .osa-product-card{background:#fff;border:1px solid var(--osa-border);border-radius:var(--osa-radius);overflow:hidden;transition:all .3s cubic-bezier(.25,.8,.25,1);position:relative;display:flex;flex-direction:column;cursor:pointer}
  .osa-product-card:hover{transform:translateY(-7px);box-shadow:var(--osa-shadow-hover);border-color:transparent;outline:2px solid var(--osa-accent)}
  .osa-product-badge{position:absolute;top:10px;left:10px;background:var(--osa-dark);color:#fff;font-size:10px;font-weight:800;padding:3px 10px;border-radius:50px;text-transform:uppercase;letter-spacing:.1em;z-index:2}
  .osa-product-badge.gold{background:var(--osa-accent)}
  .osa-product-badge.flagship{background:linear-gradient(135deg,#1a0a00,#3d2000);border:1px solid rgba(179,139,77,.4)}
  .osa-product-img-wrap{height:230px;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:linear-gradient(145deg,#fafafa,#fff);position:relative;overflow:hidden}
  .osa-product-img-wrap::before{content:'';position:absolute;bottom:0;left:0;right:0;height:60px;background:linear-gradient(to top,rgba(248,250,252,.8),transparent);pointer-events:none}
  .osa-product-img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s cubic-bezier(.25,.8,.25,1)}
  .osa-product-card:hover .osa-product-img{transform:scale(1.06)}
  .osa-product-img-wrap a{display:block;width:100%;height:100%;position:absolute;inset:0;z-index:1}
  .osa-product-body{padding:1.1rem 1.25rem 1.25rem;flex:1;display:flex;flex-direction:column}
  .osa-product-for{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--osa-accent);background:var(--osa-accent-pale);display:inline-block;padding:3px 8px;border-radius:20px;margin-bottom:.6rem}
  .osa-product-name{font-size:14px;font-weight:700;line-height:1.35;margin-bottom:.75rem;color:var(--osa-dark)}
  .osa-product-name a{color:inherit;text-decoration:none}
  .osa-product-feats{list-style:none;padding:0;margin:0 0 .875rem;flex:1}
  .osa-product-feats li{display:flex;align-items:flex-start;gap:5px;font-size:13px;color:var(--osa-muted);padding:2.5px 0;line-height:1.5}
  .osa-product-feats li::before{content:'✓';color:var(--osa-accent);font-weight:900;font-size:11px;flex-shrink:0;margin-top:2px}
  .osa-product-prices{display:flex;align-items:baseline;gap:7px;margin-bottom:.875rem;flex-wrap:wrap}
  .osa-price-sale{font-size:18px;font-weight:900;color:var(--osa-dark);letter-spacing:-.02em}
  .osa-price-was{font-size:13px;color:#adb5bd;text-decoration:line-through;font-weight:500}
  .osa-price-save{font-size:11px;font-weight:800;color:#16a34a;background:rgba(22,163,74,.08);padding:2px 7px;border-radius:20px}
  .osa-product-cta{display:block;text-align:center;background:var(--osa-dark);color:#fff;padding:.65rem;border-radius:var(--osa-radius-sm);font-weight:700;font-size:13px;transition:background .2s;text-decoration:none}
  .osa-product-cta:hover{background:var(--osa-accent);color:#fff}
  .osa-no-results{grid-column:1/-1;text-align:center;padding:4rem 0;color:var(--osa-muted)}

  /* QUICK ANSWER */
  .osa-quick-answer{background:linear-gradient(135deg,#050505 0%,#1a140a 100%);border-radius:24px;padding:3rem;border:1px solid rgba(179,139,77,.15);position:relative;overflow:hidden}
  .osa-quick-answer::before{content:'';position:absolute;top:-30%;right:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.06) 0%,transparent 70%);pointer-events:none}
  .osa-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;margin-top:2rem;position:relative;z-index:1}
  .osa-qa-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:1.5rem;transition:all .3s}
  .osa-qa-item:hover{background:rgba(255,255,255,.07);border-color:rgba(179,139,77,.25)}
  .osa-qa-item h3{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--osa-accent);margin-bottom:.625rem;font-weight:800}
  .osa-qa-item p{font-size:14px;color:rgba(255,255,255,.65);line-height:1.75;margin:0}

  /* PILLARS */
  .osa-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .osa-pillar-card{background:#fff;border:1px solid var(--osa-border);border-radius:var(--osa-radius);padding:2rem;transition:all .3s;position:relative;overflow:hidden}
  .osa-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--osa-accent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .osa-pillar-card:hover{transform:translateY(-5px);box-shadow:var(--osa-shadow)}
  .osa-pillar-card:hover::before{transform:scaleX(1)}
  .osa-pillar-icon{width:48px;height:48px;background:var(--osa-accent-pale);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:1.125rem}
  .osa-pillar-icon svg{width:24px;height:24px;fill:var(--osa-accent)}
  .osa-pillar-card h3{font-size:16px;margin-bottom:.5rem}
  .osa-pillar-card p{font-size:14px;color:var(--osa-muted);margin:0;line-height:1.7}

  /* AT A GLANCE */
  .osa-glance-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
  .osa-glance-table{width:100%;border-collapse:collapse}
  .osa-glance-table tr{border-bottom:1px solid var(--osa-border)}
  .osa-glance-table tr:last-child{border-bottom:none}
  .osa-glance-table td{padding:.875rem .5rem;font-size:14px;vertical-align:top}
  .osa-glance-table td:first-child{font-weight:800;color:var(--osa-dark);width:38%}
  .osa-glance-table td:last-child{color:var(--osa-muted)}
  .osa-glance-verdict{background:linear-gradient(145deg,#080808,#171208);border-radius:var(--osa-radius);padding:2.25rem;border:1px solid rgba(179,139,77,.12)}
  .osa-glance-verdict h3{color:#fff;font-size:17px;margin-bottom:1.25rem}
  .osa-verdict-item{display:flex;align-items:flex-start;gap:10px;padding:.625rem 0;border-bottom:1px solid rgba(255,255,255,.06)}
  .osa-verdict-item:last-child{border-bottom:none;padding-bottom:0}
  .osa-verdict-dot{width:7px;height:7px;border-radius:50%;background:var(--osa-accent);flex-shrink:0;margin-top:8px}
  .osa-verdict-item p{font-size:13px;color:rgba(255,255,255,.62);margin:0;line-height:1.65}

  /* WHO IT'S FOR */
  .osa-for-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .osa-for-card{border-radius:var(--osa-radius);padding:2rem;border:1px solid var(--osa-border);background:#fff}
  .osa-for-card.alt{background:var(--osa-surface)}
  .osa-for-badge{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:4px 12px;border-radius:50px;display:inline-block;margin-bottom:1.125rem}
  .osa-for-badge.yes{background:rgba(34,197,94,.1);color:#16a34a}
  .osa-for-badge.no{background:rgba(239,68,68,.1);color:#dc2626}
  .osa-for-list{list-style:none;padding:0}
  .osa-for-list li{display:flex;align-items:flex-start;gap:8px;padding:.55rem 0;border-bottom:1px solid var(--osa-border);font-size:14px;color:var(--osa-muted);line-height:1.6}
  .osa-for-list li:last-child{border-bottom:none}
  .osa-for-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:7px}
  .osa-for-dot.yes{background:#16a34a}
  .osa-for-dot.no{background:#dc2626}

  /* MODEL ENTRIES */
  .osa-model-entry{display:grid;grid-template-columns:260px 1fr;border-radius:var(--osa-radius);overflow:hidden;border:1px solid var(--osa-border);background:#fff;margin-bottom:1.75rem;transition:box-shadow .3s}
  .osa-model-entry:hover{box-shadow:var(--osa-shadow-hover)}
  .osa-model-side{background:linear-gradient(160deg,#080808,#171208);padding:2.25rem 1.75rem;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}
  .osa-model-side-img{width:100%;height:180px;object-fit:contain;margin:.75rem 0 .5rem;transition:transform .4s ease}
  .osa-model-entry:hover .osa-model-side-img{transform:scale(1.08)}
  .osa-model-side a{display:block;cursor:pointer}
  .osa-model-tier{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--osa-accent);margin-bottom:.4rem}
  .osa-model-side h3{color:#fff;font-size:17px;line-height:1.3}
  .osa-model-price-band{display:inline-flex;gap:5px;margin-top:1rem;font-size:12px;font-weight:700;color:rgba(255,255,255,.45);background:rgba(255,255,255,.05);padding:5px 11px;border-radius:20px;flex-wrap:wrap}
  .osa-model-price-band span{color:var(--osa-accent)}
  .osa-model-body{padding:2.25rem}
  .osa-model-best{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--osa-accent);background:var(--osa-accent-pale);display:inline-block;padding:3px 10px;border-radius:20px;margin-bottom:.875rem}
  .osa-model-body h4{font-size:16px;margin-bottom:.625rem}
  .osa-model-body p{font-size:14px;color:var(--osa-muted);line-height:1.75;margin-bottom:.875rem}
  .osa-model-traits{display:flex;gap:.4rem;flex-wrap:wrap;margin:.875rem 0}
  .osa-trait{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:var(--osa-surface2);border:1px solid var(--osa-border);color:var(--osa-muted2)}
  .osa-model-tradeoff{margin-top:1rem;padding:.875rem 1.125rem;border-radius:10px;background:var(--osa-surface);border-left:3px solid var(--osa-border2);font-size:13px;color:var(--osa-muted2);line-height:1.65}
  .osa-model-link{display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--osa-accent);margin-top:1.25rem;border-bottom:1px solid rgba(179,139,77,.3);padding-bottom:2px;transition:all .2s;text-decoration:none}
  .osa-model-link:hover{gap:9px;border-bottom-color:var(--osa-accent)}

  /* BUYER TYPES */
  .osa-buyer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
  .osa-buyer-card{background:#fff;border:1px solid var(--osa-border);border-radius:var(--osa-radius);padding:1.75rem;transition:all .3s;position:relative;overflow:hidden}
  .osa-buyer-card:hover{border-color:var(--osa-accent);box-shadow:0 10px 30px rgba(179,139,77,.1)}
  .osa-buyer-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--osa-accent),transparent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .osa-buyer-card:hover::after{transform:scaleX(1)}
  .osa-buyer-icon{width:42px;height:42px;background:var(--osa-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:.875rem}
  .osa-buyer-icon svg{width:20px;height:20px;fill:var(--osa-accent)}
  .osa-buyer-type{font-size:11px;font-weight:800;color:var(--osa-muted2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}
  .osa-buyer-card h3{font-size:14px;margin-bottom:.4rem}
  .osa-buyer-card p{font-size:13px;color:var(--osa-muted);margin:0;line-height:1.7}
  .osa-buyer-rec{margin-top:.625rem;font-size:12px;font-weight:700;color:var(--osa-accent)}

  /* COMPARE TABLE */
  .osa-compare-wrap{overflow-x:auto;border-radius:14px;border:1px solid var(--osa-border)}
  .osa-compare-table{width:100%;border-collapse:collapse;font-size:13px;min-width:680px}
  .osa-compare-table th{background:var(--osa-dark);color:#fff;padding:.875rem 1.125rem;text-align:left;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.07em}
  .osa-compare-table td{padding:.8rem 1.125rem;border-bottom:1px solid var(--osa-border);color:var(--osa-muted);vertical-align:middle}
  .osa-compare-table tr:last-child td{border-bottom:none}
  .osa-compare-table tr:hover td{background:var(--osa-surface)}
  .osa-col-feature{font-weight:800;color:var(--osa-dark)!important;white-space:nowrap}
  .osa-osaki-col{background:rgba(179,139,77,.04)!important}
  thead .osa-osaki-col{background:rgba(179,139,77,.12)!important;color:var(--osa-accent)!important;border-bottom:3px solid var(--osa-accent)!important}
  .osa-check{color:var(--osa-accent);font-weight:800}

  /* EXPERT CALLOUT */
  .osa-expert-callout{background:#fff;border:1px solid var(--osa-border);border-left:4px solid var(--osa-accent);border-radius:0 12px 12px 0;padding:1.5rem 1.75rem;display:flex;align-items:flex-start;gap:.875rem}
  .osa-expert-callout svg{width:26px;height:26px;fill:var(--osa-accent);flex-shrink:0;margin-top:1px}
  .osa-expert-callout p{font-size:14px;color:var(--osa-muted);line-height:1.75;margin:0}
  .osa-expert-callout strong{color:var(--osa-dark)}

  /* PRICE LADDER */
  .osa-price-ladder{border:1px solid var(--osa-border);border-radius:var(--osa-radius);overflow:hidden}
  .osa-price-rung{display:grid;grid-template-columns:140px 1fr;border-bottom:1px solid var(--osa-border);transition:background .2s}
  .osa-price-rung:last-child{border-bottom:none}
  .osa-price-rung:hover{background:var(--osa-surface)}
  .osa-price-rung-label{background:var(--osa-dark);padding:1.5rem;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.08)}
  .osa-price-tier-name{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.45);font-weight:700;margin-bottom:3px}
  .osa-price-amount{font-size:16px;font-weight:900;color:var(--osa-accent);letter-spacing:-.02em}
  .osa-price-rung-body{padding:1.5rem 2rem}
  .osa-price-rung-body h4{font-size:14px;margin-bottom:.35rem}
  .osa-price-rung-body p{font-size:13px;color:var(--osa-muted);margin:0;line-height:1.65}
  .osa-price-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.625rem}
  .osa-price-tag{font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;background:var(--osa-accent-pale);color:var(--osa-accent)}

  /* TRUST & REVIEW CARDS */
  .osa-trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .osa-trust-card{background:#fff;border:1px solid var(--osa-border);border-radius:var(--osa-radius);padding:1.75rem;transition:all .3s}
  .osa-trust-card:hover{transform:translateY(-4px);box-shadow:var(--osa-shadow)}
  .osa-trust-card-icon{width:44px;height:44px;background:var(--osa-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem}
  .osa-trust-card-icon svg{width:22px;height:22px;fill:var(--osa-accent)}
  .osa-trust-card h3{font-size:15px;margin-bottom:.5rem}
  .osa-trust-card p{font-size:14px;color:var(--osa-muted);margin:0;line-height:1.7}
  .osa-review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .osa-review-card{background:#fff;border:1px solid var(--osa-border);border-radius:var(--osa-radius);padding:1.75rem;transition:all .3s;position:relative}
  .osa-review-card:hover{transform:translateY(-3px);box-shadow:var(--osa-shadow)}
  .osa-review-card::before{content:'"';position:absolute;top:1rem;right:1.25rem;font-size:64px;color:var(--osa-accent-pale);font-weight:900;line-height:1;pointer-events:none}
  .osa-review-stars{color:var(--osa-accent);letter-spacing:2px;font-size:13px;margin-bottom:.625rem}
  .osa-review-text{font-size:14px;color:var(--osa-muted);line-height:1.75;margin-bottom:1.125rem;font-style:italic}
  .osa-review-author{display:flex;align-items:center;gap:9px}
  .osa-review-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:#fff;flex-shrink:0}
  .osa-review-name{font-weight:700;font-size:14px}
  .osa-review-meta{font-size:12px;color:var(--osa-muted2)}

  /* SHOWROOM */
  .osa-showroom-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .osa-showroom-card{border:1px solid var(--osa-border);border-radius:var(--osa-radius);overflow:hidden;transition:all .3s}
  .osa-showroom-card:hover{transform:translateY(-4px);box-shadow:var(--osa-shadow-hover)}
  .osa-showroom-head{background:linear-gradient(135deg,#080808,#171208);padding:2rem 2.25rem 1.75rem}
  .osa-showroom-pill{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--osa-accent);background:rgba(179,139,77,.15);padding:3px 10px;border-radius:20px;display:inline-block;margin-bottom:.625rem}
  .osa-showroom-head h3{color:#fff;font-size:17px;margin-bottom:.3rem}
  .osa-showroom-head p{color:rgba(255,255,255,.5);font-size:13px;margin:0}
  .osa-showroom-body{background:#fff;padding:1.75rem 2.25rem}
  .osa-showroom-row{display:flex;align-items:flex-start;gap:8px;padding:.5rem 0;border-bottom:1px solid var(--osa-border);font-size:13px}
  .osa-showroom-row:last-child{border-bottom:none}
  .osa-showroom-row svg{width:16px;height:16px;fill:var(--osa-accent);flex-shrink:0;margin-top:2px}
  .osa-showroom-btns{margin-top:1.25rem;display:flex;gap:.625rem;flex-wrap:wrap}

  /* FINAL CTA */
  .osa-final-cta{background:linear-gradient(135deg,#050505 0%,#1a110a 60%,#050505 100%);border-radius:28px;padding:4rem;position:relative;overflow:hidden}
  .osa-final-cta::before{content:'';position:absolute;top:-40%;right:-8%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.1) 0%,transparent 70%);pointer-events:none}
  .osa-final-cta::after{content:'';position:absolute;bottom:-30%;left:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.06) 0%,transparent 70%);pointer-events:none}
  .osa-final-cta-inner{position:relative;z-index:1}
  .osa-final-cta h2{color:#fff;font-size:clamp(29px,3vw,42px);margin-bottom:.875rem;line-height:1.12}
  .osa-final-cta p{color:rgba(255,255,255,.65);font-size:16px;max-width:640px;margin-bottom:2rem;line-height:1.75}
  .osa-cta-points{display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:2rem}
  .osa-cta-point{display:flex;align-items:center;gap:7px}
  .osa-cta-point svg{width:16px;height:16px;fill:var(--osa-accent);flex-shrink:0}
  .osa-cta-point span{font-size:13px;color:rgba(255,255,255,.6);font-weight:600}
  .osa-final-cta-btns{display:flex;gap:.875rem;flex-wrap:wrap}

  /* ANSWER BLOCKS */
  .osa-answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
  .osa-answer-block{background:#fff;border:1px solid var(--osa-border);border-radius:14px;padding:1.75rem;transition:all .3s}
  .osa-answer-block:hover{border-color:var(--osa-border2);box-shadow:0 4px 16px rgba(0,0,0,.05)}
  .osa-answer-block h3{font-size:14px;margin-bottom:.5rem}
  .osa-answer-block p{font-size:13px;color:var(--osa-muted);margin:0;line-height:1.75}

  /* FAQ */
  .osa-faq-item{border-bottom:1px solid var(--osa-border)}
  .osa-faq-q{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;cursor:pointer;gap:1rem}
  .osa-faq-q h3{font-size:16px;margin:0;font-weight:700;transition:color .2s;line-height:1.4}
  .osa-faq-q:hover h3{color:var(--osa-accent)}
  .osa-faq-icon{width:22px;height:22px;fill:var(--osa-muted2);flex-shrink:0;transition:transform .3s}
  .osa-faq-q.active .osa-faq-icon{transform:rotate(45deg)}
  .osa-faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease}
  .osa-faq-a.open{max-height:500px}
  .osa-faq-a p{margin:0;padding-bottom:1.4rem;font-size:15px;color:var(--osa-muted);line-height:1.8}
  .osa-faq-a a{color:var(--osa-accent);font-weight:700}

  /* LINK PILLS */
  .osa-link-pills{display:flex;flex-wrap:wrap;gap:.625rem;justify-content:center}
  .osa-link-pill{padding:.55rem 1.25rem;border:1.5px solid var(--osa-border);border-radius:50px;font-size:13px;font-weight:700;color:var(--osa-dark);background:#fff;transition:all .3s;text-decoration:none}
  .osa-link-pill:hover{border-color:var(--osa-accent);color:var(--osa-accent);background:var(--osa-accent-pale);transform:translateY(-2px)}

  /* RESPONSIVE */
  @media(max-width:1024px){
    .osa-pillar-grid{grid-template-columns:1fr 1fr}
    .osa-product-grid{grid-template-columns:1fr 1fr}
    .osa-trust-grid{grid-template-columns:1fr 1fr}
  }
  @media(max-width:900px){
    .osa-hero{min-height:65vh}
    .osa-hero h1{font-size:35px}
    .osa-glance-grid,.osa-for-grid,.osa-model-entry,.osa-buyer-grid,.osa-showroom-grid,.osa-qa-grid,.osa-answer-grid{grid-template-columns:1fr}
    .osa-pillar-grid,.osa-trust-grid,.osa-review-grid{grid-template-columns:1fr}
    .osa-product-grid{grid-template-columns:1fr 1fr;gap:1rem}
    .osa-section{padding:3.5rem 0}
    .osa-final-cta{padding:2.5rem 2rem}
    .osa-product-header-inner{flex-direction:column;align-items:flex-start}
    .osa-price-rung{grid-template-columns:1fr}
    .osa-price-rung-label{border-right:none;border-bottom:1px solid rgba(255,255,255,.08)}
  }
  @media(max-width:600px){
    .osa-product-grid{grid-template-columns:1fr}
    .osa-hero h1{font-size:30px}
    .osa-container{padding:0 1.25rem}
    .osa-product-header{padding:2rem 1.5rem 0}
    .osa-product-grid-wrap{padding:1.25rem}
  }
</style>

