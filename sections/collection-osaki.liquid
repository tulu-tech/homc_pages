{%- comment -%} ══════════ JAVASCRIPT ══════════ {%- endcomment -%}
<script>
// ─── DYNAMIC PRODUCT DATA FROM LIQUID ───────────────────────────────────────
var OSAKI_PRODUCTS = [
  {%- for product in collection.products -%}
    {%- assign feat_img = product.featured_image | image_url: width: 600 -%}
    {%- assign sale_price_cents = product.price -%}
    {%- assign compare_price_cents = product.compare_at_price -%}

    {%- comment -%} Build filter tags array from product tags {%- endcomment -%}
    {%- assign filter_tags = "" -%}
    {%- for tag in product.tags -%}
      {%- assign tag_low = tag | downcase -%}
      {%- if tag_low == "duo" or tag_low == "ai" or tag_low == "5d" or tag_low == "flagship" -%}
        {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: "," -%}{%- endif -%}
        {%- assign filter_tags = filter_tags | append: '"' | append: tag_low | append: '"' -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Auto-detect badge from tags {%- endcomment -%}
    {%- assign auto_badge = "" -%}
    {%- assign auto_badge_class = "" -%}
    {%- if product.tags contains "flagship" -%}
      {%- assign auto_badge = "Flagship" -%}
      {%- assign auto_badge_class = "flagship" -%}
    {%- elsif product.tags contains "5d" -%}
      {%- assign auto_badge = "5D" -%}
      {%- assign auto_badge_class = "flagship" -%}
    {%- elsif product.tags contains "duo" -%}
      {%- assign auto_badge = "Duo" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- elsif product.tags contains "ai" -%}
      {%- assign auto_badge = "AI" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- endif -%}

    {%- comment -%} Use metafield badge if set, otherwise auto {%- endcomment -%}
    {%- assign badge_val = product.metafields.custom.badge.value | default: auto_badge -%}
    {%- assign badge_class_val = product.metafields.custom.badge_class.value | default: auto_badge_class -%}
    {%- assign buyer_for_val = product.metafields.custom.buyer_for.value | default: product.type -%}

    {%- comment -%} Key features: from metafield list or fallback {%- endcomment -%}
    {%- assign feats_json = product.metafields.custom.key_features.value -%}
    {%- if feats_json == blank -%}
      {%- assign feats_json = '["Premium massage technology","Zero gravity recline","Body scanning system","Air compression"]' -%}
    {%- endif -%}

    {
      n: {{ product.title | json }},
      u: {{ product.url | prepend: shop.url | json }},
      i: {{ feat_img | json }},
      p: {{ product.price | money | json }},
      cp: {% if compare_price_cents > sale_price_cents %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      tags: [{{ filter_tags }}],
      badge: {{ badge_val | json }},
      badgeClass: {{ badge_class_val | json }},
      for: {{ buyer_for_val | json }},
      feats: {{ feats_json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];

// ─── FILTER LOGIC ─────────────────────────────────────────────────────────
var osaCurrentFilter = {type:'all',value:'all'};

function osaFilter(btn,type,value){
  document.querySelectorAll('#osaFilterBar .osa-filter-btn').forEach(function(b){b.classList.remove('active')});
  btn.classList.add('active');
  osaCurrentFilter = {type:type,value:value};
  osaRenderProducts();
}

function osaFilteredProducts(){
  return OSAKI_PRODUCTS.filter(function(p){
    if(osaCurrentFilter.type==='all') return true;
    if(osaCurrentFilter.type==='price'){
      var num = parseFloat(p.p.replace(/[^0-9.]/g,''));
      if(osaCurrentFilter.value==='under5') return num<5000;
      if(osaCurrentFilter.value==='5to10') return num>=5000&&num<10000;
      if(osaCurrentFilter.value==='10to14') return num>=10000&&num<14000;
      if(osaCurrentFilter.value==='over14') return num>=14000;
    }
    if(osaCurrentFilter.type==='type') return p.tags.indexOf(osaCurrentFilter.value)!==-1;
    return true;
  });
}

function osaSaveCalc(p,cp){
  if(!cp) return '';
  var ps=parseFloat(p.replace(/[^0-9.]/g,'')),cs=parseFloat(cp.replace(/[^0-9.]/g,''));
  if(cs<=ps) return '';
  var pct=Math.round((cs-ps)/cs*100);
  return '<span class="osa-price-save">Save '+pct+'%</span>';
}

function osaRenderProducts(){
  var grid=document.getElementById('osaGrid');
  var count=document.getElementById('osaCount');
  var prods=osaFilteredProducts();
  if(count) count.textContent=prods.length+' model'+(prods.length!==1?'s':'');
  if(!grid) return;

  if(prods.length===0){
    grid.innerHTML='<div class="osa-no-results"><p>No models match this filter.</p></div>';
    return;
  }

  grid.style.opacity='0';
  grid.innerHTML='';

  prods.forEach(function(p){
    var saveHtml=osaSaveCalc(p.p,p.cp);
    var featsHtml=Array.isArray(p.feats)?p.feats.map(function(f){return '<li>'+f+'</li>';}).join(''):'';
    var badgeHtml=p.badge?'<span class="osa-product-badge '+p.badgeClass+'">'+p.badge+'</span>':'';
    var priceHtml='<span class="osa-price-sale">'+p.p+'</span>';
    if(p.cp) priceHtml+=' <span class="osa-price-was">'+p.cp+'</span>';
    if(saveHtml) priceHtml+=' '+saveHtml;

    var card=document.createElement('article');
    card.className='osa-product-card';
    card.innerHTML=
      badgeHtml+
            '<a href="'+p.u+'" class="osa-product-img-link" style="display:block;position:relative;"><div class="osa-product-img-wrap"><img class="osa-product-img" src="'+p.i+'" alt="'+p.n+'" loading="lazy"></div></a>'+
      '<div class="osa-product-body">'+
        '<div class="osa-product-for">'+p.for+'</div>'+
        '<div class="osa-product-name"><a href="'+p.u+'">'+p.n+'</a></div>'+
        '<ul class="osa-product-feats">'+featsHtml+'</ul>'+
        '<div class="osa-product-prices">'+priceHtml+'</div>'+
        '<a href="'+p.u+'" class="osa-product-cta">View Details</a>'+
      '</div>';
    grid.appendChild(card);
  });

  setTimeout(function(){grid.style.opacity='1';grid.style.transition='opacity .3s';},40);
}

// ─── FAQ ACCORDION ────────────────────────────────────────────────────────
function osaFaq(el){
  var a=el.nextElementSibling;
  var isOpen=a.classList.contains('open');
  document.querySelectorAll('.osa-faq-a').forEach(function(x){x.classList.remove('open')});
  document.querySelectorAll('.osa-faq-q').forEach(function(x){x.classList.remove('active')});
  if(!isOpen){a.classList.add('open');el.classList.add('active');}
}

// ─── SUBNAV ACTIVE STATE ──────────────────────────────────────────────────
(function(){
  var links=document.querySelectorAll('.osa-subnav-inner a');
  var ids=['osa-collection','osa-intro','osa-comparison','osa-3d-vs-4d','osa-technology','osa-model-guide','osa-buyer-types','osa-room-fit','osa-pricing','osa-trust','osa-showrooms','osa-faq'];
  window.addEventListener('scroll',function(){
    var pos=window.scrollY+140,active='';
    ids.forEach(function(id){var el=document.getElementById(id);if(el&&pos>=el.offsetTop)active=id;});
    links.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+active)l.classList.add('active');});
  });
})();

// ─── INIT ─────────────────────────────────────────────────────────────────
osaRenderProducts();
</script>

{%- endpaginate -%}

{% schema %}
