<style>
  /* ── DESIGN TOKENS ── */
  :root {
    --fji-bg: #fff;
    --fji-surface: #f8fafc;
    --fji-surface2: #f1f5f9;
    --fji-dark: #000;
    --fji-muted: #555;
    --fji-muted2: #888;
    --fji-accent: #b38b4d;
    --fji-accent-h: #96723e;
    --fji-accent-pale: rgba(179,139,77,0.10);
    --fji-accent-pale2: rgba(179,139,77,0.06);
    --fji-border: #e5e9f0;
    --fji-border2: #d0d8e4;
    --fji-radius: 20px;
    --fji-radius-sm: 12px;
    --fji-shadow: 0 8px 30px rgba(0,0,0,0.07);
    --fji-shadow-hover: 0 20px 50px rgba(0,0,0,0.11);
  }

  /* ── RESET & WRAPPER ──
     fji-wrap isolates all styles from the Shopify theme's root font-size.
     Every font size uses absolute px — NO rem anywhere.
  */
  .fji-wrap *{box-sizing:border-box;margin:0;padding:0}
  .fji-wrap{font-family:'Inter',sans-serif;color:var(--fji-dark);line-height:1.75;font-size:16px;-webkit-font-smoothing:antialiased}
  .fji-wrap p{font-size:15px;color:var(--fji-muted);line-height:1.8}
  .fji-wrap li{font-size:14px}
  .fji-wrap h1{font-size:clamp(38px,5.5vw,64px)}
  .fji-wrap h2{font-size:clamp(26px,3vw,38px)}
  .fji-wrap h3{font-size:clamp(16px,2vw,20px)}
  .fji-wrap h4{font-size:16px}
  .fji-wrap h1,.fji-wrap h2,.fji-wrap h3,.fji-wrap h4{line-height:1.15;font-weight:800;letter-spacing:-0.03em;color:var(--fji-dark)}
  .fji-wrap img{max-width:100%;display:block}
  .fji-wrap a{text-decoration:none}

  /* ── LAYOUT ── */
  .fji-container{max-width:1200px;margin:0 auto;padding:0 2rem}
  .fji-container-narrow{max-width:860px;margin:0 auto;padding:0 2rem}

  /* ── SUBNAV ── */
  .fji-subnav{background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--fji-border);overflow-x:auto;scrollbar-width:none}
  .fji-subnav::-webkit-scrollbar{display:none}
  .fji-subnav-inner{display:flex;padding:0 2rem;min-width:max-content}
  .fji-subnav-inner a{display:block;padding:.75rem 1rem;font-size:12px;font-weight:700;color:var(--fji-muted2);border-bottom:2px solid transparent;white-space:nowrap;transition:all .2s;text-transform:uppercase;letter-spacing:.08em}
  .fji-subnav-inner a:hover,.fji-subnav-inner a.fji-active{color:var(--fji-dark);border-bottom-color:var(--fji-accent)}

  /* ── BUTTONS ── */
  .fji-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--fji-dark);color:#fff;padding:.9rem 2rem;font-size:15px;font-weight:700;border-radius:50px;transition:all .25s;border:2px solid var(--fji-dark);cursor:pointer;font-family:'Inter',sans-serif;letter-spacing:.01em;white-space:nowrap;text-decoration:none}
  .fji-btn:hover{background:#222;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.18)}
  .fji-btn-gold{background:var(--fji-accent);border-color:var(--fji-accent);color:#fff!important}
  .fji-btn-gold:hover{background:var(--fji-accent-h);border-color:var(--fji-accent-h);box-shadow:0 8px 24px rgba(179,139,77,.3)}
  .fji-btn-outline{background:transparent;color:var(--fji-dark);border-color:var(--fji-border2)}
  .fji-btn-outline:hover{border-color:var(--fji-dark);background:var(--fji-surface)}
  .fji-btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.35)}
  .fji-btn-ghost:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.7)}
  .fji-btn-sm{padding:.6rem 1.5rem;font-size:14px}

  /* ── HERO ── */
  .fji-hero{position:relative;min-height:84vh;display:flex;align-items:center;overflow:hidden;background:#080808}
  .fji-hero-bg{position:absolute;inset:0;background-image:url({% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2000 }}{% else %}https://cdn.shopify.com/s/files/1/0649/9516/4367/files/fujiiryoki-hero-bg.jpg?v=1776369234{% endif %});background-size:cover;background-position:center;opacity:.32;z-index:0}
  .fji-hero-grad{position:absolute;inset:0;background:linear-gradient(110deg,rgba(0,0,0,.92) 30%,rgba(0,0,0,.38) 100%);z-index:1}
  .fji-hero-glow{position:absolute;top:-10%;right:-8%;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.07),transparent 70%);z-index:2;pointer-events:none}
  .fji-hero-content{position:relative;z-index:3;padding:5rem 0 5.5rem}
  .fji-hero-bc{font-size:12px;color:rgba(255,255,255,.38);margin-bottom:1.5rem}
  .fji-hero-bc a{color:var(--fji-accent);transition:color .2s}
  .fji-hero-bc a:hover{color:#fff}
  .fji-hero-bc span{margin:0 .4rem}
  .fji-hero-eye{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--fji-accent);margin-bottom:1.25rem;background:rgba(179,139,77,.1);padding:5px 14px;border-radius:50px;border:1px solid rgba(179,139,77,.18)}
  .fji-hero h1{color:#fff;max-width:800px;margin-bottom:1.25rem;text-shadow:0 4px 30px rgba(0,0,0,.4);line-height:1.08}
  .fji-hero-lead{font-size:clamp(17px,1.5vw,20px);color:rgba(255,255,255,.8);max-width:620px;margin-bottom:.75rem;font-weight:600;line-height:1.65}
  .fji-hero-sub{font-size:16px;color:rgba(255,255,255,.5);max-width:580px;margin-bottom:2.5rem;line-height:1.75}
  .fji-hero-ctas{display:flex;gap:.875rem;flex-wrap:wrap;margin-bottom:3rem}
  .fji-hero-stats{display:flex;border-top:1px solid rgba(255,255,255,.1);padding-top:2.5rem;flex-wrap:wrap}
  .fji-hero-stat{padding:0 2.5rem 0 0;border-right:1px solid rgba(255,255,255,.1);margin-right:2.5rem}
  .fji-hero-stat:last-child{border-right:none;margin-right:0}
  .fji-hero-stat-n{font-size:32px;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:4px;letter-spacing:-.04em}
  .fji-hero-stat-l{font-size:12px;color:rgba(255,255,255,.38);text-transform:uppercase;letter-spacing:.12em;font-weight:700}

  /* ── TRUST BAR ── */
  .fji-trust-bar{display:flex;justify-content:center;gap:3rem;padding:1.25rem 2rem;border-bottom:1px solid var(--fji-border);background:#fff;font-size:14px;font-weight:700;flex-wrap:wrap}
  .fji-trust-item{display:flex;align-items:center;gap:7px;color:var(--fji-muted)}
  .fji-trust-item svg{width:16px;height:16px;fill:var(--fji-accent);flex-shrink:0}

  /* ── SECTION ── */
  .fji-section{padding:5.5rem 0}
  .fji-section-alt{background:var(--fji-surface)}
  .fji-section-sm{padding:3.5rem 0}
  .fji-section-label{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--fji-accent);margin-bottom:.875rem}
  .fji-section-header{margin-bottom:3rem}
  .fji-section-header.center{text-align:center}
  .fji-section-header.center .fji-section-label{display:block}
  .fji-section-header h2{font-size:clamp(26px,3vw,38px);margin-bottom:.875rem}
  .fji-section-header p{font-size:17px;color:var(--fji-muted);max-width:680px;line-height:1.8}
  .fji-section-header.center p{margin:0 auto}
  .fji-accent-u{display:inline-block;background:linear-gradient(90deg,var(--fji-accent),#d4a96a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

  /* ── PRODUCT SECTION ── */
  .fji-product-header{background:linear-gradient(135deg,#050505,#181008 60%,#0a0a0a);padding:3rem 3rem 0;border-radius:var(--fji-radius) var(--fji-radius) 0 0;position:relative;overflow:hidden}
  .fji-product-header::before{content:'';position:absolute;top:-40%;right:-10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.08),transparent 70%);pointer-events:none}
  .fji-product-header-inner{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding-bottom:2.5rem}
  .fji-product-header h2{color:#fff;font-size:clamp(24px,2.5vw,32px)}
  .fji-product-header p{color:rgba(255,255,255,.55);font-size:14px;max-width:560px;margin-top:.5rem;line-height:1.7}

  /* ── FILTER BAR ── */
  .fji-filter-bar{background:#fff;border:1px solid var(--fji-border);border-top:none;padding:1rem 1.5rem;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
  .fji-filter-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.16em;color:var(--fji-muted2);white-space:nowrap}
  .fji-filter-sep{width:1px;height:20px;background:var(--fji-border);flex-shrink:0}
  .fji-filter-btn{padding:6px 14px;border:1.5px solid var(--fji-border);border-radius:50px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;background:transparent;color:var(--fji-muted);font-family:'Inter',sans-serif;white-space:nowrap}
  .fji-filter-btn:hover{border-color:var(--fji-accent);color:var(--fji-accent);background:var(--fji-accent-pale2)}
  .fji-filter-btn.active{background:var(--fji-dark);color:#fff;border-color:var(--fji-dark)}
  .fji-filter-count{margin-left:auto;font-size:13px;color:var(--fji-muted2);font-weight:600}

  /* ── PRODUCT GRID ── */
  .fji-product-grid-wrap{background:var(--fji-surface);border:1px solid var(--fji-border);border-top:none;border-radius:0 0 var(--fji-radius) var(--fji-radius);padding:2rem}
  .fji-product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}

  /* ── PRODUCT CARD ── */
  .fji-product-card{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);overflow:hidden;transition:all .3s cubic-bezier(.25,.8,.25,1);position:relative;display:flex;flex-direction:column}
  .fji-product-card:hover{transform:translateY(-7px);box-shadow:var(--fji-shadow-hover);border-color:transparent;outline:2px solid var(--fji-accent)}
  .fji-product-badge{position:absolute;top:10px;left:10px;background:var(--fji-dark);color:#fff;font-size:10px;font-weight:800;padding:3px 10px;border-radius:50px;text-transform:uppercase;letter-spacing:.1em;z-index:2}
  .fji-product-badge.gold{background:var(--fji-accent)}
  .fji-product-badge.flagship{background:linear-gradient(135deg,#1a0a00,#3d2000);color:#d4a96a;border:1px solid rgba(179,139,77,.4)}
  .fji-product-img-wrap{height:230px;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:linear-gradient(145deg,#fafafa,#fff);position:relative;overflow:hidden}
  .fji-product-img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s}
  .fji-product-card:hover .fji-product-img{transform:scale(1.06)}
  .fji-product-img-link{display:block;width:100%;height:100%;position:absolute;inset:0;z-index:1}
  .fji-product-body{padding:1.1rem 1.25rem 1.25rem;flex:1;display:flex;flex-direction:column}
  .fji-product-for{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--fji-accent);background:var(--fji-accent-pale);display:inline-block;padding:3px 8px;border-radius:20px;margin-bottom:.6rem}
  .fji-product-name{font-size:14px;font-weight:700;line-height:1.35;margin-bottom:.75rem;color:var(--fji-dark)}
  .fji-product-name a{color:inherit}
  .fji-product-feats{list-style:none;padding:0;margin:0 0 .875rem;flex:1}
  .fji-product-feats li{display:flex;align-items:flex-start;gap:5px;font-size:13px;color:var(--fji-muted);padding:2.5px 0;line-height:1.5}
  .fji-product-feats li::before{content:'✓';color:var(--fji-accent);font-weight:900;font-size:11px;flex-shrink:0;margin-top:2px}
  .fji-product-prices{display:flex;align-items:baseline;gap:7px;margin-bottom:.875rem;flex-wrap:wrap}
  .fji-price-sale{font-size:18px;font-weight:900;color:var(--fji-dark);letter-spacing:-.02em}
  .fji-price-was{font-size:13px;color:#adb5bd;text-decoration:line-through;font-weight:500}
  .fji-price-save{font-size:11px;font-weight:800;color:#16a34a;background:rgba(22,163,74,.08);padding:2px 7px;border-radius:20px}
  .fji-product-cta{display:block;text-align:center;background:var(--fji-dark);color:#fff;padding:.65rem;border-radius:var(--fji-radius-sm);font-weight:700;font-size:13px;transition:background .2s}
  .fji-product-cta:hover{background:var(--fji-accent);color:#fff}
  .fji-no-results{grid-column:1/-1;text-align:center;padding:4rem 0;color:var(--fji-muted)}

  /* ── QUICK ANSWER ── */
  .fji-quick-answer{background:linear-gradient(135deg,#050505,#1a140a);border-radius:24px;padding:3rem;border:1px solid rgba(179,139,77,.15);position:relative;overflow:hidden}
  .fji-quick-answer::before{content:'';position:absolute;top:-30%;right:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.06),transparent 70%);pointer-events:none}
  .fji-qa-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:2rem;position:relative;z-index:1}
  .fji-qa-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:1.5rem;transition:all .3s}
  .fji-qa-item:hover{background:rgba(255,255,255,.07);border-color:rgba(179,139,77,.25)}
  .fji-qa-item h3{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--fji-accent);margin-bottom:.625rem;font-weight:800}
  .fji-qa-item p{font-size:14px;color:rgba(255,255,255,.65);line-height:1.75;margin:0}

  /* ── PILLARS ── */
  .fji-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .fji-pillar-card{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:2rem;transition:all .3s;position:relative;overflow:hidden}
  .fji-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--fji-accent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .fji-pillar-card:hover{transform:translateY(-5px);box-shadow:var(--fji-shadow)}
  .fji-pillar-card:hover::before{transform:scaleX(1)}
  .fji-pillar-icon{width:48px;height:48px;background:var(--fji-accent-pale);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:1.125rem}
  .fji-pillar-icon svg{width:24px;height:24px;fill:var(--fji-accent)}
  .fji-pillar-card h3{font-size:16px;margin-bottom:.5rem}
  .fji-pillar-card p{font-size:14px;color:var(--fji-muted);margin:0;line-height:1.7}

  /* ── FEATURE IMAGE ── */
  .fji-feature-img-wrap{border-radius:24px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.4);position:relative}
  .fji-feature-img-wrap img{width:100%;display:block}
  .fji-feature-img-caption{position:absolute;bottom:0;left:0;right:0;padding:1.25rem 2rem;background:linear-gradient(to top,rgba(0,0,0,.85),transparent);font-size:12px;color:rgba(255,255,255,.5);font-weight:700;letter-spacing:.12em;text-transform:uppercase}

  /* ── AT A GLANCE ── */
  .fji-glance-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
  .fji-glance-table{width:100%;border-collapse:collapse}
  .fji-glance-table tr{border-bottom:1px solid var(--fji-border)}
  .fji-glance-table tr:last-child{border-bottom:none}
  .fji-glance-table td{padding:.875rem .5rem;font-size:14px;vertical-align:top}
  .fji-glance-table td:first-child{font-weight:800;color:var(--fji-dark);width:38%}
  .fji-glance-table td:last-child{color:var(--fji-muted)}
  .fji-glance-verdict{background:linear-gradient(145deg,#080808,#171208);border-radius:var(--fji-radius);padding:2.25rem;border:1px solid rgba(179,139,77,.12)}
  .fji-glance-verdict h3{color:#fff;font-size:17px;margin-bottom:1.25rem}
  .fji-verdict-item{display:flex;align-items:flex-start;gap:10px;padding:.625rem 0;border-bottom:1px solid rgba(255,255,255,.06)}
  .fji-verdict-item:last-child{border-bottom:none;padding-bottom:0}
  .fji-verdict-dot{width:7px;height:7px;border-radius:50%;background:var(--fji-accent);flex-shrink:0;margin-top:8px}
  .fji-verdict-item p{font-size:13px;color:rgba(255,255,255,.62);margin:0;line-height:1.65}

  /* ── WHO IT'S FOR ── */
  .fji-for-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .fji-for-card{border-radius:var(--fji-radius);padding:2rem;border:1px solid var(--fji-border);background:#fff}
  .fji-for-card.alt{background:var(--fji-surface)}
  .fji-for-badge{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:4px 12px;border-radius:50px;display:inline-block;margin-bottom:1.125rem}
  .fji-for-badge.yes{background:rgba(34,197,94,.1);color:#16a34a}
  .fji-for-badge.no{background:rgba(239,68,68,.08);color:#dc2626}
  .fji-for-list{list-style:none;padding:0}
  .fji-for-list li{display:flex;align-items:flex-start;gap:8px;padding:.55rem 0;border-bottom:1px solid var(--fji-border);font-size:14px;color:var(--fji-muted);line-height:1.6}
  .fji-for-list li:last-child{border-bottom:none}
  .fji-for-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:7px}
  .fji-for-dot.yes{background:#16a34a}
  .fji-for-dot.no{background:#dc2626}

  /* ── MODEL ENTRIES ── */
  .fji-model-entry{display:grid;grid-template-columns:260px 1fr;border-radius:var(--fji-radius);overflow:hidden;border:1px solid var(--fji-border);background:#fff;margin-bottom:1.75rem;transition:box-shadow .3s}
  .fji-model-entry:hover{box-shadow:var(--fji-shadow-hover)}
  .fji-model-side{background:linear-gradient(160deg,#080808,#171208);padding:2.25rem 1.75rem;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}
  .fji-model-side-imgbox{background:#fff;border-radius:12px;padding:1rem;margin:.75rem 0 .5rem;display:flex;align-items:center;justify-content:center;min-height:180px;max-height:220px;overflow:hidden}
  .fji-model-side-img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s}
  .fji-model-entry:hover .fji-model-side-img{transform:scale(1.08)}
  .fji-model-tier{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--fji-accent);margin-bottom:.4rem}
  .fji-model-side h3{color:#fff;font-size:17px;line-height:1.3}
  .fji-model-side-desc{font-size:12px;color:rgba(255,255,255,.42);line-height:1.6;margin-top:.375rem}
  .fji-model-price-band{display:inline-flex;gap:5px;margin-top:.875rem;font-size:12px;font-weight:700;color:rgba(255,255,255,.45);background:rgba(255,255,255,.05);padding:5px 11px;border-radius:20px}
  .fji-model-price-band span{color:var(--fji-accent)}
  .fji-model-body{padding:2.25rem}
  .fji-model-best{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--fji-accent);background:var(--fji-accent-pale);display:inline-block;padding:3px 10px;border-radius:20px;margin-bottom:.875rem}
  .fji-model-body h4{font-size:16px;margin-bottom:.625rem}
  .fji-model-body p{font-size:14px;color:var(--fji-muted);line-height:1.75;margin-bottom:.875rem}
  .fji-model-traits{display:flex;gap:.4rem;flex-wrap:wrap;margin:.875rem 0}
  .fji-trait{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:var(--fji-surface2);border:1px solid var(--fji-border);color:var(--fji-muted2)}
  .fji-model-tradeoff{margin-top:1rem;padding:.875rem 1.125rem;border-radius:10px;background:var(--fji-surface);border-left:3px solid var(--fji-border2);font-size:13px;color:var(--fji-muted2);line-height:1.65}
  .fji-model-link{display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--fji-accent);margin-top:1.25rem;border-bottom:1px solid rgba(179,139,77,.3);padding-bottom:2px;transition:all .2s;text-decoration:none}
  .fji-model-link:hover{gap:9px;border-bottom-color:var(--fji-accent)}

  /* ── BUYER TYPES ── */
  .fji-buyer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
  .fji-buyer-card{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:1.75rem;transition:all .3s;position:relative;overflow:hidden}
  .fji-buyer-card:hover{border-color:var(--fji-accent);box-shadow:0 10px 30px rgba(179,139,77,.1)}
  .fji-buyer-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--fji-accent),transparent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .fji-buyer-card:hover::after{transform:scaleX(1)}
  .fji-buyer-icon{width:42px;height:42px;background:var(--fji-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:.875rem}
  .fji-buyer-icon svg{width:20px;height:20px;fill:var(--fji-accent)}
  .fji-buyer-type{font-size:11px;font-weight:800;color:var(--fji-muted2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}
  .fji-buyer-card h3{font-size:14px;margin-bottom:.4rem}
  .fji-buyer-card p{font-size:13px;color:var(--fji-muted);margin:0;line-height:1.7}
  .fji-buyer-rec{margin-top:.625rem;font-size:12px;font-weight:700;color:var(--fji-accent)}

  /* ── COMPARE TABLE ── */
  .fji-compare-wrap{overflow-x:auto;border-radius:14px;border:1px solid var(--fji-border)}
  .fji-compare-table{width:100%;border-collapse:collapse;font-size:13px;min-width:700px}
  .fji-compare-table th{background:var(--fji-dark);color:#fff;padding:.875rem 1.125rem;text-align:left;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.07em}
  .fji-compare-table td{padding:.8rem 1.125rem;border-bottom:1px solid var(--fji-border);color:var(--fji-muted);vertical-align:middle}
  .fji-compare-table tr:last-child td{border-bottom:none}
  .fji-compare-table tr:hover td{background:var(--fji-surface)}
  .fji-col-feat{font-weight:800;color:var(--fji-dark)!important;white-space:nowrap}
  .fji-fji-col{background:rgba(179,139,77,.04)!important}
  thead .fji-fji-col{background:rgba(179,139,77,.14)!important;color:var(--fji-accent)!important;border-bottom:3px solid var(--fji-accent)!important}
  .fji-check{color:var(--fji-accent);font-weight:800}

  /* ── EXPERT CALLOUT ── */
  .fji-expert-callout{background:#fff;border:1px solid var(--fji-border);border-left:4px solid var(--fji-accent);border-radius:0 12px 12px 0;padding:1.5rem 1.75rem;display:flex;align-items:flex-start;gap:.875rem}
  .fji-expert-callout svg{width:26px;height:26px;fill:var(--fji-accent);flex-shrink:0;margin-top:1px}
  .fji-expert-callout p{font-size:14px;color:var(--fji-muted);line-height:1.75;margin:0}
  .fji-expert-callout strong{color:var(--fji-dark)}

  /* ── PRICE LADDER ── */
  .fji-price-ladder{border:1px solid var(--fji-border);border-radius:var(--fji-radius);overflow:hidden}
  .fji-price-rung{display:grid;grid-template-columns:140px 1fr;border-bottom:1px solid var(--fji-border);transition:background .2s}
  .fji-price-rung:last-child{border-bottom:none}
  .fji-price-rung:hover{background:var(--fji-surface)}
  .fji-price-rung-label{background:var(--fji-dark);padding:1.5rem;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.08)}
  .fji-price-tier-name{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.45);font-weight:700;margin-bottom:3px}
  .fji-price-amount{font-size:16px;font-weight:900;color:var(--fji-accent);letter-spacing:-.02em}
  .fji-price-rung-body{padding:1.5rem 2rem}
  .fji-price-rung-body h4{font-size:14px;margin-bottom:.35rem}
  .fji-price-rung-body p{font-size:13px;color:var(--fji-muted);margin:0;line-height:1.65}
  .fji-price-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.625rem}
  .fji-price-tag{font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;background:var(--fji-accent-pale);color:var(--fji-accent)}

  /* ── TRUST & REVIEW CARDS ── */
  .fji-trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .fji-trust-card{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:1.75rem;transition:all .3s}
  .fji-trust-card:hover{transform:translateY(-4px);box-shadow:var(--fji-shadow)}
  .fji-trust-card-icon{width:44px;height:44px;background:var(--fji-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem}
  .fji-trust-card-icon svg{width:22px;height:22px;fill:var(--fji-accent)}
  .fji-trust-card h3{font-size:15px;margin-bottom:.5rem}
  .fji-trust-card p{font-size:14px;color:var(--fji-muted);margin:0;line-height:1.7}
  .fji-review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .fji-review-card{background:#fff;border:1px solid var(--fji-border);border-radius:var(--fji-radius);padding:1.75rem;transition:all .3s;position:relative}
  .fji-review-card:hover{transform:translateY(-3px);box-shadow:var(--fji-shadow)}
  .fji-review-card::before{content:'"';position:absolute;top:1rem;right:1.25rem;font-size:64px;color:var(--fji-accent-pale);font-weight:900;line-height:1;pointer-events:none}
  .fji-review-stars{color:var(--fji-accent);letter-spacing:2px;font-size:13px;margin-bottom:.625rem}
  .fji-review-text{font-size:14px;color:var(--fji-muted);line-height:1.75;margin-bottom:1.125rem;font-style:italic}
  .fji-review-author{display:flex;align-items:center;gap:9px}
  .fji-review-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:#fff;flex-shrink:0}
  .fji-review-name{font-weight:700;font-size:14px}
  .fji-review-meta{font-size:12px;color:var(--fji-muted2)}

  /* ── SHOWROOM ── */
  .fji-showroom-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .fji-showroom-card{border:1px solid var(--fji-border);border-radius:var(--fji-radius);overflow:hidden;transition:all .3s}
  .fji-showroom-card:hover{transform:translateY(-4px);box-shadow:var(--fji-shadow-hover)}
  .fji-showroom-head{background:linear-gradient(135deg,#080808,#171208);padding:2rem 2.25rem 1.75rem}
  .fji-showroom-pill{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--fji-accent);background:rgba(179,139,77,.15);padding:3px 10px;border-radius:20px;display:inline-block;margin-bottom:.625rem}
  .fji-showroom-head h3{color:#fff;font-size:17px;margin-bottom:.3rem}
  .fji-showroom-head p{color:rgba(255,255,255,.5);font-size:13px;margin:0}
  .fji-showroom-body{background:#fff;padding:1.75rem 2.25rem}
  .fji-showroom-row{display:flex;align-items:flex-start;gap:8px;padding:.5rem 0;border-bottom:1px solid var(--fji-border);font-size:13px}
  .fji-showroom-row:last-of-type{border-bottom:none}
  .fji-showroom-row svg{width:16px;height:16px;fill:var(--fji-accent);flex-shrink:0;margin-top:2px}
  .fji-showroom-btns{margin-top:1.25rem;display:flex;gap:.625rem;flex-wrap:wrap}

  /* ── ANSWER BLOCKS ── */
  .fji-answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
  .fji-answer-block{background:#fff;border:1px solid var(--fji-border);border-radius:14px;padding:1.75rem;transition:all .3s}
  .fji-answer-block:hover{border-color:var(--fji-border2);box-shadow:0 4px 16px rgba(0,0,0,.05)}
  .fji-answer-block h3{font-size:14px;margin-bottom:.5rem}
  .fji-answer-block p{font-size:13px;color:var(--fji-muted);margin:0;line-height:1.75}

  /* ── FAQ ── */
  .fji-faq-item{border-bottom:1px solid var(--fji-border)}
  .fji-faq-q{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;cursor:pointer;gap:1rem}
  .fji-faq-q h3{font-size:16px;margin:0;font-weight:700;transition:color .2s;line-height:1.4}
  .fji-faq-q:hover h3{color:var(--fji-accent)}
  .fji-faq-icon{width:22px;height:22px;fill:var(--fji-muted2);flex-shrink:0;transition:transform .3s}
  .fji-faq-q.active .fji-faq-icon{transform:rotate(45deg)}
  .fji-faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease}
  .fji-faq-a.open{max-height:500px}
  .fji-faq-a p{margin:0;padding-bottom:1.4rem;font-size:15px;color:var(--fji-muted);line-height:1.8}
  .fji-faq-a a{color:var(--fji-accent);font-weight:700}

  /* ── FINAL CTA ── */
  .fji-final-cta{background:linear-gradient(135deg,#050505,#1a110a 60%,#050505);border-radius:28px;padding:4rem;position:relative;overflow:hidden}
  .fji-final-cta::before{content:'';position:absolute;top:-40%;right:-8%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.1),transparent 70%);pointer-events:none}
  .fji-final-cta-inner{position:relative;z-index:1}
  .fji-final-cta h2{color:#fff;font-size:clamp(29px,3vw,42px);margin-bottom:.875rem;line-height:1.12}
  .fji-final-cta p{color:rgba(255,255,255,.65);font-size:16px;max-width:640px;margin-bottom:2rem;line-height:1.75}
  .fji-cta-points{display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:2rem}
  .fji-cta-point{display:flex;align-items:center;gap:7px}
  .fji-cta-point svg{width:16px;height:16px;fill:var(--fji-accent);flex-shrink:0}
  .fji-cta-point span{font-size:13px;color:rgba(255,255,255,.6);font-weight:600}
  .fji-final-cta-btns{display:flex;gap:.875rem;flex-wrap:wrap}

  /* ── LINK PILLS ── */
  .fji-link-pills{display:flex;flex-wrap:wrap;gap:.625rem;justify-content:center}
  .fji-link-pill{padding:.55rem 1.25rem;border:1.5px solid var(--fji-border);border-radius:50px;font-size:13px;font-weight:700;color:var(--fji-dark);background:#fff;transition:all .3s;text-decoration:none}
  .fji-link-pill:hover{border-color:var(--fji-accent);color:var(--fji-accent);background:var(--fji-accent-pale);transform:translateY(-2px)}

  /* ── RESPONSIVE ── */
  @media(max-width:1024px){
    .fji-pillar-grid,.fji-trust-grid{grid-template-columns:1fr 1fr}
    .fji-product-grid{grid-template-columns:1fr 1fr}
  }
  @media(max-width:900px){
    .fji-hero{min-height:65vh}
    .fji-hero h1{font-size:35px}
    .fji-glance-grid,.fji-for-grid,.fji-model-entry,.fji-buyer-grid,.fji-showroom-grid,.fji-qa-grid,.fji-answer-grid{grid-template-columns:1fr}
    .fji-pillar-grid,.fji-trust-grid,.fji-review-grid{grid-template-columns:1fr}
    .fji-product-grid{grid-template-columns:1fr 1fr;gap:1rem}
    .fji-section{padding:3.5rem 0}
    .fji-final-cta{padding:2.5rem 2rem}
    .fji-product-header-inner{flex-direction:column;align-items:flex-start}
    .fji-price-rung{grid-template-columns:1fr}
    .fji-price-rung-label{border-right:none;border-bottom:1px solid rgba(255,255,255,.08)}
  }
  @media(max-width:600px){
    .fji-product-grid{grid-template-columns:1fr}
    .fji-hero h1{font-size:30px}
    .fji-container{padding:0 1.25rem}
    .fji-product-header{padding:2rem 1.5rem 0}
    .fji-product-grid-wrap{padding:1.25rem}
  }
</style>

