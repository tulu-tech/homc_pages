{%- comment -%} ══════════════════ JAVASCRIPT ══════════════════ {%- endcomment -%}
<script>
// ── PRODUCT DATA ────────────────────────────────────────────────────────────
var FJI_PRODUCTS = [
  {%- for product in collection.products limit:50 -%}
    {%- assign feat_img = product.featured_image | image_url: width: 600 -%}
    {%- assign tags_low = product.tags | join: ',' | downcase -%}

    {%- comment -%} Build type tag array {%- endcomment -%}
    {%- assign ftags = '' -%}
    {%- if tags_low contains 'cyber-relax' or product.title contains 'Cyber' -%}{%- assign ftags = ftags | append: '"cyber-relax",' -%}{%- endif -%}
    {%- if tags_low contains 'ai' or product.title contains ' Ai' -%}{%- assign ftags = ftags | append: '"ai",' -%}{%- endif -%}
    {%- if tags_low contains '4d' or product.title contains '4D' -%}{%- assign ftags = ftags | append: '"4d",' -%}{%- endif -%}
    {%- assign ftags = ftags | remove_last: ',' -%}

    {%- comment -%} Badge auto-detect {%- endcomment -%}
    {%- assign auto_badge = product.metafields.custom.badge.value | default: '' -%}
    {%- assign auto_bc = product.metafields.custom.badge_class.value | default: 'standard' -%}
    {%- if auto_badge == '' -%}
      {%- assign title_l = product.title | downcase -%}
      {%- if title_l contains ' ai' or tags_low contains 'ai' -%}{%- assign auto_badge = 'AI' -%}{%- assign auto_bc = 'gold' -%}
      {%- elsif title_l contains 'pro' or tags_low contains 'flagship' -%}{%- assign auto_badge = 'Flagship' -%}{%- assign auto_bc = 'flagship' -%}
      {%- elsif title_l contains '4d' or tags_low contains '4d' -%}{%- assign auto_badge = '4D' -%}{%- assign auto_bc = 'gold' -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Features: use metafield or fallback {%- endcomment -%}
    {%- assign feats_raw = product.metafields.custom.key_features.value | default: '["Premium Japanese engineering","Refined massage feel","Advanced body scanning","Premium build quality"]' -%}

    {
      n: {{ product.title | json }},
      u: {{ product.url | prepend: shop.url | json }},
      img: {{ feat_img | json }},
      p: {{ product.price | money | json }},
      pc: {{ product.price }},
      cp: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      tags: [{{ ftags }}],
      badge: {{ auto_badge | json }},
      bc: {{ auto_bc | json }},
      bFor: {{ product.metafields.custom.buyer_for.value | default: product.type | default: 'Premium Japanese' | json }},
      feats: {{ feats_raw }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];

// ── FILTER ──────────────────────────────────────────────────────────────────
var _fjiFilter = {type:'all',value:'all'};

function fujiFilter(btn, type, value) {
  document.querySelectorAll('#fji-filter-bar .fji-filter-btn').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  _fjiFilter = {type:type, value:value};
  fjiBuildGrid();
}

function fjiFiltered() {
  return FJI_PRODUCTS.filter(function(p) {
    if (_fjiFilter.type === 'all') return true;
    if (_fjiFilter.type === 'price') {
      var pc = p.pc / 100;
      if (_fjiFilter.value === 'under5')  return pc < 5000;
      if (_fjiFilter.value === '5to10')   return pc >= 5000 && pc < 10000;
      if (_fjiFilter.value === 'over10')  return pc >= 10000;
    }
    if (_fjiFilter.type === 'type') return p.tags.indexOf(_fjiFilter.value) !== -1;
    return true;
  });
}

function fjiBuildGrid() {
  var grid = document.getElementById('fji-grid');
  var countEl = document.getElementById('fji-count');
  var prods = fjiFiltered();
  if (countEl) countEl.textContent = prods.length + ' model' + (prods.length !== 1 ? 's' : '');
  if (!grid) return;
  if (prods.length === 0) {
    grid.innerHTML = '<div class="fji-no-results"><p style="font-size:15px">No models match this filter. <a href="#" onclick="fujiFilter(document.querySelector(\'.fji-filter-btn\'),\'all\',\'all\');return false;" style="color:var(--fji-accent);font-weight:700">View all models</a></p></div>';
    return;
  }
  grid.style.opacity = '0';
  grid.innerHTML = '';
  prods.forEach(function(p) {
    var badgeHtml = p.badge ? '<span class="fji-product-badge ' + p.bc + '">' + p.badge + '</span>' : '';
    var cpHtml = p.cp ? '<span class="fji-price-was">' + p.cp + '</span>' : '';
    var saveHtml = '';
    if (p.cp) {
      var orig = parseFloat(p.cp.replace(/[^0-9.]/g, '')), sale = parseFloat(p.p.replace(/[^0-9.]/g, ''));
      if (orig > sale) saveHtml = '<span class="fji-price-save">Save ' + Math.round((orig - sale) / orig * 100) + '%</span>';
    }
    var featsHtml = Array.isArray(p.feats) ? p.feats.map(function(f){ return '<li>' + f + '</li>'; }).join('') : '';
    var card = document.createElement('article');
    card.className = 'fji-product-card';
    card.innerHTML =
      badgeHtml +
      '<div class="fji-product-img-wrap">' +
        '<a class="fji-product-img-link" href="' + p.u + '"></a>' +
        '<img class="fji-product-img" src="' + p.img + '" alt="' + p.n + '" loading="lazy">' +
      '</div>' +
      '<div class="fji-product-body">' +
        '<div class="fji-product-for">' + p.bFor + '</div>' +
        '<div class="fji-product-name"><a href="' + p.u + '">' + p.n + '</a></div>' +
        '<ul class="fji-product-feats">' + featsHtml + '</ul>' +
        '<div class="fji-product-prices"><span class="fji-price-sale">' + p.p + '</span>' + cpHtml + saveHtml + '</div>' +
        '<a href="' + p.u + '" class="fji-product-cta">View Details &rarr;</a>' +
      '</div>';
    grid.appendChild(card);
  });
  setTimeout(function(){ grid.style.transition = 'opacity .3s'; grid.style.opacity = '1'; }, 40);
}

// ── FAQ ─────────────────────────────────────────────────────────────────────
function fjiFaq(el) {
  var a = el.nextElementSibling;
  var open = a.classList.contains('open');
  document.querySelectorAll('.fji-faq-a').forEach(function(x){ x.classList.remove('open'); });
  document.querySelectorAll('.fji-faq-q').forEach(function(x){ x.classList.remove('active'); });
  if (!open) { a.classList.add('open'); el.classList.add('active'); }
}

// ── SCROLL SPY ──────────────────────────────────────────────────────────────
(function() {
  var links = document.querySelectorAll('.fji-subnav-inner a');
  var ids = ['fji-collection','fji-overview','fji-why','fji-model-guide','fji-buyer-types','fji-vs-brands','fji-pricing','fji-trust','fji-showrooms','fji-faq'];
  window.addEventListener('scroll', function() {
    var pos = window.scrollY + 140, active = '';
    ids.forEach(function(id){ var el = document.getElementById(id); if (el && pos >= el.offsetTop) active = id; });
    links.forEach(function(l){ l.classList.remove('fji-active'); if (l.getAttribute('href') === '#' + active) l.classList.add('fji-active'); });
  });
})();

// ── INIT ────────────────────────────────────────────────────────────────────
fjiBuildGrid();
</script>



