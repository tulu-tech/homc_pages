<style>
  :root {
    --inf-bg: #fff;
    --inf-surface: #f8fafc;
    --inf-surface2: #f1f5f9;
    --inf-dark: #000;
    --inf-muted: #555;
    --inf-muted2: #888;
    --inf-accent: #b38b4d;
    --inf-accent-h: #96723e;
    --inf-accent-pale: rgba(179,139,77,0.10);
    --inf-accent-pale2: rgba(179,139,77,0.06);
    --inf-border: #e5e9f0;
    --inf-border2: #d0d8e4;
    --inf-radius: 20px;
    --inf-radius-sm: 12px;
    --inf-shadow: 0 8px 30px rgba(0,0,0,0.07);
    --inf-shadow-hover: 0 20px 50px rgba(0,0,0,0.11);
  }

  .inf-wrap *{box-sizing:border-box;margin:0;padding:0}
  /* ── CRITICAL: Forces correct 16px base regardless of Shopify theme root font-size (e.g. 62.5%) ── */
  .inf-wrap{font-family:'Inter',sans-serif;color:var(--inf-dark);line-height:1.75;font-size:16px!important;-webkit-font-smoothing:antialiased}
  .inf-wrap p{font-size:15px!important;color:var(--inf-muted);line-height:1.8}
  .inf-wrap li{font-size:14px!important}
  .inf-wrap h1{font-size:clamp(38px,5.5vw,64px)!important}
  .inf-wrap h2{font-size:clamp(26px,3vw,38px)!important}
  .inf-wrap h3{font-size:clamp(16px,2vw,20px)!important}
  .inf-wrap h4{font-size:16px!important}
  .inf-wrap h1,.inf-wrap h2,.inf-wrap h3,.inf-wrap h4{line-height:1.15;font-weight:800;letter-spacing:-0.03em}
  .inf-wrap img{max-width:100%;display:block}

  .inf-container{max-width:1200px;margin:0 auto;padding:0 2rem}
  .inf-container-narrow{max-width:860px;margin:0 auto;padding:0 2rem}

  /* SUBNAV */
  .inf-subnav{background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--inf-border);overflow-x:auto;scrollbar-width:none}
  .inf-subnav::-webkit-scrollbar{display:none}
  .inf-subnav-inner{display:flex;padding:0 2rem;min-width:max-content}
  .inf-subnav-inner a{display:block;padding:.75rem 1rem;font-size:12px!important;font-weight:700;color:var(--inf-muted2);border-bottom:2px solid transparent;white-space:nowrap;transition:all .2s;text-transform:uppercase;letter-spacing:.08em;text-decoration:none}
  .inf-subnav-inner a:hover,.inf-subnav-inner a.active{color:var(--inf-dark);border-bottom-color:var(--inf-accent)}

  /* BUTTONS */
  .inf-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--inf-dark);color:#fff;padding:.9rem 2rem;font-size:15px!important;font-weight:700;border-radius:50px;transition:all .25s;border:2px solid var(--inf-dark);cursor:pointer;font-family:'Inter',sans-serif;letter-spacing:.01em;white-space:nowrap;text-decoration:none}
  .inf-btn:hover{background:#222;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.18)}
  .inf-btn-gold{background:var(--inf-accent);border-color:var(--inf-accent);color:#fff!important}
  .inf-btn-gold:hover{background:var(--inf-accent-h);border-color:var(--inf-accent-h);box-shadow:0 8px 24px rgba(179,139,77,.3)}
  .inf-btn-outline{background:transparent;color:var(--inf-dark);border-color:var(--inf-border2)}
  .inf-btn-outline:hover{border-color:var(--inf-dark);background:var(--inf-surface)}
  .inf-btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.35)}
  .inf-btn-ghost:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.7)}
  .inf-btn-sm{padding:.6rem 1.5rem;font-size:14px!important}

  /* HERO */
  .inf-hero{position:relative;min-height:84vh;display:flex;align-items:center;overflow:hidden;background:#080808}
  .inf-hero-bg{position:absolute;inset:0;background-image:url({% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2000 }}{% else %}https://cdn.shopify.com/s/files/1/0649/9516/4367/files/infinity-features-hero.jpg?v=1776368241{% endif %});background-size:cover;background-position:center;opacity:.38;z-index:0;transform:scale(1.04)}
  .inf-hero-grad{position:absolute;inset:0;background:linear-gradient(105deg,rgba(0,0,0,.92) 30%,rgba(0,0,0,.28) 100%),radial-gradient(ellipse 55% 75% at 100% 55%,rgba(179,139,77,.10) 0%,transparent 60%);z-index:1}
  .inf-hero-accent-bar{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent 0%,var(--inf-accent) 30%,#d4a95c 60%,transparent 100%);opacity:.85;z-index:3}
  .inf-hero-content{position:relative;z-index:3;padding:5rem 0 5.5rem}
  .inf-hero-bc{font-size:12px!important;color:rgba(255,255,255,.4);margin-bottom:1.5rem}
  .inf-hero-bc a{color:var(--inf-accent);transition:color .2s;text-decoration:none}
  .inf-hero-bc a:hover{color:#fff}
  .inf-hero-bc span{margin:0 .4rem}
  .inf-hero-eye{display:inline-flex;align-items:center;gap:8px;font-size:12px!important;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--inf-accent);margin-bottom:1.25rem}
  .inf-hero-eye::before{content:'';display:block;width:28px;height:2px;background:var(--inf-accent);border-radius:2px}
  .inf-hero h1{font-size:clamp(38px,5.5vw,64px);color:#fff;max-width:800px;margin-bottom:1.25rem;text-shadow:0 4px 30px rgba(0,0,0,.4);line-height:1.08}
  .inf-hero-lead{font-size:clamp(17px,1.5vw,20px);color:rgba(255,255,255,.8);max-width:620px;margin-bottom:.75rem;font-weight:600;line-height:1.65}
  .inf-hero-sub{font-size:16px!important;color:rgba(255,255,255,.52);max-width:580px;margin-bottom:2.5rem;line-height:1.75}
  .inf-hero-ctas{display:flex;gap:.875rem;flex-wrap:wrap;margin-bottom:3rem}
  .inf-hero-stats{display:flex;gap:0;border-top:1px solid rgba(255,255,255,.1);padding-top:2.5rem;flex-wrap:wrap}
  .inf-hero-stat{padding:0 2.5rem 0 0;border-right:1px solid rgba(255,255,255,.1);margin-right:2.5rem}
  .inf-hero-stat:last-child{border-right:none;margin-right:0}
  .inf-hero-stat-n{font-size:32px!important;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:4px;letter-spacing:-.04em}
  .inf-hero-stat-l{font-size:12px!important;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.12em;font-weight:700}

  /* TRUST BAR */
  .inf-trust-bar{display:flex;justify-content:center;gap:3rem;padding:1.25rem 2rem;border-bottom:1px solid var(--inf-border);background:#fff;font-size:14px!important;font-weight:700;flex-wrap:wrap}
  .inf-trust-item{display:flex;align-items:center;gap:7px;color:var(--inf-muted)}
  .inf-trust-item svg{width:16px;height:16px;fill:var(--inf-accent);flex-shrink:0}

  /* SECTION */
  .inf-section{padding:5.5rem 0}
  .inf-section-alt{background:var(--inf-surface)}
  .inf-section-sm{padding:3.5rem 0}
  .inf-section-label{display:inline-block;font-size:11px!important;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--inf-accent);margin-bottom:.875rem}
  .inf-section-header{margin-bottom:3rem}
  .inf-section-header.center{text-align:center}
  .inf-section-header.center .inf-section-label{display:block}
  .inf-section-header h2{font-size:clamp(26px,3vw,38px);margin-bottom:.875rem}
  .inf-underline{position:relative;display:inline-block}
  .inf-underline::after{content:'';position:absolute;bottom:-4px;left:0;right:0;height:3px;background:var(--inf-accent);border-radius:2px}
  .inf-section-header p{font-size:17px!important;color:var(--inf-muted);max-width:680px;line-height:1.8}
  .inf-section-header.center p{margin:0 auto}

  /* PRODUCT SECTION HEADER */
  .inf-product-header{background:linear-gradient(135deg,#050505 0%,#14100a 60%,#0a0a0a 100%);padding:3rem 3rem 0;border-radius:var(--inf-radius) var(--inf-radius) 0 0;position:relative;overflow:hidden}
  .inf-product-header::before{content:'';position:absolute;top:-40%;right:-10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.08) 0%,transparent 70%);pointer-events:none}
  .inf-product-header-inner{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding-bottom:2.5rem}
  .inf-product-header h2{color:#fff;font-size:clamp(24px,2.5vw,32px)}
  .inf-product-header p{color:rgba(255,255,255,.55);font-size:14px!important;max-width:560px;margin-top:.5rem;line-height:1.7}

  /* FILTER BAR */
  .inf-filter-bar{background:#fff;border:1px solid var(--inf-border);border-top:none;padding:1rem 1.5rem;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
  .inf-filter-label{font-size:11px!important;font-weight:800;text-transform:uppercase;letter-spacing:.16em;color:var(--inf-muted2);white-space:nowrap}
  .inf-filter-sep{width:1px;height:20px;background:var(--inf-border);flex-shrink:0}
  .inf-filter-btn{padding:6px 14px;border:1.5px solid var(--inf-border);border-radius:50px;font-size:12px!important;font-weight:700;cursor:pointer;transition:all .2s;background:transparent;color:var(--inf-muted);font-family:'Inter',sans-serif;white-space:nowrap}
  .inf-filter-btn:hover{border-color:var(--inf-accent);color:var(--inf-accent);background:var(--inf-accent-pale2)}
  .inf-filter-btn.active{background:var(--inf-dark);color:#fff;border-color:var(--inf-dark)}
  .inf-filter-count{margin-left:auto;font-size:13px!important;color:var(--inf-muted2);font-weight:600}

  /* PRODUCT GRID */
  .inf-product-grid-wrap{background:var(--inf-surface);border:1px solid var(--inf-border);border-top:none;border-radius:0 0 var(--inf-radius) var(--inf-radius);padding:2rem}
  .inf-product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}

  /* PRODUCT CARD */
  .inf-product-card{background:#fff;border:1px solid var(--inf-border);border-radius:var(--inf-radius);overflow:hidden;transition:all .3s cubic-bezier(.25,.8,.25,1);position:relative;display:flex;flex-direction:column;cursor:pointer}
  .inf-product-card:hover{transform:translateY(-7px);box-shadow:var(--inf-shadow-hover);border-color:transparent;outline:2px solid var(--inf-accent)}
  .inf-product-badge{position:absolute;top:10px;left:10px;background:var(--inf-dark);color:#fff;font-size:10px!important;font-weight:800;padding:3px 10px;border-radius:50px;text-transform:uppercase;letter-spacing:.1em;z-index:2}
  .inf-product-badge.gold{background:var(--inf-accent)}
  .inf-product-badge.flagship{background:linear-gradient(135deg,#1a0a00,#3d2000);border:1px solid rgba(179,139,77,.4)}
  .inf-product-img-wrap{height:230px;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:linear-gradient(145deg,#fafafa,#fff);position:relative;overflow:hidden}
  .inf-product-img-wrap::before{content:'';position:absolute;bottom:0;left:0;right:0;height:60px;background:linear-gradient(to top,rgba(248,250,252,.8),transparent);pointer-events:none}
  .inf-product-img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s cubic-bezier(.25,.8,.25,1)}
  .inf-product-card:hover .inf-product-img{transform:scale(1.06)}
  .inf-product-body{padding:1.1rem 1.25rem 1.25rem;flex:1;display:flex;flex-direction:column}
  .inf-product-for{font-size:11px!important;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--inf-accent);background:var(--inf-accent-pale);display:inline-block;padding:3px 8px;border-radius:20px;margin-bottom:.6rem}
  .inf-product-name{font-size:14px!important;font-weight:700;line-height:1.35;margin-bottom:.75rem;color:var(--inf-dark)}
  .inf-product-name a{color:inherit;text-decoration:none}
  .inf-product-feats{list-style:none;padding:0;margin:0 0 .875rem;flex:1}
  .inf-product-feats li{display:flex;align-items:flex-start;gap:5px;font-size:13px!important;color:var(--inf-muted);padding:2.5px 0;line-height:1.5}
  .inf-product-feats li::before{content:'✓';color:var(--inf-accent);font-weight:900;font-size:11px!important;flex-shrink:0;margin-top:2px}
  .inf-product-prices{display:flex;align-items:baseline;gap:7px;margin-bottom:.875rem;flex-wrap:wrap}
  .inf-price-sale{font-size:18px!important;font-weight:900;color:var(--inf-dark);letter-spacing:-.02em}
  .inf-price-was{font-size:13px!important;color:#adb5bd;text-decoration:line-through;font-weight:500}
  .inf-price-save{font-size:11px!important;font-weight:800;color:#16a34a;background:rgba(22,163,74,.08);padding:2px 7px;border-radius:20px}
  .inf-product-cta{display:block;text-align:center;background:var(--inf-dark);color:#fff;padding:.65rem;border-radius:var(--inf-radius-sm);font-weight:700;font-size:13px!important;transition:background .2s;text-decoration:none}
  .inf-product-cta:hover{background:var(--inf-accent);color:#fff}
  .inf-no-results{grid-column:1/-1;text-align:center;padding:4rem 0;color:var(--inf-muted)}

  /* QUICK ANSWER */
  .inf-quick-answer{background:linear-gradient(135deg,#050505 0%,#1a140a 100%);border-radius:24px;padding:3rem;border:1px solid rgba(179,139,77,.15);position:relative;overflow:hidden}
  .inf-quick-answer::before{content:'';position:absolute;top:-30%;right:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.06) 0%,transparent 70%);pointer-events:none}
  .inf-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;margin-top:2rem;position:relative;z-index:1}
  .inf-qa-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:1.5rem;transition:all .3s}
  .inf-qa-item:hover{background:rgba(255,255,255,.07);border-color:rgba(179,139,77,.25)}
  .inf-qa-item h3{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--inf-accent);margin-bottom:.625rem;font-weight:800}
  .inf-qa-item p{font-size:14px;color:rgba(255,255,255,.65);line-height:1.75;margin:0}

  /* PILLARS */
  .inf-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .inf-pillar-card{background:#fff;border:1px solid var(--inf-border);border-radius:var(--inf-radius);padding:2rem;transition:all .3s;position:relative;overflow:hidden}
  .inf-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--inf-accent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .inf-pillar-card:hover{transform:translateY(-5px);box-shadow:var(--inf-shadow)}
  .inf-pillar-card:hover::before{transform:scaleX(1)}
  .inf-pillar-icon{width:48px;height:48px;background:var(--inf-accent-pale);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:1.125rem}
  .inf-pillar-icon svg{width:24px;height:24px;fill:var(--inf-accent)}
  .inf-pillar-card h3{font-size:16px;margin-bottom:.5rem}
  .inf-pillar-card p{font-size:14px;color:var(--inf-muted);margin:0;line-height:1.7}

  /* AT A GLANCE */
  .inf-glance-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
  .inf-glance-table{width:100%;border-collapse:collapse}
  .inf-glance-table tr{border-bottom:1px solid var(--inf-border)}
  .inf-glance-table tr:last-child{border-bottom:none}
  .inf-glance-table td{padding:.875rem .5rem;font-size:14px;vertical-align:top}
  .inf-glance-table td:first-child{font-weight:800;color:var(--inf-dark);width:38%}
  .inf-glance-table td:last-child{color:var(--inf-muted)}
  .inf-glance-verdict{background:linear-gradient(145deg,#080808,#171208);border-radius:var(--inf-radius);padding:2.25rem;border:1px solid rgba(179,139,77,.12)}
  .inf-glance-verdict h3{color:#fff;font-size:17px;margin-bottom:1.25rem}
  .inf-verdict-item{display:flex;align-items:flex-start;gap:10px;padding:.625rem 0;border-bottom:1px solid rgba(255,255,255,.06)}
  .inf-verdict-item:last-child{border-bottom:none;padding-bottom:0}
  .inf-verdict-dot{width:7px;height:7px;border-radius:50%;background:var(--inf-accent);flex-shrink:0;margin-top:8px}
  .inf-verdict-item p{font-size:13px;color:rgba(255,255,255,.62);margin:0;line-height:1.65}

  /* WHO IT'S FOR */
  .inf-for-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .inf-for-card{border-radius:var(--inf-radius);padding:2rem;border:1px solid var(--inf-border);background:#fff}
  .inf-for-card.alt{background:var(--inf-surface)}
  .inf-for-badge{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:4px 12px;border-radius:50px;display:inline-block;margin-bottom:1.125rem}
  .inf-for-badge.yes{background:rgba(34,197,94,.1);color:#16a34a}
  .inf-for-badge.no{background:rgba(239,68,68,.1);color:#dc2626}
  .inf-for-list{list-style:none;padding:0}
  .inf-for-list li{display:flex;align-items:flex-start;gap:8px;padding:.55rem 0;border-bottom:1px solid var(--inf-border);font-size:14px;color:var(--inf-muted);line-height:1.6}
  .inf-for-list li:last-child{border-bottom:none}
  .inf-for-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:7px}
  .inf-for-dot.yes{background:#16a34a}
  .inf-for-dot.no{background:#dc2626}

  /* MODEL ENTRIES */
  .inf-model-entry{display:grid;grid-template-columns:280px 1fr;border-radius:var(--inf-radius);overflow:hidden;border:1px solid var(--inf-border);background:#fff;margin-bottom:1.75rem;transition:box-shadow .3s}
  .inf-model-entry:hover{box-shadow:var(--inf-shadow-hover)}
  .inf-model-side{background:#f8fafc;padding:2.25rem 1.75rem;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative;border-right:1px solid var(--inf-border)}
  .inf-model-img-frame{width:100%;height:200px;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:12px;border:1px solid var(--inf-border);overflow:hidden;margin:.75rem 0 .5rem}
  .inf-model-side-img{width:90%;height:90%;object-fit:contain;transition:transform .4s ease}
  .inf-model-entry:hover .inf-model-side-img{transform:scale(1.08)}
  .inf-model-tier{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--inf-accent);margin-bottom:.4rem}
  .inf-model-side h3{color:var(--inf-dark);font-size:17px;line-height:1.3}
  .inf-model-price-band{display:inline-flex;gap:5px;margin-top:1rem;font-size:12px;font-weight:700;color:var(--inf-muted2);background:var(--inf-surface2);padding:5px 11px;border-radius:20px;flex-wrap:wrap}
  .inf-model-price-band span{color:var(--inf-accent)}
  .inf-model-body{padding:2.25rem}
  .inf-model-best{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--inf-accent);background:var(--inf-accent-pale);display:inline-block;padding:3px 10px;border-radius:20px;margin-bottom:.875rem}
  .inf-model-body h4{font-size:16px;margin-bottom:.625rem}
  .inf-model-body p{font-size:14px;color:var(--inf-muted);line-height:1.75;margin-bottom:.875rem}
  .inf-model-traits{display:flex;gap:.4rem;flex-wrap:wrap;margin:.875rem 0}
  .inf-trait{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:var(--inf-surface2);border:1px solid var(--inf-border);color:var(--inf-muted2)}
  .inf-model-link{display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--inf-accent);margin-top:1.25rem;border-bottom:1px solid rgba(179,139,77,.3);padding-bottom:2px;transition:all .2s;text-decoration:none}
  .inf-model-link:hover{gap:9px;border-bottom-color:var(--inf-accent)}

  /* BUYER TYPES */
  .inf-buyer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
  .inf-buyer-card{background:#fff;border:1px solid var(--inf-border);border-radius:var(--inf-radius);padding:1.75rem;transition:all .3s;position:relative;overflow:hidden}
  .inf-buyer-card:hover{border-color:var(--inf-accent);box-shadow:0 10px 30px rgba(179,139,77,.1)}
  .inf-buyer-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--inf-accent),transparent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .inf-buyer-card:hover::after{transform:scaleX(1)}
  .inf-buyer-icon{width:42px;height:42px;background:var(--inf-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:.875rem}
  .inf-buyer-icon svg{width:20px;height:20px;fill:var(--inf-accent)}
  .inf-buyer-type{font-size:11px;font-weight:800;color:var(--inf-muted2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}
  .inf-buyer-card h3{font-size:14px;margin-bottom:.4rem}
  .inf-buyer-card p{font-size:13px;color:var(--inf-muted);margin:0;line-height:1.7}
  .inf-buyer-rec{margin-top:.625rem;font-size:12px;font-weight:700;color:var(--inf-accent)}

  /* COMPARE TABLE */
  .inf-compare-wrap{overflow-x:auto;border-radius:14px;border:1px solid var(--inf-border)}
  .inf-compare-table{width:100%;border-collapse:collapse;font-size:13px;min-width:680px}
  .inf-compare-table th{background:var(--inf-dark);color:#fff;padding:.875rem 1.125rem;text-align:left;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.07em}
  .inf-compare-table td{padding:.8rem 1.125rem;border-bottom:1px solid var(--inf-border);color:var(--inf-muted);vertical-align:middle}
  .inf-compare-table tr:last-child td{border-bottom:none}
  .inf-compare-table tr:hover td{background:var(--inf-surface)}
  .inf-col-feature{font-weight:800;color:var(--inf-dark)!important;white-space:nowrap}
  .inf-inf-col{background:rgba(179,139,77,.025)!important}
  .inf-check{color:var(--inf-accent);font-weight:800}

  /* EXPERT CALLOUT */
  .inf-expert-callout{background:#fff;border:1px solid var(--inf-border);border-left:4px solid var(--inf-accent);border-radius:0 12px 12px 0;padding:1.5rem 1.75rem;display:flex;align-items:flex-start;gap:.875rem}
  .inf-expert-callout svg{width:26px;height:26px;fill:var(--inf-accent);flex-shrink:0;margin-top:1px}
  .inf-expert-callout p{font-size:14px;color:var(--inf-muted);line-height:1.75;margin:0}
  .inf-expert-callout strong{color:var(--inf-dark)}

  /* PRICE LADDER */
  .inf-price-ladder{border:1px solid var(--inf-border);border-radius:var(--inf-radius);overflow:hidden}
  .inf-price-rung{display:grid;grid-template-columns:140px 1fr;border-bottom:1px solid var(--inf-border);transition:background .2s}
  .inf-price-rung:last-child{border-bottom:none}
  .inf-price-rung:hover{background:var(--inf-surface)}
  .inf-price-rung-label{background:var(--inf-dark);padding:1.5rem;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.08)}
  .inf-price-tier-name{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.45);font-weight:700;margin-bottom:3px}
  .inf-price-amount{font-size:16px;font-weight:900;color:var(--inf-accent);letter-spacing:-.02em}
  .inf-price-rung-body{padding:1.5rem 2rem}
  .inf-price-rung-body h4{font-size:14px;margin-bottom:.35rem}
  .inf-price-rung-body p{font-size:13px;color:var(--inf-muted);margin:0;line-height:1.65}
  .inf-price-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.625rem}
  .inf-price-tag{font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;background:var(--inf-accent-pale);color:var(--inf-accent)}

  /* TRUST & REVIEW CARDS */
  .inf-trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .inf-trust-card{background:#fff;border:1px solid var(--inf-border);border-radius:var(--inf-radius);padding:1.75rem;transition:all .3s}
  .inf-trust-card:hover{transform:translateY(-4px);box-shadow:var(--inf-shadow)}
  .inf-trust-card-icon{width:44px;height:44px;background:var(--inf-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem}
  .inf-trust-card-icon svg{width:22px;height:22px;fill:var(--inf-accent)}
  .inf-trust-card h3{font-size:15px;margin-bottom:.5rem}
  .inf-trust-card p{font-size:14px;color:var(--inf-muted);margin:0;line-height:1.7}
  .inf-review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .inf-review-card{background:#fff;border:1px solid var(--inf-border);border-radius:var(--inf-radius);padding:1.75rem;transition:all .3s;position:relative}
  .inf-review-card:hover{transform:translateY(-3px);box-shadow:var(--inf-shadow)}
  .inf-review-card::before{content:'"';position:absolute;top:1rem;right:1.25rem;font-size:64px;color:var(--inf-accent-pale);font-weight:900;line-height:1;pointer-events:none}
  .inf-review-stars{color:var(--inf-accent);letter-spacing:2px;font-size:13px;margin-bottom:.625rem}
  .inf-review-text{font-size:14px;color:var(--inf-muted);line-height:1.75;margin-bottom:1.125rem;font-style:italic}
  .inf-review-author{display:flex;align-items:center;gap:9px}
  .inf-review-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:#fff;flex-shrink:0}
  .inf-review-name{font-weight:700;font-size:14px}
  .inf-review-meta{font-size:12px;color:var(--inf-muted2)}

  /* SHOWROOM */
  .inf-showroom-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .inf-showroom-card{border:1px solid var(--inf-border);border-radius:var(--inf-radius);overflow:hidden;transition:all .3s}
  .inf-showroom-card:hover{transform:translateY(-4px);box-shadow:var(--inf-shadow-hover)}
  .inf-showroom-head{background:linear-gradient(135deg,#080808,#171208);padding:2rem 2.25rem 1.75rem}
  .inf-showroom-pill{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--inf-accent);background:rgba(179,139,77,.15);padding:3px 10px;border-radius:20px;display:inline-block;margin-bottom:.625rem}
  .inf-showroom-head h3{color:#fff;font-size:17px;margin-bottom:.3rem}
  .inf-showroom-head p{color:rgba(255,255,255,.5);font-size:13px;margin:0}
  .inf-showroom-body{background:#fff;padding:1.75rem 2.25rem}
  .inf-showroom-row{display:flex;align-items:flex-start;gap:8px;padding:.5rem 0;border-bottom:1px solid var(--inf-border);font-size:13px}
  .inf-showroom-row:last-child{border-bottom:none}
  .inf-showroom-row svg{width:16px;height:16px;fill:var(--inf-accent);flex-shrink:0;margin-top:2px}
  .inf-showroom-btns{margin-top:1.25rem;display:flex;gap:.625rem;flex-wrap:wrap}

  /* FINAL CTA */
  .inf-final-cta{background:linear-gradient(135deg,#050505 0%,#1a110a 60%,#050505 100%);border-radius:28px;padding:4rem;position:relative;overflow:hidden}
  .inf-final-cta::before{content:'';position:absolute;top:-40%;right:-8%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.1) 0%,transparent 70%);pointer-events:none}
  .inf-final-cta::after{content:'';position:absolute;bottom:-30%;left:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.06) 0%,transparent 70%);pointer-events:none}
  .inf-final-cta-inner{position:relative;z-index:1}
  .inf-final-cta h2{color:#fff;font-size:clamp(29px,3vw,42px);margin-bottom:.875rem;line-height:1.12}
  .inf-final-cta p{color:rgba(255,255,255,.65);font-size:16px;max-width:640px;margin-bottom:2rem;line-height:1.75}
  .inf-cta-points{display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:2rem}
  .inf-cta-point{display:flex;align-items:center;gap:7px}
  .inf-cta-point svg{width:16px;height:16px;fill:var(--inf-accent);flex-shrink:0}
  .inf-cta-point span{font-size:13px;color:rgba(255,255,255,.6);font-weight:600}
  .inf-final-cta-btns{display:flex;gap:.875rem;flex-wrap:wrap}

  /* ANSWER BLOCKS */
  .inf-answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
  .inf-answer-block{background:#fff;border:1px solid var(--inf-border);border-radius:14px;padding:1.75rem;transition:all .3s}
  .inf-answer-block:hover{border-color:var(--inf-border2);box-shadow:0 4px 16px rgba(0,0,0,.05)}
  .inf-answer-block h3{font-size:14px;margin-bottom:.5rem}
  .inf-answer-block p{font-size:13px;color:var(--inf-muted);margin:0;line-height:1.75}

  /* FAQ */
  .inf-faq-item{border-bottom:1px solid var(--inf-border)}
  .inf-faq-q{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;cursor:pointer;gap:1rem}
  .inf-faq-q h3{font-size:16px;margin:0;font-weight:700;transition:color .2s;line-height:1.4}
  .inf-faq-q:hover h3{color:var(--inf-accent)}
  .inf-faq-icon{width:22px;height:22px;fill:var(--inf-muted2);flex-shrink:0;transition:transform .3s}
  .inf-faq-q.active .inf-faq-icon{transform:rotate(45deg)}
  .inf-faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease}
  .inf-faq-a.open{max-height:500px}
  .inf-faq-a p{margin:0;padding-bottom:1.4rem;font-size:15px;color:var(--inf-muted);line-height:1.8}
  .inf-faq-a a{color:var(--inf-accent);font-weight:700}

  /* LINK PILLS */
  .inf-link-pills{display:flex;flex-wrap:wrap;gap:.625rem;justify-content:center}
  .inf-link-pill{padding:.55rem 1.25rem;border:1.5px solid var(--inf-border);border-radius:50px;font-size:13px;font-weight:700;color:var(--inf-dark);background:#fff;transition:all .3s;text-decoration:none}
  .inf-link-pill:hover{border-color:var(--inf-accent);color:var(--inf-accent);background:var(--inf-accent-pale);transform:translateY(-2px)}

  /* RESPONSIVE */
  @media(max-width:1024px){
    .inf-pillar-grid{grid-template-columns:1fr 1fr}
    .inf-product-grid{grid-template-columns:1fr 1fr}
    .inf-trust-grid{grid-template-columns:1fr 1fr}
  }
  @media(max-width:900px){
    .inf-hero{min-height:65vh}
    .inf-hero h1{font-size:35px}
    .inf-glance-grid,.inf-for-grid,.inf-model-entry,.inf-buyer-grid,.inf-showroom-grid,.inf-qa-grid,.inf-answer-grid{grid-template-columns:1fr}
    .inf-pillar-grid,.inf-trust-grid,.inf-review-grid{grid-template-columns:1fr}
    .inf-product-grid{grid-template-columns:1fr 1fr;gap:1rem}
    .inf-section{padding:3.5rem 0}
    .inf-final-cta{padding:2.5rem 2rem}
    .inf-product-header-inner{flex-direction:column;align-items:flex-start}
    .inf-price-rung{grid-template-columns:1fr}
    .inf-price-rung-label{border-right:none;border-bottom:1px solid rgba(255,255,255,.08)}
  }
  @media(max-width:600px){
    .inf-product-grid{grid-template-columns:1fr}
    .inf-hero h1{font-size:30px}
    .inf-container{padding:0 1.25rem}
    .inf-product-header{padding:2rem 1.5rem 0}
    .inf-product-grid-wrap{padding:1.25rem}
  }
</style>

