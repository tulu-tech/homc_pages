{%- comment -%} ══════════ JAVASCRIPT ══════════ {%- endcomment -%}
<script>
// ─── DYNAMIC PRODUCT DATA FROM LIQUID ───────────────────────────────────────
var INF_PRODUCTS = [
  {%- for product in collection.products -%}
    {%- assign feat_img = product.featured_image | image_url: width: 600 -%}
    {%- assign sale_price_cents = product.price -%}
    {%- assign compare_price_cents = product.compare_at_price -%}

    {%- comment -%} Build filter tags array {%- endcomment -%}
    {%- assign filter_tags = "" -%}
    {%- for tag in product.tags -%}
      {%- assign tag_low = tag | downcase -%}
      {%- if tag_low == "synerd" or tag_low == "4d" or tag_low == "flagship" or tag_low == "entry" -%}
        {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: "," -%}{%- endif -%}
        {%- assign filter_tags = filter_tags | append: '"' | append: tag_low | append: '"' -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Auto-detect badge from tags {%- endcomment -%}
    {%- assign auto_badge = "" -%}
    {%- assign auto_badge_class = "" -%}
    {%- if product.tags contains "flagship" -%}
      {%- assign auto_badge = "Flagship" -%}
      {%- assign auto_badge_class = "flagship" -%}
    {%- elsif product.tags contains "synerd" -%}
      {%- assign auto_badge = "Syner-D" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- elsif product.tags contains "4d" -%}
      {%- assign auto_badge = "4D" -%}
      {%- assign auto_badge_class = "" -%}
    {%- endif -%}

    {%- assign badge_val = product.metafields.custom.badge.value | default: auto_badge -%}
    {%- assign badge_class_val = product.metafields.custom.badge_class.value | default: auto_badge_class -%}
    {%- assign buyer_for_val = product.metafields.custom.buyer_for.value | default: product.type -%}

    {%- assign feats_json = product.metafields.custom.key_features.value -%}
    {%- if feats_json == blank -%}
      {%- assign feats_json = '["Premium 4D massage technology","Zero gravity recline","Body scanning system","Air compression coverage"]' -%}
    {%- endif -%}

    {
      n: {{ product.title | json }},
      u: {{ product.url | prepend: shop.url | json }},
      i: {{ feat_img | json }},
      p: {{ product.price | money | json }},
      cp: {% if compare_price_cents > sale_price_cents %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      tags: [{{ filter_tags }}],
      badge: {{ badge_val | json }},
      badgeClass: {{ badge_class_val | json }},
      for: {{ buyer_for_val | json }},
      feats: {{ feats_json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];

// ─── FILTER LOGIC ────────────────────────────────────────────────────────────
var infCurrentFilter = {type:'all',value:'all'};

function infFilter(btn,type,value){
  document.querySelectorAll('#infFilterBar .inf-filter-btn').forEach(function(b){b.classList.remove('active')});
  btn.classList.add('active');
  infCurrentFilter = {type:type,value:value};
  infRenderProducts();
}

function infFilteredProducts(){
  return INF_PRODUCTS.filter(function(p){
    if(infCurrentFilter.type==='all') return true;
    if(infCurrentFilter.type==='price'){
      var num = parseFloat(p.p.replace(/[^0-9.]/g,''));
      if(infCurrentFilter.value==='under8') return num<8000;
      if(infCurrentFilter.value==='8to12') return num>=8000&&num<12000;
      if(infCurrentFilter.value==='over12') return num>=12000;
    }
    if(infCurrentFilter.type==='type') return p.tags.indexOf(infCurrentFilter.value)!==-1;
    return true;
  });
}

function infSaveCalc(p,cp){
  if(!cp) return '';
  var ps=parseFloat(p.replace(/[^0-9.]/g,'')),cs=parseFloat(cp.replace(/[^0-9.]/g,''));
  if(cs<=ps) return '';
  var save=Math.round(cs-ps);
  return '<span class="inf-price-save">Save $'+save.toLocaleString()+'</span>';
}

function infRenderProducts(){
  var grid=document.getElementById('infGrid');
  var count=document.getElementById('infCount');
  var prods=infFilteredProducts();
  if(count) count.textContent=prods.length+' model'+(prods.length!==1?'s':'');
  if(!grid) return;

  if(prods.length===0){
    grid.innerHTML='<div class="inf-no-results"><p>No models match this filter.</p></div>';
    return;
  }

  grid.style.opacity='0';
  grid.innerHTML='';

  prods.forEach(function(p){
    var saveHtml=infSaveCalc(p.p,p.cp);
    var featsHtml=Array.isArray(p.feats)?p.feats.map(function(f){return '<li>'+f+'</li>';}).join(''):'' ;
    var badgeHtml=p.badge?'<span class="inf-product-badge '+p.badgeClass+'">'+p.badge+'</span>':'';
    var priceHtml='<span class="inf-price-sale">'+p.p+'</span>';
    if(p.cp) priceHtml+=' <span class="inf-price-was">'+p.cp+'</span>';
    if(saveHtml) priceHtml+=' '+saveHtml;

    var card=document.createElement('article');
    card.className='inf-product-card';
    card.setAttribute('onclick','window.location="'+p.u+'"');
    card.innerHTML=
      badgeHtml+
      '<a href="'+p.u+'" tabindex="-1"><div class="inf-product-img-wrap"><img class="inf-product-img" src="'+p.i+'" alt="'+p.n+'" loading="lazy"></div></a>'+
      '<div class="inf-product-body">'+
        '<div class="inf-product-for">'+(p.for||'Premium Massage Chair')+'</div>'+
        '<div class="inf-product-name"><a href="'+p.u+'">'+p.n+'</a></div>'+
        '<ul class="inf-product-feats">'+featsHtml+'</ul>'+
        '<div class="inf-product-prices">'+priceHtml+'</div>'+
        '<a href="'+p.u+'" class="inf-product-cta">View Details</a>'+
      '</div>';
    grid.appendChild(card);
  });

  setTimeout(function(){grid.style.opacity='1';grid.style.transition='opacity .3s';},40);
}

// ─── FAQ ACCORDION ────────────────────────────────────────────────────────────
function infFaq(el){
  var a=el.nextElementSibling;
  var isOpen=a.classList.contains('open');
  document.querySelectorAll('.inf-faq-a').forEach(function(x){x.classList.remove('open')});
  document.querySelectorAll('.inf-faq-q').forEach(function(x){x.classList.remove('active')});
  if(!isOpen){a.classList.add('open');el.classList.add('active');}
}

// ─── SUBNAV ACTIVE STATE ──────────────────────────────────────────────────────
(function(){
  var links=document.querySelectorAll('.inf-subnav-inner a');
  var ids=['inf-collection','inf-overview','inf-4d-options','inf-why-infinity','inf-model-guide','inf-buyer-types','inf-vs-brands','inf-pricing','inf-trust','inf-warranty','inf-showrooms','inf-faq'];
  window.addEventListener('scroll',function(){
    var pos=window.scrollY+140,active='';
    ids.forEach(function(id){var el=document.getElementById(id);if(el&&pos>=el.offsetTop)active=id;});
    links.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+active)l.classList.add('active');});
  });
})();

// ─── INIT ─────────────────────────────────────────────────────────────────────
infRenderProducts();
</script>

{%- endpaginate -%}

