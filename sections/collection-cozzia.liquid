<style>
  /* ── DESIGN TOKENS ─────────────────────────────────────────────── */
  :root {
    --czz-bg: #fff;
    --czz-surface: #f8fafc;
    --czz-surface2: #f1f5f9;
    --czz-dark: #0d0d12;
    --czz-muted: #52565e;
    --czz-muted2: #8a8f9a;
    --czz-accent: #b38b4d;        /* HOMC gold — matches Osaki, Kyota, Infinity */
    --czz-accent-h: #9a7540;
    --czz-accent2: #d4aa6b;       /* lighter gold */
    --czz-accent-pale: rgba(179,139,77,0.10);
    --czz-accent-pale2: rgba(179,139,77,0.06);
    --czz-border: #e5e9f0;
    --czz-border2: #c8d4e8;
    --czz-radius: 20px;
    --czz-radius-sm: 12px;
    --czz-shadow: 0 8px 30px rgba(0,0,0,0.07);
    --czz-shadow-hover: 0 20px 50px rgba(0,0,0,0.11);
  }

  /* ── BASE RESET (scoped) ───────────────────────────────────────── */
  /* All font-sizes are in px to prevent Shopify theme rem inheritance */
  .czz-wrap *{box-sizing:border-box;margin:0;padding:0}
  .czz-wrap{font-family:'Inter',sans-serif;color:var(--czz-dark);line-height:1.75;font-size:16px;-webkit-font-smoothing:antialiased}

  /* Override Shopify theme root font-size — ALL px, NO rem */
  .czz-wrap p{font-size:15px;color:var(--czz-muted);line-height:1.8}
  .czz-wrap li{font-size:14px;line-height:1.6}
  .czz-wrap h2{font-size:clamp(26px,3vw,38px);line-height:1.15;font-weight:800;letter-spacing:-0.03em}
  .czz-wrap h3{font-size:clamp(16px,2vw,20px);line-height:1.15;font-weight:800;letter-spacing:-0.02em}
  .czz-wrap h4{font-size:16px;line-height:1.2;font-weight:700}
  .czz-wrap h1{font-size:clamp(38px,5.5vw,64px);line-height:1.08;font-weight:900;letter-spacing:-0.03em}
  .czz-wrap a{text-decoration:none}
  .czz-wrap img{max-width:100%;display:block}
  .czz-wrap button{font-family:'Inter',sans-serif}
  .czz-wrap strong{font-weight:700}

  .czz-container{max-width:1200px;margin:0 auto;padding:0 2rem}
  .czz-container-narrow{max-width:860px;margin:0 auto;padding:0 2rem}

  /* ── SUBNAV ────────────────────────────────────────────────────── */
  .czz-subnav{background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--czz-border);overflow-x:auto;scrollbar-width:none;position:sticky;top:0;z-index:100}
  .czz-subnav::-webkit-scrollbar{display:none}
  .czz-subnav-inner{display:flex;padding:0 2rem;min-width:max-content}
  .czz-subnav-inner a{display:block;padding:.75rem 1rem;font-size:12px;font-weight:700;color:var(--czz-muted2);border-bottom:2px solid transparent;white-space:nowrap;transition:all .2s;text-transform:uppercase;letter-spacing:.08em}
  .czz-subnav-inner a:hover,.czz-subnav-inner a.active{color:var(--czz-dark);border-bottom-color:var(--czz-accent)}

  /* ── BUTTONS ───────────────────────────────────────────────────── */
  .czz-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--czz-dark);color:#fff;padding:.9rem 2rem;font-size:15px;font-weight:700;border-radius:50px;transition:all .25s;border:2px solid var(--czz-dark);cursor:pointer;font-family:'Inter',sans-serif;letter-spacing:.01em;white-space:nowrap;text-decoration:none}
  .czz-btn:hover{background:#222;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.18)}
  .czz-btn-green{background:var(--czz-accent);border-color:var(--czz-accent);color:#fff!important}
  .czz-btn-green:hover{background:var(--czz-accent-h);border-color:var(--czz-accent-h);box-shadow:0 8px 24px rgba(179,139,77,.35)}
  .czz-btn-outline{background:transparent;color:var(--czz-dark);border-color:var(--czz-border2)}
  .czz-btn-outline:hover{border-color:var(--czz-dark);background:var(--czz-surface)}
  .czz-btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.35)}
  .czz-btn-ghost:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.7)}
  .czz-btn-sm{padding:.6rem 1.5rem;font-size:14px}

  /* ── HERO ──────────────────────────────────────────────────────── */
  .czz-hero{position:relative;min-height:86vh;display:flex;align-items:center;overflow:hidden;background:#06080f}
  .czz-hero-bg{position:absolute;inset:0;z-index:0}
  .czz-hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:.32;mix-blend-mode:luminosity}
  .czz-hero-grad{position:absolute;inset:0;background:linear-gradient(108deg,rgba(6,8,15,.96) 0%,rgba(6,8,15,.72) 55%,rgba(6,8,15,.45) 100%);z-index:1}
  .czz-hero-grain{position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");z-index:2;pointer-events:none}
  .czz-hero-content{position:relative;z-index:3;padding:5.5rem 0 6rem;width:100%}
  .czz-hero-bc{font-size:12px;color:rgba(255,255,255,.38);margin-bottom:1.5rem}
  .czz-hero-bc a{color:var(--czz-accent2);transition:opacity .2s}
  .czz-hero-bc a:hover{color:#fff}
  .czz-hero-bc span{margin:0 .4rem}
  .czz-hero-eye{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--czz-accent2);margin-bottom:1.25rem;background:rgba(179,139,77,.1);padding:6px 16px;border-radius:50px;border:1px solid rgba(179,139,77,.22)}
  .czz-hero-eye::before{content:'';display:block;width:6px;height:6px;border-radius:50%;background:var(--czz-accent2)}
  .czz-hero h1{color:#fff;max-width:800px;margin-bottom:1.25rem;text-shadow:0 4px 30px rgba(0,0,0,.4)}
  .czz-hero-lead{font-size:clamp(17px,1.5vw,20px);color:rgba(255,255,255,.8);max-width:620px;margin-bottom:.75rem;font-weight:600;line-height:1.65}
  .czz-hero-sub{font-size:16px;color:rgba(255,255,255,.52);max-width:580px;margin-bottom:2.5rem;line-height:1.75}
  .czz-hero-ctas{display:flex;gap:.875rem;flex-wrap:wrap;margin-bottom:3rem}
  .czz-hero-stats{display:flex;gap:0;border-top:1px solid rgba(255,255,255,.1);padding-top:2.5rem;flex-wrap:wrap}
  .czz-hero-stat{padding:0 2.5rem 0 0;border-right:1px solid rgba(255,255,255,.1);margin-right:2.5rem}
  .czz-hero-stat:last-child{border-right:none;margin-right:0}
  .czz-hero-stat-n{font-size:32px;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:4px;letter-spacing:-.04em}
  .czz-hero-stat-l{font-size:12px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.12em;font-weight:700}

  /* ── TRUST BAR ─────────────────────────────────────────────────── */
  .czz-trust-bar{display:flex;justify-content:center;gap:3rem;padding:1.25rem 2rem;border-bottom:1px solid var(--czz-border);background:#fff;font-size:14px;font-weight:700;flex-wrap:wrap}
  .czz-trust-item{display:flex;align-items:center;gap:7px;color:var(--czz-muted)}
  .czz-trust-item svg{width:16px;height:16px;fill:var(--czz-accent);flex-shrink:0}

  /* ── SECTION ───────────────────────────────────────────────────── */
  .czz-section{padding:5.5rem 0}
  .czz-section-alt{background:var(--czz-surface)}
  .czz-section-sm{padding:3.5rem 0}
  .czz-section-label{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--czz-accent);margin-bottom:.875rem}
  .czz-section-header{margin-bottom:3rem}
  .czz-section-header.center{text-align:center}
  .czz-section-header.center .czz-section-label{display:block}
  .czz-section-header h2{margin-bottom:.875rem}
  .czz-underline{position:relative;display:inline-block}
  .czz-underline::after{content:'';position:absolute;bottom:-4px;left:0;right:0;height:3px;background:var(--czz-accent);border-radius:2px}
  .czz-section-header p{font-size:17px;color:var(--czz-muted);max-width:680px;line-height:1.8}
  .czz-section-header.center p{margin:0 auto}

  /* ── PRODUCT HEADER ────────────────────────────────────────────── */
  .czz-product-header{background:linear-gradient(135deg,#0d0b07 0%,#1c1508 60%,#0d0b07 100%);padding:3rem 3rem 0;border-radius:var(--czz-radius) var(--czz-radius) 0 0;position:relative;overflow:hidden}
  .czz-product-header::before{content:'';position:absolute;top:-40%;right:-10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.08) 0%,transparent 70%);pointer-events:none}
  .czz-product-header-inner{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding-bottom:2.5rem}
  .czz-product-header h2{color:#fff;font-size:clamp(24px,2.5vw,32px)}
  .czz-product-header p{color:rgba(255,255,255,.55);font-size:14px;max-width:560px;margin-top:.5rem;line-height:1.7}

  /* ── FILTER BAR ────────────────────────────────────────────────── */
  .czz-filter-bar{background:#fff;border:1px solid var(--czz-border);border-top:none;padding:1rem 1.5rem;display:flex;align-items:center;gap:.625rem;flex-wrap:wrap}
  .czz-filter-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.16em;color:var(--czz-muted2);white-space:nowrap}
  .czz-filter-sep{width:1px;height:20px;background:var(--czz-border);flex-shrink:0}
  .czz-filter-btn{padding:6px 14px;border:1.5px solid var(--czz-border);border-radius:50px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;background:transparent;color:var(--czz-muted);font-family:'Inter',sans-serif;white-space:nowrap}
  .czz-filter-btn:hover{border-color:var(--czz-accent);color:var(--czz-accent);background:var(--czz-accent-pale2)}
  .czz-filter-btn.active{background:var(--czz-dark);color:#fff;border-color:var(--czz-dark)}
  .czz-filter-count{margin-left:auto;font-size:13px;color:var(--czz-muted2);font-weight:600}

  /* ── PRODUCT GRID ──────────────────────────────────────────────── */
  .czz-product-grid-wrap{background:var(--czz-surface);border:1px solid var(--czz-border);border-top:none;border-radius:0 0 var(--czz-radius) var(--czz-radius);padding:2rem}
  .czz-product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}

  /* ── PRODUCT CARD ──────────────────────────────────────────────── */
  .czz-product-card{background:#fff;border:1px solid var(--czz-border);border-radius:var(--czz-radius);overflow:hidden;transition:all .3s cubic-bezier(.25,.8,.25,1);position:relative;display:flex;flex-direction:column;cursor:pointer}
  .czz-product-card:hover{transform:translateY(-7px);box-shadow:var(--czz-shadow-hover);border-color:transparent;outline:2px solid var(--czz-accent)}
  .czz-product-badge{position:absolute;top:10px;left:10px;background:var(--czz-dark);color:#fff;font-size:10px;font-weight:800;padding:3px 10px;border-radius:50px;text-transform:uppercase;letter-spacing:.1em;z-index:2}
  .czz-product-badge.gold{background:var(--czz-accent)}
  .czz-product-badge.flagship{background:linear-gradient(135deg,#0d0b07,#1c1508);border:1px solid rgba(179,139,77,.4)}
  .czz-product-img-wrap{height:230px;display:flex;align-items:center;justify-content:center;padding:1.5rem;background:linear-gradient(145deg,#fafafa,#fff);position:relative;overflow:hidden}
  .czz-product-img-wrap::before{content:'';position:absolute;bottom:0;left:0;right:0;height:60px;background:linear-gradient(to top,rgba(248,250,252,.8),transparent);pointer-events:none}
  .czz-product-img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .4s cubic-bezier(.25,.8,.25,1)}
  .czz-product-card:hover .czz-product-img{transform:scale(1.06)}
  .czz-product-body{padding:1.1rem 1.25rem 1.25rem;flex:1;display:flex;flex-direction:column}
  .czz-product-for{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--czz-accent);background:var(--czz-accent-pale);display:inline-block;padding:3px 8px;border-radius:20px;margin-bottom:.6rem}
  .czz-product-name{font-size:14px;font-weight:700;line-height:1.35;margin-bottom:.75rem;color:var(--czz-dark)}
  .czz-product-name a{color:inherit;text-decoration:none}
  .czz-product-feats{list-style:none;padding:0;margin:0 0 .875rem;flex:1}
  .czz-product-feats li{display:flex;align-items:flex-start;gap:5px;font-size:13px;color:var(--czz-muted);padding:2.5px 0;line-height:1.5}
  .czz-product-feats li::before{content:'✓';color:var(--czz-accent);font-weight:900;font-size:11px;flex-shrink:0;margin-top:2px}
  .czz-product-prices{display:flex;align-items:baseline;gap:7px;margin-bottom:.875rem;flex-wrap:wrap}
  .czz-price-sale{font-size:18px;font-weight:900;color:var(--czz-dark);letter-spacing:-.02em}
  .czz-price-was{font-size:13px;color:#adb5bd;text-decoration:line-through;font-weight:500}
  .czz-price-save{font-size:11px;font-weight:800;color:#16a34a;background:rgba(22,163,74,.08);padding:2px 7px;border-radius:20px}
  .czz-product-cta{display:block;text-align:center;background:var(--czz-dark);color:#fff;padding:.65rem;border-radius:var(--czz-radius-sm);font-weight:700;font-size:13px;transition:background .2s;text-decoration:none}
  .czz-product-cta:hover{background:var(--czz-accent);color:#fff}
  .czz-no-results{grid-column:1/-1;text-align:center;padding:4rem 0;color:var(--czz-muted)}

  /* ── QUICK ANSWER ──────────────────────────────────────────────── */
  .czz-quick-answer{background:linear-gradient(135deg,#0d0b07 0%,#1c1508 100%);border-radius:24px;padding:3rem;border:1px solid rgba(179,139,77,.18);position:relative;overflow:hidden}
  .czz-quick-answer::before{content:'';position:absolute;top:-30%;right:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.07) 0%,transparent 70%);pointer-events:none}
  .czz-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;margin-top:2rem;position:relative;z-index:1}
  .czz-qa-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:1.5rem;transition:all .3s}
  .czz-qa-item:hover{background:rgba(255,255,255,.07);border-color:rgba(179,139,77,.28)}
  .czz-qa-item h3{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--czz-accent2);margin-bottom:.625rem;font-weight:800}
  .czz-qa-item p{font-size:14px;color:rgba(255,255,255,.65);line-height:1.75;margin:0}

  /* ── PILLARS ───────────────────────────────────────────────────── */
  .czz-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .czz-pillar-card{background:#fff;border:1px solid var(--czz-border);border-radius:var(--czz-radius);padding:2rem;transition:all .3s;position:relative;overflow:hidden}
  .czz-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--czz-accent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .czz-pillar-card:hover{transform:translateY(-5px);box-shadow:var(--czz-shadow)}
  .czz-pillar-card:hover::before{transform:scaleX(1)}
  .czz-pillar-icon{width:48px;height:48px;background:var(--czz-accent-pale);border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:1.125rem}
  .czz-pillar-icon svg{width:24px;height:24px;fill:var(--czz-accent)}
  .czz-pillar-card h3{font-size:16px;margin-bottom:.5rem}
  .czz-pillar-card p{font-size:14px;color:var(--czz-muted);margin:0;line-height:1.7}

  /* ── AT A GLANCE ───────────────────────────────────────────────── */
  .czz-glance-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
  .czz-glance-table{width:100%;border-collapse:collapse}
  .czz-glance-table tr{border-bottom:1px solid var(--czz-border)}
  .czz-glance-table tr:last-child{border-bottom:none}
  .czz-glance-table td{padding:.875rem .5rem;font-size:14px;vertical-align:top}
  .czz-glance-table td:first-child{font-weight:800;color:var(--czz-dark);width:38%}
  .czz-glance-table td:last-child{color:var(--czz-muted)}
  .czz-glance-verdict{background:linear-gradient(145deg,#0d0b07,#1c1508);border-radius:var(--czz-radius);padding:2.25rem;border:1px solid rgba(179,139,77,.15)}
  .czz-glance-verdict h3{color:#fff;font-size:17px;margin-bottom:1.25rem}
  .czz-verdict-item{display:flex;align-items:flex-start;gap:10px;padding:.625rem 0;border-bottom:1px solid rgba(255,255,255,.06)}
  .czz-verdict-item:last-child{border-bottom:none;padding-bottom:0}
  .czz-verdict-dot{width:7px;height:7px;border-radius:50%;background:var(--czz-accent2);flex-shrink:0;margin-top:8px}
  .czz-verdict-item p{font-size:13px;color:rgba(255,255,255,.62);margin:0;line-height:1.65}

  /* ── WHO IT'S FOR ──────────────────────────────────────────────── */
  .czz-for-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .czz-for-card{border-radius:var(--czz-radius);padding:2rem;border:1px solid var(--czz-border);background:#fff}
  .czz-for-card.alt{background:var(--czz-surface)}
  .czz-for-badge{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:4px 12px;border-radius:50px;display:inline-block;margin-bottom:1.125rem}
  .czz-for-badge.yes{background:rgba(34,197,94,.1);color:#16a34a}
  .czz-for-badge.no{background:rgba(239,68,68,.1);color:#dc2626}
  .czz-for-list{list-style:none;padding:0}
  .czz-for-list li{display:flex;align-items:flex-start;gap:8px;padding:.55rem 0;border-bottom:1px solid var(--czz-border);font-size:14px;color:var(--czz-muted);line-height:1.6}
  .czz-for-list li:last-child{border-bottom:none}
  .czz-for-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:7px}
  .czz-for-dot.yes{background:#16a34a}
  .czz-for-dot.no{background:#dc2626}

  /* ── MODEL ENTRIES ─────────────────────────────────────────────── */
  .czz-model-entry{display:grid;grid-template-columns:260px 1fr;border-radius:var(--czz-radius);overflow:hidden;border:1px solid var(--czz-border);background:#fff;margin-bottom:1.75rem;transition:box-shadow .3s}
  .czz-model-entry:hover{box-shadow:var(--czz-shadow-hover)}
  .czz-model-side{background:linear-gradient(160deg,#0d0b07,#1c1508);padding:2.25rem 1.75rem;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}
  .czz-model-side-img{width:100%;height:180px;object-fit:contain;margin:.75rem 0 .5rem;transition:transform .4s ease}
  .czz-model-entry:hover .czz-model-side-img{transform:scale(1.08)}
  .czz-model-side a{display:block;cursor:pointer}
  .czz-model-tier{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--czz-accent2);margin-bottom:.4rem}
  .czz-model-side h3{color:#fff;font-size:17px;line-height:1.3}
  .czz-model-price-band{display:inline-flex;gap:5px;margin-top:1rem;font-size:12px;font-weight:700;color:rgba(255,255,255,.45);background:rgba(255,255,255,.05);padding:5px 11px;border-radius:20px;flex-wrap:wrap}
  .czz-model-price-band span{color:var(--czz-accent2)}
  .czz-model-body{padding:2.25rem}
  .czz-model-best{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--czz-accent);background:var(--czz-accent-pale);display:inline-block;padding:3px 10px;border-radius:20px;margin-bottom:.875rem}
  .czz-model-body h4{font-size:16px;margin-bottom:.625rem}
  .czz-model-body p{font-size:14px;color:var(--czz-muted);line-height:1.75;margin-bottom:.875rem}
  .czz-model-traits{display:flex;gap:.4rem;flex-wrap:wrap;margin:.875rem 0}
  .czz-trait{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:var(--czz-surface2);border:1px solid var(--czz-border);color:var(--czz-muted2)}
  .czz-model-tradeoff{margin-top:1rem;padding:.875rem 1.125rem;border-radius:10px;background:var(--czz-surface);border-left:3px solid var(--czz-border2);font-size:13px;color:var(--czz-muted2);line-height:1.65}
  .czz-model-link{display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--czz-accent);margin-top:1.25rem;border-bottom:1px solid rgba(26,107,74,.3);padding-bottom:2px;transition:all .2s;text-decoration:none}
  .czz-model-link:hover{gap:9px;border-bottom-color:var(--czz-accent)}

  /* ── BUYER TYPES ───────────────────────────────────────────────── */
  .czz-buyer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
  .czz-buyer-card{background:#fff;border:1px solid var(--czz-border);border-radius:var(--czz-radius);padding:1.75rem;transition:all .3s;position:relative;overflow:hidden}
  .czz-buyer-card:hover{border-color:var(--czz-accent);box-shadow:0 10px 30px rgba(26,107,74,.1)}
  .czz-buyer-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--czz-accent),transparent);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .czz-buyer-card:hover::after{transform:scaleX(1)}
  .czz-buyer-icon{width:42px;height:42px;background:var(--czz-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:.875rem}
  .czz-buyer-icon svg{width:20px;height:20px;fill:var(--czz-accent)}
  .czz-buyer-type{font-size:11px;font-weight:800;color:var(--czz-muted2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}
  .czz-buyer-card h3{font-size:14px;margin-bottom:.4rem}
  .czz-buyer-card p{font-size:13px;color:var(--czz-muted);margin:0;line-height:1.7}
  .czz-buyer-rec{margin-top:.625rem;font-size:12px;font-weight:700;color:var(--czz-accent)}

  /* ── COMPARE TABLE ─────────────────────────────────────────────── */
  .czz-compare-wrap{overflow-x:auto;border-radius:14px;border:1px solid var(--czz-border)}
  .czz-compare-table{width:100%;border-collapse:collapse;font-size:13px;min-width:680px}
  .czz-compare-table th{background:var(--czz-dark);color:#fff;padding:.875rem 1.125rem;text-align:left;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.07em}
  .czz-compare-table td{padding:.8rem 1.125rem;border-bottom:1px solid var(--czz-border);color:var(--czz-muted);vertical-align:middle}
  .czz-compare-table tr:last-child td{border-bottom:none}
  .czz-compare-table tr:hover td{background:var(--czz-surface)}
  .czz-col-feature{font-weight:800;color:var(--czz-dark)!important;white-space:nowrap}
  .czz-czz-col{background:rgba(179,139,77,.04)!important}
  thead .czz-czz-col{background:rgba(179,139,77,.14)!important;color:var(--czz-accent2)!important;border-bottom:3px solid var(--czz-accent)!important}
  .czz-check{color:var(--czz-accent);font-weight:800}

  /* ── EXPERT CALLOUT ────────────────────────────────────────────── */
  .czz-expert-callout{background:#fff;border:1px solid var(--czz-border);border-left:4px solid var(--czz-accent);border-radius:0 12px 12px 0;padding:1.5rem 1.75rem;display:flex;align-items:flex-start;gap:.875rem}
  .czz-expert-callout svg{width:26px;height:26px;fill:var(--czz-accent);flex-shrink:0;margin-top:1px}
  .czz-expert-callout p{font-size:14px;color:var(--czz-muted);line-height:1.75;margin:0}
  .czz-expert-callout strong{color:var(--czz-dark)}

  /* ── PRICE LADDER ──────────────────────────────────────────────── */
  .czz-price-ladder{border:1px solid var(--czz-border);border-radius:var(--czz-radius);overflow:hidden}
  .czz-price-rung{display:grid;grid-template-columns:140px 1fr;border-bottom:1px solid var(--czz-border);transition:background .2s}
  .czz-price-rung:last-child{border-bottom:none}
  .czz-price-rung:hover{background:var(--czz-surface)}
  .czz-price-rung-label{background:var(--czz-dark);padding:1.5rem;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.08)}
  .czz-price-tier-name{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.45);font-weight:700;margin-bottom:3px}
  .czz-price-amount{font-size:16px;font-weight:900;color:var(--czz-accent2);letter-spacing:-.02em}
  .czz-price-rung-body{padding:1.5rem 2rem}
  .czz-price-rung-body h4{font-size:14px;margin-bottom:.35rem}
  .czz-price-rung-body p{font-size:13px;color:var(--czz-muted);margin:0;line-height:1.65}
  .czz-price-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.625rem}
  .czz-price-tag{font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;background:var(--czz-accent-pale);color:var(--czz-accent)}

  /* ── TRUST & REVIEW CARDS ──────────────────────────────────────── */
  .czz-trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .czz-trust-card{background:#fff;border:1px solid var(--czz-border);border-radius:var(--czz-radius);padding:1.75rem;transition:all .3s}
  .czz-trust-card:hover{transform:translateY(-4px);box-shadow:var(--czz-shadow)}
  .czz-trust-card-icon{width:44px;height:44px;background:var(--czz-accent-pale);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem}
  .czz-trust-card-icon svg{width:22px;height:22px;fill:var(--czz-accent)}
  .czz-trust-card h3{font-size:15px;margin-bottom:.5rem}
  .czz-trust-card p{font-size:14px;color:var(--czz-muted);margin:0;line-height:1.7}
  .czz-review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
  .czz-review-card{background:#fff;border:1px solid var(--czz-border);border-radius:var(--czz-radius);padding:1.75rem;transition:all .3s;position:relative}
  .czz-review-card:hover{transform:translateY(-3px);box-shadow:var(--czz-shadow)}
  .czz-review-card::before{content:'"';position:absolute;top:1rem;right:1.25rem;font-size:64px;color:var(--czz-accent-pale);font-weight:900;line-height:1;pointer-events:none}
  .czz-review-stars{color:var(--czz-accent);letter-spacing:2px;font-size:13px;margin-bottom:.625rem}
  .czz-review-text{font-size:14px;color:var(--czz-muted);line-height:1.75;margin-bottom:1.125rem;font-style:italic}
  .czz-review-author{display:flex;align-items:center;gap:9px}
  .czz-review-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:#fff;flex-shrink:0}
  .czz-review-name{font-weight:700;font-size:14px}
  .czz-review-meta{font-size:12px;color:var(--czz-muted2)}

  /* ── SHOWROOM ──────────────────────────────────────────────────── */
  .czz-showroom-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem}
  .czz-showroom-card{border:1px solid var(--czz-border);border-radius:var(--czz-radius);overflow:hidden;transition:all .3s}
  .czz-showroom-card:hover{transform:translateY(-4px);box-shadow:var(--czz-shadow-hover)}
  .czz-showroom-head{background:linear-gradient(135deg,#0d0b07,#1c1508);padding:2rem 2.25rem 1.75rem}
  .czz-showroom-pill{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--czz-accent2);background:rgba(179,139,77,.18);padding:3px 10px;border-radius:20px;display:inline-block;margin-bottom:.625rem}
  .czz-showroom-head h3{color:#fff;font-size:17px;margin-bottom:.3rem}
  .czz-showroom-head p{color:rgba(255,255,255,.5);font-size:13px;margin:0}
  .czz-showroom-body{background:#fff;padding:1.75rem 2.25rem}
  .czz-showroom-row{display:flex;align-items:flex-start;gap:8px;padding:.5rem 0;border-bottom:1px solid var(--czz-border);font-size:13px}
  .czz-showroom-row:last-child{border-bottom:none}
  .czz-showroom-row svg{width:16px;height:16px;fill:var(--czz-accent);flex-shrink:0;margin-top:2px}
  .czz-showroom-btns{margin-top:1.25rem;display:flex;gap:.625rem;flex-wrap:wrap}

  /* ── FINAL CTA ─────────────────────────────────────────────────── */
  .czz-final-cta{background:linear-gradient(135deg,#0d0b07 0%,#1c1508 60%,#0d0b07 100%);border-radius:28px;padding:4rem;position:relative;overflow:hidden}
  .czz-final-cta::before{content:'';position:absolute;top:-40%;right:-8%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.1) 0%,transparent 70%);pointer-events:none}
  .czz-final-cta::after{content:'';position:absolute;bottom:-30%;left:-5%;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(179,139,77,.06) 0%,transparent 70%);pointer-events:none}
  .czz-final-cta-inner{position:relative;z-index:1}
  .czz-final-cta h2{color:#fff;font-size:clamp(29px,3vw,42px);margin-bottom:.875rem;line-height:1.12}
  .czz-final-cta p{color:rgba(255,255,255,.65);font-size:16px;max-width:640px;margin-bottom:2rem;line-height:1.75}
  .czz-cta-points{display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:2rem}
  .czz-cta-point{display:flex;align-items:center;gap:7px}
  .czz-cta-point svg{width:16px;height:16px;fill:var(--czz-accent2);flex-shrink:0}
  .czz-cta-point span{font-size:13px;color:rgba(255,255,255,.6);font-weight:600}
  .czz-final-cta-btns{display:flex;gap:.875rem;flex-wrap:wrap}

  /* ── ANSWER BLOCKS ─────────────────────────────────────────────── */
  .czz-answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
  .czz-answer-block{background:#fff;border:1px solid var(--czz-border);border-radius:14px;padding:1.75rem;transition:all .3s}
  .czz-answer-block:hover{border-color:var(--czz-border2);box-shadow:0 4px 16px rgba(0,0,0,.05)}
  .czz-answer-block h3{font-size:14px;margin-bottom:.5rem}
  .czz-answer-block p{font-size:13px;color:var(--czz-muted);margin:0;line-height:1.75}

  /* ── FAQ ───────────────────────────────────────────────────────── */
  .czz-faq-item{border-bottom:1px solid var(--czz-border)}
  .czz-faq-q{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;cursor:pointer;gap:1rem}
  .czz-faq-q h3{font-size:16px;margin:0;font-weight:700;transition:color .2s;line-height:1.4}
  .czz-faq-q:hover h3{color:var(--czz-accent)}
  .czz-faq-icon{width:22px;height:22px;fill:var(--czz-muted2);flex-shrink:0;transition:transform .3s}
  .czz-faq-q.active .czz-faq-icon{transform:rotate(45deg)}
  .czz-faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease}
  .czz-faq-a.open{max-height:500px}
  .czz-faq-a p{margin:0;padding-bottom:1.4rem;font-size:15px;color:var(--czz-muted);line-height:1.8}
  .czz-faq-a a{color:var(--czz-accent);font-weight:700}

  /* ── LINK PILLS ────────────────────────────────────────────────── */
  .czz-link-pills{display:flex;flex-wrap:wrap;gap:.625rem;justify-content:center}
  .czz-link-pill{padding:.55rem 1.25rem;border:1.5px solid var(--czz-border);border-radius:50px;font-size:13px;font-weight:700;color:var(--czz-dark);background:#fff;transition:all .3s;text-decoration:none}
  .czz-link-pill:hover{border-color:var(--czz-accent);color:var(--czz-accent);background:var(--czz-accent-pale);transform:translateY(-2px)}

  /* ── RESPONSIVE ────────────────────────────────────────────────── */
  @media(max-width:1024px){
    .czz-pillar-grid{grid-template-columns:1fr 1fr}
    .czz-product-grid{grid-template-columns:1fr 1fr}
    .czz-trust-grid{grid-template-columns:1fr 1fr}
  }
  @media(max-width:900px){
    .czz-hero{min-height:65vh}
    .czz-hero h1{font-size:35px}
    .czz-glance-grid,.czz-for-grid,.czz-model-entry,.czz-buyer-grid,.czz-showroom-grid,.czz-qa-grid,.czz-answer-grid{grid-template-columns:1fr}
    .czz-pillar-grid,.czz-trust-grid,.czz-review-grid{grid-template-columns:1fr}
    .czz-product-grid{grid-template-columns:1fr 1fr;gap:1rem}
    .czz-section{padding:3.5rem 0}
    .czz-final-cta{padding:2.5rem 2rem}
    .czz-product-header-inner{flex-direction:column;align-items:flex-start}
    .czz-price-rung{grid-template-columns:1fr}
    .czz-price-rung-label{border-right:none;border-bottom:1px solid rgba(255,255,255,.08)}
  }
  @media(max-width:600px){
    .czz-product-grid{grid-template-columns:1fr}
    .czz-hero h1{font-size:30px}
    .czz-container{padding:0 1.25rem}
    .czz-product-header{padding:2rem 1.5rem 0}
    .czz-product-grid-wrap{padding:1.25rem}
  }
</style>

