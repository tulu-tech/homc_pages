{%- comment -%} ══════════ JAVASCRIPT ══════════ {%- endcomment -%}
<script>
// ─── DYNAMIC PRODUCT DATA FROM LIQUID ───────────────────────────────────────
var COZZIA_PRODUCTS = [
  {%- for product in collection.products -%}
    {%- assign feat_img = product.featured_image | image_url: width: 600 -%}
    {%- assign sale_price_cents = product.price -%}
    {%- assign compare_price_cents = product.compare_at_price -%}

    {%- comment -%} Build filter tags {%- endcomment -%}
    {%- assign filter_tags = "" -%}
    {%- for tag in product.tags -%}
      {%- assign tag_low = tag | downcase -%}
      {%- if tag_low == "quantum" or tag_low == "qi" or tag_low == "zen" or tag_low == "flagship" or tag_low == "ai" -%}
        {%- if filter_tags != "" -%}{%- assign filter_tags = filter_tags | append: "," -%}{%- endif -%}
        {%- assign filter_tags = filter_tags | append: '"' | append: tag_low | append: '"' -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Auto-detect badge from tags {%- endcomment -%}
    {%- assign auto_badge = "" -%}
    {%- assign auto_badge_class = "" -%}
    {%- if product.tags contains "flagship" -%}
      {%- assign auto_badge = "Flagship" -%}
      {%- assign auto_badge_class = "flagship" -%}
    {%- elsif product.tags contains "quantum" -%}
      {%- assign auto_badge = "5D AI" -%}
      {%- assign auto_badge_class = "flagship" -%}
    {%- elsif product.tags contains "qi" -%}
      {%- assign auto_badge = "4D AI" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- elsif product.tags contains "ai" -%}
      {%- assign auto_badge = "AI" -%}
      {%- assign auto_badge_class = "gold" -%}
    {%- endif -%}

    {%- assign badge_val = product.metafields.custom.badge.value | default: auto_badge -%}
    {%- assign badge_class_val = product.metafields.custom.badge_class.value | default: auto_badge_class -%}
    {%- assign buyer_for_val = product.metafields.custom.buyer_for.value | default: product.type -%}

    {%- assign feats_json = product.metafields.custom.key_features.value -%}
    {%- if feats_json == blank -%}
      {%- assign feats_json = '["Premium massage technology","Chair Doctor AI biometric","Zero gravity recline","Air compression system"]' -%}
    {%- endif -%}

    {
      n: {{ product.title | json }},
      u: {{ product.url | prepend: shop.url | json }},
      i: {{ feat_img | json }},
      p: {{ product.price | money | json }},
      cp: {% if compare_price_cents > sale_price_cents %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      tags: [{{ filter_tags }}],
      badge: {{ badge_val | json }},
      badgeClass: {{ badge_class_val | json }},
      for: {{ buyer_for_val | json }},
      feats: {{ feats_json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];

// ─── FILTER LOGIC ─────────────────────────────────────────────────────────
var czzCurrentFilter = {type:'all',value:'all'};

function czzFilter(btn,type,value){
  document.querySelectorAll('#czzFilterBar .czz-filter-btn').forEach(function(b){b.classList.remove('active')});
  btn.classList.add('active');
  czzCurrentFilter = {type:type,value:value};
  czzRenderProducts();
}

function czzFilteredProducts(){
  return COZZIA_PRODUCTS.filter(function(p){
    if(czzCurrentFilter.type==='all') return true;
    if(czzCurrentFilter.type==='price'){
      var num = parseFloat(p.p.replace(/[^0-9.]/g,''));
      if(czzCurrentFilter.value==='under5') return num<5000;
      if(czzCurrentFilter.value==='5to8') return num>=5000&&num<8000;
      if(czzCurrentFilter.value==='over8') return num>=8000;
    }
    if(czzCurrentFilter.type==='type') return p.tags.indexOf(czzCurrentFilter.value)!==-1;
    return true;
  });
}

function czzSaveCalc(p,cp){
  if(!cp) return '';
  var ps=parseFloat(p.replace(/[^0-9.]/g,'')),cs=parseFloat(cp.replace(/[^0-9.]/g,''));
  if(cs<=ps) return '';
  var pct=Math.round((cs-ps)/cs*100);
  return '<span class="czz-price-save">Save '+pct+'%</span>';
}

function czzRenderProducts(){
  var grid=document.getElementById('czzGrid');
  var count=document.getElementById('czzCount');
  var prods=czzFilteredProducts();
  if(count) count.textContent=prods.length+' model'+(prods.length!==1?'s':'');
  if(!grid) return;

  if(prods.length===0){
    grid.innerHTML='<div class="czz-no-results"><p>No models match this filter.</p></div>';
    return;
  }

  grid.style.opacity='0';
  grid.innerHTML='';

  prods.forEach(function(p){
    var saveHtml=czzSaveCalc(p.p,p.cp);
    var featsHtml=Array.isArray(p.feats)?p.feats.map(function(f){return '<li>'+f+'</li>';}).join(''):'' ;
    var badgeHtml=p.badge?'<span class="czz-product-badge '+p.badgeClass+'">'+p.badge+'</span>':'';
    var priceHtml='<span class="czz-price-sale">'+p.p+'</span>';
    if(p.cp) priceHtml+=' <span class="czz-price-was">'+p.cp+'</span>';
    if(saveHtml) priceHtml+=' '+saveHtml;

    var card=document.createElement('article');
    card.className='czz-product-card';
    card.innerHTML=
      badgeHtml+
      '<a href="'+p.u+'" style="display:block;position:relative;"><div class="czz-product-img-wrap"><img class="czz-product-img" src="'+p.i+'" alt="'+p.n+'" loading="lazy"></div></a>'+
      '<div class="czz-product-body">'+
        '<div class="czz-product-for">'+p.for+'</div>'+
        '<div class="czz-product-name"><a href="'+p.u+'">'+p.n+'</a></div>'+
        '<ul class="czz-product-feats">'+featsHtml+'</ul>'+
        '<div class="czz-product-prices">'+priceHtml+'</div>'+
        '<a href="'+p.u+'" class="czz-product-cta">View Details</a>'+
      '</div>';
    grid.appendChild(card);
  });

  setTimeout(function(){grid.style.opacity='1';grid.style.transition='opacity .3s';},40);
}

// ─── FAQ ACCORDION ────────────────────────────────────────────────────────
function czzFaq(el){
  var a=el.nextElementSibling;
  var isOpen=a.classList.contains('open');
  document.querySelectorAll('.czz-faq-a').forEach(function(x){x.classList.remove('open')});
  document.querySelectorAll('.czz-faq-q').forEach(function(x){x.classList.remove('active')});
  if(!isOpen){a.classList.add('open');el.classList.add('active');}
}

// ─── SUBNAV ACTIVE STATE ──────────────────────────────────────────────────
(function(){
  var links=document.querySelectorAll('.czz-subnav-inner a');
  var ids=['czz-collection','czz-overview','czz-why-cozzia','czz-model-guide','czz-buyer-types','czz-vs-brands','czz-pricing','czz-trust','czz-showrooms','czz-faq'];
  window.addEventListener('scroll',function(){
    var pos=window.scrollY+140,active='';
    ids.forEach(function(id){var el=document.getElementById(id);if(el&&pos>=el.offsetTop)active=id;});
    links.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+active)l.classList.add('active');});
  });
})();

// ─── INIT ─────────────────────────────────────────────────────────────────
czzRenderProducts();
</script>

{%- endpaginate -%}

